 "functions": [],
 "react": [
  {
   "component": "ProjectCard",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": false,
     "description": "The project's name"
    },
    {
     "name": "tasks",
     "type": "ProjectTask[]",
     "optional": true,
     "description": "Subtasks – one ring segment and one row each (controlled): ticks are only reported through `onTasksChange`, so\npass the new list back. Use `defaultTasks` to let the card keep the ticks itself"
    },
    {
     "name": "defaultTasks",
     "type": "ProjectTask[]",
     "optional": true,
     "description": "Starting subtasks when `tasks` isn't controlled"
    },
    {
     "name": "onTasksChange",
     "type": "(tasks: ProjectTask[]) => void",
     "optional": true,
     "description": "Called with the full list after a subtask was ticked or unticked"
    },
    {
     "name": "statuses",
     "type": "ProjectOption[]",
     "optional": true,
     "description": "Options of the status picker"
    },
    {
     "name": "status",
     "type": "string",
     "optional": true,
     "description": "The chosen status id (controlled)"
    },
    {
     "name": "defaultStatus",
     "type": "string",
     "optional": true,
     "description": "Starting status id when `status` isn't controlled – defaults to the first option"
    },
    {
     "name": "onStatusChange",
     "type": "(id: string) => void",
     "optional": true,
     "description": "Called with the id of the status picked"
    },
    {
     "name": "action",
     "type": "{ label: string; onClick: () => void }",
     "optional": true,
     "description": "A button on the tray of the open card (Clean: in its last row), e.g. { label: \"Open\", onClick }"
    },
    {
     "name": "hint",
     "type": "React.ReactNode",
     "optional": true,
     "description": "Replaces the line on the tray (Clean: in the last row) while nothing is hovered"
    },
    {
     "name": "open",
     "type": "boolean",
     "optional": true,
     "description": "Controlled open state"
    },
    {
     "name": "defaultOpen",
     "type": "boolean",
     "optional": true,
     "description": "Whether the card starts unfolded when `open` isn't controlled"
    },
    {
     "name": "onOpenChange",
     "type": "(open: boolean) => void",
     "optional": true,
     "description": "Called when the card opens or closes"
    }
   ],
   "hides": [
    "heading",
    "tasks",
    "statuses",
    "status",
    "open",
    "hint",
    "actionLabel"
   ]
