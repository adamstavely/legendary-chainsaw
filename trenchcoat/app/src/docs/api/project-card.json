{
 "elements": [
  {
   "tag": "tc-project-card",
   "className": "TcProjectCard",
   "description": "A project summary with a segmented progress ring that unfolds into its subtasks, people and status.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The project's name",
     "readonly": false
    },
    {
     "name": "tasks",
     "attribute": null,
     "type": "ProjectTask[]",
     "default": "[]",
     "description": "Subtasks – one ring segment and one row each",
     "readonly": false
    },
    {
     "name": "statuses",
     "attribute": null,
     "type": "ProjectOption[]",
     "default": "[ { id: \"todo\", label: \"To do\", tone: \"violet\" }, { id: \"progress\", label: \"In progress\", tone: \"amber\" }, { id: \"review\", label: \"In review\", tone: \"blue\" }, { id: \"done\", label: \"Done\", tone: \"green\" }, ]",
     "description": "Options of the status picker",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The chosen status id – unset is the first option",
     "readonly": false
    },
    {
     "name": "due",
     "attribute": "due",
     "type": "string",
     "default": "\"\"",
     "description": "Ready-to-show due date, e.g. \"Oct 24\"",
     "readonly": false
    },
    {
     "name": "members",
     "attribute": null,
     "type": "ProjectMember[]",
     "default": "[]",
     "description": "The people on the project – avatars in the head that filter the subtasks to theirs",
     "readonly": false
    },
    {
     "name": "actionLabel",
     "attribute": "action-label",
     "type": "string",
     "default": "\"\"",
     "description": "A button on the tray of the open card (Clean: in its last row); it fires tc-action",
     "readonly": false
    },
    {
     "name": "hint",
     "attribute": null,
     "type": "string | Element | undefined",
     "default": "undefined",
     "description": "Replaces the line on the tray while nothing is hovered: text, or an element (cloned)",
     "readonly": false
    },
    {
     "name": "trigger",
     "attribute": "trigger",
     "type": "\"hover\" | \"click\"",
     "default": "\"hover\"",
     "description": "\"hover\" opens under the pointer (taps and the keyboard still toggle), \"click\" only on click",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": "open",
     "type": "boolean",
     "default": "false",
     "description": "Whether the card is unfolded, showing the subtasks, the people filter and the tray",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-tasks-change",
     "detail": "",
     "description": "A subtask was ticked or unticked; detail `{ tasks: ProjectTask[] }`. Cancelable.",
     "cancelable": true
