{
 "elements": [
  {
   "tag": "tc-flow-builder",
   "className": "TcFlowBuilder",
   "description": "An automation built in place as a top-down flow – + on every line, If / else paths, undo, and a test run that lights\nthe working step.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Flow\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "trigger",
     "attribute": null,
     "type": "FlowTrigger",
     "default": "{ title: \"When this happens\" }",
     "description": "What starts the flow, shown at the top",
     "readonly": false
    },
    {
     "name": "flow",
     "attribute": null,
     "type": "FlowStep[]",
     "default": "[]",
     "description": "The steps, in order, with If / else paths inside. Changed by the user unless a tc-flow-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "options",
     "attribute": null,
     "type": "FlowStepOption[]",
     "default": "[ { id: \"ai\", kind: \"llm\", label: \"AI step\", description: \"Asks a model to write, sort or pull out\" }, { id: \"message\", kind: \"output\", label: \"Send message\", description: \"Emails or posts to people you choose\" }, { id: \"wait\", kind: \"wait\", label: \"Wait\", description: \"Pauses for a time or until something happens\" }, { id: \"if-else\", kind: \"condition\", label: \"If / else\", description: \"Splits into two paths by a rule\", branches: [\"If\", \"Else\"] }, { id: \"approval\", kind: \"approval\", label: \"Approval\", description: \"Waits for a person to approve\" }, ]",
     "description": "The steps the + menu offers",
     "readonly": false
    },
    {
     "name": "kinds",
     "attribute": null,
     "type": "Record<string, Partial<WorkflowKindInfo>>",
     "default": "{}",
     "description": "Labels and icons for kinds, merged over the defaults",
     "readonly": false
    },
    {
     "name": "statuses",
     "attribute": null,
     "type": "Record<string, FlowStepStatus>",
     "default": "{}",
     "description": "Each step's state in a test run, by step id – a light runs into the one that's \"running\"",
     "readonly": false
    },
    {
     "name": "statusLabels",
     "attribute": null,
     "type": "Partial<Record<FlowStepStatus, string>>",
     "default": "{}",
     "description": "The status words, merged over the defaults",
     "readonly": false
    },
    {
     "name": "readonly",
     "attribute": "readonly",
     "type": "boolean",
     "default": "false",
     "description": "Leaves out the editing controls: no +, renaming, moving or removing",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-flow-change",
