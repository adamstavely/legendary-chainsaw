{
 "elements": [
  {
   "tag": "tc-agent-recap",
   "className": "TcAgentRecap",
   "description": "What your agents did while you were away – a chart of the period with a marker per notable event, then Needs you,\nFailed and Done, acted on in place.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Agent recap\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "since",
     "attribute": "since",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When the period began – when you left – in epoch ms; unset starts at the first event",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When it ends, in epoch ms; unset reads the clock once",
     "readonly": false
    },
    {
     "name": "events",
     "attribute": null,
     "type": "RecapEvent[]",
     "default": "[]",
     "description": "Everything that happened, for the chart",
     "readonly": false
    },
    {
     "name": "items",
     "attribute": null,
     "type": "RecapItem[]",
     "default": "[]",
     "description": "What's on the board, in any order – grouped by status, newest first",
     "readonly": false
    },
    {
     "name": "binMinutes",
     "attribute": "bin-minutes",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Minutes per bar; unset is 15 for six hours or less, else 30 (wider when it would pass 64 bars)",
     "readonly": false
    },
    {
     "name": "still",
     "attribute": "still",
     "type": "boolean",
     "default": "false",
     "description": "Draws the chart at once, without the entrance",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Locale for times",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<AgentRecapLabels>",
     "default": "{}",
     "description": "Words the page can change, merged over defaultAgentRecapLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-item-action",
