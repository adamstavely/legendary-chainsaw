    "--tc-tray-inset",
    "--tc-tray-radius"
   ]
  }
 ],
 "functions": [
  {
   "name": "scheduleCountdown",
   "signature": "scheduleCountdown(ms: number): void",
   "description": "\"in 2 h 10 min\", \"in 45 s\" – the time left, to the precision that matters"
  }
 ],
 "react": [
  {
   "component": "ScheduleCard",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The task's name, and the card's heading"
    },
    {
     "name": "paused",
     "type": "boolean",
     "optional": true,
     "description": "Paused – controlled when given"
    },
    {
     "name": "defaultPaused",
     "type": "boolean",
     "optional": true,
     "description": "Paused on mount when `paused` isn't controlled"
    },
    {
     "name": "onPausedChange",
     "type": "(paused: boolean) => void",
     "optional": true,
     "description": "Pause or Resume was pressed"
    },
    {
     "name": "onRunNow",
     "type": "() => void",
     "optional": true,
     "description": "Run now was pressed"
    },
    {
     "name": "onEdit",
     "type": "() => void",
     "optional": true,
     "description": "Edit was pressed"
    },
    {
     "name": "onRunOpen",
     "type": "(id: string, run: ScheduleRun) => void",
     "optional": true,
     "description": "A run in the strip was opened"
    }
   ],
   "hides": [
    "heading",
    "paused",
    "children"
   ],
   "events": {
    "tc-run-now": "onRunNow",
    "tc-paused-change": null,
    "tc-edit": "onEdit",
    "tc-run-open": "onRunOpen"
   }
  }
 ],
