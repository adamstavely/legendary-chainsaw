{
 "elements": [
  {
   "tag": "tc-schedule-card",
   "className": "TcScheduleCard",
   "description": "A recurring agent task at a glance – the schedule in words, a live countdown to the next run, the last runs as\nmarks, and Run now, Pause / Resume and Edit.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Scheduled task\"",
     "description": "The task's name, and the card's heading",
     "readonly": false
    },
    {
     "name": "schedule",
     "attribute": "schedule",
     "type": "string",
     "default": "\"\"",
     "description": "The schedule in words, e.g. \"Every weekday at 09:00, Europe/London\"",
     "readonly": false
    },
    {
     "name": "nextRun",
     "attribute": null,
     "type": "number | null",
     "default": "null",
     "description": "When it runs next, epoch ms; null when nothing is scheduled",
     "readonly": false
    },
    {
     "name": "runs",
     "attribute": null,
     "type": "ScheduleRun[]",
     "default": "[]",
     "description": "The last runs, oldest first",
     "readonly": false
    },
    {
     "name": "maxRuns",
     "attribute": "max-runs",
     "type": "number",
     "default": "14",
     "description": "How many of the last runs the strip shows",
     "readonly": false
    },
    {
     "name": "paused",
     "attribute": "paused",
     "type": "boolean",
     "default": "false",
     "description": "Paused: no countdown, and Resume in place of Pause. Changed by the user unless a tc-paused-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The time now, epoch ms; leave it unset and the element keeps its own clock",
     "readonly": false
    },
    {
     "name": "hideEdit",
     "attribute": "hide-edit",
     "type": "boolean",
     "default": "false",
     "description": "Hides Edit",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for dates and times, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "ScheduleCardLabelsInput",
     "default": "{}",
     "description": "The card's words, merged over defaultScheduleCardLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-run-now",
     "detail": "",
     "description": "Run now was pressed (detail: {})",
     "cancelable": false
    },
    {
     "name": "tc-paused-change",
     "detail": "",
     "description": "Pause or Resume was pressed ({ paused }: SchedulePausedChange); cancelable – prevented, `paused` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-edit",
     "detail": "",
     "description": "Edit was pressed (detail: {})",
     "cancelable": false
    },
    {
     "name": "tc-run-open",
     "detail": "",
     "description": "A run in the strip was opened ({ id, run }: ScheduleRunOpen)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "scd",
   "cssProperties": [
    {
     "name": "--tc-scd-mark",
     "value": "22px",
     "looks": [
      "both"
     ]
    }
   ],
   "tokens": [
