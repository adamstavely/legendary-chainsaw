   ]
  },
  "features": [
   {
    "id": "light-dark",
    "name": "light-dark()",
    "bcd": "css.types.color.light-dark",
    "versions": {
     "chrome": "123",
     "edge": "123",
     "firefox": "120",
     "safari": "17.5",
     "safari_ios": "17.5"
    },
    "progressive": false,
    "why": "Every colour token is a light / dark pair; without it no colour token resolves.",
