{
 "elements": [
  {
   "tag": "tc-disagreement-banner",
   "className": "TcDisagreementBanner",
   "description": "Today's answer and an earlier answer to the same question side by side, the difference highlighted, with dismiss\nand open-the-earlier-session.",
   "properties": [
    {
     "name": "earlier",
     "attribute": null,
     "type": "DisagreementAnswer | undefined",
     "default": "undefined",
     "description": "The earlier answer – on the left",
     "readonly": false
    },
    {
     "name": "current",
     "attribute": null,
     "type": "DisagreementAnswer | undefined",
     "default": "undefined",
     "description": "Today's answer – on the right",
     "readonly": false
    },
    {
     "name": "question",
     "attribute": "question",
     "type": "string",
     "default": "\"\"",
     "description": "The question both answers were given to, shown under the heading",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"This answer differs from an earlier one\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "summary",
     "attribute": "summary",
     "type": "string",
     "default": "\"\"",
     "description": "A line from your product on what changed, e.g. \"The notice period went from 30 to 60 days\"",
     "readonly": false
    },
    {
     "name": "expanded",
     "attribute": "expanded",
     "type": "boolean",
     "default": "false",
     "description": "Shows both answers in full; unset, long answers show only the changes and the words around them",
     "readonly": false
    },
    {
     "name": "context",
     "attribute": "context",
     "type": "number",
     "default": "8",
     "description": "How many shared words to keep either side of a change while not expanded",
     "readonly": false
    },
    {
     "name": "dismissible",
     "attribute": "dismissible",
     "type": "boolean",
     "default": "false",
     "description": "Shows Dismiss (fires tc-dismiss)",
     "readonly": false
    },
    {
     "name": "canOpen",
     "attribute": "can-open",
     "type": "boolean",
     "default": "false",
     "description": "Shows \"Open earlier session\" (fires tc-open-session)",
     "readonly": false
    },
    {
     "name": "dismissed",
     "attribute": "dismissed",
     "type": "boolean",
     "default": "false",
     "description": "Dismissed: the banner shows nothing",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-expanded-change",
     "detail": "",
     "description": "\"Show full answers\" or \"Show changes only\" was pressed; detail `{ expanded }`: DisagreementExpandedChange. Cancelable.",
     "cancelable": true
    },
    {
     "name": "tc-dismiss",
     "detail": "",
     "description": "Dismiss was pressed (with `dismissible`); detail `null`. Cancelable: preventDefault() keeps the banner.",
     "cancelable": true
    },
    {
     "name": "tc-open-session",
     "detail": "",
     "description": "\"Open earlier session\" was pressed (with `can-open`); detail `{ sessionId, answer }`: DisagreementOpenSession.",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
