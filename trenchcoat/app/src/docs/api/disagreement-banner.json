 "functions": [],
 "react": [
  {
   "component": "DisagreementBanner",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading"
    },
    {
     "name": "expanded",
     "type": "boolean",
     "optional": true,
     "description": "Shows both answers in full (controlled). Leave it undefined to let the banner keep it, starting at `defaultExpanded`"
    },
    {
     "name": "defaultExpanded",
     "type": "boolean",
     "optional": true,
     "description": "Whether both answers show in full at first when uncontrolled"
    },
    {
     "name": "onExpandedChange",
     "type": "(expanded: boolean) => void",
     "optional": true,
     "description": "Called when \"Show full answers\" or \"Show changes only\" is pressed, controlled or not"
    },
    {
     "name": "onDismiss",
     "type": "() => boolean | void",
     "optional": true,
     "description": "Shows Dismiss and is called when it's pressed; return false to keep the banner"
    },
    {
     "name": "onOpenEarlier",
     "type": "(sessionId: string | undefined, answer: DisagreementAnswer) => void",
     "optional": true,
     "description": "Shows \"Open earlier session\" and is called with the earlier answer's session id when it's pressed"
    }
   ],
   "hides": [
    "heading",
    "expanded",
    "dismissible",
    "canOpen",
    "dismissed"
   ],
   "events": {
    "tc-expanded-change": "onExpandedChange",
    "tc-dismiss": "onDismiss",
    "tc-open-session": "onOpenEarlier"
   }
  }
 ],
 "changelog": [
  "**Trust & calibration**, from THEMIS and built domain-neutral: - claims and their reliability: `tc-claim-answer`, `tc-verification-queue`, `tc-reflection-gate`, `tc-reliance-gauge`, `tc-disagreement-banner`, `tc-synthesis-notes`; - where outputs came from: `tc-lineage-graph`, `tc-validity-badge`, `tc-provenance-summary`, `tc-correction-propagation`, `tc-attestation-check`, `tc-run-manifest`; - policy and control: `tc-policy-simulator`, `tc-gate-config`, `tc-coverage-matrix`, `tc-kill-switch`, `tc-playbook-canvas`."
 ],
