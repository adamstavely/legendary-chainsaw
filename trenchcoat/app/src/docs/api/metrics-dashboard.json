     "optional": true,
     "description": "Line or bars (controlled)"
    },
    {
     "name": "defaultChart",
     "type": "MetricsChart",
     "optional": true,
     "description": "The chart type at first (uncontrolled)"
    },
    {
     "name": "onChartChange",
