{
 "elements": [
  {
   "tag": "tc-metrics-dashboard",
   "className": "TcMetricsDashboard",
   "description": "A compact sales overview: KPI tabs that pick the charted metric, a line or bar chart with an optional previous-period\ncomparison, and top products and channels.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Sales\"",
     "description": "Title in the bar on top",
     "readonly": false
    },
    {
     "name": "site",
     "attribute": "site",
     "type": "string",
     "default": "\"Northwind Store\"",
     "description": "Site or workspace shown under the title",
     "readonly": false
    },
    {
     "name": "range",
     "attribute": "range",
     "type": "RangeKey",
     "default": "\"30d\"",
     "description": "The period: \"7d\", \"30d\" or \"90d\"",
     "readonly": false
    },
    {
     "name": "metric",
     "attribute": "metric",
     "type": "MetricKey",
     "default": "\"revenue\"",
     "description": "The charted metric: \"revenue\", \"orders\", \"aov\" or \"refunds\"",
     "readonly": false
    },
    {
     "name": "chart",
     "attribute": "chart",
     "type": "MetricsChart",
     "default": "\"line\"",
     "description": "The chart type: \"line\" or \"bars\"",
     "readonly": false
    },
    {
     "name": "compare",
     "attribute": "compare",
     "type": "boolean",
     "default": "false",
     "description": "Shows the previous period beside the current one",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Last day of the sample data, as epoch ms – today by default",
     "readonly": false
    },
    {
     "name": "onExport",
     "attribute": null,
     "type": "((range: RangeKey, metric: MetricKey) => void | Promise<unknown>) | undefined",
     "default": "undefined",
     "description": "Called when Export is pressed, with the current range and metric. Return a promise to show Exporting… until it settles",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-range-change",
     "detail": "",
     "description": "The period was picked ({ range }: MetricsRangeChange); cancelable – prevented, `range` stays",
     "cancelable": true
    },
    {
     "name": "tc-metric-change",
     "detail": "",
     "description": "A KPI card was picked ({ metric }: MetricsMetricChange); cancelable – prevented, `metric` stays",
     "cancelable": true
    },
    {
     "name": "tc-chart-change",
     "detail": "",
     "description": "Line or bars was picked ({ chart }: MetricsChartChange); cancelable – prevented, `chart` stays",
     "cancelable": true
    },
    {
     "name": "tc-compare-change",
     "detail": "",
     "description": "The comparison switch was toggled ({ compare }: MetricsCompareChange); cancelable – prevented, `compare` stays",
     "cancelable": true
    },
    {
     "name": "tc-export",
     "detail": "",
     "description": "Export was pressed ({ range, metric }: MetricsExport); `onExport` may return a promise it waits for",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "md",
