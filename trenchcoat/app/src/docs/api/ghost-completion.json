{
 "elements": [
  {
   "tag": "tc-ghost-completion",
   "className": "TcGhostCompletion",
   "description": "A text field with dimmed AI suggestions after the caret – Tab accepts, Ctrl/⌘ + → takes a word, Escape dismisses.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Draft\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "label",
     "attribute": "label",
     "type": "string",
     "default": "\"Message\"",
     "description": "The field's visible label",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": "value",
     "type": "string",
     "default": "\"\"",
     "description": "The text in the field",
     "readonly": false
    },
    {
     "name": "placeholder",
     "attribute": "placeholder",
     "type": "string",
     "default": "\"\"",
     "description": "Shown while the field is empty and there's no suggestion",
     "readonly": false
    },
    {
     "name": "rows",
     "attribute": "rows",
     "type": "number",
     "default": "4",
     "description": "The field's height in lines",
     "readonly": false
    },
    {
     "name": "suggestion",
     "attribute": "suggestion",
     "type": "string",
     "default": "\"\"",
     "description": "A suggestion the page sets itself: the text to show after what's typed. Typing that matches it uses it up",
     "readonly": false
    },
    {
     "name": "suggest",
     "attribute": null,
     "type": "GhostCompletionSuggest | undefined",
     "default": "undefined",
     "description": "Asked for a suggestion a moment after typing stops; the signal aborts when typing starts again",
     "readonly": false
    },
    {
     "name": "debounce",
     "attribute": "debounce",
     "type": "number",
     "default": "300",
     "description": "How long typing must pause before `suggest` is asked, in ms",
     "readonly": false
    },
    {
     "name": "disabled",
     "attribute": "disabled",
     "type": "boolean",
     "default": "false",
     "description": "No editing and no suggestions",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<GhostCompletionLabels>",
     "default": "{}",
     "description": "Words the page can rename, merged over defaultGhostCompletionLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "The text changed by typing or accepting ({ value }: GhostCompletionValueChange); cancelable – prevented, the field keeps its text",
     "cancelable": true
    },
    {
     "name": "tc-accept",
     "detail": "",
     "description": "Some or all of a suggestion was taken ({ text, whole }: GhostCompletionAccept)",
     "cancelable": false
    },
    {
     "name": "tc-dismiss",
     "detail": "",
     "description": "The suggestion was dismissed with Escape ({ text }: GhostCompletionDismiss)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "focus",
     "params": "options?: FocusOptions",
     "returns": "void",
     "description": "Puts focus in the field"
    },
    {
     "name": "accept",
     "params": "whole: unknown",
     "returns": "void",
     "description": "Takes the suggestion – all of it, or its next word"
    },
    {
     "name": "dismiss",
     "params": "",
     "returns": "void",
     "description": "Hides the suggestion until the next one"
    }
   ],
   "ui": "ghc",
   "cssProperties": [
    {
     "name": "--tc-ghc-ghost",
     "value": "var(--tc-text-muted)",
     "looks": [
      "both"
     ]
    }
