     "type": "string[]",
     "optional": true,
     "description": "Ids of the needs ticked off – controlled when given"
    },
    {
     "name": "defaultChecked",
     "type": "string[]",
     "optional": true,
     "description": "The needs ticked off at first, when `checked` isn't set"
    },
    {
     "name": "onCheckedChange",
     "type": "(checked: string[]) => void",
     "optional": true,
     "description": "Called with the ids of the ticked needs, in the needs' order, whenever one is ticked or unticked"
    },
    {
     "name": "note",
     "type": "string",
     "optional": true,
     "description": "The note for the agent – controlled when given"
    },
    {
     "name": "defaultNote",
     "type": "string",
     "optional": true,
     "description": "The note at first, when `note` isn't set"
    },
    {
     "name": "onNoteChange",
     "type": "(note: string) => void",
     "optional": true,
     "description": "Called with the note as it is typed"
    },
    {
     "name": "onReturn",
     "type": "(result: HandoffReturn) => void",
     "optional": true,
     "description": "Handed back: what was done, what's still open and the note – the agent should listen to this"
    }
