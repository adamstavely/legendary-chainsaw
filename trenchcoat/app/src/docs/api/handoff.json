{
 "elements": [
  {
   "tag": "tc-handoff",
   "className": "TcHandoff",
   "description": "The agent hands control to a person mid-task with what it did, why it stopped and what it needs – and takes it back.",
   "properties": [
    {
     "name": "agent",
     "attribute": null,
     "type": "HandoffAgent",
     "default": "{ name: \"\" }",
     "description": "Who hands over",
     "readonly": false
    },
    {
     "name": "ask",
     "attribute": "ask",
     "type": "string",
     "default": "\"\"",
     "description": "What it needs you to do, lower case after \"needs you to\", e.g. \"sign in to Stripe\"",
     "readonly": false
    },
    {
     "name": "task",
     "attribute": "task",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The run it belongs to, e.g. \"Book flights to Lisbon\" – shown under the heading",
     "readonly": false
    },
    {
     "name": "step",
     "attribute": "step",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Where in the run, e.g. \"Step 4 of 7\"",
     "readonly": false
    },
    {
     "name": "blocker",
     "attribute": "blocker",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Why it stopped, in a pill: \"Sign-in required\", \"Needs a decision\"",
     "readonly": false
    },
    {
     "name": "reason",
     "attribute": "reason",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The agent's own words on why it stopped",
     "readonly": false
    },
    {
     "name": "done",
     "attribute": null,
     "type": "HandoffItem[]",
     "default": "[]",
     "description": "What it did so far",
     "readonly": false
    },
    {
     "name": "needs",
     "attribute": null,
     "type": "HandoffItem[]",
     "default": "[]",
     "description": "What it needs from you – a checklist once you have control",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "HandoffStatus",
     "default": "\"waiting\"",
     "description": "Who has control",
     "readonly": false
    },
    {
     "name": "checked",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "Ids of the needs ticked off",
     "readonly": false
    },
    {
     "name": "note",
     "attribute": "note",
     "type": "string",
     "default": "\"\"",
     "description": "Your note for the agent, passed on when you hand back",
     "readonly": false
    },
    {
     "name": "doneLimit",
     "attribute": "done-limit",
     "type": "number",
     "default": "3",
     "description": "Done steps shown before \"N more\"",
     "readonly": false
    },
    {
     "name": "doneTitle",
     "attribute": "done-title",
     "type": "string",
     "default": "\"What I did\"",
     "description": "Heading of the list of what the agent did",
     "readonly": false
    },
    {
     "name": "needsTitle",
     "attribute": "needs-title",
     "type": "string",
     "default": "\"What I need from you\"",
     "description": "Heading of the list of what the agent needs – the checklist once you have control",
     "readonly": false
    },
    {
     "name": "noteLabel",
     "attribute": "note-label",
     "type": "string",
     "default": "\"Note for the agent\"",
     "description": "Label of the note field shown while you have control",
     "readonly": false
    },
    {
     "name": "notePlaceholder",
     "attribute": "note-placeholder",
     "type": "string",
     "default": "\"Anything it should know before it carries on\"",
     "description": "Placeholder of the note field",
     "readonly": false
    },
    {
     "name": "shortcuts",
     "attribute": "shortcuts",
     "type": "boolean",
     "default": "true",
     "description": "Show ⌘↵ hints on the main button (the shortcut works either way). Default true",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
