{
 "elements": [
  {
   "tag": "tc-schema-fields",
   "className": "TcSchemaFields",
   "description": "An API's fields from a JSON Schema: name, type in words, required, default, limits and meaning, with nested objects folding under their field.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Fields\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "schema",
     "attribute": null,
     "type": "JsonSchema | undefined",
     "default": "undefined",
     "description": "A JSON Schema for an object; its properties become the fields",
     "readonly": false
    },
    {
     "name": "fields",
     "attribute": null,
     "type": "SchemaField[] | undefined",
     "default": "undefined",
     "description": "The fields themselves; wins over `schema`",
     "readonly": false
    },
    {
     "name": "expanded",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The paths of fields whose children are showing (\"owner\", \"owner.address\"). Changed by the toggles unless a tc-expanded-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "query",
     "attribute": "query",
     "type": "string",
     "default": "\"\"",
     "description": "The filter text. Changed by typing unless a tc-query-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "searchThreshold",
     "attribute": "search-threshold",
     "type": "number",
     "default": "8",
     "description": "How many fields bring up the filter box; 0 always shows it",
     "readonly": false
    },
    {
     "name": "idPrefix",
     "attribute": "id-prefix",
     "type": "string",
     "default": "\"field\"",
     "description": "What anchors start with: `<id-prefix>-owner.email`",
     "readonly": false
    },
    {
     "name": "anchorBase",
     "attribute": "anchor-base",
     "type": "string",
     "default": "\"\"",
     "description": "The address Copy link puts before the anchor; the page's own address when empty",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<SchemaFieldsLabels>",
     "default": "{}",
     "description": "Rename any of the words, over the defaults",
     "readonly": false
    },
    {
     "name": "resolvedFields",
     "attribute": null,
     "type": "SchemaField[]",
     "default": null,
     "description": "The fields drawn: `fields`, else the schema's",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-expanded-change",
     "detail": "",
     "description": "A field's children opened or closed, or Expand all / Collapse all was pressed ({ expanded, path, open }: SchemaFieldsExpandedChange); cancelable – prevented, `expanded` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-query-change",
     "detail": "",
     "description": "The filter changed ({ query }: SchemaFieldsQueryChange); cancelable – prevented, `query` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-anchor-copy",
     "detail": "",
     "description": "Copy link was pressed ({ id, path, url }: SchemaFieldsAnchorCopy); cancelable – prevented, nothing is copied",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "scf",
   "cssProperties": [
    {
     "name": "--tc-scf-indent",
     "value": "var(--tc-space-3)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-scf-depth",
     "value": "0",
     "looks": [
      "both"
     ],
     "fallback": true
    }
   ],
   "tokens": [
    "--tc-accent-text",
    "--tc-border-default",
    "--tc-card-radius",
    "--tc-card-shadow",
    "--tc-control-h-sm",
    "--tc-control-radius-sm",
