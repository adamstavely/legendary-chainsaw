    "--tc-font-mono",
    "--tc-font-sans",
    "--tc-font-size-md",
    "--tc-font-size-sm",
    "--tc-font-size-xs",
    "--tc-font-weight-medium",
    "--tc-font-weight-semibold",
    "--tc-hairline",
    "--tc-line-height-normal",
    "--tc-radius-full",
    "--tc-radius-sm",
    "--tc-space-1",
    "--tc-space-1-5",
    "--tc-space-2",
    "--tc-space-2-5",
    "--tc-space-3",
    "--tc-space-4",
    "--tc-space-5",
    "--tc-space-6",
    "--tc-status-danger-fg",
    "--tc-status-warning-fg",
    "--tc-surface-on-tray",
    "--tc-surface-raised",
    "--tc-surface-tray",
    "--tc-text-muted",
    "--tc-text-primary",
    "--tc-text-secondary",
    "--tc-tray-inset",
    "--tc-tray-radius"
   ]
  }
 ],
 "functions": [
  {
   "name": "defaultSchemaFieldsLabels",
   "signature": "defaultSchemaFieldsLabels: SchemaFieldsLabels",
   "description": "The words used when the page gives none"
  },
  {
   "name": "schemaConstraints",
   "signature": "schemaConstraints(s: JsonSchema): string[]",
   "description": "The limits of a schema node, in words"
  },
  {
   "name": "schemaToFields",
   "signature": "schemaToFields(schema: JsonSchema | undefined, root: JsonSchema | undefined, depth: unknown): SchemaField[]",
   "description": "A JSON Schema's properties as fields – nested objects and arrays of objects as `fields`"
  },
  {
   "name": "fieldTypeWords",
   "signature": "fieldTypeWords(f: SchemaField): void",
   "description": "A field's type in words: \"string · email\", \"array of Tag\", \"string or null\""
  }
 ],
 "react": [
  {
   "component": "SchemaFields",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading"
    },
    {
     "name": "expanded",
     "type": "string[]",
     "optional": true,
     "description": "The paths of fields whose children are showing – controlled when given"
    },
    {
     "name": "defaultExpanded",
     "type": "string[]",
     "optional": true,
     "description": "On mount, when `expanded` isn't controlled"
    },
    {
     "name": "onExpandedChange",
     "type": "(expanded: string[], detail: SchemaFieldsExpandedChange) => void",
     "optional": true,
     "description": "Called with the open fields' paths when a field opens or closes, or Expand all / Collapse all is pressed"
    },
    {
     "name": "query",
     "type": "string",
     "optional": true,
     "description": "The filter text – controlled when given"
    },
    {
     "name": "defaultQuery",
     "type": "string",
     "optional": true,
     "description": "On mount, when `query` isn't controlled"
    },
    {
     "name": "onQueryChange",
     "type": "(query: string) => void",
     "optional": true,
     "description": "Called with the filter text as it's typed"
    },
    {
     "name": "onAnchorCopy",
     "type": "(detail: SchemaFieldsAnchorCopy) => boolean | void",
     "optional": true,
     "description": "Copy link was pressed; return false to copy nothing (the page copies or shares it itself)"
    }
   ],
   "hides": [
    "heading",
    "expanded",
    "query",
    "children"
   ],
   "events": {
    "tc-expanded-change": null,
    "tc-query-change": null,
    "tc-anchor-copy": "onAnchorCopy"
   }
  }
 ],
