{
 "elements": [
  {
   "tag": "tc-fine-tune-card",
   "className": "TcFineTuneCard",
   "description": "An inspector where an agent tunes a design's properties and the person can take over: numbers, a percentage, a choice and swatches, a live preview, Agent markers and a revert.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Fine-tune\"",
     "description": "What's being tuned, such as \"Findings summary\"; empty draws no header",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "sections",
     "attribute": null,
     "type": "FineTuneSection[]",
     "default": "[]",
     "description": "The fields, in sections",
     "readonly": false
    },
    {
     "name": "values",
     "attribute": null,
     "type": "FineTuneValues",
     "default": "{}",
     "description": "Each field's value by its id. Changed by the fields unless a tc-values-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "agentChanges",
     "attribute": null,
     "type": "FineTuneAgentChange[]",
     "default": "[]",
     "description": "Changes the agent made; each new list is applied, counted in and marked",
     "readonly": false
    },
    {
     "name": "adjusting",
     "attribute": "adjusting",
     "type": "boolean",
     "default": "false",
     "description": "The agent is working: Adjust says so and waits",
     "readonly": false
    },
    {
     "name": "preview",
     "attribute": null,
     "type": "FineTunePreview",
     "default": "{ width: \"w\", height: \"h\", radius: \"radius\", opacity: \"opacity\", fill: \"fill\", type: \"type\" }",
     "description": "Which fields the preview follows, by id; an empty object hides the preview",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<FineTuneLabels>",
     "default": "{}",
     "description": "Rename any of the words, over the defaults",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-values-change",
     "detail": "",
     "description": "A field changed, by the person, the agent or a revert ({ values, field, source }: FineTuneValuesChange); cancelable – prevented, `values` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-adjust-request",
     "detail": "",
     "description": "Adjust was pressed: the page should ask its agent to tune ({ heading }: FineTuneAdjustRequest)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "applyAgentChange",
     "params": "field: string, to: number | string",
     "returns": "void",
     "description": "Applies one change from the agent: it counts in, flashes and is marked until the person edits the field"
    },
    {
     "name": "applyAgentChanges",
     "params": "changes: FineTuneAgentChange[]",
     "returns": "void",
     "description": "Applies several of the agent's changes as one change to `values`"
    },
    {
     "name": "revertAgentChanges",
     "params": "",
     "returns": "void",
     "description": "Puts back every value the agent changed"
    }
   ],
   "ui": "ftc",
   "cssProperties": [
    {
     "name": "--tc-ftc-fill",
     "value": "var(--tc-surface-raised)",
     "looks": [
      "both"
