{
 "elements": [
  {
   "tag": "tc-session-context-bar",
   "className": "TcSessionContextBar",
   "description": "The session's declared terms kept in view – intent, knowledge mode, scope, review, posture, limits, deadline and\nbudget – as labelled chips, with \"+N more\" for the rest.",
   "properties": [
    {
     "name": "terms",
