     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "certifications",
     "attribute": null,
     "type": "TrustCertification[]",
     "default": "[]",
     "description": "Certifications and frameworks, in order",
     "readonly": false
    },
    {
