 "react": [
  {
   "component": "SessionList",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading; \"\" leaves the header out"
    },
    {
     "name": "selected",
     "type": "string | null",
     "optional": true,
     "description": "The open session's id – controlled when given"
    },
    {
     "name": "defaultSelected",
     "type": "string | null",
     "optional": true,
     "description": "At first, when `selected` isn't controlled"
    },
    {
     "name": "onSelectedChange",
     "type": "(selected: string | null, session?: SessionItem) => void",
     "optional": true,
     "description": "Another session was opened"
    },
    {
     "name": "query",
     "type": "string",
     "optional": true,
     "description": "The filter's text – controlled when given"
    },
    {
     "name": "defaultQuery",
     "type": "string",
     "optional": true,
     "description": "At first, when `query` isn't controlled"
    },
    {
     "name": "onQueryChange",
     "type": "(query: string) => void",
     "optional": true,
     "description": "The filter's text changed"
    }
   ],
   "hides": [
    "heading",
    "selected",
    "query",
    "children"
   ],
   "events": {
    "tc-selected-change": "onSelectedChange",
    "tc-query-change": null,
    "tc-pin": "onTcPin",
    "tc-archive": "onTcArchive",
    "tc-create": "onTcCreate",
    "tc-action": "onTcAction"
   }
  }
