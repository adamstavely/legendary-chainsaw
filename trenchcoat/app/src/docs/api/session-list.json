{
 "elements": [
  {
   "tag": "tc-session-list",
   "className": "TcSessionList",
   "description": "The sessions in a sidebar: pinned first, then grouped by project or status, each with its status, title, unread dot, branch and time, plus Pin and Archive.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Sessions\"",
     "description": "The heading; empty draws no header",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "sessions",
     "attribute": null,
     "type": "SessionItem[]",
     "default": "[]",
     "description": "The sessions, any order; within a group the newest comes first",
     "readonly": false
    },
    {
     "name": "groupBy",
     "attribute": "group-by",
     "type": "SessionGroupBy",
     "default": "\"project\"",
     "description": "How the unpinned sessions are grouped",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The open session's id. Changed by the user unless a tc-selected-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "query",
     "attribute": "query",
     "type": "string",
     "default": "\"\"",
     "description": "What the filter holds. Changed by typing unless a tc-query-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "hideFilter",
     "attribute": "hide-filter",
     "type": "boolean",
     "default": "false",
     "description": "Hides the filter",
     "readonly": false
    },
    {
     "name": "hideCreate",
     "attribute": "hide-create",
     "type": "boolean",
     "default": "false",
     "description": "Hides New session",
     "readonly": false
    },
    {
     "name": "actions",
     "attribute": null,
     "type": "SessionListActionItem[]",
     "default": "[]",
     "description": "Small buttons in the header",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<SessionListLabels>",
     "default": "{}",
     "description": "Rename any of the words, over the defaults",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The tallest the list grows before it scrolls, a CSS length",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The time now, epoch ms; by default the element's own clock",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for times, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "bare",
     "attribute": "bare",
     "type": "boolean",
     "default": "false",
     "description": "Drops the tray and card",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A session was opened ({ selected, session }: SessionSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-query-change",
     "detail": "",
     "description": "The filter changed ({ query }: SessionQueryChange); cancelable – prevented, the filter keeps its text",
     "cancelable": true
    },
    {
     "name": "tc-pin",
     "detail": "",
     "description": "Pin or Unpin was pressed ({ id, pinned, session }: SessionPin); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-archive",
     "detail": "",
     "description": "Archive was pressed ({ id, session }: SessionArchive); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-create",
     "detail": "",
     "description": "New session was pressed (detail: {})",
     "cancelable": false
    },
    {
     "name": "tc-action",
     "detail": "",
     "description": "A header button was pressed ({ id }: SessionListAction)",
     "cancelable": false
    }
   ],
