{
 "elements": [
  {
   "tag": "tc-fan-out-grid",
   "className": "TcFanOutGrid",
   "description": "A big job fanned out to many workers: one cell per task, live.",
   "properties": [
    {
     "name": "tasks",
     "attribute": null,
     "type": "FanoutTask[]",
     "default": "[]",
     "description": "Every task in the job, one cell each, in order – its label, state, worker, times, cost, result or error",
     "readonly": false
    },
    {
     "name": "job",
     "attribute": "job",
     "type": "string",
     "default": "\"\"",
     "description": "What the whole job does – e.g. \"Enrich 240 leads\"",
     "readonly": false
    },
    {
     "name": "workers",
     "attribute": "workers",
     "type": "number | undefined",
     "default": "undefined",
     "description": "How many workers run at once – used for the time left (defaults to the tasks running now)",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The clock, in epoch ms – without it (and without `elapsed`) the element reads the clock and ticks while tasks run",
     "readonly": false
    },
    {
     "name": "startedAt",
     "attribute": "started-at",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When the job started, in epoch ms – defaults to the earliest task start",
     "readonly": false
    },
    {
     "name": "elapsed",
     "attribute": "elapsed",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The clock as ms from the start of the job; task start/end are then job-relative too. Wins over `now`",
     "readonly": false
    },
    {
     "name": "onRetry",
     "attribute": null,
     "type": "((ids: string[]) => void | Promise<unknown>) | undefined",
     "default": "undefined",
     "description": "\"Retry failed\" sends the failed tasks' ids here – unset, the button doesn't show. A promise holds the button\nwhile it runs; a rejection says so and the button stays to try again",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": null,
     "type": "string | null",
     "default": "null",
     "description": "The id of the task whose window is kept open (null: none). Changed by the user unless a tc-selected-change\nlistener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "filter",
     "attribute": null,
     "type": "FanoutStatus | null",
     "default": "null",
     "description": "The state every other cell steps back from (null: none). Changed by the user unless a tc-filter-change listener\ncalls preventDefault()",
     "readonly": false
    },
    {
     "name": "formatCost",
     "attribute": null,
     "type": "(amount: number) => string",
     "default": "dollars",
     "description": "Formats every cost – defaults to dollars, e.g. \"$0.014\"",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Fan-out\"",
     "description": "The title in the header",
     "readonly": false
    },
    {
     "name": "icon",
     "attribute": null,
     "type": "Element | undefined",
     "default": "undefined",
     "description": "The header's icon (cloned); unset shows the default",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "The task kept open changes ({ selected: string | null }); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-filter-change",
     "detail": "",
     "description": "The state filter changes ({ filter: FanoutStatus | null }); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-select",
     "detail": "",
