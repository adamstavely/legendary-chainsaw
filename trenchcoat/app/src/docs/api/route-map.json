     "name": "defaultSelected",
     "type": "string | null",
     "optional": true,
     "description": "The chosen route at first, when `selected` isn't controlled"
    },
    {
     "name": "onSelectedChange",
     "type": "(selected: string | null, route: RouteItem | null) => void",
     "optional": true,
     "description": "A route was pressed"
    },
    {
     "name": "statuses",
     "type": "RouteStatus[]",
     "optional": true,
     "description": "The statuses shown – controlled when given; empty shows every route"
    },
    {
     "name": "defaultStatuses",
     "type": "RouteStatus[]",
     "optional": true,
     "description": "The statuses shown at first, when `statuses` isn't controlled"
    },
    {
     "name": "onStatusesChange",
     "type": "(statuses: RouteStatus[]) => void",
     "optional": true,
     "description": "A status chip was toggled"
    }
   ],
   "hides": [
    "heading",
    "selected",
    "statuses",
    "children"
   ],
   "events": {
    "tc-selected-change": null,
    "tc-statuses-change": null,
    "tc-open": "onTcOpen"
   }
  }
 ],
