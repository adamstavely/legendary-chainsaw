{
 "elements": [
  {
   "tag": "tc-route-map",
   "className": "TcRouteMap",
   "description": "An app's routes as an indented list, with status, load time and last visit, filterable by status; pressing one opens it.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Routes\"",
     "description": "The heading; empty leaves the header out",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "Small text under the heading – the site or environment",
     "readonly": false
    },
    {
     "name": "routes",
     "attribute": null,
     "type": "RouteItem[]",
     "default": "[]",
     "description": "The routes; children are indented under their parent",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The chosen route's id, or null",
     "readonly": false
    },
    {
     "name": "statuses",
     "attribute": null,
     "type": "RouteStatus[]",
     "default": "[]",
     "description": "The statuses shown; empty shows every route",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The time \"last visited\" counts to, in epoch ms; unset, the element keeps its own clock",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "0",
     "description": "Height in px at which the list scrolls; 0 for no limit",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<RouteMapLabels>",
     "default": "{}",
     "description": "Renames the words it uses",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for numbers and times, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A route was pressed ({ selected, route }: RouteSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-statuses-change",
     "detail": "",
     "description": "A status chip was toggled ({ statuses }: RouteStatusesChange); cancelable – prevented, `statuses` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-open",
     "detail": "",
     "description": "A route was clicked, or Enter or Space pressed on it ({ id, route }: RouteOpen); cancelable – prevented, nothing is announced",
     "cancelable": true
    }
   ],
