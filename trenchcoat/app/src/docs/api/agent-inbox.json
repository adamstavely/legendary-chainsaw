{
 "elements": [
  {
   "tag": "tc-agent-inbox",
   "className": "TcAgentInbox",
   "description": "Background agent tasks as a board (or list): Needs you, Running, Done.",
   "properties": [
    {
     "name": "tasks",
     "attribute": null,
     "type": "AgentTask[]",
     "default": "[]",
     "description": "The tasks – always the source of truth. After Approve, Reject or Retry the card shows the result right away;\nas soon as you pass that task with a new status (or steps, start or elapsed time), your version wins",
     "readonly": false
    },
    {
     "name": "heading",
