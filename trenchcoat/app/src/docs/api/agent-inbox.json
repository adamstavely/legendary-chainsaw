 "functions": [],
 "react": [
  {
   "component": "AgentInbox",
   "exported": true,
   "props": [
    {
     "name": "tasks",
     "type": "AgentTask[]",
     "optional": false,
     "description": "The tasks – always the source of truth; a decision shows at once, and your next version of the task wins"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "Heading on the left of the bar"
    },
    {
     "name": "onOpen",
     "type": "(task: AgentTask) => void",
     "optional": true,
     "description": "Shows an Open button on running and done tasks"
    },
    {
     "name": "view",
     "type": "AgentInboxView",
     "optional": true,
     "description": "The layout. Controlled when defined; otherwise the component keeps it, starting from `defaultView`"
    },
    {
     "name": "defaultView",
     "type": "AgentInboxView",
     "optional": true,
     "description": "The layout at first when `view` isn't controlled"
    },
    {
     "name": "onViewChange",
     "type": "(view: AgentInboxView) => void",
     "optional": true,
     "description": "Called with the layout the user picked, controlled or not"
    },
    {
     "name": "expanded",
     "type": "string | null",
     "optional": true,
     "description": "The id of the unfolded card. Controlled when defined (null = none); otherwise the component keeps it"
    },
    {
     "name": "defaultExpanded",
     "type": "string | null",
     "optional": true,
     "description": "The card unfolded at first when `expanded` isn't controlled"
    },
    {
     "name": "onExpandedChange",
     "type": "(id: string | null) => void",
     "optional": true,
     "description": "Called with the id of the card the user unfolded, or null when they folded it"
    }
   ],
