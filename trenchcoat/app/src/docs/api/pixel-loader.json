{
 "elements": [
  {
   "tag": "tc-pixel-loader",
   "className": "TcPixelLoader",
   "description": "A pixel-grid working indicator: dots lit in a pattern, a shimmering label and the time since the work started; a check or a cross when it ends.",
   "properties": [
    {
     "name": "label",
     "attribute": "label",
     "type": "string",
     "default": "\"Working\"",
     "description": "What the work is, in a few words",
     "readonly": false
    },
    {
     "name": "pattern",
     "attribute": "pattern",
     "type": "PixelLoaderPattern",
     "default": "\"wave\"",
     "description": "How the dots move: a diagonal \"wave\", a lit dot that \"drive\"s a snake path, a seeded \"dots\" twinkle, or an \"orbit\" round the edge",
     "readonly": false
    },
    {
     "name": "state",
     "attribute": "state",
     "type": "PixelLoaderState",
     "default": "\"working\"",
     "description": "\"working\" animates and counts; \"done\" settles into a check and stops the clock; \"error\" into a cross",
     "readonly": false
    },
    {
     "name": "started",
     "attribute": "started",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When the work started, in epoch ms; by default when the loader connected (or went back to working)",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The current time, in epoch ms – given, the loader keeps no clock of its own and shows the time up to it",
     "readonly": false
    },
    {
     "name": "hideTime",
     "attribute": "hide-time",
     "type": "boolean",
     "default": "false",
     "description": "Hides the elapsed time",
     "readonly": false
    },
    {
     "name": "size",
     "attribute": "size",
     "type": "\"sm\" | \"md\"",
     "default": "\"md\"",
     "description": "\"md\" is the default; \"sm\" fits inside a chat bubble or a row",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<PixelLoaderLabels>",
     "default": "{}",
     "description": "Rename the words for how it ended, over the defaults",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
