{
 "elements": [
  {
   "tag": "tc-judge-sampling",
   "className": "TcJudgeSampling",
   "description": "How much of an agent's traffic an LLM judge reads, and what it costs – a sampling rate per segment, rules that\nalways include a chat, the judge model, and live estimates of chats judged, monthly cost and what the sample can\nsee, with a budget cap that warns.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Judge sampling\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "segments",
     "attribute": null,
     "type": "JudgeSegment[]",
     "default": "[]",
     "description": "The traffic segments, each with its chats a day",
     "readonly": false
    },
    {
     "name": "includeRules",
     "attribute": null,
     "type": "JudgeIncludeRule[]",
     "default": "[]",
     "description": "Rules that always include a chat, whatever the rate",
     "readonly": false
    },
    {
     "name": "models",
     "attribute": null,
     "type": "JudgeModel[]",
     "default": "[]",
     "description": "The judge models to choose from, with a price per chat",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": null,
     "type": "JudgeSamplingValue",
     "default": "{ rates: {}, include: {}, model: \"\" }",
     "description": "The settings. Changed by the user unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "currency",
     "attribute": "currency",
     "type": "string",
     "default": "\"USD\"",
     "description": "The currency for prices and the budget, e.g. \"USD\"",
     "readonly": false
    },
    {
     "name": "scoreSd",
     "attribute": "score-sd",
     "type": "number",
     "default": "1",
     "description": "How spread out the judge's scores are (their standard deviation), for what the sample can see",
     "readonly": false
    },
    {
     "name": "detect",
     "attribute": "detect",
     "type": "number",
     "default": "0.2",
     "description": "The drop in the average score worth seeing, e.g. 0.2 on a 1–5 scale",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for numbers, e.g. \"en-GB\"; by default the browser's",
