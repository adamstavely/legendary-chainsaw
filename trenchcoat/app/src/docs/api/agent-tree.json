    {
     "name": "defaultCollapsed",
     "type": "string[]",
     "optional": true,
     "description": "Ids of the branches folded at first when `collapsed` isn't controlled"
    },
    {
     "name": "onCollapsedChange",
     "type": "(collapsed: string[]) => void",
     "optional": true,
     "description": "Called with every folded branch's id after a branch is folded or unfolded"
    },
    {
     "name": "onResolve",
     "type": "(agent: TreeAgent, action: AgentTreeResolution) => void | Promise<unknown>",
     "optional": true,
     "description": "An answer from the \"needs you\" or \"failed\" window: approve or reject a waiting agent, retry or dismiss a failed\none. May return a promise: the answer's buttons wait, and if it rejects the window stays open and says so"
    },
    {
     "name": "onSelect",
     "type": "(agent: TreeAgent) => void",
     "optional": true,
     "description": "A click on a card – e.g. to open its log"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the tree list's name (default \"Agents\")"
    }
   ],
   "hides": [
