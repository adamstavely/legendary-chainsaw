{
 "elements": [
  {
   "tag": "tc-agent-tree",
   "className": "TcAgentTree",
   "description": "Who started whom in a run of agents: cards joined by connectors, with costs, times and folding.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Agents\"",
     "description": "The heading, and the tree list's name",
     "readonly": false
    },
    {
     "name": "root",
     "attribute": null,
     "type": "TreeAgent",
     "default": "{ id: \"\", name: \"\", task: \"\", status: \"queued\" }",
     "description": "The orchestrator, with its sub-agents nested in `children` – the whole run as one tree",
     "readonly": false
    },
    {
     "name": "collapsed",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "Ids of folded branches. Changed by the fold buttons unless tc-collapsed-change is prevented",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The clock for running times, in epoch ms – unset uses an internal clock",
     "readonly": false
    },
    {
     "name": "formatCost",
     "attribute": null,
     "type": "(amount: number) => string",
     "default": "dollars",
     "description": "Formats every cost – defaults to dollars, e.g. \"$0.42\"",
     "readonly": false
    },
    {
     "name": "resolver",
     "attribute": null,
     "type": "((agent: TreeAgent, action: AgentTreeResolution) => void | Promise<unknown>) | undefined",
     "default": "undefined",
     "description": "Called with each answer (as well as tc-resolve). May return a promise: the answer's buttons wait, and if it\nrejects the window stays open and says so",
     "readonly": false
    },
    {
     "name": "selectable",
     "attribute": "selectable",
     "type": "boolean",
     "default": "false",
     "description": "The agents' names are buttons that fire tc-select (the whole card stays clickable for a pointer)",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-collapsed-change",
     "detail": "",
     "description": "A branch was folded or unfolded (detail: { collapsed: string[] }); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-select",
     "detail": "",
     "description": "A card was clicked, or its name pressed (detail: { agent: TreeAgent }); shown as a button with `selectable`",
     "cancelable": false
    },
    {
     "name": "tc-resolve",
     "detail": "",
     "description": "An answer from the \"needs you\" or \"failed\" window (detail: { agent: TreeAgent, action: \"approve\" | \"reject\" | \"retry\" | \"dismiss\" })",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
