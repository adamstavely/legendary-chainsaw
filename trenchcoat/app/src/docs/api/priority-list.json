{
 "elements": [
  {
   "tag": "tc-priority-list",
   "className": "TcPriorityList",
   "description": "Topics or projects by priority – a priority badge, name, owner and team, momentum, coverage, what's open and the\nwork in flight – with health filters and optional groups per priority.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Priorities\"",
     "description": "The heading, and the list's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "items",
     "attribute": null,
     "type": "PriorityItem[]",
     "default": "[]",
     "description": "The topics or projects, in the order to show them (within a group when grouped)",
     "readonly": false
    },
    {
     "name": "grouped",
     "attribute": "grouped",
     "type": "boolean",
     "default": "false",
     "description": "Puts the rows under a header per priority",
     "readonly": false
    },
    {
     "name": "filter",
     "attribute": "filter",
     "type": "PriorityFilter",
     "default": "\"all\"",
     "description": "The health shown. Changed by the user unless a tc-filter-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "noFilters",
     "attribute": "no-filters",
     "type": "boolean",
     "default": "false",
     "description": "Shows the health filter chips with their counts",
     "readonly": false
    },
    {
     "name": "tiers",
     "attribute": null,
     "type": "Record<number, string>",
     "default": "{}",
     "description": "The tiers' names by number, merged over the defaults (Top priority, High, Medium, Watching)",
     "readonly": false
    },
    {
     "name": "healthLabels",
     "attribute": null,
     "type": "Partial<Record<PriorityHealth, string>>",
     "default": "{}",
     "description": "The healths' names, merged over the defaults (At risk, Watch, On track)",
     "readonly": false
    },
    {
     "name": "nameLabel",
     "attribute": "name-label",
     "type": "string",
     "default": "\"Topic\"",
     "description": "The first column's heading",
     "readonly": false
    },
    {
     "name": "openUnit",
     "attribute": "open-unit",
     "type": "string",
     "default": "\"gaps\"",
     "description": "What's open, after its count: \"5 gaps\"",
     "readonly": false
    },
    {
     "name": "openUnitOne",
     "attribute": "open-unit-one",
     "type": "string | undefined",
     "default": "undefined",
     "description": "What's open when there's one: \"1 gap\"; `open-unit` when unset",
     "readonly": false
    },
    {
     "name": "workUnit",
     "attribute": "work-unit",
     "type": "string",
     "default": "\"wk\"",
     "description": "The short unit after the work count: \"3·wk\"",
     "readonly": false
    },
    {
     "name": "workLabel",
     "attribute": "work-label",
     "type": "string",
     "default": "\"work items\"",
     "description": "The work count in words, for screen readers: \"3 work items\"",
     "readonly": false
    },
    {
     "name": "coverageWarn",
     "attribute": "coverage-warn",
     "type": "number",
     "default": "0.45",
     "description": "Coverage under this share, from 0 to 1, is drawn in the danger colour",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for numbers, e.g. \"de\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "empty",
     "attribute": "empty",
     "type": "string",
     "default": "\"Nothing to show.\"",
     "description": "Shown when nothing matches",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-open",
     "detail": "",
     "description": "A row was opened with Enter or a click ({ id, item }: PriorityOpen)",
     "cancelable": false
    },
