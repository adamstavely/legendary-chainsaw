{
 "elements": [
  {
   "tag": "tc-rate-limit-status",
   "className": "TcRateLimitStatus",
   "description": "Usage against each provider's rate limits – requests, input and output tokens a minute as meters, the headroom in\nwords with a countdown when limited, 429s in the last hour, the tier and a sparkline, tightest first.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Rate limits\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "A line under the heading, e.g. the window the numbers cover",
     "readonly": false
    },
    {
     "name": "rows",
     "attribute": null,
     "type": "RateLimitRow[]",
     "default": "[]",
     "description": "One row per provider and model",
     "readonly": false
    },
    {
     "name": "sort",
     "attribute": "sort",
     "type": "RateLimitSort",
     "default": "\"tightest\"",
     "description": "The order: the tightest headroom first, or by provider and model. Changed by the user unless a tc-sort-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "hideSort",
     "attribute": "hide-sort",
     "type": "boolean",
     "default": "false",
     "description": "Hides the sort select",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The time now, epoch ms, for the reset countdown; leave it unset and the element keeps its own clock",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for numbers, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "RateLimitStatusLabelsInput",
     "default": "{}",
     "description": "The element's words, merged over defaultRateLimitStatusLabels",
     "readonly": false
    },
    {
     "name": "ordered",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "The rows in their order: tightest share first, or provider then model",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-sort-change",
     "detail": "",
     "description": "The sort was changed ({ sort }: RateLimitSortChange); cancelable – prevented, `sort` stays as it was",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
