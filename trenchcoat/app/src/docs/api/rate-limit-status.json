   "name": "rateLimitHeadroom",
   "signature": "rateLimitHeadroom(row: RateLimitRow): RateLimitHeadroom",
   "description": "Plenty under 70% of the limit, Near limit under 100%, Limited at or over it"
  },
  {
   "name": "rateLimitCountdown",
   "signature": "rateLimitCountdown(ms: number): void",
   "description": "\"18 s\", \"2 min 5 s\" – the time until a reset"
