    {
     "name": "hotkey",
     "attribute": null,
     "type": "string | false | null",
     "default": "\"F8\"",
     "description": "Key that moves focus to the newest toast (KeyboardEvent.key or .code) – false (or null) turns it off",
     "readonly": false
    },
    {
     "name": "hairline",
     "attribute": "hairline",
     "type": "boolean",
     "default": "true",
