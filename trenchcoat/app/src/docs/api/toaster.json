    {
     "name": "actionDuration",
     "attribute": "actionDuration",
     "type": "",
     "default": "Infinity",
     "description": "Default time on screen for toasts with an action. Infinity (the default) keeps them until they're dismissed (WCAG 2.2.1)",
     "readonly": false
    },
    {
     "name": "visibleToasts",
     "attribute": "visibleToasts",
     "type": "number",
     "default": "3",
     "description": "How many toasts are visible at once; older ones wait behind",
     "readonly": false
    },
    {
     "name": "expand",
     "attribute": "expand",
     "type": "boolean",
     "default": "false",
     "description": "Always show the stack fanned out",
     "readonly": false
    },
    {
     "name": "offset",
     "attribute": "offset",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Distance from the edges in px",
     "readonly": false
    },
