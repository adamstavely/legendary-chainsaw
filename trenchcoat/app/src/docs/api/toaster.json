 "functions": [
  {
   "name": "resetToasts",
   "signature": "resetToasts(): void",
   "description": "Empties the store at once – no exit animation, no onDismiss – and cancels pending exits. Meant for tests\n(e.g. in afterEach), since the store lives at module level and would otherwise carry toasts between them"
  },
  {
   "name": "toast",
   "signature": "toast: object",
   "description": "toast(\"Saved\"), toast.success(…), toast.error(…), toast.info(…), toast.loading(…), toast.promise(…), toast.dismiss(id?)"
  }
 ],
