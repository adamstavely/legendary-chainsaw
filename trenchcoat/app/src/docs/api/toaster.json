{
 "elements": [
  {
   "tag": "tc-toaster",
   "className": "TcToaster",
   "description": "A stack of toasts in a corner of the page (or of a positioned parent, with `inline`). Show toasts with `toast()`.",
   "properties": [
    {
     "name": "position",
     "attribute": "position",
     "type": "ToastPosition",
     "default": "\"bottom-right\"",
     "description": "Corner (or edge center) the stack sits in",
     "readonly": false
    },
    {
     "name": "inline",
     "attribute": "inline",
     "type": "boolean",
     "default": "false",
     "description": "Positions the stack inside the nearest positioned ancestor instead of the viewport – for previews and panels",
     "readonly": false
    },
    {
     "name": "stack",
     "attribute": "stack",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Only shows toasts sent with { toaster: name } – for a second, separate stack",
     "readonly": false
    },
    {
     "name": "duration",
     "attribute": "duration",
     "type": "number",
     "default": "4000",
     "description": "Default time on screen in ms",
     "readonly": false
