{
 "elements": [
  {
   "tag": "tc-api-keys",
   "className": "TcApiKeys",
   "description": "A workspace's API keys: masked values, permissions, last use and status in words, with Create key (the secret shown\nonce) and Revoke.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The heading; by default \"API keys\"",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "A line under the heading, such as what the keys reach",
     "readonly": false
    },
    {
     "name": "keys",
     "attribute": null,
     "type": "ApiKey[]",
     "default": "[]",
     "description": "The keys. A revoke changes it unless a tc-key-revoke listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "scopes",
     "attribute": null,
     "type": "ApiKeyScope[]",
     "default": "[]",
     "description": "The permissions a key can have, offered as checkboxes when creating one",
     "readonly": false
    },
    {
     "name": "expiryOptions",
     "attribute": null,
     "type": "ApiKeyExpiryOption[]",
     "default": "[ { days: 30, label: \"30 days\" }, { days: 90, label: \"90 days\" }, { days: 365, label: \"1 year\" }, { days: null, label: \"Never\" }, ]",
     "description": "How long a new key can last; by default 30 days, 90 days, 1 year and Never",
     "readonly": false
    },
    {
     "name": "defaultExpiry",
     "attribute": null,
     "type": "number | null",
     "default": "90",
     "description": "The expiry picked when the form opens, in days or null; by default 90",
     "readonly": false
    },
    {
     "name": "revealed",
     "attribute": null,
     "type": "ApiKeyReveal | null",
     "default": "null",
     "description": "A new key's secret to show once, set by the page after tc-key-create; cleared by Done unless a tc-reveal-dismiss listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "warnDays",
     "attribute": "warn-days",
     "type": "number",
     "default": "14",
     "description": "How many days before expiry a key says \"Expires in n days\" in warning colours",
     "readonly": false
    },
    {
     "name": "readOnly",
     "attribute": "read-only",
     "type": "boolean",
     "default": "false",
     "description": "Hides Create key, for people who may only look",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "\"Now\" in epoch ms; unset, the clock's",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The locale for dates and relative times",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<ApiKeysLabels>",
     "default": "{}",
     "description": "Rename any of the words",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-key-create",
     "detail": "",
     "description": "Create key was submitted ({ name, scopes, expiresIn }: ApiKeyCreate); cancelable – prevented, the form stays open. The page makes the key and sets `revealed`",
     "cancelable": true
    },
    {
     "name": "tc-key-revoke",
     "detail": "",
     "description": "Revoke was confirmed ({ id, keys }: ApiKeyRevoke) with the keys as they'd be; cancelable – prevented, `keys` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-reveal-dismiss",
     "detail": "",
     "description": "Done was pressed on the new key's secret ({ id }: ApiKeyRevealDismiss); cancelable – prevented, the secret stays showing",
     "cancelable": true
    },
    {
     "name": "tc-copy",
     "detail": "",
     "description": "Copy was pressed on the new key's secret ({ id }: ApiKeyCopy); cancelable – prevented, nothing is written to the clipboard",
     "cancelable": true
    }
