{
 "elements": [
  {
   "tag": "tc-heatmap",
   "className": "TcHeatmap",
   "description": "A matrix of rows by columns shaded by value – sequential or diverging, binned or continuous – with a legend, the\nhighest and lowest cells, a tooltip per cell, selection and a table view.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Heatmap\"",
     "description": "The heading, and the grid's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "rows",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The rows' labels, top to bottom",
     "readonly": false
    },
    {
     "name": "columns",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The columns' labels, left to right",
     "readonly": false
    },
    {
     "name": "values",
     "attribute": null,
     "type": "(number | null)[][]",
     "default": "[]",
     "description": "The values, a row at a time: values[row][column]; null (or missing) is no data",
     "readonly": false
    },
    {
     "name": "scale",
     "attribute": "scale",
     "type": "HeatmapScale",
     "default": "\"sequential\"",
     "description": "Light to dark (\"sequential\"), or two colours either side of `midpoint` (\"diverging\")",
     "readonly": false
    },
    {
     "name": "midpoint",
     "attribute": "midpoint",
     "type": "number",
     "default": "0",
     "description": "The value between the two colours of a diverging scale",
     "readonly": false
    },
    {
     "name": "steps",
     "attribute": "steps",
     "type": "number",
     "default": "5",
     "description": "How many shades the legend bins the values into; 0 shades continuously",
     "readonly": false
    },
    {
     "name": "min",
     "attribute": "min",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The bottom of the scale; by default the lowest value",
     "readonly": false
    },
    {
     "name": "max",
     "attribute": "max",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The top of the scale; by default the highest value",
     "readonly": false
    },
    {
     "name": "unit",
     "attribute": "unit",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The unit after the number: \"%\", \"runs\"",
     "readonly": false
    },
    {
     "name": "format",
     "attribute": null,
     "type": "((value: number) => string) | undefined",
     "default": "undefined",
     "description": "Writes a value, e.g. (v) => `${v} runs`; replaces the number and `unit`",
     "readonly": false
    },
    {
     "name": "showValues",
     "attribute": "show-values",
     "type": "boolean",
     "default": "false",
     "description": "Writes each value in its cell",
     "readonly": false
    },
    {
     "name": "crosshair",
     "attribute": "crosshair",
     "type": "boolean",
     "default": "false",
     "description": "Lights up the row and column of the cell under the pointer or focus",
     "readonly": false
    },
    {
     "name": "rowHeader",
     "attribute": "row-header",
     "type": "string",
     "default": "\"Row\"",
     "description": "What the rows are, for the table's corner: \"Day\"",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": null,
     "type": "HeatmapCell | null",
     "default": "null",
     "description": "The selected cell. Changed by the user unless a tc-selected-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "view",
     "attribute": "view",
     "type": "HeatmapView",
     "default": "\"chart\"",
     "description": "The chart or the same numbers as a table. Changed by the Table button unless a tc-view-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for numbers, e.g. \"de\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
