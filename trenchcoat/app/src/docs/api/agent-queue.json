{
 "elements": [
  {
   "tag": "tc-agent-queue",
   "className": "TcAgentQueue",
   "description": "The work waiting for your agents, and how fast it moves: the queue, the workers, Done and Failed, and a depth chart.",
   "properties": [
    {
     "name": "jobs",
     "attribute": null,
     "type": "QueueJob[]",
     "default": "[]",
     "description": "Waiting and running jobs, plus finished ones for as long as the chart should count them",
     "readonly": false
    },
    {
     "name": "workers",
     "attribute": null,
     "type": "QueueWorker[]",
     "default": "[]",
     "description": "The worker slots – their number is the concurrency",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The clock in epoch ms – unset, the element keeps its own while there is work",
     "readonly": false
    },
    {
     "name": "rateLimits",
     "attribute": null,
     "type": "QueueRateLimit[]",
     "default": "[]",
     "description": "Stretches when the provider rate-limits – while one is active the workers show as paused",
     "readonly": false
    },
    {
     "name": "paused",
     "attribute": "paused",
     "type": "boolean",
     "default": "false",
     "description": "The queue is paused – no new jobs start",
     "readonly": false
    },
    {
     "name": "pausable",
     "attribute": "pausable",
     "type": "boolean",
     "default": "false",
     "description": "Shows a Pause/Resume button",
     "readonly": false
    },
    {
     "name": "stepper",
     "attribute": "stepper",
     "type": "boolean",
     "default": "false",
     "description": "Shows a – N + stepper for the number of workers",
     "readonly": false
    },
    {
     "name": "minConcurrency",
     "attribute": "min-concurrency",
     "type": "number",
     "default": "1",
     "description": "The fewest workers the stepper allows – its – button is disabled at this number",
     "readonly": false
    },
    {
     "name": "maxConcurrency",
     "attribute": "max-concurrency",
     "type": "number",
     "default": "8",
     "description": "The most workers the stepper allows – its + button is disabled at this number",
     "readonly": false
    },
    {
     "name": "backpressure",
     "attribute": "backpressure",
     "type": "number | undefined",
     "default": "undefined",
     "description": "A depth that means trouble – drawn as a dashed line on the chart; above it Waiting turns amber",
     "readonly": false
    },
    {
     "name": "range",
     "attribute": "range",
     "type": "",
     "default": null,
     "description": "How far back the chart looks, in ms",
     "readonly": false
    },
    {
     "name": "totals",
     "attribute": null,
     "type": "{ done?: number; failed?: number } | undefined",
     "default": "undefined",
     "description": "Counts since the start, when `jobs` only holds the recent ones",
     "readonly": false
    },
    {
     "name": "openId",
     "attribute": null,
     "type": "string | null",
     "default": "null",
     "description": "The id of the job whose card is pinned, or null",
     "readonly": false
    },
    {
     "name": "promotable",
     "attribute": "promotable",
     "type": "boolean",
     "default": "false",
     "description": "Shows \"Move to front\" in a waiting job's card",
     "readonly": false
    },
    {
     "name": "cancellable",
     "attribute": "cancellable",
     "type": "boolean",
     "default": "false",
     "description": "Shows \"Cancel\" in a waiting or running job's card",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Queue\"",
     "description": "The heading at the top of the card",
     "readonly": false
    },
    {
     "name": "name",
     "attribute": "name",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The queue's name, muted next to the heading",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-paused-change",
     "detail": "",
     "description": "Pause or Resume was pressed ({ paused: boolean }); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-concurrency-change",
     "detail": "",
     "description": "The worker stepper asked for more or fewer workers ({ workers: number })",
     "cancelable": false
    },
    {
     "name": "tc-open-change",
     "detail": "",
     "description": "A job's card was pinned or closed ({ id: string | null, job?: QueueJob }); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-promote",
     "detail": "",
     "description": "Move to front was pressed in a waiting job's card ({ job: QueueJob })",
     "cancelable": false
    },
    {
     "name": "tc-cancel",
     "detail": "",
     "description": "Cancel was pressed in a job's card ({ job: QueueJob })",
     "cancelable": false
    }
   ],
