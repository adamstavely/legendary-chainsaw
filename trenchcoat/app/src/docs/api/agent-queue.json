 "functions": [],
 "react": [
  {
   "component": "AgentQueue",
   "exported": true,
   "props": [
    {
     "name": "jobs",
     "type": "QueueJob[]",
     "optional": false,
     "description": "Waiting and running jobs, plus finished ones for as long as the chart should count them"
    },
    {
     "name": "workers",
     "type": "QueueWorker[]",
     "optional": false,
     "description": "The worker slots – their number is the concurrency"
    },
    {
     "name": "paused",
     "type": "boolean",
     "optional": true,
     "description": "The queue is paused – no new jobs start. Controlled when defined; otherwise the component keeps it, starting\nfrom `defaultPaused`"
    },
    {
     "name": "defaultPaused",
     "type": "boolean",
     "optional": true,
     "description": "Whether the queue starts paused when `paused` isn't controlled"
    },
    {
     "name": "onPausedChange",
     "type": "(paused: boolean) => void",
     "optional": true,
     "description": "Shows a Pause/Resume button, and hears every change"
    },
    {
     "name": "onConcurrencyChange",
     "type": "(workers: number) => void",
     "optional": true,
     "description": "Shows a – N + stepper for the number of workers"
    },
    {
     "name": "window",
     "type": "number",
     "optional": true,
     "description": "How far back the chart looks, in ms (default 2 minutes)"
    },
    {
     "name": "openId",
     "type": "string | null",
     "optional": true,
     "description": "The id of the job whose card is pinned. Controlled when defined (null = none); otherwise the component keeps it,\nstarting from `defaultOpenId`"
    },
    {
     "name": "defaultOpenId",
     "type": "string | null",
     "optional": true,
     "description": "The job whose card starts pinned when `openId` isn't controlled"
    },
    {
     "name": "onOpenChange",
     "type": "(id: string | null, job?: QueueJob) => void",
     "optional": true,
     "description": "Called when a job's card is pinned or closed, with its id (null when closed) and the job"
    },
    {
     "name": "onPromote",
     "type": "(job: QueueJob) => void",
     "optional": true,
     "description": "Shows \"Move to front\" in a waiting job's card"
    },
    {
     "name": "onCancel",
     "type": "(job: QueueJob) => void",
     "optional": true,
     "description": "Shows \"Cancel\" in a waiting or running job's card"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading at the top of the card (the element's `heading`)"
    }
   ],
   "hides": [
    "jobs",
    "workers",
    "paused",
    "pausable",
    "stepper",
    "openId",
    "promotable",
    "cancellable",
    "heading",
    "range"
   ],
   "events": {
    "tc-paused-change": null,
    "tc-concurrency-change": "onConcurrencyChange",
    "tc-open-change": "onOpenChange",
    "tc-promote": "onPromote",
    "tc-cancel": "onCancel"
   }
  }
 ],
