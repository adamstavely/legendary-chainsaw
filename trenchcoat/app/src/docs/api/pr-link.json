     "readonly": false
    },
    {
     "name": "compact",
     "attribute": "compact",
     "type": "boolean",
     "default": "false",
     "description": "Just the mark and #number, without the repository and title",
     "readonly": false
    },
    {
     "name": "newTab",
     "attribute": "new-tab",
     "type": "boolean",
     "default": "false",
     "description": "Open the link in a new tab",
     "readonly": false
    },
    {
     "name": "hoverDelay",
     "attribute": "hover-delay",
