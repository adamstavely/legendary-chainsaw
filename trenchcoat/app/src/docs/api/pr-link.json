     "default": "{}",
     "description": "The words it uses, to translate or reword",
     "readonly": false
    },
    {
     "name": "trigger",
     "attribute": null,
     "type": "HTMLElement | null",
     "default": null,
     "description": "The link (or the text, without `href`) the card belongs to",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
