{
 "elements": [
  {
   "tag": "tc-saved-views",
   "className": "TcSavedViews",
   "description": "Saved views as tabs above a list or table – counts, shared and default marks, rename, duplicate, share, set as default and delete, and Save changes when the view on screen has been edited.",
   "properties": [
    {
     "name": "views",
     "attribute": null,
     "type": "SavedView[]",
     "default": "[]",
     "description": "The saved views, in the order shown",
     "readonly": false
    },
    {
     "name": "active",
     "attribute": "active",
     "type": "string | null",
     "default": "null",
     "description": "The open view's id. Changed by the user unless a tc-active-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "dirty",
     "attribute": "dirty",
     "type": "boolean",
     "default": "false",
     "description": "The filters on screen differ from the open view – shows Edited and the Save changes bar",
     "readonly": false
    },
    {
     "name": "controls",
     "attribute": "controls",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The id of the list or table the views filter, for aria-controls",
     "readonly": false
    },
    {
     "name": "hideCreate",
     "attribute": "hide-create",
     "type": "boolean",
     "default": "false",
     "description": "Hides \"+ New view\"",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<SavedViewsLabels>",
     "default": "{}",
     "description": "Rename any of the words, over the defaults",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-active-change",
     "detail": "",
     "description": "A view was opened ({ active, view }: SavedViewsActiveChange); cancelable – prevented, `active` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-view-save",
     "detail": "",
     "description": "Save changes was pressed for the open view ({ id }: SavedViewId); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-view-create",
     "detail": "",
     "description": "A name was given for a new view, from the filters on screen or blank ({ name, basis }: SavedViewCreate); cancelable – prevented, the name field stays",
     "cancelable": true
    },
    {
     "name": "tc-view-reset",
     "detail": "",
     "description": "Reset was pressed: go back to the open view as saved ({ id }: SavedViewId); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-view-rename",
     "detail": "",
     "description": "A view was renamed in place ({ id, name }: SavedViewRename); cancelable – prevented, the name field stays",
     "cancelable": true
    },
    {
     "name": "tc-view-duplicate",
     "detail": "",
     "description": "Duplicate was picked ({ id }: SavedViewId); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-view-share",
     "detail": "",
     "description": "Share with team or Stop sharing was picked ({ id, shared }: SavedViewShare); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-view-default",
     "detail": "",
     "description": "Set as default was picked ({ id }: SavedViewId); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-view-delete",
     "detail": "",
     "description": "Delete was confirmed ({ id }: SavedViewId); cancelable",
     "cancelable": true
    }
   ],
