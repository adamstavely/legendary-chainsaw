{
 "elements": [
  {
   "tag": "tc-role-editor",
   "className": "TcRoleEditor",
   "description": "What each role can do – a grid of permissions against roles, with dependent permissions kept in step, a locked\nOwner, custom roles to add, rename and delete, member counts and a summary of unsaved changes.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Roles\"",
     "description": "The heading, and the grid's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "groups",
     "attribute": null,
     "type": "RolePermissionGroup[]",
     "default": "[ { id: \"agents\", label: \"Agents\", permissions: [ { id: \"agents.view\", label: \"View agents\" }, { id: \"agents.edit\", label: \"Edit agents\", description: \"Instructions, tools and triggers\", requires: [\"agents.view\"] }, { id: \"agents.deploy\", label: \"Deploy agents\", description: \"Put a draft live\", requires: [\"agents.edit\"] }, ], }, { id: \"data\", label: \"Data\", permissions: [ { id: \"data.view\", label: \"View data\", description: \"Conversations, runs and sources\" }, { id: \"data.export\", label: \"Export data\", requires: [\"data.view\"] }, ], }, { id: \"billing\", label: \"Billing\", permissions: [ { id: \"billing.view\", label: \"View billing\" }, { id: \"billing.manage\", label: \"Manage billing\", description: \"Plan, payment and limits\", requires: [\"billing.view\"] }, ], }, { id: \"admin\", label: \"Admin\", permissions: [ { id: \"admin.members\", label: \"Manage members\" }, { id: \"admin.roles\", label: \"Manage roles\" }, { id: \"admin.audit\", label: \"View the audit log\" }, ], }, ]",
     "description": "The rows: permissions, grouped",
     "readonly": false
    },
    {
     "name": "roles",
     "attribute": null,
     "type": "Role[]",
     "default": "[]",
     "description": "The columns. Changed by the user unless a tc-roles-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "saved",
     "attribute": null,
     "type": "Role[] | undefined",
     "default": "undefined",
     "description": "What was last saved – the summary lists the differences. Unset: the roles the element first showed",
     "readonly": false
    },
    {
     "name": "newRoleName",
     "attribute": "new-role-name",
     "type": "string",
     "default": "\"New role\"",
     "description": "The name a new role starts with",
     "readonly": false
    },
    {
     "name": "changesLimit",
     "attribute": "changes-limit",
     "type": "number",
     "default": "5",
     "description": "Changes listed before \"N more\"",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-roles-change",
     "detail": "",
     "description": "A cell, New role, a rename, a delete or Discard changed the roles ({ roles, change }: RolesChange); cancelable – prevented, `roles` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-roles-save",
     "detail": "",
     "description": "Save was pressed ({ roles, changes }: RolesSave); cancelable – unless prevented, `saved` becomes the roles",
     "cancelable": true
    }
   ],
