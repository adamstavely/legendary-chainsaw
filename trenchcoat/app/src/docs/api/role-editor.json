     "type": "Role[]",
     "optional": true,
     "description": "The roles on mount, when `roles` isn't controlled"
    },
    {
     "name": "onRolesChange",
     "type": "(roles: Role[], change: RoleEditCause) => void",
     "optional": true,
     "description": "Called with the next roles and what changed"
    },
    {
     "name": "saved",
     "type": "Role[]",
     "optional": true,
     "description": "What was last saved – controlled when given; otherwise the first roles, then whatever Save stores"
    },
    {
     "name": "onRolesSave",
     "type": "(roles: Role[], changes: RoleDiff[]) => void | boolean",
     "optional": true,
     "description": "Save was pressed – store the roles; return false to keep the changes listed (a failed save)"
    }
   ],
   "hides": [
    "heading",
    "roles",
    "saved",
    "children"
   ],
   "events": {
    "tc-roles-change": "onRolesChange",
    "tc-roles-save": "onRolesSave"
   }
  }
 ],
