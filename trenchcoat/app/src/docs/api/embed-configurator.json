{
 "elements": [
  {
   "tag": "tc-embed-configurator",
   "className": "TcEmbedConfigurator",
   "description": "Style a site's chat widget beside a live preview, and copy its install snippet.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Site widget\"",
     "description": "The heading",
