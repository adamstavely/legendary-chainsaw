     "type": "string | undefined",
     "default": "undefined",
     "description": "A line under the heading",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": null,
     "type": "EmbedConfig",
     "default": "{ title: \"Assistant\", greeting: \"Hi! How can I help?\", starters: [], accent: \"#2563eb\", position: \"right\", radius: 16, launcherLabel: \"Chat with us\", domains: [], }",
     "description": "The settings",
     "readonly": false
    },
    {
     "name": "scriptSrc",
     "attribute": "script-src",
     "type": "string",
     "default": "\"https://cdn.example.org/assistant/embed.js\"",
