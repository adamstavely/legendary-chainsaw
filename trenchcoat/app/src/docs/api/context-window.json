 "functions": [],
 "react": [
  {
   "component": "ContextWindow",
   "exported": true,
   "props": [
    {
     "name": "parts",
     "type": "ContextPart[]",
     "optional": false,
     "description": "What fills the window, in order – each part takes the next run of cells"
    },
    {
     "name": "limit",
     "type": "number",
     "optional": false,
     "description": "Size of the context window in tokens"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the group's name"
    },
    {
     "name": "modelIcon",
     "type": "React.ReactNode",
     "optional": true,
     "description": "Logo in front of the model name – any node, sized to 12px"
    },
    {
     "name": "onRemoveItem",
     "type": "(partId: string, itemId: string) => void",
     "optional": true,
     "description": "Called when an item is removed. The card hides the item at once and keeps it hidden until `parts` brings a\ndifferent list of items for that part – so `parts` stays the source of truth, whether you handle the removal or\nonly listen to it"
    },
    {
     "name": "action",
     "type": "{ label: string; onClick: () => void }",
     "optional": true,
     "description": "A button on the tray (Clean: in the card's last row), e.g. { label: \"New chat\", onClick }"
    }
   ],
   "hides": [
    "heading",
    "modelIcon",
    "actionLabel",
    "limit",
    "parts"
   ],
   "events": {
    "tc-remove-item": "onRemoveItem",
    "tc-action": "onClick"
   }
  }
 ],
 "changelog": [
  "context-window: Clean's \"Compacting…\" shine runs 3 times and rests, like every other shimmer (it ran endlessly)."
