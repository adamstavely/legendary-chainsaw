{
 "elements": [
  {
   "tag": "tc-context-window",
   "className": "TcContextWindow",
   "description": "What fills a model's context window, as a field of cells per part, with removal and compaction.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Context window\"",
     "description": "The heading, and the group's name",
     "readonly": false
    },
    {
     "name": "parts",
     "attribute": null,
     "type": "ContextPart[]",
     "default": "[]",
     "description": "What fills the window, in order – each part takes the next run of cells",
     "readonly": false
    },
    {
     "name": "limit",
     "attribute": "limit",
     "type": "number",
     "default": "0",
     "description": "Size of the context window in tokens",
     "readonly": false
    },
    {
     "name": "model",
     "attribute": "model",
     "type": "string",
     "default": "\"\"",
     "description": "Small tag in the head, e.g. the model name",
     "readonly": false
    },
    {
     "name": "modelIcon",
     "attribute": null,
     "type": "Element | undefined",
     "default": "undefined",
     "description": "Logo in front of the model name, an element that's cloned, sized to 12px",
     "readonly": false
    },
    {
     "name": "actionLabel",
     "attribute": "action-label",
     "type": "string",
     "default": "\"\"",
     "description": "Label of a button on the tray (Clean: in the card's last row), e.g. \"New chat\" – it fires tc-action",
     "readonly": false
    },
    {
     "name": "warnAt",
     "attribute": "warn-at",
     "type": "number",
     "default": "0.8",
     "description": "Share of the limit from which the card warns (0–1)",
     "readonly": false
    },
    {
     "name": "cells",
     "attribute": "cells",
     "type": "number",
     "default": "216",
     "description": "Number of cells and how many sit in one row",
     "readonly": false
    },
    {
     "name": "columns",
     "attribute": "columns",
     "type": "number",
     "default": "36",
     "description": "How many cells sit in one row (two thirds of it, at least 8, in a narrow container)",
     "readonly": false
    },
    {
     "name": "onCompact",
     "attribute": null,
     "type": "ContextCompactAction | undefined",
     "default": "undefined",
     "description": "Called when Compact is pressed; the cells shimmer until the returned promise settles, and a rejection says so and\nleaves Compact to press again. The signal aborts when the element is removed. Once it settles the part shows its\n`compact` share at once, until `parts` brings a new size for it",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-remove-item",
     "detail": "",
     "description": "An item was removed (`{ partId: string; itemId: string }`); it stays hidden until `parts` brings a different list of items for that part",
     "cancelable": false
    },
    {
     "name": "tc-compact",
     "detail": "",
     "description": "Compact was pressed (`{ partId: string }`); `onCompact` may return a promise the cells wait for",
     "cancelable": false
    },
    {
     "name": "tc-action",
     "detail": "",
     "description": "The tray's action button was pressed (`{ label: string }`)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
