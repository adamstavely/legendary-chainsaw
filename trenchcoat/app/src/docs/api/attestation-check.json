{
 "elements": [
  {
   "tag": "tc-attestation-check",
   "className": "TcAttestationCheck",
   "description": "Verify a signed evidence package by its hash or file – signature, chain integrity and what it covers, checked\nlocally.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Verify an evidence package\"",
     "description": "The heading, and the component's name",
     "readonly": false
    },
    {
     "name": "verify",
     "attribute": null,
     "type": "AttestationVerify | undefined",
     "default": "undefined",
     "description": "Checks a pasted hash (a string) or a dropped file (a File) in the page and returns the result, or a promise of\nit. Throw to say it couldn't check. The element never sends the file anywhere",
     "readonly": false
    },
    {
     "name": "result",
     "attribute": null,
     "type": "AttestationResult | null",
     "default": "null",
     "description": "The result on show (null = none). Set by a finished check unless a tc-result-change listener calls\npreventDefault()",
     "readonly": false
    },
    {
     "name": "hashPattern",
     "attribute": null,
     "type": "RegExp",
     "default": "/^(?:sha(?:256|384|512):)?[0-9a-f]{40,128}$/i",
     "description": "What a pasted hash must look like before it's checked – hex, 40 to 128 characters, optionally \"sha256:\" first",
     "readonly": false
    },
    {
     "name": "accept",
     "attribute": null,
     "type": "string[] | undefined",
     "default": "undefined",
     "description": "File types the file picker offers – e.g. [\".json\", \".zip\"]; unset offers any file",
     "readonly": false
    },
    {
     "name": "hint",
     "attribute": "hint",
     "type": "string",
     "default": "\"Checked in this browser – the file isn't uploaded\"",
     "description": "The line under the drop area – where the check happens",
     "readonly": false
    },
    {
     "name": "placeholder",
     "attribute": "placeholder",
     "type": "string",
     "default": "\"sha256:9f2c41ab07e3…\"",
     "description": "Placeholder of the hash field",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-verify",
     "detail": "",
     "description": "A check started ({ input }: AttestationVerifyStart – the pasted hash or the File)",
     "cancelable": false
    },
    {
     "name": "tc-result-change",
     "detail": "",
     "description": "A check finished, or \"Check another\" cleared the result ({ result, input }: AttestationResultChange); cancelable – prevent it to keep `result` as it is (controlled use)",
