     "optional": true,
     "description": "The result on show when uncontrolled"
    },
    {
     "name": "onResultChange",
     "type": "(result: AttestationResult | null, input?: AttestationInput) => void",
     "optional": true,
     "description": "Called when a check finishes (with its result and what was checked), or with null when \"Check another\" clears it"
    },
    {
     "name": "onVerifyStart",
     "type": "(input: AttestationInput) => void",
     "optional": true,
     "description": "Called when a check starts, with the pasted hash or the File"
    }
   ],
   "hides": [
    "heading",
    "result"
   ],
   "events": {
    "tc-verify": "onVerifyStart",
    "tc-result-change": null
   }
  }
 ],
 "changelog": [
  "**Trust & calibration**, from THEMIS and built domain-neutral: - claims and their reliability: `tc-claim-answer`, `tc-verification-queue`, `tc-reflection-gate`, `tc-reliance-gauge`, `tc-disagreement-banner`, `tc-synthesis-notes`; - where outputs came from: `tc-lineage-graph`, `tc-validity-badge`, `tc-provenance-summary`, `tc-correction-propagation`, `tc-attestation-check`, `tc-run-manifest`; - policy and control: `tc-policy-simulator`, `tc-gate-config`, `tc-coverage-matrix`, `tc-kill-switch`, `tc-playbook-canvas`."
 ],
