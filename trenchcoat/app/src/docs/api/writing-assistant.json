 "functions": [],
 "react": [
  {
   "component": "WritingAssistant",
   "exported": true,
   "props": [
    {
     "name": "messages",
     "type": "ChatMessage[]",
     "optional": true,
     "description": "The conversation (controlled) – read it, seed it or restore it; new messages are asked for through `onMessagesChange`"
    },
    {
     "name": "defaultMessages",
     "type": "ChatMessage[]",
     "optional": true,
     "description": "Starting conversation when `messages` isn't controlled"
    },
    {
     "name": "onMessagesChange",
     "type": "(messages: ChatMessage[]) => void",
     "optional": true,
     "description": "Called with the whole conversation whenever a message is added or the chat is reset"
    },
    {
     "name": "draft",
     "type": "string",
     "optional": true,
     "description": "Text in the prompt field (controlled)"
    },
    {
     "name": "defaultDraft",
     "type": "string",
     "optional": true,
     "description": "Starting text in the prompt field when `draft` isn't controlled"
    },
    {
     "name": "onDraftChange",
     "type": "(draft: string) => void",
     "optional": true,
     "description": "Called with the field's new text whenever it changes – typing, dictation, or clearing after a send"
    }
   ],
   "hides": [
    "messages",
    "draft"
   ],
   "events": {
    "tc-messages-change": "onMessagesChange",
    "tc-draft-change": "onDraftChange"
   }
  }
 ],
 "changelog": [
  "writing-assistant: dictation fills the field and no longer sends by itself."
 ],
