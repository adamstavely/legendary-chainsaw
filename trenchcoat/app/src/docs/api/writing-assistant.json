{
 "elements": [
  {
   "tag": "tc-writing-assistant",
   "className": "TcWritingAssistant",
   "description": "A compact AI chat card with suggestions, a growing prompt field and dictation.",
   "properties": [
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"Quill\"",
     "description": "The assistant's name, in the header",
     "readonly": false
    },
    {
     "name": "tagline",
     "attribute": "tagline",
     "type": "string",
     "default": "\"Your writing companion.\"",
     "description": "Short line under the name",
     "readonly": false
    },
    {
     "name": "greeting",
     "attribute": "greeting",
     "type": "string",
     "default": "\"What should we write?\"",
     "description": "Big line on the welcome screen",
     "readonly": false
    },
    {
     "name": "suggestions",
     "attribute": null,
     "type": "string[]",
     "default": "[\"Polish my email\", \"Make it shorter\", \"Fix the tone\", \"Draft a reply\"]",
     "description": "Chips on the welcome screen; picking one sends it as a message",
     "readonly": false
    },
    {
     "name": "placeholder",
     "attribute": "placeholder",
     "type": "string",
     "default": "\"Ask anything…\"",
     "description": "Text in the empty prompt field",
     "readonly": false
    },
    {
     "name": "respond",
     "attribute": null,
     "type": "WritingAssistantRespond | undefined",
     "default": "undefined",
     "description": "Your answer for a message – return text or a promise of text. A rejected promise shows an error and lets the\nmessage be sent again. `signal` aborts when the chat is reset or the element is removed. Without it a sample\nwriter answers (and warns once, unless `demo` is set). `history` is the conversation so far, ending with this message",
     "readonly": false
    },
    {
     "name": "messages",
     "attribute": null,
     "type": "ChatMessage[]",
     "default": "[]",
     "description": "The conversation. Changed by the element unless a tc-messages-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "draft",
     "attribute": "draft",
     "type": "string",
     "default": "\"\"",
     "description": "Text in the prompt field. Changed by the element unless a tc-draft-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "speech",
     "attribute": "speech",
     "type": "\"auto\" | \"simulate\"",
     "default": "\"auto\"",
     "description": "\"auto\" uses real speech recognition when the browser has it and shows an error otherwise (or plays the sample\ntake with `demo`); \"simulate\" always plays a sample take",
     "readonly": false
    },
    {
     "name": "demo",
     "attribute": "demo",
     "type": "boolean",
     "default": "false",
     "description": "Demo mode: the sample writer answers without a warning, and dictation plays the sample take where the browser\nhas no speech recognition",
     "readonly": false
    },
    {
     "name": "dictation",
     "attribute": "dictation",
     "type": "string",
     "default": "\"Write a friendly reminder that the report is due on Friday\"",
     "description": "Sample sentence for simulated dictation",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-messages-change",
     "detail": "",
     "description": "A message was added or the chat was reset ({ messages }: ChatMessagesChange, the whole conversation); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-draft-change",
     "detail": "",
     "description": "The text in the prompt field changed ({ draft }: ChatDraftChange); cancelable",
     "cancelable": true
    }
   ],
