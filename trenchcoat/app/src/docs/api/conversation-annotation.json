{
 "elements": [
  {
   "tag": "tc-conversation-annotation",
   "className": "TcConversationAnnotation",
   "description": "A conversation transcript to annotate: label spans, redact, rate turns, correct answers and send the example on.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Conversation review\"",
     "description": "The heading, and the transcript's accessible name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "A quieter line under the heading – where the conversation came from",
     "readonly": false
    },
    {
     "name": "messages",
     "attribute": null,
     "type": "AnnotationMessage[]",
     "default": "[]",
     "description": "The conversation, in order",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "AnnotationLabel[]",
     "default": "[ { id: \"incorrect\", label: \"Incorrect\", tone: \"rose\", description: \"States something that isn't true\" }, { id: \"unsupported\", label: \"Unsupported\", tone: \"amber\", description: \"Not backed by anything it was given\" }, { id: \"sensitive\", label: \"Sensitive\", tone: \"violet\", description: \"Personal or confidential information\" }, { id: \"helpful\", label: \"Helpful\", tone: \"teal\", description: \"A good example of what we want\" }, ]",
     "description": "The label set; the first nine get the shortcut keys 1–9",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": null,
     "type": "ConversationAnnotationValue",
     "default": "{ spans: [], ratings: {}, corrections: {} }",
     "description": "Spans, ratings and corrections. Changed by the user unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "ratingLevels",
     "attribute": null,
     "type": "RubricLevel[]",
     "default": "[ { value: 1, label: \"Poor\" }, { value: 2, label: \"Okay\" }, { value: 3, label: \"Good\" }, ]",
     "description": "The rating scale for a turn, lowest first",
     "readonly": false
    },
    {
     "name": "rateRoles",
     "attribute": null,
     "type": "string[]",
     "default": "[\"assistant\"]",
     "description": "The roles whose turns can be rated",
     "readonly": false
    },
    {
     "name": "correctRoles",
     "attribute": null,
     "type": "string[]",
     "default": "[\"assistant\"]",
     "description": "The roles whose turns can be corrected",
     "readonly": false
    },
    {
     "name": "roleLabels",
     "attribute": null,
     "type": "Record<string, string>",
     "default": "{ user: \"User\", assistant: \"Assistant\", system: \"System\", tool: \"Tool\" }",
     "description": "Display names per role; an unknown role shows as written",
     "readonly": false
    },
    {
     "name": "sendLabel",
     "attribute": "send-label",
     "type": "string",
     "default": "\"Send to dataset\"",
     "description": "The send button's label",
     "readonly": false
    },
    {
     "name": "sending",
     "attribute": "sending",
     "type": "boolean",
     "default": "false",
     "description": "The app is sending the example: the button shows it's busy",
     "readonly": false
    },
    {
     "name": "sent",
     "attribute": "sent",
     "type": "boolean",
     "default": "false",
     "description": "The app has stored the example: the button reads \"Sent to dataset\" until the value changes",
     "readonly": false
    },
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"\"",
     "description": "Submitted with the form: the value as JSON",
     "readonly": false
    },
    {
     "name": "disabled",
     "attribute": "disabled",
     "type": "boolean",
     "default": "false",
     "description": "Turns every control off and leaves the value out of the form; a disabled fieldset does the same",
     "readonly": false
    },
    {
     "name": "example",
     "attribute": null,
     "type": "AnnotationExport",
     "default": null,
     "description": "The export copy tc-send carries: redacted text replaced by █",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "A span, rating or correction changed ({ value }: ConversationAnnotationValueChange); cancelable – prevent it to control `value`",
     "cancelable": true
    },
    {
     "name": "tc-send",
     "detail": "",
     "description": "\"Send to dataset\" was pressed ({ value, example }: ConversationAnnotationSend) – `example` has redacted text blanked out",
     "cancelable": false
    }
