 "react": [
  {
   "component": "ConversationAnnotation",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading – defaults to \"Conversation review\""
    },
    {
     "name": "value",
     "type": "ConversationAnnotationValue",
     "optional": true,
     "description": "Spans, ratings and corrections. Controlled when defined; otherwise the component keeps them, starting from `defaultValue`"
    },
    {
     "name": "defaultValue",
     "type": "ConversationAnnotationValue",
     "optional": true,
     "description": "The value at first when `value` isn't controlled"
    },
    {
     "name": "onChange",
     "type": "(value: ConversationAnnotationValue) => void",
     "optional": true,
     "description": "Called with the whole value after every label, redaction, rating or correction, controlled or not"
    },
    {
     "name": "onSend",
     "type": "(example: AnnotationExport, value: ConversationAnnotationValue) => void",
     "optional": true,
     "description": "Called when \"Send to dataset\" is pressed, with the value and the export copy whose redacted text is blanked out"
    }
   ],
   "hides": [
    "heading",
    "value",
    "defaultValue",
    "onChange",
    "children"
   ],
   "events": {
    "tc-value-change": "onChange",
    "tc-send": "onSend"
   }
  }
