    {
     "name": "language",
     "attribute": "language",
     "type": "string",
     "default": "\"\"",
     "description": "Language for the colours: ts, tsx, js, jsx, py, json, html, xml, css, sh/bash, or plain",
     "readonly": false
    },
    {
     "name": "filename",
     "attribute": "filename",
     "type": "string",
     "default": "\"\"",
     "description": "File name shown in the head, e.g. \"src/auth/session.ts\"",
     "readonly": false
    },
    {
     "name": "current",
     "attribute": null,
     "type": "string | undefined",
     "default": "undefined",
     "description": "The file as it is now. When given, a Diff button shows the changes the code would make",
     "readonly": false
    },
    {
     "name": "view",
     "attribute": "view",
     "type": "CodeBlockView",
     "default": "\"code\"",
     "description": "\"code\" or \"diff\". Changed by the user unless a tc-view-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "streaming",
     "attribute": "streaming",
     "type": "boolean",
     "default": "false",
     "description": "The code is still coming in: a caret blinks at the end, Diff and Apply wait",
     "readonly": false
