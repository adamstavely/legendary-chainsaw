   "name": "codeBlockTokens",
   "signature": "codeBlockTokens(code: string, language: unknown): CodeBlockToken[][]",
   "description": "The code as lines of coloured tokens – what the element renders, for tests and other renderers"
  },
  {
   "name": "codeBlockDiff",
   "signature": "codeBlockDiff(before: string, after: string): CodeBlockDiffLine[]",
   "description": "A line diff of two texts: inline-diff's Myers diff (diffWords) run over one token per distinct line, read back as\nrows. Within a change, the removed lines come first, then the added ones."
  }
 ],
