{
 "elements": [
  {
   "tag": "tc-code-block",
   "className": "TcCodeBlock",
   "description": "Streaming code with syntax colours, Copy, Apply, and a line diff against the current file.",
   "properties": [
    {
     "name": "code",
     "attribute": "code",
     "type": "string",
     "default": "\"\"",
     "description": "The code; it may grow every frame while streaming",
     "readonly": false
