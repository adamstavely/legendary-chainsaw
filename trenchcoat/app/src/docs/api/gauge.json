{
 "elements": [
  {
   "tag": "tc-gauge",
   "className": "TcGauge",
   "description": "One value against its range – a dial, a half dial or a bar – with the band it's in, the bands round it, a target\nand the change since last time; optionally a slider.",
   "properties": [
    {
     "name": "label",
     "attribute": "label",
     "type": "string",
     "default": "\"Gauge\"",
     "description": "What it measures, named above the dial – the meter's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the label",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": "value",
     "type": "number",
     "default": "0",
     "description": "The value. Changed by the user when editable, unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "min",
     "attribute": "min",
     "type": "number",
     "default": "0",
     "description": "The start of the range",
     "readonly": false
