     "name": "bands",
     "attribute": null,
     "type": "GaugeBand[]",
     "default": "[]",
     "description": "The bands from `min` up – each runs to its `to`, the last to `max`; none draws the dial in one colour",
     "readonly": false
    },
    {
     "name": "target",
     "attribute": "target",
     "type": "number | undefined",
     "default": "undefined",
