     "name": "defaultSelected",
     "type": "string | null",
     "optional": true,
     "description": "The step selected on mount when `selected` isn't controlled"
    },
    {
     "name": "onSelectedChange",
     "type": "(selected: string | null, node: WorkflowNode | null) => void",
     "optional": true,
     "description": "A step was selected, or the selection cleared"
