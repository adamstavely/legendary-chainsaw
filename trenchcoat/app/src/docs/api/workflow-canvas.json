{
 "elements": [
  {
   "tag": "tc-workflow-canvas",
   "className": "TcWorkflowCanvas",
   "description": "An agent workflow as a node graph – step cards joined by connectors, panned, zoomed, edited with the pointer or\nthe keyboard, and coloured by status while it runs.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Workflow\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "nodes",
     "attribute": null,
     "type": "WorkflowNode[]",
     "default": "[]",
     "description": "The steps, each with its position on the canvas",
     "readonly": false
    },
    {
     "name": "edges",
     "attribute": null,
     "type": "WorkflowEdge[]",
     "default": "[]",
     "description": "The connectors between steps",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": null,
     "type": "string | null",
     "default": "null",
     "description": "The selected step. Changed by the user unless a tc-selected-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "view",
     "attribute": "view",
     "type": "WorkflowView",
     "default": "\"canvas\"",
     "description": "\"canvas\" (the default) or \"list\" – the same steps as a list. Changed by the user unless prevented",
     "readonly": false
    },
    {
     "name": "readonly",
     "attribute": "readonly",
     "type": "boolean",
     "default": "false",
     "description": "Watching only: no moving, connecting, adding or removing",
     "readonly": false
    },
    {
     "name": "kinds",
     "attribute": null,
     "type": "Record<string, Partial<WorkflowKindInfo>>",
     "default": "{}",
     "description": "Labels and icons for kinds, merged over the defaults (trigger, llm, tool, condition, approval, output)",
     "readonly": false
    },
    {
     "name": "statusLabels",
     "attribute": null,
     "type": "Partial<Record<WorkflowStatus, string>>",
     "default": "{}",
     "description": "Words for each run status, merged over `defaultWorkflowStatusLabels`",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-nodes-change",
     "detail": "",
     "description": "A step was moved or removed ({ nodes, reason, id }: WorkflowNodesChange); cancelable – prevented, `nodes` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-edges-change",
     "detail": "",
     "description": "Steps were connected or disconnected, or a removed step took its connectors ({ edges, reason, edge }: WorkflowEdgesChange); cancelable – prevented, `edges` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A step was selected or the selection cleared ({ selected, node }: WorkflowSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-add-request",
     "detail": "",
     "description": "Add step was asked for, after the given step or at the start ({ after }: WorkflowAddRequest) – the page opens a step picker",
     "cancelable": false
    },
    {
     "name": "tc-view-change",
     "detail": "",
     "description": "The canvas or the list was chosen ({ view }: WorkflowViewChange); cancelable – prevented, `view` stays as it was",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "fit",
     "params": "",
     "returns": "void",
     "description": "Frames every step, never zooming past 100% or below FIT_MIN so step cards stay readable; a workflow too big for\nthat starts at its first step, and the rest is a pan away"
    }
   ],
   "ui": "wfc",
   "cssProperties": [
    {
     "name": "--tc-wfc-h",
     "value": "360px",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-wfc-trigger",
     "value": "var(--tc-tone-amber-solid)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-wfc-llm",
     "value": "var(--tc-tone-violet-solid)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-wfc-tool",
     "value": "var(--tc-chart-1)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-wfc-condition",
     "value": "var(--tc-tone-teal-solid)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-wfc-approval",
     "value": "var(--tc-tone-pink-solid)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-wfc-output",
     "value": "var(--tc-status-success-solid)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-wfc-dot",
     "value": "10px",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-wfc-bg",
     "value": "var(--tc-surface-raised)",
     "looks": [
      "standard",
      "clean"
     ]
    },
    {
     "name": "--tc-wfc-kind",
     "value": "var(--tc-icon-muted)",
     "looks": [
      "both"
     ],
     "fallback": true
    }
   ],
