     "type": "WorkflowEdge[]",
     "optional": true,
     "description": "The connectors on mount when `edges` isn't controlled"
    },
    {
     "name": "onEdgesChange",
     "type": "(edges: WorkflowEdge[], detail: WorkflowEdgesChange) => void",
     "optional": true,
     "description": "Steps were connected or disconnected"
    },
    {
     "name": "selected",
     "type": "string | null",
     "optional": true,
     "description": "The selected step – controlled when given (null for none)"
