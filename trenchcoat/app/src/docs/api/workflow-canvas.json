 "functions": [
  {
   "name": "WORKFLOW_NODE_W",
   "signature": "WORKFLOW_NODE_W: number",
   "description": "A step card's size on the canvas, px at 100% zoom – connectors leave and arrive at its vertical middle"
  },
  {
   "name": "workflowKind",
   "signature": "workflowKind(kind: string, kinds: Record<string, Partial<WorkflowKindInfo>>): WorkflowKindInfo",
   "description": "A kind's label and icon: the page's own first, then the defaults, then the kind itself and a box"
  },
  {
   "name": "workflowKindIcon",
   "signature": "workflowKindIcon(kind: string, kinds?: Record<string, Partial<WorkflowKindInfo>>): void",
   "description": "The kind's icon as a 24×24 stroked SVG"
  },
  {
   "name": "workflowEdgePath",
   "signature": "workflowEdgePath(from: { x: number; y: number }, to: { x: number; y: number }): void",
   "description": "The connector from one card's right edge to the next card's left edge, as an SVG path, and its middle"
  }
 ],
 "react": [
  {
   "component": "WorkflowCanvas",
   "exported": true,
   "props": [
    {
     "name": "title",
