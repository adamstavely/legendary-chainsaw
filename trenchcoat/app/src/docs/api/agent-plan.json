{
 "elements": [
  {
   "tag": "tc-agent-plan",
   "className": "TcAgentPlan",
   "description": "A step-by-step plan from an agent: reviewed and edited as a draft, then shown while it runs.",
   "properties": [
    {
     "name": "steps",
     "attribute": null,
     "type": "AgentPlanStep[]",
     "default": "[]",
     "description": "The steps. Edits apply unless a tc-steps-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "AgentPlanStatus",
     "default": "\"draft\"",
     "description": "\"draft\" = review and edit, \"running\" = executing, \"done\" = finished – always set by the app",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The goal of the plan, shown as the heading",
     "readonly": false
    },
    {
     "name": "estimate",
     "attribute": "estimate",
     "type": "string",
     "default": "\"\"",
     "description": "Estimated run time shown in review, e.g. \"~2 min\"",
     "readonly": false
    },
    {
     "name": "cancellable",
     "attribute": "cancellable",
     "type": "boolean",
     "default": "false",
     "description": "Shows a \"Cancel\" button next to \"Run plan\" (fires tc-cancel)",
     "readonly": false
    },
    {
     "name": "retryable",
     "attribute": "retryable",
     "type": "boolean",
     "default": "false",
     "description": "Shows \"Retry from here\" on failed steps (fires tc-retry)",
     "readonly": false
    },
    {
     "name": "rerunnable",
     "attribute": "rerunnable",
     "type": "boolean",
     "default": "false",
     "description": "Shows \"Run again\" once the plan is done (fires tc-run)",
     "readonly": false
    },
    {
     "name": "runner",
     "attribute": null,
     "type": "((steps: AgentPlanStep[]) => void | Promise<unknown>) | undefined",
     "default": "undefined",
     "description": "Called on run (as well as tc-run). May return a promise: the button waits, and if it rejects the plan stays in\nreview and says so",
     "readonly": false
    },
    {
     "name": "retrier",
     "attribute": null,
     "type": "((stepId: string) => void | Promise<unknown>) | undefined",
     "default": "undefined",
     "description": "Called on retry (as well as tc-retry). May return a promise: the button waits, and says so if it rejects",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-steps-change",
     "detail": "",
     "description": "An edit in review: rename, remove, reorder, add (detail: { steps: AgentPlanStep[] }); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-run",
     "detail": "",
     "description": "\"Run plan\" or \"Run again\" pressed (detail: { steps: AgentPlanStep[] }, in their final order)",
     "cancelable": false
    },
    {
     "name": "tc-retry",
     "detail": "",
     "description": "\"Retry from here\" pressed on a failed step (detail: { stepId: string })",
     "cancelable": false
    },
    {
     "name": "tc-cancel",
     "detail": "",
     "description": "\"Cancel\" pressed (shown with `cancellable`)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "pl",
