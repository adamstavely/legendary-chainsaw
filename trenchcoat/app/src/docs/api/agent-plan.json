 "functions": [],
 "react": [
  {
   "component": "AgentPlan",
   "exported": true,
   "props": [
    {
     "name": "steps",
     "type": "PlanStep[]",
     "optional": true,
     "description": "The steps. Controlled when defined – pair with onChange; otherwise the component keeps them, starting from\n`defaultSteps`. Edits are reported to onChange either way"
    },
    {
     "name": "defaultSteps",
     "type": "PlanStep[]",
     "optional": true,
     "description": "Initial steps when uncontrolled"
    },
    {
     "name": "onChange",
     "type": "(steps: PlanStep[]) => void",
     "optional": true,
     "description": "Every edit during review: rename, remove, reorder, add"
    },
    {
     "name": "onRun",
     "type": "(steps: PlanStep[]) => void | Promise<unknown>",
     "optional": true,
     "description": "\"Run plan\" pressed – gets the steps in their final order. May return a promise: the button waits while it\nruns, and if it rejects the plan stays in review and says so"
    },
    {
     "name": "onCancel",
     "type": "() => void",
     "optional": true,
     "description": "Shows a \"Cancel\" button next to \"Run plan\""
    },
    {
     "name": "onRetry",
     "type": "(stepId: string) => void | Promise<unknown>",
     "optional": true,
     "description": "Shows \"Retry from here\" on failed steps. May return a promise: the button waits, and says so if it rejects"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The goal of the plan, shown as the heading"
    },
    {
     "name": "estimate",
     "type": "string",
     "optional": true,
     "description": "Estimated run time shown in review, e.g. \"~2 min\""
    }
   ],
   "hides": [
    "steps",
    "heading",
    "estimate",
    "cancellable",
    "retryable",
    "rerunnable",
    "runner",
    "retrier",
    "onChange"
   ],
   "events": {
    "tc-steps-change": "onChange",
    "tc-cancel": "onCancel"
   }
  }
 ],
