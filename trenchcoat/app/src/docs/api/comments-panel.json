{
 "elements": [
  {
   "tag": "tc-comments-panel",
   "className": "TcCommentsPanel",
   "description": "A comment feed with filters, sort, runnable /edit commands, resolving and a composer.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Comments\"",
     "description": "The heading, and the region's name",
     "readonly": false
    },
    {
     "name": "comments",
     "attribute": null,
     "type": "PanelComment[]",
     "default": "[]",
     "description": "The feed, keyed by id – comments added here show first until they appear in it",
     "readonly": false
    },
    {
     "name": "currentUser",
     "attribute": null,
     "type": "CommentAuthor",
     "default": "{ name: \"You\" }",
     "description": "Who writes new comments",
     "readonly": false
    },
    {
     "name": "onRunEdit",
     "attribute": null,
     "type": "((comment: PanelComment) => Promise<void> | void) | undefined",
     "default": "undefined",
     "description": "Runs an /edit command – resolve when done, reject to show that it failed. Without it the edit is simulated:\nmarked as applied after a beat (and warns once, unless `demo` is set)",
     "readonly": false
    },
    {
     "name": "onUndoEdit",
     "attribute": null,
     "type": "((comment: PanelComment) => Promise<void> | void) | undefined",
     "default": "undefined",
     "description": "Reverts an edit that onRunEdit applied – resolve when done, reject to keep it applied with an error. Without it an\napplied edit offers no Undo, since the panel can't take it back on its own",
     "readonly": false
    },
    {
     "name": "onAdd",
     "attribute": null,
     "type": "((comment: PanelComment) => Promise<unknown> | void) | undefined",
     "default": "undefined",
     "description": "A new comment – may return a promise: pending while it runs, a rejection takes the comment out again",
     "readonly": false
    },
    {
     "name": "demo",
     "attribute": "demo",
     "type": "boolean",
     "default": "false",
     "description": "Demo mode: edits are simulated silently when onRunEdit is missing. For galleries and prototypes",
     "readonly": false
    },
    {
     "name": "resolved",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "Ids of resolved comments",
     "readonly": false
    },
    {
     "name": "filter",
     "attribute": "filter",
     "type": "CommentsFilter",
     "default": "\"all\"",
     "description": "The filter tab",
     "readonly": false
    },
    {
     "name": "closable",
     "attribute": "closable",
     "type": "boolean",
     "default": "false",
     "description": "Shows a close button in the header, which fires tc-close",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-comments-change",
     "detail": "",
     "description": "A comment was added here, or taken out again when onAdd failed; detail `{ comments: PanelComment[] }` is the whole feed. Cancelable: preventDefault() keeps an added comment out until the app passes it back.",
     "cancelable": true
    },
    {
     "name": "tc-resolved-change",
     "detail": "",
     "description": "A comment was resolved or reopened; detail `{ resolved: string[] }`. Cancelable.",
     "cancelable": true
    },
    {
     "name": "tc-filter-change",
     "detail": "",
     "description": "Another filter was picked; detail `{ filter: CommentsFilter }`. Cancelable.",
     "cancelable": true
    },
    {
     "name": "tc-close",
     "detail": "",
     "description": "The close button was pressed (shown with `closable`)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "cp",
   "cssProperties": [
