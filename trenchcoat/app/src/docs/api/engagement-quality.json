   "tag": "tc-engagement-quality",
   "className": "TcEngagementQuality",
   "description": "Whether reviews are genuine: an index with its band and trend, the signals it is built from – each with its value,\nwhat was observed, an explanation and an example – and an optional note on who else sees it.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Engagement quality\"",
     "description": "The heading, and the region's name",
     "readonly": false
    },
    {
     "name": "scope",
     "attribute": "scope",
     "type": "string",
     "default": "\"\"",
     "description": "What the numbers cover, a quiet line under the heading – e.g. \"Last 5 sessions · 38 reviews\"",
     "readonly": false
    },
    {
     "name": "index",
     "attribute": "index",
     "type": "number | undefined",
     "default": "undefined",
