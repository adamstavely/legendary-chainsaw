{
 "elements": [
  {
   "tag": "tc-pull-request",
   "className": "TcPullRequest",
   "description": "One pull request at a glance: branches, author, lines changed, review, checks and whether it can merge, with the button its state calls for.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Pull request\"",
     "description": "The heading; empty draws no header",
     "readonly": false
    },
    {
     "name": "number",
     "attribute": "number",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Its number; with neither this nor `prTitle` the empty state shows",
     "readonly": false
    },
    {
     "name": "prTitle",
     "attribute": "pr-title",
     "type": "string",
     "default": "\"\"",
     "description": "Its title",
     "readonly": false
    },
    {
     "name": "url",
     "attribute": "url",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Where it lives; the title becomes a link to it",
     "readonly": false
    },
    {
     "name": "state",
     "attribute": "state",
     "type": "PullRequestState",
     "default": "\"open\"",
     "description": "Draft, open, merged or closed",
     "readonly": false
    },
    {
     "name": "head",
     "attribute": "head",
     "type": "string",
     "default": "\"\"",
     "description": "The branch with the changes",
     "readonly": false
    },
    {
     "name": "base",
     "attribute": "base",
     "type": "string",
     "default": "\"\"",
     "description": "The branch it goes into",
     "readonly": false
    },
    {
     "name": "author",
     "attribute": "author",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Who opened it",
     "readonly": false
    },
    {
     "name": "updatedAt",
     "attribute": null,
     "type": "number | string | undefined",
     "default": "undefined",
     "description": "When it last changed: epoch ms or an ISO string",
     "readonly": false
    },
    {
     "name": "additions",
     "attribute": "additions",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Lines added",
     "readonly": false
    },
    {
     "name": "deletions",
     "attribute": "deletions",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Lines removed",
     "readonly": false
    },
    {
     "name": "files",
     "attribute": "files",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Files changed",
     "readonly": false
    },
    {
     "name": "review",
     "attribute": "review",
     "type": "PullRequestReview",
     "default": "\"none\"",
     "description": "The review as a whole",
     "readonly": false
    },
    {
     "name": "reviewers",
     "attribute": null,
     "type": "PullRequestReviewer[]",
     "default": "[]",
     "description": "Who reviewed it, or was asked to",
     "readonly": false
    },
    {
     "name": "checks",
     "attribute": null,
     "type": "CheckCounts | undefined",
     "default": "undefined",
     "description": "How its checks went; unset draws no checks row",
     "readonly": false
    },
    {
     "name": "mergeable",
     "attribute": "mergeable",
     "type": "PullRequestMergeable",
     "default": "\"unknown\"",
     "description": "Whether it can merge into its base",
     "readonly": false
    },
    {
     "name": "autoMerge",
     "attribute": "auto-merge",
     "type": "boolean",
     "default": "false",
     "description": "Merge on its own once the checks pass. Changed by the switch unless a tc-auto-merge-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "mergeMethod",
     "attribute": "merge-method",
     "type": "PullRequestMergeMethod",
     "default": "\"merge\"",
     "description": "How Merge merges. Changed by the picker unless a tc-merge-method-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "mergeMethods",
     "attribute": null,
     "type": "PullRequestMergeMethod[]",
     "default": "[\"merge\", \"squash\", \"rebase\"]",
     "description": "The methods offered; with one, there's no picker",
     "readonly": false
    },
    {
     "name": "busy",
     "attribute": "busy",
     "type": "boolean",
     "default": "false",
     "description": "Something is under way: the buttons wait",
     "readonly": false
    },
    {
     "name": "actions",
     "attribute": null,
     "type": "PullRequestActionItem[]",
     "default": "[]",
     "description": "Small buttons in the header",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<PullRequestLabels>",
     "default": "{}",
     "description": "Rename any of the words, over the defaults",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The time now, epoch ms; by default the element's own clock",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for times and numbers, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "bare",
     "attribute": "bare",
     "type": "boolean",
     "default": "false",
     "description": "Drops the tray and card",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-open",
     "detail": "",
     "description": "The title was pressed ({ number, url }: PullRequestOpen); cancelable – prevented, a link isn't followed",
     "cancelable": true
    },
    {
     "name": "tc-merge",
     "detail": "",
     "description": "Merge was pressed ({ number, method }: PullRequestMerge); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-ready",
     "detail": "",
     "description": "Mark ready was pressed ({ number }: PullRequestDetail); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-update-branch",
     "detail": "",
     "description": "Update branch was pressed ({ number }: PullRequestDetail); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-resolve",
     "detail": "",
     "description": "Resolve was pressed on conflicts ({ number }: PullRequestDetail); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-checks",
     "detail": "",
     "description": "The checks were pressed ({ number }: PullRequestDetail)",
     "cancelable": false
    },
    {
     "name": "tc-create",
     "detail": "",
     "description": "Create pull request was pressed in the empty state ({ number }: PullRequestDetail)",
     "cancelable": false
    },
    {
     "name": "tc-action",
     "detail": "",
     "description": "A header button was pressed ({ id }: PullRequestAction)",
     "cancelable": false
    },
    {
     "name": "tc-auto-merge-change",
     "detail": "",
     "description": "The auto-merge switch changed ({ autoMerge, method }: PullRequestAutoMergeChange); cancelable – prevented, the switch stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-merge-method-change",
     "detail": "",
     "description": "A merge method was picked ({ mergeMethod }: PullRequestMergeMethodChange); cancelable – prevented, the method stays as it was",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "prq",
