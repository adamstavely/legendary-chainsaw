 "functions": [],
 "react": [
  {
   "component": "ToolCallCard",
   "exported": true,
   "props": [
    {
     "name": "name",
     "type": "string",
     "optional": false,
     "description": "Tool name as the agent calls it, shown in mono – e.g. \"search_web\""
    },
    {
     "name": "status",
     "type": "TcToolCallCard[\"status\"]",
     "optional": false,
     "description": "\"running\" shows a spinner and a live timer, \"success\" a check and the duration, \"error\" \"Failed\" and the message"
    },
    {
     "name": "summary",
     "type": "React.ReactNode",
     "optional": true,
     "description": "Short human summary – e.g. \"Searched the web for 'CRM pricing 2026'\""
    },
    {
     "name": "icon",
     "type": "React.ReactNode",
     "optional": true,
     "description": "Icon in the tile on the left – defaults to a wrench"
    },
    {
     "name": "defaultOpen",
     "type": "boolean",
     "optional": true,
     "description": "Start expanded (uncontrolled)"
    },
    {
     "name": "open",
     "type": "boolean",
     "optional": true,
     "description": "Expanded state (controlled)"
    },
    {
     "name": "onOpenChange",
     "type": "(open: boolean) => void",
     "optional": true,
     "description": "Called when the card opens or closes – by a click, or on its own when the call fails"
    }
   ],
   "hides": [
    "summary",
    "icon",
    "open",
    "name",
    "status"
   ],
   "events": {
    "tc-open-change": "onOpenChange"
   }
  },
  {
   "component": "ToolCallGroup",
   "exported": true,
   "props": [
    {
     "name": "children",
     "type": "React.ReactNode",
     "optional": false,
     "description": "ToolCallCard elements – the group reads their name, icon, status and duration"
    },
    {
     "name": "defaultOpen",
     "type": "boolean",
     "optional": true,
     "description": "Start expanded (uncontrolled)"
    },
    {
     "name": "open",
     "type": "boolean",
     "optional": true,
     "description": "Expanded state (controlled)"
    },
    {
     "name": "onOpenChange",
