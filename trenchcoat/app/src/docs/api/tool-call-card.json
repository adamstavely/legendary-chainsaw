{
 "elements": [
  {
   "tag": "tc-tool-call-card",
   "className": "TcToolCallCard",
   "description": "One tool call of an AI agent: name, summary, status with a live timer, arguments and result.",
   "properties": [
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"\"",
     "description": "Tool name as the agent calls it, shown in mono – e.g. \"search_web\"",
     "readonly": false
    },
    {
     "name": "summary",
     "attribute": null,
     "type": "string | Element | undefined",
     "default": "undefined",
     "description": "Short human summary – text, or an element (cloned)",
     "readonly": false
    },
    {
     "name": "icon",
     "attribute": null,
     "type": "Element | undefined",
     "default": "undefined",
     "description": "Icon in the tile on the left (cloned) – defaults to a wrench",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "ToolCallStatus",
     "default": "\"success\"",
     "description": "\"running\" shows a spinner and a live timer, \"success\" a check and the duration, \"error\" \"Failed\" and the message",
     "readonly": false
    },
    {
     "name": "args",
     "attribute": null,
     "type": "unknown",
     "default": "undefined",
     "description": "Arguments the tool was called with – objects are pretty-printed, JSON strings parsed",
     "readonly": false
    },
    {
     "name": "result",
     "attribute": null,
     "type": "unknown",
     "default": "undefined",
     "description": "What the tool returned – objects are pretty-printed, JSON strings parsed, other text shown as is",
     "readonly": false
    },
    {
     "name": "error",
     "attribute": "error",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Error message, shown when status is \"error\"",
     "readonly": false
    },
    {
     "name": "startedAt",
     "attribute": "started-at",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When the call started (ms since epoch) – the live timer counts from here",
     "readonly": false
    },
    {
     "name": "duration",
     "attribute": "duration",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Final duration in ms – otherwise measured while the card shows \"running\"",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": "open",
     "type": "boolean",
     "default": "false",
     "description": "Expanded. Changed by the user (and on an error) unless a tc-open-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "openOnError",
     "attribute": "open-on-error",
     "type": "boolean",
     "default": "true",
     "description": "Opens the card when the call fails and closes it again on the next run, unless someone toggled it",
     "readonly": false
    },
    {
     "name": "onRetry",
     "attribute": null,
     "type": "(() => void | Promise<unknown>) | undefined",
     "default": "undefined",
     "description": "Shows a Retry button next to the error – may return a promise: Retry waits for it, a rejection is shown",
     "readonly": false
    },
    {
     "name": "maxCodeHeight",
     "attribute": "max-code-height",
     "type": "number",
     "default": "220",
     "description": "Height in px after which arguments and result are capped with a fade and \"Show all\"",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-open-change",
     "detail": "",
     "description": "The card opens or closes – by the user or on an error ({ open: boolean }); cancelable",
