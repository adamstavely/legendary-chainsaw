     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-prompt-change",
     "detail": "",
     "description": "The description changed ({ prompt }: AgentCreatePromptChange); cancelable – prevented, `prompt` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-generate",
     "detail": "",
     "description": "Generate was pressed ({ description }: AgentCreateGenerate); cancelable – prevented, `streaming` isn't set",
     "cancelable": true
    },
    {
     "name": "tc-draft-change",
     "detail": "",
     "description": "The draft was edited or cleared ({ draft, field }: AgentCreateDraftChange); cancelable – prevented, `draft` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-create",
     "detail": "",
     "description": "Create was pressed with a named, finished draft ({ draft }: AgentCreateCreate); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-reset",
     "detail": "",
     "description": "Start over was pressed (detail: {}); cancelable – prevented, nothing is cleared",
     "cancelable": true
