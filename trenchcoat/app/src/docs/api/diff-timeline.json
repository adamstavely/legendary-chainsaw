{
 "elements": [
  {
   "tag": "tc-diff-timeline",
   "className": "TcDiffTimeline",
   "description": "What a coding agent changed in a pull request, edit by edit over time, with a replay scrubber.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Changes over time\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "A line under the heading",
     "readonly": false
    },
    {
     "name": "files",
     "attribute": null,
     "type": "DiffTimelineFile[]",
     "default": "[]",
     "description": "The files and their edits",
     "readonly": false
    },
    {
     "name": "start",
     "attribute": "start",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When the run started, epoch ms; by default the first edit",
     "readonly": false
    },
    {
     "name": "end",
     "attribute": "end",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When it ended, epoch ms; by default the last edit, or now while live",
     "readonly": false
    },
    {
     "name": "live",
     "attribute": "live",
     "type": "boolean",
     "default": "false",
     "description": "The run is still going: the axis runs to now and new edits land as they come",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "\"Now\", epoch ms, while live; unset, the element keeps its own clock",
     "readonly": false
    },
    {
     "name": "time",
     "attribute": "time",
     "type": "number | null",
     "default": "null",
     "description": "The replay position, epoch ms, or null for everything. Changed by the user unless a tc-time-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The picked edit's id, or null. Changed by the user unless a tc-selected-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<DiffTimelineLabels>",
     "default": "{}",
     "description": "Rename any of the words",
     "readonly": false
    },
    {
     "name": "ticking",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "Whether the live clock is ticking, for the page and for tests",
     "readonly": true
    },
    {
     "name": "range",
     "attribute": null,
     "type": "[number, number]",
     "default": null,
     "description": "The axis: start to end, never zero wide",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "An edit was picked or closed ({ selected, edit, path }: DiffTimelineSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-time-change",
     "detail": "",
     "description": "The replay position moved ({ time }: DiffTimelineTimeChange); cancelable – prevented, `time` stays as it was",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "dtl",
   "cssProperties": [
    {
     "name": "--tc-dtl-chart",
     "value": "calc(var(--tc-space-10) * 2)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-dtl-path",
     "value": "9em",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-dtl-bar",
     "value": "5em",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-dtl-mark",
     "value": "var(--tc-space-2-5)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-dtl-added",
     "value": "var(--tc-status-success-fg)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-dtl-removed",
     "value": "var(--tc-status-danger-fg)",
     "looks": [
      "both"
     ]
    }
   ],
   "tokens": [
    "--tc-border-default",
    "--tc-border-subtle",
    "--tc-card-radius",
    "--tc-card-shadow",
    "--tc-control-h-sm",
    "--tc-control-radius-md",
    "--tc-fill-hover",
    "--tc-focus-outline",
    "--tc-focus-ring-width",
    "--tc-font-mono",
    "--tc-font-sans",
    "--tc-font-size-sm",
    "--tc-font-size-xs",
    "--tc-font-weight-medium",
    "--tc-font-weight-regular",
    "--tc-line-height-normal",
    "--tc-line-height-snug",
    "--tc-radius-2xs",
    "--tc-radius-full",
    "--tc-space-0-5",
    "--tc-space-1",
    "--tc-space-1-5",
    "--tc-space-10",
    "--tc-space-2",
    "--tc-space-2-5",
    "--tc-space-3",
    "--tc-space-4",
    "--tc-status-danger-fg",
    "--tc-status-info-fg",
    "--tc-status-success-fg",
    "--tc-surface-on-tray",
    "--tc-surface-raised",
    "--tc-surface-tray",
    "--tc-text-primary",
    "--tc-text-secondary",
    "--tc-tray-inset",
    "--tc-tray-radius"
   ]
  }
 ],
 "functions": [
  {
   "name": "diffTimelineOffset",
   "signature": "diffTimelineOffset(ms: number): void",
   "description": "m:ss from the start, or h:mm:ss past an hour"
  },
  {
   "name": "diffTimelineSeries",
   "signature": "diffTimelineSeries(files: DiffTimelineFile[], until: unknown): void",
   "description": "Running totals of lines added and removed, one point per edit in time order, up to `until`"
  }
 ],
 "react": [
  {
   "component": "DiffTimeline",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading"
    },
    {
     "name": "selected",
     "type": "string | null",
     "optional": true,
     "description": "The picked edit's id – controlled when given"
    },
    {
     "name": "defaultSelected",
     "type": "string | null",
     "optional": true,
     "description": "The picked edit on mount when `selected` isn't controlled"
    },
    {
     "name": "onSelectedChange",
     "type": "(selected: string | null, edit: DiffTimelineEdit | null, path: string | null) => void",
     "optional": true,
     "description": "An edit was picked or closed"
    },
    {
     "name": "time",
     "type": "number | null",
     "optional": true,
     "description": "The replay position, epoch ms, or null for everything – controlled when given"
    },
    {
     "name": "defaultTime",
     "type": "number | null",
     "optional": true,
     "description": "The replay position on mount when `time` isn't controlled"
    },
    {
     "name": "onTimeChange",
     "type": "(time: number | null) => void",
     "optional": true,
     "description": "The replay position moved"
    }
   ],
   "hides": [
    "heading",
    "selected",
    "time",
    "children"
   ],
   "events": {
    "tc-selected-change": "onSelectedChange",
    "tc-time-change": null
   }
  }
 ],
 "changelog": [],
