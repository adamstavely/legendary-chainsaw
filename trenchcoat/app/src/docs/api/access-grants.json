     "type": "AccessGrantsFilter",
     "optional": true,
     "description": "The tab on mount, when `filter` isn't controlled"
    },
    {
     "name": "onFilterChange",
     "type": "(filter: AccessGrantsFilter) => void",
     "optional": true,
     "description": "A tab was chosen"
    },
    {
     "name": "onRevoke",
     "type": "(grant: AccessGrant) => boolean | void",
     "optional": true,
     "description": "Revoke was confirmed; return false to keep the grant in the list"
    },
    {
     "name": "onRenew",
     "type": "(grant: AccessGrant) => void",
     "optional": true,
     "description": "Renew was pressed – give the grant a new `expiresAt`"
    },
    {
     "name": "onDriftReview",
     "type": "(grant: AccessGrant, accepted: boolean) => boolean | void",
     "optional": true,
     "description": "A changed grant was reviewed: accepted, or refused (which revokes it); return false to leave it as it is"
    }
