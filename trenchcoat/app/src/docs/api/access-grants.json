{
 "elements": [
  {
   "tag": "tc-access-grants",
   "className": "TcAccessGrants",
   "description": "The standing access an assistant or agent has – by source, with scope, level, who granted it, last use and expiry –\nwith a \"changed since you agreed\" notice, Review, Renew and Revoke.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Access\"",
     "description": "The heading",
     "readonly": false
