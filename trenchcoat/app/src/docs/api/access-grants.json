     "cancelable": true
    },
    {
     "name": "tc-revoke",
     "detail": "",
     "description": "Revoke was confirmed ({ grant }: AccessGrantRevoke); cancelable – unless prevented, the grant leaves `grants`",
     "cancelable": true
    },
    {
     "name": "tc-renew",
     "detail": "",
     "description": "Renew was pressed on a grant that expires soon or has expired ({ grant }: AccessGrantRenew); set its new `expiresAt` in answer",
     "cancelable": false
    },
    {
     "name": "tc-drift-review",
     "detail": "",
     "description": "A changed grant was reviewed ({ grant, accepted }: AccessGrantDriftReview); cancelable – unless prevented, accepting clears `changed` and refusing removes the grant",
     "cancelable": true
    }
