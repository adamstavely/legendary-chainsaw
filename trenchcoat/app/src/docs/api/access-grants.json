     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "One line under the heading – whose access this is",
     "readonly": false
    },
    {
     "name": "grants",
     "attribute": null,
     "type": "AccessGrant[]",
     "default": "[]",
     "description": "The grants. Revoking one, or refusing a change, removes it unless the event is prevented",
     "readonly": false
    },
    {
     "name": "filter",
     "attribute": "filter",
     "type": "AccessGrantsFilter",
     "default": "\"all\"",
     "description": "Which grants show: all, changed since agreed, or expiring soon (and expired)",
