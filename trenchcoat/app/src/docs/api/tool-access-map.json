{
 "elements": [
  {
   "tag": "tc-tool-access-map",
   "className": "TcToolAccessMap",
   "description": "One agent in the middle and every tool it can reach around it – used, failed, running, unused or off limits – with\neach tool's calls and a replay.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Tool access\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "agent",
     "attribute": null,
     "type": "ToolAccessAgent | null",
     "default": "null",
     "description": "The agent in the middle",
     "readonly": false
    },
    {
     "name": "tools",
     "attribute": null,
     "type": "ToolAccessTool[]",
     "default": "[]",
     "description": "Every tool it can reach, clockwise from the top",
     "readonly": false
    },
    {
     "name": "calls",
     "attribute": null,
     "type": "ToolAccessFeedCall[]",
     "default": "[]",
     "description": "Calls as one feed, each naming its tool in `to` – added to the tools' own `calls`",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": null,
     "type": "string | null",
     "default": "null",
     "description": "The open tool. Changed by the user unless a tc-selected-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "agents",
     "attribute": null,
     "type": "ToolAccessAgentTab[]",
     "default": "[]",
     "description": "Agents to switch between, as tabs over the map – leave empty for none",
     "readonly": false
    },
    {
     "name": "agentId",
     "attribute": "agent-id",
     "type": "string | null",
     "default": "null",
     "description": "The chosen agent tab. Changed by the user unless a tc-agent-id-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "onReplay",
     "attribute": null,
     "type": "((tool: ToolAccessTool, call: ToolAccessCall) => unknown) | undefined",
     "default": "undefined",
     "description": "Called on Replay (after tc-replay, unless it was prevented). May return a promise: the button is busy until it settles",
     "readonly": false
    },
    {
     "name": "statusLabels",
     "attribute": null,
     "type": "Partial<Record<ToolAccessAgentStatus, string>>",
     "default": "{}",
     "description": "The agent's status words, merged over defaultToolAccessAgentLabels",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Locale for call times",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A tool was opened or closed ({ selected, tool }: ToolAccessSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-agent-id-change",
     "detail": "",
     "description": "An agent tab was chosen ({ agentId }: ToolAccessAgentIdChange); cancelable – prevented, `agentId` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-replay",
     "detail": "",
     "description": "Replay was pressed on a call ({ tool, call }: ToolAccessReplay); cancelable – prevented, `onReplay` isn't called",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
