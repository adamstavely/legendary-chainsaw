{
 "elements": [
  {
   "tag": "tc-away-summary",
   "className": "TcAwaySummary",
   "description": "The \"while you were away\" card for a chat thread: how long you were gone, then what needs you, what failed and\nwhat's done – acted on in place.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"While you were away\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "since",
     "attribute": "since",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When the person left, in epoch ms",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When they came back, in epoch ms; unset reads the clock once",
     "readonly": false
    },
    {
     "name": "items",
     "attribute": null,
     "type": "AwayItem[]",
     "default": "[]",
     "description": "What happened, in any order – grouped by status, newest first within a group",
     "readonly": false
    },
    {
     "name": "expanded",
     "attribute": "expanded",
     "type": "boolean",
     "default": "false",
     "description": "The Done group is open",
     "readonly": false
    },
    {
     "name": "seen",
     "attribute": "seen",
     "type": "boolean",
     "default": "false",
     "description": "Mark all seen was pressed: the card folds to one line",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Locale for times of day",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<AwaySummaryLabels>",
     "default": "{}",
     "description": "Words the page can change, merged over defaultAwaySummaryLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-item-action",
     "detail": "",
     "description": "An item's button ({ id, action, item }: AwayItemAction); cancelable – on an item with `href`, prevented keeps the link from being followed",
     "cancelable": true
    },
    {
     "name": "tc-expanded-change",
     "detail": "",
     "description": "The Done group opens or closes ({ expanded }: AwayExpandedChange); cancelable – prevented, it stays",
     "cancelable": true
    },
    {
     "name": "tc-seen",
     "detail": "",
     "description": "Mark all seen ({ ids }: AwaySeen); cancelable – unless prevented the card folds to \"You're all caught up\"",
     "cancelable": true
    }
   ],
