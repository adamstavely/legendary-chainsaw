 "functions": [
  {
   "name": "sandboxLogPlainText",
   "signature": "sandboxLogPlainText(output: string): string",
   "description": "The output of a step as plain text – what Copy takes"
  }
 ],
 "react": [
  {
   "component": "SandboxLog",
   "exported": true,
   "props": [
    {
     "name": "steps",
     "type": "TcSandboxLog[\"steps\"]",
     "optional": false,
     "description": "The commands in the order they ran – one collapsible block each, with their output so far"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "Shown at the top; names the region"
    },
    {
     "name": "open",
     "type": "string[]",
     "optional": true,
     "description": "Ids of the open steps (controlled) – unset opens the running and failed ones"
    },
    {
     "name": "defaultOpen",
     "type": "string[]",
     "optional": true,
     "description": "Ids of the steps open at first (uncontrolled) – unset opens the running and failed ones"
    },
    {
     "name": "onOpenChange",
     "type": "(open: string[]) => void",
     "optional": true,
     "description": "Called with the ids of the open steps whenever a step opens or closes"
    },
    {
     "name": "query",
     "type": "string",
     "optional": true,
     "description": "The search text (controlled)"
    },
    {
     "name": "defaultQuery",
     "type": "string",
     "optional": true,
     "description": "The search text at first (uncontrolled)"
    },
    {
     "name": "onQueryChange",
     "type": "(query: string) => void",
     "optional": true,
     "description": "Called with the search text whenever it changes"
    },
    {
     "name": "onCopy",
     "type": "(stepId: string | null, text: string) => void",
     "optional": true,
     "description": "After a copy: the step's id (null for the whole log) and the text"
    }
   ],
   "hides": [
    "open",
    "query",
    "heading",
    "steps",
    "onCopy"
   ],
   "events": {
    "tc-open-change": null,
    "tc-query-change": "onQueryChange",
    "tc-copy": "onCopy"
   }
  }
 ],
 "changelog": [
  "`tc-sandbox-log` – sandbox command output: a block per step with command, exit code and time; ANSI colours (16, 256 and true colour) mapped to tokens, never parsed as HTML; incremental parsing while it streams; copy and search; windowed (50,000 lines render under 400 rows)."
 ],
