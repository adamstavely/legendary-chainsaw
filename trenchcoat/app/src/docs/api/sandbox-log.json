{
 "elements": [
  {
   "tag": "tc-sandbox-log",
   "className": "TcSandboxLog",
   "description": "Command output from an agent's sandbox: a collapsible block per step with the command, exit code, duration and\nthe output in colour; search and copy; windowed for long logs.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Sandbox\"",
     "description": "Names the region, shown at the top",
     "readonly": false
    },
    {
     "name": "environment",
     "attribute": "environment",
     "type": "string",
     "default": "\"\"",
     "description": "Small text next to the heading – the machine, image or working directory",
     "readonly": false
    },
    {
     "name": "steps",
     "attribute": null,
     "type": "SandboxLogStep[]",
     "default": "[]",
     "description": "The commands in the order they ran – one collapsible block each, with their output so far",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": null,
     "type": "string[] | undefined",
     "default": "undefined",
     "description": "Ids of the open steps – unset opens the steps that are running or failed",
     "readonly": false
    },
    {
     "name": "query",
     "attribute": "query",
     "type": "string",
     "default": "\"\"",
     "description": "The search text",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "320",
     "description": "Height in px at which a step's output scrolls",
     "readonly": false
    },
    {
     "name": "follow",
     "attribute": "follow",
     "type": "boolean",
     "default": "true",
     "description": "Keeps a step's output scrolled to its end, as a terminal does, until the reader scrolls up",
     "readonly": false
    },
    {
     "name": "lineNumbers",
     "attribute": "line-numbers",
     "type": "boolean",
     "default": "true",
     "description": "Shows a line-number gutter",
     "readonly": false
    },
    {
     "name": "hideSummary",
     "attribute": "hide-summary",
     "type": "boolean",
     "default": "false",
     "description": "Hides the summary line under the log",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-open-change",
     "detail": "",
     "description": "A step opens or closes ({ open: string[] }); cancelable – prevent it to control `open`",
     "cancelable": true
    },
    {
     "name": "tc-query-change",
     "detail": "",
     "description": "The search text changes ({ query: string }); cancelable – prevent it to control `query`",
     "cancelable": true
    },
    {
     "name": "tc-copy",
     "detail": "",
     "description": "A step's output, or the whole log, was copied ({ stepId: string | null, text: string })",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "linesOf",
     "params": "id: string",
     "returns": "readonly SandboxLogLine[]",
     "description": "The parsed lines of a step (cached; a longer output parses only its new lines)"
    },
    {
     "name": "go",
     "params": "delta: number",
     "returns": "void",
     "description": "Moves to the next (1) or previous (-1) match: opens its step and scrolls it into view"
    }
   ],
   "ui": "sbl",
