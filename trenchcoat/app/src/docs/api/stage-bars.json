{
 "elements": [
  {
   "tag": "tc-stage-bars",
   "className": "TcStageBars",
   "description": "A funnel as a list: a pill per stage sized to its share of the first, the counts and shares beside it, a headline that\nfollows the pointer, stat tiles, an optional period switch and a table view.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Stages\"",
     "description": "The heading, and the list's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "stages",
     "attribute": null,
     "type": "StageBarsStage[]",
     "default": "[]",
     "description": "The stages, top of the funnel first – used when there are no `ranges`",
     "readonly": false
    },
    {
     "name": "ranges",
     "attribute": null,
     "type": "StageBarsRange[] | undefined",
     "default": "undefined",
     "description": "Periods, each with its own stages and change – adds a switch to the header",
     "readonly": false
    },
    {
     "name": "range",
     "attribute": "range",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The chosen range's id; unset is the first",
     "readonly": false
    },
    {
     "name": "delta",
     "attribute": "delta",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Change in the first stage against the period before, in percent – a range's own `delta` wins",
     "readonly": false
    },
    {
     "name": "stage",
     "attribute": "stage",
     "type": "number | null",
     "default": "null",
     "description": "The picked stage's index, or null for none – it stays emphasised while nothing else is pointed at",
     "readonly": false
    },
    {
     "name": "mono",
     "attribute": "mono",
     "type": "boolean",
     "default": "false",
     "description": "Draws every pill in one ink instead of a colour per stage",
     "readonly": false
    },
    {
     "name": "showIcons",
     "attribute": "show-icons",
     "type": "boolean",
     "default": "true",
     "description": "Draws the stages' icons at the pills' left ends; show-icons=\"false\" hides them",
     "readonly": false
    },
    {
     "name": "format",
     "attribute": null,
     "type": "(value: number) => string",
     "default": null,
     "description": "Formats every count",
     "readonly": false
    },
    {
     "name": "view",
     "attribute": "view",
     "type": "StageBarsView",
     "default": "\"chart\"",
     "description": "The list or the table",
     "readonly": false
    },
    {
     "name": "still",
     "attribute": "still",
     "type": "boolean",
     "default": "false",
     "description": "Draws everything where it ends, with no entrance",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<StageBarsLabels>",
     "default": "{}",
     "description": "Words the page can rename, merged over `defaultStageBarsLabels`",
     "readonly": false
    },
    {
     "name": "shownStages",
     "attribute": null,
     "type": "StageBarsStage[]",
     "default": null,
     "description": "The stages shown: the chosen range's, else `stages`",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-range-change",
     "detail": "",
     "description": "A period was picked ({ range }: StageBarsRangeChange); cancelable – prevented, `range` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-stage-change",
     "detail": "",
     "description": "A stage was picked with a click, Enter or Space, or let go ({ stage, item }: StageBarsStageChange); cancelable – prevented, `stage` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-view-change",
     "detail": "",
     "description": "The Table button was pressed ({ view }: StageBarsViewChange); cancelable – prevented, `view` stays as it was",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "replay",
     "params": "",
     "returns": "void",
     "description": "Plays the entrance again"
    }
   ],
   "ui": "stgb",
