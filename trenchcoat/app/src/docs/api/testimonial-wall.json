{
 "elements": [
  {
   "tag": "tc-testimonial-wall",
   "className": "TcTestimonialWall",
   "description": "The landing-page wall of quotes: columns that scroll endlessly in opposite directions, ease to a stop on hover and pause for good.",
   "properties": [
    {
     "name": "items",
     "attribute": null,
     "type": "Testimonial[]",
     "default": "[]",
     "description": "The quotes",
     "readonly": false
    },
    {
     "name": "columns",
     "attribute": "columns",
     "type": "1 | 2 | 3",
     "default": "3",
     "description": "Most columns on a wide container – narrower containers use fewer (2 below 740 px, 1 below 480 px)",
     "readonly": false
    },
    {
     "name": "speed",
     "attribute": "speed",
     "type": "number",
     "default": "28",
     "description": "Pixels per second of the first column; the others run a little slower and faster",
     "readonly": false
    },
    {
     "name": "pauseOnHover",
     "attribute": "pause-on-hover",
     "type": "boolean",
     "default": "true",
     "description": "Ease a column to a stop while the pointer is over it or a card in it has keyboard focus",
     "readonly": false
    },
    {
     "name": "paused",
     "attribute": "paused",
     "type": "boolean",
     "default": "false",
     "description": "Stopped for good (the Pause / Play button's state)",
     "readonly": false
    },
    {
     "name": "pauseButton",
     "attribute": "pause-button",
     "type": "boolean",
     "default": "true",
     "description": "Show the Pause / Play button (on by default – moving content needs a way to stop it, WCAG 2.2.2)",
     "readonly": false
    },
    {
     "name": "label",
     "attribute": "label",
     "type": "string",
     "default": "\"What customers say\"",
     "description": "Accessible name of the wall",
     "readonly": false
    },
    {
     "name": "buttonLabels",
     "attribute": null,
     "type": "{ pause: string; play: string }",
     "default": "{ pause: \"Pause testimonials\", play: \"Play testimonials\" }",
     "description": "The Pause button's name, and the Play button's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
