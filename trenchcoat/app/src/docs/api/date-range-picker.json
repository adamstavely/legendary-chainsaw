 "react": [
  {
   "component": "DateRangePicker",
   "exported": true,
   "props": [
    {
     "name": "value",
     "type": "DateRange",
     "optional": true,
     "description": "The applied range. Controlled when defined; otherwise the picker keeps its own, starting at `defaultValue`"
    },
    {
     "name": "defaultValue",
     "type": "DateRange",
     "optional": true,
     "description": "Starting range when uncontrolled – defaults to the last 30 days"
    },
    {
     "name": "onChange",
     "type": "(range: DateRange, compare: DateRange | null, mode: CompareMode) => void",
     "optional": true,
     "description": "Called on Apply with the range and the comparison range (if any)"
    },
    {
     "name": "compareMode",
     "type": "CompareMode",
     "optional": true,
     "description": "The applied comparison. Controlled when defined (changes come through onChange's third argument); otherwise\nstarts at `defaultCompare`"
    },
    {
     "name": "defaultCompare",
     "type": "CompareMode",
     "optional": true,
     "description": "The comparison applied at first when `compareMode` isn't controlled – defaults to \"previous\""
    },
    {
     "name": "open",
     "type": "boolean",
     "optional": true,
     "description": "Whether the panel is open. Controlled when defined; otherwise starts at `defaultOpen`"
    },
    {
     "name": "defaultOpen",
     "type": "boolean",
     "optional": true,
     "description": "Open the panel right away – nice for previews"
    },
    {
     "name": "onOpenChange",
     "type": "(open: boolean) => void",
     "optional": true,
     "description": "Called whenever the panel opens or closes, controlled or not"
    }
   ],
   "hides": [
    "value",
    "open",
    "compareMode",
    "onChange"
   ],
   "events": {
    "tc-value-change": "onChange",
    "tc-compare-change": null,
    "tc-open-change": "onOpenChange"
   }
  }
 ],
