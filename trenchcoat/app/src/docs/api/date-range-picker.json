{
 "elements": [
  {
   "tag": "tc-date-range-picker",
   "className": "TcDateRangePicker",
   "description": "Pick a date range from presets or two calendars, optionally compared with the period before or a year back.",
   "properties": [
    {
     "name": "value",
     "attribute": null,
     "type": "DateRange | undefined",
     "default": "undefined",
     "description": "The applied range; unset, the last 30 days",
     "readonly": false
    },
    {
     "name": "presets",
     "attribute": null,
     "type": "RangePreset[]",
     "default": "[ { id: \"today\", label: \"Today\", range: (t) => ({ start: t, end: t }) }, { id: \"yesterday\", label: \"Yesterday\", range: (t) => ({ start: addDays(t, -1), end: addDays(t, -1) }) }, { id: \"7d\", label: \"Last 7 days\", range: (t) => ({ start: addDays(t, -6), end: t }) }, { id: \"30d\", label: \"Last 30 days\", range: (t) => ({ start: addDays(t, -29), end: t }) }, { id: \"90d\", label: \"Last 90 days\", range: (t) => ({ start: addDays(t, -89), end: t }) }, { id: \"month\", label: \"This month\", range: (t) => ({ start: startOfMonth(t), end: t }) }, { id: \"last-month\", label: \"Last month\", range: (t) => ({ start: addMonths(t, -1), end: endOfMonth(addMonths(t, -1)) }) }, { id: \"quarter\", label: \"This quarter\", range: (t) => ({ start: quarterStart(t), end: t }) }, { id: \"ytd\", label: \"Year to date\", range: (t) => ({ start: new Date(t.getFullYear(), 0, 1), end: t }) }, ]",
     "description": "The quick picks on the left, each building its range from today – defaults to Today through Year to date",
     "readonly": false
    },
    {
     "name": "compare",
     "attribute": null,
     "type": "boolean",
     "default": "true",
     "description": "Show the \"Compare to\" control",
     "readonly": false
    },
    {
     "name": "compareMode",
     "attribute": "compare-mode",
     "type": "CompareMode",
     "default": "\"previous\"",
     "description": "The applied comparison",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": "open",
     "type": "boolean",
     "default": "false",
     "description": "Whether the panel is open",
     "readonly": false
    },
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"\"",
     "description": "Name for native form submission: a hidden input with the applied range as \"YYYY-MM-DD/YYYY-MM-DD\"",
     "readonly": false
    },
    {
     "name": "disabled",
     "attribute": "disabled",
     "type": "boolean",
     "default": "false",
     "description": "The trigger can't be used and the hidden input is left out of the form",
     "readonly": false
    },
    {
     "name": "weekStartsOn",
     "attribute": "week-starts-on",
     "type": "0 | 1",
     "default": "1",
     "description": "0 = Sunday, 1 = Monday",
     "readonly": false
    },
    {
     "name": "max",
     "attribute": null,
     "type": "Date | undefined",
     "default": "undefined",
     "description": "Days after this can't be picked – defaults to today",
     "readonly": false
    },
    {
     "name": "min",
     "attribute": null,
     "type": "Date | undefined",
     "default": "undefined",
     "description": "Days before this can't be picked – unset, there is no lower limit",
     "readonly": false
    },
    {
     "name": "today",
     "attribute": null,
     "type": "Date | undefined",
     "default": "undefined",
     "description": "\"Today\" for the presets – defaults to the real day, read when the element connects",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "Apply; detail `{ value, compare, mode }` – the range, the comparison range (or null) and the compare mode. Cancelable: preventDefault() keeps `value` as it is (controlled use)",
     "cancelable": true
    },
    {
     "name": "tc-compare-change",
     "detail": "",
     "description": "Apply with another compare mode; detail `{ mode }`. Cancelable: preventDefault() keeps `compareMode` as it is",
     "cancelable": true
    },
    {
     "name": "tc-open-change",
     "detail": "",
