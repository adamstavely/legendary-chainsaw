{
 "elements": [
  {
   "tag": "tc-preview-frame",
   "className": "TcPreviewFrame",
   "description": "A browser pane around a page the app supplies, with an address field, back, forward and reload, phone, tablet and desktop widths, a console count and tabs.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Preview\"",
     "description": "The heading; empty draws no header",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "src",
     "attribute": "src",
     "type": "string",
     "default": "\"\"",
     "description": "The page the iframe loads: http, https or about:blank. Children, when there are any, show instead",
     "readonly": false
    },
    {
     "name": "url",
     "attribute": "url",
     "type": "string",
     "default": "\"\"",
     "description": "The address shown; by default the active tab's url, else `src`",
     "readonly": false
    },
    {
     "name": "sandbox",
     "attribute": "sandbox",
     "type": "string",
     "default": "\"allow-scripts allow-forms allow-same-origin\"",
     "description": "The iframe's sandbox attribute",
     "readonly": false
    },
    {
     "name": "viewport",
     "attribute": "viewport",
     "type": "PreviewViewport",
     "default": "\"desktop\"",
     "description": "The width the page is drawn at. Changed by the switch unless a tc-viewport-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "height",
     "attribute": "height",
     "type": "number",
     "default": "420",
     "description": "The page area's height in px",
     "readonly": false
    },
    {
     "name": "loading",
     "attribute": "loading",
     "type": "boolean",
     "default": "false",
     "description": "The page is loading: a bar runs and Reload spins",
     "readonly": false
    },
    {
     "name": "error",
     "attribute": "error",
     "type": "string",
     "default": "\"\"",
     "description": "Why the page couldn't load; set, the error state shows instead of the page",
     "readonly": false
    },
    {
     "name": "startable",
     "attribute": "startable",
     "type": "boolean",
     "default": "false",
     "description": "Shows the Start button in the empty state",
     "readonly": false
    },
    {
     "name": "canGoBack",
     "attribute": "can-go-back",
     "type": "boolean",
     "default": "false",
     "description": "Back can be pressed",
     "readonly": false
    },
    {
     "name": "canGoForward",
     "attribute": "can-go-forward",
     "type": "boolean",
     "default": "false",
     "description": "Forward can be pressed",
     "readonly": false
    },
    {
     "name": "consoleCount",
     "attribute": null,
     "type": "PreviewConsole | undefined",
     "default": "undefined",
     "description": "The console's counts; unset hides the badge",
     "readonly": false
    },
    {
     "name": "tabs",
     "attribute": null,
     "type": "PreviewTab[]",
     "default": "[]",
     "description": "Open pages; with none there's no tab row",
     "readonly": false
    },
    {
     "name": "active",
     "attribute": "active",
     "type": "string | null",
     "default": "null",
     "description": "The active tab's id. Changed by choosing a tab unless a tc-active-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "noNewTab",
     "attribute": "no-new-tab",
     "type": "boolean",
     "default": "false",
     "description": "Hides the New tab button",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<PreviewFrameLabels>",
     "default": "{}",
     "description": "Rename any of the words, over the defaults",
     "readonly": false
    },
    {
     "name": "bare",
     "attribute": "bare",
     "type": "boolean",
     "default": "false",
     "description": "Drops the tray and card",
     "readonly": false
    },
    {
     "name": "address",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "The address shown",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-navigate",
     "detail": "",
     "description": "Enter was pressed in the address ({ url }: PreviewNavigate); cancelable – prevented, the address and `src` stay as they were",
     "cancelable": true
    },
    {
     "name": "tc-viewport-change",
     "detail": "",
     "description": "A width was chosen ({ viewport }: PreviewViewportChange); cancelable – prevented, `viewport` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-active-change",
     "detail": "",
     "description": "A tab was chosen ({ active, tab }: PreviewActiveChange); cancelable – prevented, `active` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-close",
     "detail": "",
     "description": "A tab's close button or Delete was pressed ({ id, tab }: PreviewTabEvent); cancelable – prevented, the tab stays",
     "cancelable": true
    },
    {
     "name": "tc-new-tab",
     "detail": "",
     "description": "New tab was pressed (detail: null)",
     "cancelable": false
    },
    {
     "name": "tc-back",
     "detail": "",
     "description": "Back was pressed (detail: null)",
     "cancelable": false
    },
    {
     "name": "tc-forward",
     "detail": "",
     "description": "Forward was pressed (detail: null)",
     "cancelable": false
    },
    {
     "name": "tc-reload",
     "detail": "",
     "description": "Reload or Retry was pressed (detail: null)",
     "cancelable": false
    },
    {
     "name": "tc-start",
     "detail": "",
     "description": "Start was pressed in the empty state (detail: null)",
     "cancelable": false
    },
    {
     "name": "tc-open-external",
     "detail": "",
     "description": "Open in a new window was pressed ({ url }: PreviewExternal)",
     "cancelable": false
    },
    {
     "name": "tc-console",
     "detail": "",
     "description": "The console count was pressed (detail: null)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
