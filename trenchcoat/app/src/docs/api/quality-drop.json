 "functions": [],
 "react": [
  {
   "component": "QualityDrop",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading"
    },
    {
     "name": "status",
     "type": "QualityDropStatus",
     "optional": true,
     "description": "\"open\", \"rolled-back\" or \"dismissed\". Controlled when defined"
    },
    {
     "name": "defaultStatus",
     "type": "QualityDropStatus",
     "optional": true,
     "description": "The status at first when `status` isn't controlled"
    },
    {
     "name": "onStatusChange",
     "type": "(status: QualityDropStatus) => void",
     "optional": true,
     "description": "Called after a rollback, a dismissal or Undo, controlled or not"
    },
    {
     "name": "onRollback",
     "type": "(version: string) => boolean | void",
     "optional": true,
     "description": "Called when the rollback is confirmed, with the version to return to; return false to keep the card open"
    },
    {
     "name": "onInvestigate",
     "type": "(criterion: string) => void",
     "optional": true,
     "description": "Called when Investigate is pressed"
    },
    {
     "name": "onChatOpen",
     "type": "(id: string, evidence: QualityDropEvidence) => void",
     "optional": true,
     "description": "Called when a failing chat's quote is opened"
    }
   ],
   "hides": [
    "heading",
    "status",
    "children"
   ],
   "events": {
    "tc-rollback": "onRollback",
    "tc-status-change": null,
    "tc-investigate": "onInvestigate",
    "tc-chat-open": "onChatOpen"
   }
  }
 ],
