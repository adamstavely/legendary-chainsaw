{
 "elements": [
  {
   "tag": "tc-quality-drop",
   "className": "TcQualityDrop",
   "description": "One drop in a judge score on live chats – what fell, the likely cause with its evidence, the topics it clusters in,\nand Roll back, Investigate or Dismiss as expected.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Quality drop\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "criterion",
     "attribute": "criterion",
     "type": "string",
     "default": "\"\"",
     "description": "The criterion that fell – \"Correctness\"",
     "readonly": false
    },
    {
     "name": "from",
     "attribute": "from",
     "type": "number",
     "default": "0",
     "description": "Its mean before the drop",
     "readonly": false
    },
    {
     "name": "to",
     "attribute": "to",
     "type": "number",
     "default": "0",
     "description": "Its mean since",
     "readonly": false
    },
    {
     "name": "at",
     "attribute": "at",
     "type": "number",
     "default": "0",
     "description": "When it fell, as epoch ms",
     "readonly": false
    },
    {
     "name": "chats",
     "attribute": "chats",
     "type": "number",
     "default": "0",
     "description": "How many chats were scored since it fell",
     "readonly": false
    },
    {
     "name": "series",
     "attribute": null,
     "type": "QualityDropPoint[]",
     "default": "[]",
     "description": "The daily mean round the drop, for the small chart",
     "readonly": false
    },
    {
     "name": "cause",
     "attribute": null,
     "type": "QualityDropCause | null",
     "default": "null",
     "description": "The likely cause, or null when nothing lines up",
     "readonly": false
    },
    {
     "name": "evidence",
     "attribute": null,
     "type": "QualityDropEvidence[]",
     "default": "[]",
     "description": "Failing chats that point to the cause, as short quotes",
     "readonly": false
    },
    {
     "name": "segments",
     "attribute": null,
     "type": "QualityDropSegment[]",
     "default": "[]",
     "description": "The topics the failing chats fall in, with their share",
     "readonly": false
    },
    {
     "name": "rollbackTo",
     "attribute": "rollback-to",
     "type": "string",
     "default": "\"\"",
     "description": "The version Roll back returns to – \"v13\"; empty hides Roll back",
     "readonly": false
    },
    {
     "name": "reverts",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "What rolling back reverts, a line each – said before it's confirmed",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "QualityDropStatus",
     "default": "\"open\"",
     "description": "\"open\", \"rolled-back\" or \"dismissed\"",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string",
     "default": "\"en-US\"",
     "description": "Formats dates and numbers",
     "readonly": false
    },
    {
     "name": "timeZone",
     "attribute": "time-zone",
     "type": "string",
     "default": "\"UTC\"",
     "description": "The time zone dates are read in",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-rollback",
     "detail": "",
     "description": "Roll back was confirmed ({ version }: QualityDropRollback); cancelable – prevented, the card stays open",
     "cancelable": true
    },
    {
     "name": "tc-status-change",
     "detail": "",
     "description": "The drop was rolled back, dismissed or reopened ({ status }: QualityDropStatusChange); cancelable – prevented, `status` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-investigate",
     "detail": "",
     "description": "Investigate was pressed ({ criterion }: QualityDropInvestigate)",
     "cancelable": false
    },
    {
     "name": "tc-chat-open",
     "detail": "",
     "description": "A failing chat's quote was opened ({ id, evidence }: QualityDropChatOpen)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "qdr",
   "cssProperties": [
