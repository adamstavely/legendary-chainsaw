{
 "elements": [
  {
   "tag": "tc-edit-region",
   "className": "TcEditRegion",
   "description": "Brush a mask over an image and say what should change – brush, eraser and a keyboard-movable box, undo and redo,\nhow much is selected, and Generate with the mask as a PNG.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Edit region\"",
     "description": "The title above the image",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the title",
     "readonly": false
    },
    {
     "name": "src",
     "attribute": "src",
     "type": "string",
     "default": "\"\"",
     "description": "The image to edit",
     "readonly": false
    },
    {
     "name": "alt",
     "attribute": "alt",
     "type": "string",
     "default": "\"\"",
     "description": "What the image shows, for screen readers",
     "readonly": false
    },
    {
     "name": "mask",
     "attribute": null,
     "type": "EditRegionOp[]",
     "default": "[]",
     "description": "The mask: brush strokes, erasures and boxes in fractions of the image",
     "readonly": false
    },
    {
     "name": "tool",
     "attribute": "tool",
     "type": "EditRegionTool",
     "default": "\"brush\"",
     "description": "The tool in use",
     "readonly": false
    },
    {
     "name": "brushSize",
     "attribute": "brush-size",
     "type": "number",
     "default": "32",
     "description": "The brush's width in px on the image as shown",
     "readonly": false
    },
    {
     "name": "minBrush",
     "attribute": "min-brush",
     "type": "number",
     "default": "8",
     "description": "The smallest and largest brush the slider offers, in px",
     "readonly": false
    },
    {
     "name": "maxBrush",
     "attribute": "max-brush",
     "type": "number",
     "default": "96",
     "description": "The largest brush the slider offers, in px",
     "readonly": false
    },
    {
     "name": "instruction",
     "attribute": "instruction",
     "type": "string",
     "default": "\"\"",
     "description": "What should change",
     "readonly": false
    },
    {
     "name": "busy",
     "attribute": "busy",
     "type": "boolean",
     "default": "false",
     "description": "Holds everything while the page generates; Generate turns it on unless tc-edit is prevented",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<EditRegionLabels>",
     "default": "{}",
     "description": "Words the page can rename (merged over defaultEditRegionLabels)",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-mask-change",
     "detail": "",
     "description": "The mask changed: a stroke or box was added, or undo, redo or clear ({ mask, reason }: EditRegionMaskChange); cancelable – prevented, the mask stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-tool-change",
     "detail": "",
     "description": "Another tool was picked ({ tool }: EditRegionToolChange); cancelable – prevented, the tool stays",
     "cancelable": true
    },
    {
     "name": "tc-instruction-change",
     "detail": "",
     "description": "The instruction was edited ({ instruction }: EditRegionInstructionChange); cancelable – prevented, the text goes back",
     "cancelable": true
    },
    {
     "name": "tc-edit",
     "detail": "",
     "description": "Generate was pressed ({ instruction, mask, bounds, ops, coverage }: EditRegionEdit); cancelable – not prevented, the element turns `busy` until the page clears it",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "undo",
     "params": "",
     "returns": "void",
     "description": "Steps the mask back one change"
    },
    {
     "name": "redo",
     "params": "",
     "returns": "void",
     "description": "Steps forward again after undo"
    },
    {
     "name": "clear",
     "params": "",
     "returns": "void",
     "description": "Empties the mask"
    },
    {
     "name": "toMaskDataURL",
     "params": "",
     "returns": "string",
     "description": "The mask as a PNG data URL – white where selected, black elsewhere – at the image's own size (at most 2048 px)"
    }
   ],
   "ui": "edr",
   "cssProperties": [
    {
     "name": "--tc-edr-tint-opacity",
     "value": "0.45",
     "looks": [
      "both"
     ]
    }
   ],
