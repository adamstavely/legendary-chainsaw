  {
   "name": "paintMask",
   "signature": "paintMask(ctx: CanvasRenderingContext2D, ops: readonly EditRegionOp[], w: number, h: number, colour: string): void",
   "description": "Paints the operations onto a 2-D context of the given size: added paint in `colour`, erasures cut out"
  },
  {
   "name": "measureMask",
   "signature": "measureMask(ops: readonly EditRegionOp[], aspect: number): { coverage: number; bounds: EditRegionBounds | null }",
   "description": "How much of the image the mask covers (0–1) and its bounds, measured on a small raster"
  }
 ],
