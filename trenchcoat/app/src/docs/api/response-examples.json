     "name": "examples",
     "attribute": null,
     "type": "ResponseExample[]",
     "default": "[]",
     "description": "The example responses, one tab each, in the order given",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "string",
     "default": "\"\"",
     "description": "The tab showing, by its status (\"200\"); the first when empty or unknown. Changed by the tabs unless a tc-status-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "mediaType",
