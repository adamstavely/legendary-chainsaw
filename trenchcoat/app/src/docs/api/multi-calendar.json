{
 "elements": [
  {
   "tag": "tc-multi-calendar",
   "className": "TcMultiCalendar",
   "description": "A calendar of calendars – many people's events from many accounts in one Day, Week, Month, Agenda or People view,\nwith show/hide per calendar, conflicts across a person's calendars, and create, edit, move and delete.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Calendars\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "calendars",
     "attribute": null,
     "type": "CalendarSource[]",
     "default": "[]",
     "description": "The calendars, from every account and person, in the order the sidebar lists them",
     "readonly": false
    },
    {
     "name": "events",
     "attribute": null,
     "type": "CalendarEvent[]",
     "default": "[]",
     "description": "The events of every calendar, in any order. Changed by the user (create, edit, move, delete) unless the event's listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "view",
     "attribute": "view",
     "type": "MultiCalendarView",
     "default": "\"week\"",
     "description": "The view: \"day\", \"week\", \"month\", \"agenda\" or \"people\". Changed by the user unless a tc-view-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "date",
     "attribute": "date",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The day in focus, as epoch ms of any moment in it; by default today. Changed by the user unless a tc-date-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "visible",
     "attribute": null,
     "type": "string[] | undefined",
     "default": "undefined",
     "description": "The ids of the calendars shown; by default each calendar's own `visible`. Changed by the user unless a tc-visible-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "pending",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "Ids of events being saved: drawn as saving, and not editable until they leave the list",
     "readonly": false
    },
    {
     "name": "groupBy",
     "attribute": "group-by",
     "type": "\"person\" | \"provider\"",
     "default": "\"person\"",
     "description": "How the sidebar groups calendars: \"person\" or \"provider\" (the account)",
     "readonly": false
    },
    {
     "name": "timeZone",
     "attribute": "time-zone",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The IANA time zone the calendar shows, e.g. \"America/Los_Angeles\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for dates and times, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "weekStart",
     "attribute": "week-start",
     "type": "number",
     "default": "1",
     "description": "The first day of the week: 0 Sunday, 1 Monday … 6 Saturday",
     "readonly": false
    },
    {
     "name": "workingHours",
     "attribute": null,
     "type": "MultiCalendarHours",
     "default": "{ start: 9, end: 17, days: [1, 2, 3, 4, 5] }",
     "description": "Working hours; time outside them is shaded",
     "readonly": false
    },
    {
     "name": "agendaDays",
     "attribute": "agenda-days",
     "type": "number",
     "default": "14",
     "description": "How many days Agenda lists from the day in focus",
     "readonly": false
    },
    {
     "name": "readonly",
     "attribute": "readonly",
     "type": "boolean",
     "default": "false",
     "description": "View only: no creating, editing, moving or deleting anywhere",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The current time, epoch ms – for a fixed clock (tests, screenshots); by default the element keeps its own",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<MultiCalendarLabels>",
     "default": "{}",
     "description": "Any of the words it shows (see defaultMultiCalendarLabels)",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-event-create",
     "detail": "",
     "description": "An event was created ({ event, calendar }: MultiCalendarEventCreate); cancelable – prevented, it isn't added",
     "cancelable": true
    },
    {
     "name": "tc-event-update",
     "detail": "",
     "description": "An event was edited, moved or resized ({ event, previous, calendar }: MultiCalendarEventUpdate); cancelable – prevented, it stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-event-delete",
     "detail": "",
     "description": "An event was deleted ({ event, calendar }: MultiCalendarEventDelete); cancelable – prevented, it stays",
     "cancelable": true
    },
    {
     "name": "tc-view-change",
     "detail": "",
     "description": "The view was switched ({ view }: MultiCalendarViewChange); cancelable – prevented, `view` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-date-change",
     "detail": "",
     "description": "The day in focus moved ({ date }: MultiCalendarDateChange); cancelable – prevented, `date` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-visible-change",
     "detail": "",
     "description": "Calendars were shown or hidden ({ visible }: MultiCalendarVisibleChange); cancelable – prevented, `visible` stays as it was",
     "cancelable": true
    }
   ],
