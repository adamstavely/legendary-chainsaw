 "functions": [
  {
   "name": "planRuns",
   "signature": "planRuns(sessions: ScheduledSession[], tasks: ScheduledTask[]): ScheduledPlacement[]",
   "description": "Places tasks in sessions: pinned first, then by priority and size. Splits what no one session can hold; never overfills"
  },
  {
   "name": "movePlacement",
   "signature": "movePlacement(placements: ScheduledPlacement[], placement: ScheduledPlacement, session: string | null): ScheduledPlacement[]",
   "description": "Moves one placement to a session (or null); a part joining another part of its task merges with it, and parts renumber"
  }
 ],
 "react": [
  {
   "component": "ScheduledRuns",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading; by default \"Scheduled runs\""
    },
    {
     "name": "placements",
     "type": "ScheduledPlacement[]",
     "optional": true,
     "description": "Where each task goes – controlled when given"
    },
    {
     "name": "defaultPlacements",
     "type": "ScheduledPlacement[]",
     "optional": true,
     "description": "Where each task goes on mount when `placements` isn't controlled; by default `planRuns` decides"
    },
    {
     "name": "onPlacementsChange",
     "type": "(placements: ScheduledPlacement[], detail: ScheduledPlacementsChange) => void",
     "optional": true,
     "description": "A task was moved"
    },
    {
     "name": "mode",
     "type": "ScheduledRunsMode",
     "optional": true,
     "description": "\"auto\" or \"manual\" – controlled when given"
    },
    {
     "name": "defaultMode",
     "type": "ScheduledRunsMode",
     "optional": true,
     "description": "The mode on mount when `mode` isn't controlled; by default \"manual\""
    },
    {
     "name": "onModeChange",
     "type": "(mode: ScheduledRunsMode) => void",
     "optional": true,
     "description": "Auto or Manual was picked"
    }
   ],
   "hides": [
    "heading",
    "placements",
    "mode",
    "children"
   ],
   "events": {
    "tc-placements-change": "onPlacementsChange",
    "tc-mode-change": null
   }
  }
 ],
 "changelog": [
  "**Conflict Radar** (`tc-conflict-radar`), **Scheduled Runs** (`tc-scheduled-runs`), **Fallback Chain** (`tc-fallback-chain`), **Agent Handoff** (`tc-agent-handoff`), **Agent Findings** (`tc-agent-findings`) and **Agent Monitor** (`tc-agent-monitor`): where parallel agents collide, tasks across a week's sessions, one request finding a model, what's lost between agents, what a group of agents found, and one agent at work."
 ],
