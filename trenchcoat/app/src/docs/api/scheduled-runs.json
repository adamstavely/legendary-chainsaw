{
 "elements": [
  {
   "tag": "tc-scheduled-runs",
   "className": "TcScheduledRuns",
   "description": "Agent tasks placed into a week's sessions under usage limits.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Scheduled runs\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "A line under the heading",
     "readonly": false
    },
    {
     "name": "sessions",
     "attribute": null,
     "type": "ScheduledSession[]",
     "default": "[]",
     "description": "The week's sessions, in order",
     "readonly": false
    },
    {
     "name": "tasks",
     "attribute": null,
     "type": "ScheduledTask[]",
     "default": "[]",
     "description": "The tasks to place",
     "readonly": false
    },
    {
     "name": "placements",
     "attribute": null,
     "type": "ScheduledPlacement[] | undefined",
     "default": "undefined",
     "description": "Where each task goes; unset, planRuns() decides. Changed by the user unless a tc-placements-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "layout",
     "attribute": "layout",
     "type": "ScheduledRunsLayout",
     "default": "\"calendar\"",
     "description": "\"calendar\" lays sessions out by day and time beside To schedule; \"cards\" lets them wrap",
     "readonly": false
    },
    {
     "name": "mode",
     "attribute": "mode",
     "type": "ScheduledRunsMode",
     "default": "\"manual\"",
     "description": "\"manual\" lets tasks move; \"auto\" plans them. Changed by the user unless a tc-mode-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The current time, epoch ms, for the Now line. Unset, there's no line",
     "readonly": false
    },
    {
     "name": "unit",
     "attribute": "unit",
     "type": "string",
     "default": "\"credits\"",
     "description": "What the numbers count",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The locale for numbers",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<ScheduledRunsLabels>",
     "default": "{}",
     "description": "Rename any of the words",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-placements-change",
     "detail": "",
     "description": "A task was moved, or Auto redid the plan ({ placements, task }: ScheduledPlacementsChange); cancelable – prevented, `placements` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-mode-change",
     "detail": "",
     "description": "Auto or Manual was picked ({ mode }: ScheduledModeChange); cancelable – prevented, `mode` stays as it was",
     "cancelable": true
    }
   ],
