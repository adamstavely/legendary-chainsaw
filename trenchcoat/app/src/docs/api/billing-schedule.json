     "type": "ScheduleLine[]",
     "optional": true,
     "description": "Schedule lines (controlled)"
    },
    {
     "name": "defaultLines",
     "type": "ScheduleLine[]",
     "optional": true,
     "description": "Lines on mount when `lines` isn't controlled"
    },
    {
     "name": "onLinesChange",
     "type": "(lines: ScheduleLine[]) => void",
     "optional": true,
     "description": "Called with every line after a product, discount or minimum is added, edited or removed"
