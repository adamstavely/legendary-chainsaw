     "type": "Duration",
     "optional": true,
     "description": "Phase length (controlled)"
    },
    {
     "name": "defaultDuration",
     "type": "Duration",
     "optional": true,
     "description": "Phase length on mount when `duration` isn't controlled"
    },
    {
     "name": "onDurationChange",
     "type": "(duration: Duration) => void",
     "optional": true,
     "description": "Called with the new phase length"
    },
    {
     "name": "onChange",
     "type": "(schedule: Schedule) => void",
     "optional": true,
     "description": "Called with the full schedule after every change the user makes (not on mount)"
    }
