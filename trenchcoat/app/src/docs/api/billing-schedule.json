    {
     "name": "start",
     "type": "string",
     "optional": true,
     "description": "Start date, yyyy-mm-dd (controlled)"
    },
    {
     "name": "defaultStart",
     "type": "string",
     "optional": true,
     "description": "Start date on mount when `start` isn't controlled"
    },
    {
     "name": "onStartChange",
