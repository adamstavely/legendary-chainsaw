{
 "elements": [
  {
   "tag": "tc-session-panel",
   "className": "TcSessionPanel",
   "description": "The side panel of a working session: tools, environment, context, connectors, outputs, changes and background tasks.",
   "properties": [
    {
     "name": "tools",
     "attribute": null,
     "type": "IconRailItem[]",
     "default": "[]",
     "description": "The tool buttons at the top; without any, the rail is left out",
     "readonly": false
    },
    {
     "name": "tool",
     "attribute": "tool",
     "type": "string | null",
     "default": "null",
     "description": "The id of the chosen tool. Changed by the user unless a tc-selected-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "moreTools",
     "attribute": null,
     "type": "IconRailMoreItem[]",
     "default": "[]",
     "description": "The rail's More menu",
     "readonly": false
    },
    {
     "name": "environment",
     "attribute": null,
     "type": "EnvironmentItem[]",
     "default": "[]",
     "description": "Where the session runs",
     "readonly": false
    },
    {
     "name": "toggles",
     "attribute": null,
     "type": "Record<string, boolean>",
     "default": "{}",
     "description": "The environment rows' switches. Changed by the user unless a tc-toggles-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "context",
     "attribute": "context",
     "type": "number | undefined",
     "default": "undefined",
     "description": "How full the context is, from 0 to 1; without it, the row is left out",
     "readonly": false
    },
    {
     "name": "connectors",
     "attribute": "connectors",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The Connectors row's value, such as \"14 to reconnect\"; without it, the row is left out",
     "readonly": false
    },
    {
     "name": "outputs",
     "attribute": "outputs",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The Outputs row's value, such as \"51\"; without it, the row is left out",
     "readonly": false
    },
    {
     "name": "changes",
     "attribute": null,
     "type": "ChangeItem[]",
     "default": "[]",
     "description": "The changes the session has made",
     "readonly": false
    },
    {
     "name": "changeActions",
     "attribute": null,
     "type": "ChangeRowAction[]",
     "default": "[]",
     "description": "The menu on each change",
     "readonly": false
    },
    {
     "name": "changeLimit",
     "attribute": "change-limit",
     "type": "number",
     "default": "5",
     "description": "How many changes show before Show more",
     "readonly": false
    },
    {
     "name": "background",
     "attribute": "background",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The Background tasks row's value, such as \"4 running\"; without it, the row is left out",
     "readonly": false
    },
    {
     "name": "sections",
     "attribute": null,
     "type": "SessionPanelSection[]",
     "default": "[\"environment\", \"changes\"]",
