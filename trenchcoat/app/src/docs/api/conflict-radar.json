     "type": "(filter: ConflictFilter) => void",
     "optional": true,
     "description": "The filter changed"
    },
    {
     "name": "onResolve",
     "type": "(file: ConflictFile) => void",
     "optional": true,
     "description": "Resolve was pressed"
    }
   ],
   "hides": [
