{
 "elements": [
  {
   "tag": "tc-profile-header",
   "className": "TcProfileHeader",
   "description": "The top of a person's or an account's page: picture, name, status and tags, other names, a line of facts, the\npage's actions and an optional row of tabs.",
   "properties": [
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"\"",
     "description": "The person's or the account's name: the page's heading",
     "readonly": false
    },
    {
     "name": "level",
     "attribute": "level",
     "type": "1 | 2",
     "default": "2",
     "description": "The heading's level – 1 when the header tops the page, 2 (the default) inside a layout that has its own h1",
     "readonly": false
    },
    {
     "name": "picture",
     "attribute": "picture",
     "type": "string | undefined",
     "default": "undefined",
     "description": "A picture URL; without one the avatar shows the name's initials",
     "readonly": false
    },
    {
     "name": "kind",
     "attribute": "kind",
     "type": "\"person\" | \"account\"",
     "default": "\"person\"",
     "description": "\"person\" draws a round avatar, \"account\" (a company, a team, a workspace) a rounded square",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": null,
     "type": "ProfilePill | undefined",
     "default": "undefined",
     "description": "The status beside the name, e.g. { label: \"Under review\", tone: \"warning\" }",
     "readonly": false
    },
    {
     "name": "tags",
     "attribute": null,
     "type": "ProfilePill[]",
     "default": "[]",
     "description": "More pills after the status, e.g. a priority",
     "readonly": false
    },
    {
     "name": "aliases",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "Other names the person or account goes by, as chips",
     "readonly": false
    },
    {
     "name": "aliasLabel",
     "attribute": "alias-label",
     "type": "string",
     "default": "\"Also known as\"",
     "description": "The label before the other names",
     "readonly": false
    },
    {
     "name": "meta",
     "attribute": null,
     "type": "ProfileMeta[]",
     "default": "[]",
     "description": "Short facts in one line, separated by dots: a role, a place, when last seen, a linked case",
     "readonly": false
    },
    {
     "name": "actions",
     "attribute": null,
     "type": "ProfileAction[]",
     "default": "[]",
     "description": "The page's actions, at the right",
     "readonly": false
    },
    {
     "name": "more",
     "attribute": "more",
     "type": "boolean",
     "default": "false",
     "description": "Shows an overflow button after the actions, which fires tc-action \"more\"",
     "readonly": false
    },
    {
     "name": "moreLabel",
     "attribute": "more-label",
     "type": "string",
     "default": "\"More actions\"",
     "description": "The overflow button's name",
     "readonly": false
    },
    {
     "name": "tabs",
     "attribute": null,
     "type": "ProfileTab[]",
     "default": "[]",
     "description": "Tabs for the sections below; none hides the row",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The selected tab's id; the first tab when unset. Changed by the user unless a tc-selected-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "tabsLabel",
     "attribute": "tabs-label",
     "type": "string",
     "default": "\"Sections\"",
     "description": "The tab row's name for screen readers",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-action",
     "detail": "",
     "description": "An action button, or the overflow button, was used ({ id }: ProfileActionEvent; \"more\" for the overflow button)",
     "cancelable": false
    },
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A tab was chosen ({ selected }: ProfileSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    }
   ],
