{
 "elements": [
  {
   "tag": "tc-subprocessor-list",
   "className": "TcSubprocessorList",
   "description": "Every vendor that touches customer data – purpose, data categories, location, transfer mechanism, when added and\nwhether it's active, new or removed – with search, category and location filters, Export CSV and Subscribe to\nchanges.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Subprocessors\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "subprocessors",
     "attribute": null,
     "type": "Subprocessor[]",
     "default": "[]",
     "description": "The vendors, in order",
     "readonly": false
    },
    {
     "name": "query",
     "attribute": "query",
     "type": "string",
     "default": "\"\"",
     "description": "The search text. Changed by typing unless a tc-query-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "category",
     "attribute": null,
     "type": "string | null",
     "default": "null",
     "description": "The data category shown, or null for all. Changed by the filter unless a tc-category-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "location",
     "attribute": null,
     "type": "string | null",
     "default": "null",
     "description": "The location shown, or null for all. Changed by the filter unless a tc-location-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "hideSubscribe",
     "attribute": "hide-subscribe",
     "type": "boolean",
     "default": "false",
     "description": "Leaves out Subscribe to changes",
     "readonly": false
    },
    {
     "name": "filename",
     "attribute": "filename",
     "type": "string",
     "default": "\"subprocessors.csv\"",
     "description": "The name Export CSV saves as",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for dates, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<SubprocessorListLabels>",
     "default": "{}",
     "description": "The words used, merged over defaultSubprocessorListLabels",
     "readonly": false
    },
    {
     "name": "shown",
     "attribute": null,
     "type": "Subprocessor[]",
     "default": null,
     "description": "The vendors that pass the search and filters",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-query-change",
     "detail": "",
     "description": "The search changed ({ query }: SubprocessorQueryChange); cancelable – prevented, `query` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-category-change",
     "detail": "",
     "description": "The data-category filter changed ({ category }: SubprocessorCategoryChange); cancelable – prevented, `category` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-location-change",
     "detail": "",
     "description": "The location filter changed ({ location }: SubprocessorLocationChange); cancelable – prevented, `location` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-subscribe",
     "detail": "",
     "description": "A valid email was submitted to Subscribe to changes ({ email }: SubprocessorSubscribe); cancelable – prevented, no confirmation is shown",
     "cancelable": true
    },
    {
     "name": "tc-export",
     "detail": "",
     "description": "Export CSV was pressed ({ csv, rows, filename }: SubprocessorExport); cancelable – prevented, nothing is downloaded",
     "cancelable": true
    }
   ],
