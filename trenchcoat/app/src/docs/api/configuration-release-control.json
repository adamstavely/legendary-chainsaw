{
 "elements": [
  {
   "tag": "tc-configuration-release-control",
   "className": "TcConfigurationReleaseControl",
   "description": "A configuration version moving through environments: the pipeline, what changed, the evaluation evidence, the\napprovals, the rollout and the rollback target, with a gated, confirmed Promote and a confirmed Roll back.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Configuration release\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "A quieter line under the heading, e.g. which assistant this configures",
     "readonly": false
    },
    {
     "name": "stages",
     "attribute": null,
     "type": "ReleaseStage[]",
     "default": "[]",
     "description": "The environments in order, each with the version it runs and any rollout in progress",
     "readonly": false
    },
    {
     "name": "versions",
     "attribute": null,
     "type": "ReleaseVersion[]",
     "default": "[]",
     "description": "Every version the stages, the candidate and the rollback target refer to",
     "readonly": false
    },
    {
     "name": "candidate",
     "attribute": "candidate",
     "type": "string",
     "default": "\"\"",
     "description": "The id of the version being promoted",
     "readonly": false
    },
    {
     "name": "target",
     "attribute": "target",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The id of the stage it's promoted to; unset, the stage after the last one that fully runs it",
     "readonly": false
    },
    {
     "name": "changes",
     "attribute": null,
     "type": "ReleaseChange[]",
     "default": "[]",
     "description": "What changed against the version it replaces, by area",
     "readonly": false
    },
    {
     "name": "evidence",
     "attribute": null,
     "type": "ReleaseEvidence | undefined",
     "default": "undefined",
     "description": "The evaluation behind the promotion; unset, promotion waits for one",
     "readonly": false
    },
    {
     "name": "approvals",
     "attribute": null,
     "type": "ReleaseApproval[]",
     "default": "[]",
     "description": "Who has reviewed the candidate",
     "readonly": false
    },
    {
     "name": "requiredApprovals",
     "attribute": "required-approvals",
     "type": "number",
     "default": "1",
     "description": "How many approvals Promote needs",
     "readonly": false
    },
    {
     "name": "rollback",
     "attribute": null,
     "type": "ReleaseRollback | undefined",
     "default": "undefined",
     "description": "Where Roll back goes; unset, there's nothing to roll back to",
     "readonly": false
    },
    {
     "name": "hold",
     "attribute": "hold",
     "type": "string",
     "default": "\"\"",
     "description": "A reason that holds every promotion, e.g. \"Releases are frozen until Monday\"",
     "readonly": false
    },
    {
     "name": "promoteNote",
     "attribute": "promote-note",
     "type": "string",
     "default": "\"Traffic moves as your release process sets it. You can roll back afterwards.\"",
     "description": "Said in the promote confirmation, under the move",
     "readonly": false
    },
    {
     "name": "rollbackNote",
     "attribute": "rollback-note",
     "type": "string",
     "default": "\"Only this stage changes. Other stages keep the versions they run.\"",
     "description": "Said in the rollback confirmation, under the move",
     "readonly": false
    },
    {
     "name": "cancelLabel",
     "attribute": "cancel-label",
     "type": "string",
     "default": "\"Cancel\"",
     "description": "The confirmation's Cancel button",
     "readonly": false
    },
    {
     "name": "suites",
     "attribute": null,
     "type": "ReleaseSuite[]",
     "default": "[]",
     "description": "Gate suites and their results; unset, the gate doesn't ask for any",
     "readonly": false
    },
    {
     "name": "findings",
     "attribute": null,
     "type": "ReleaseFinding[]",
     "default": "[]",
     "description": "Open findings linked to the candidate; blocking ones hold promotion unless waived",
     "readonly": false
    },
    {
     "name": "waivers",
     "attribute": null,
     "type": "ReleaseWaiver[]",
     "default": "[]",
     "description": "Waivers for conditional suites and blocking findings, with who granted them and when they expire",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-promote",
     "detail": "",
     "description": "Promote was confirmed ({ version, stage, from }: ReleasePromoteEvent); cancelable – prevented, the stage isn't marked \"Requested\"",
     "cancelable": true
    },
    {
     "name": "tc-rollback",
     "detail": "",
     "description": "Roll back was confirmed ({ stage, from, to }: ReleaseRollbackEvent); cancelable – prevented, the stage isn't marked \"Requested\"",
     "cancelable": true
    },
    {
     "name": "tc-compare",
     "detail": "",
     "description": "Compare was pressed – open the full diff ({ from, to }: ReleaseCompareEvent); cancelable, with nothing else to stop",
     "cancelable": true
    },
    {
     "name": "tc-finding-open",
     "detail": "",
     "description": "A linked finding was pressed – open it ({ finding }: ReleaseFindingOpenEvent); cancelable, with nothing else to stop",
     "cancelable": true
    }
   ],
