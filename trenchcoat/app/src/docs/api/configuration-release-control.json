 "react": [
  {
   "component": "ConfigurationReleaseControl",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading"
    },
    {
     "name": "onPromote",
     "type": "(request: ReleasePromoteEvent, event: CustomEvent<ReleasePromoteEvent>) => void",
     "optional": true,
     "description": "Promote was confirmed: start the move. Call `event.preventDefault()` if it can't start, so the stage isn't marked \"Requested\""
    },
    {
     "name": "onRollback",
     "type": "(request: ReleaseRollbackEvent, event: CustomEvent<ReleaseRollbackEvent>) => void",
     "optional": true,
     "description": "Roll back was confirmed: start it. Call `event.preventDefault()` if it can't start, so the stage isn't marked \"Requested\""
    },
    {
     "name": "onCompare",
     "type": "(versions: ReleaseCompareEvent) => void",
     "optional": true,
     "description": "Compare was pressed: open the full diff between the two versions"
    },
    {
     "name": "onOpenFinding",
     "type": "(finding: ReleaseFindingOpenEvent[\"finding\"]) => void",
     "optional": true,
     "description": "A linked finding was pressed: open it"
    }
   ],
   "hides": [
    "heading",
    "children"
   ],
   "events": {
    "tc-promote": "onPromote",
    "tc-rollback": "onRollback",
    "tc-compare": "onCompare",
    "tc-finding-open": "onOpenFinding"
   }
  }
