 "functions": [],
 "react": [
  {
   "component": "MessageActions",
   "exported": true,
   "props": [
    {
     "name": "onVersionChange",
     "type": "(index: number) => void",
     "optional": true,
     "description": "Called with the version index picked in the switcher"
    },
    {
     "name": "onCopy",
     "type": "(text?: string) => void",
     "optional": true,
     "description": "Called once `text` is on the clipboard (or right away when there's no `text`). \"Copied\" shows only after a successful write"
    },
    {
     "name": "onSpeak",
     "type": "(playing: boolean) => void",
     "optional": true,
     "description": "Called with true when Read aloud starts and false when it stops – play your audio here. Without it (and without\n`speaking`) the browser's speech synthesis reads `text`"
    }
   ],
   "hides": [
    "ownSpeech"
   ],
   "events": {
    "tc-version-change": "onVersionChange",
    "tc-copy": "onCopy",
    "tc-speak": "onSpeak"
   }
  },
  {
   "component": "MessageText",
   "exported": true,
   "props": [
    {
     "name": "version",
     "type": "string | number",
     "optional": false,
     "description": "Which version is shown – a change crossfades to the new children"
    },
    {
     "name": "children",
     "type": "React.ReactNode",
     "optional": false,
     "description": "The message: text or any React content"
    }
   ],
   "hides": [
