{
 "elements": [
  {
   "tag": "tc-agreement-tracker",
   "className": "TcAgreementTracker",
   "description": "How often the AI agreed with the person's framing versus pushed back, this session: the record, the rate and the\nrun, amber at a run of agreements, with \"Show the other side\".",
   "properties": [
    {
     "name": "turns",
     "attribute": null,
     "type": "AgreementTurn[]",
     "default": "[]",
     "description": "The session's answers in order, oldest first, each classified by the app",
     "readonly": false
    },
    {
     "name": "threshold",
     "attribute": "threshold",
     "type": "number",
     "default": "2",
     "description": "How many agreements in a row turn the tracker amber",
     "readonly": false
    },
    {
     "name": "layout",
     "attribute": "layout",
     "type": "AgreementLayout",
     "default": "\"card\"",
     "description": "\"card\" – a small card; \"inline\" – one compact strip for a chat",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Agreement\"",
     "description": "The heading, and the tracker's accessible name",
     "readonly": false
    },
    {
     "name": "scope",
     "attribute": "scope",
     "type": "string",
     "default": "\"This session\"",
     "description": "A quiet line under the heading (card only)",
     "readonly": false
    },
    {
     "name": "stanceLabels",
     "attribute": null,
     "type": "Partial<Record<AgreementStance, string>>",
     "default": "{}",
     "description": "Names of the three stances – \"Agreed\", \"Pushed back\" and \"Neutral\" by default",
     "readonly": false
    },
    {
     "name": "max",
     "attribute": "max",
     "type": "number | undefined",
     "default": "undefined",
     "description": "How many of the latest turns the record shows – 24 in a card and 8 inline by default; earlier ones are counted",
     "readonly": false
    },
    {
     "name": "counterLabel",
     "attribute": "counter-label",
     "type": "string",
     "default": "\"Show the other side\"",
     "description": "The label of the button that asks for the counter-argument",
     "readonly": false
    },
    {
     "name": "warningText",
     "attribute": "warning-text",
     "type": "string",
     "default": "\"The last {n} answers agreed with you. The strongest case against may show what agreement hides.\"",
     "description": "The warning at the threshold; {n} is replaced by the length of the run",
     "readonly": false
    },
    {
     "name": "stats",
     "attribute": null,
     "type": "AgreementStats",
     "default": null,
     "description": "The counts, the rate and the current run",
     "readonly": true
    },
    {
     "name": "warned",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "Whether the run of agreements has reached the threshold",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-counter-request",
     "detail": "",
     "description": "\"Show the other side\" was pressed; detail `{ run, turnId }`: AgreementCounterRequest – the run's length and its last turn.",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
