     "readonly": false
    },
    {
     "name": "steps",
     "attribute": null,
     "type": "StatusTrackerStep[]",
     "default": "[]",
     "description": "The steps, in order",
     "readonly": false
    },
    {
     "name": "statuses",
     "attribute": null,
     "type": "Record<string, StatusTrackerStatus>",
     "default": "{}",
     "description": "Statuses by key, merged over the defaults (cleared, pending, blocked, not-reached)",
     "readonly": false
    },
    {
     "name": "noun",
     "attribute": "noun",
     "type": "string",
     "default": "\"Step\"",
     "description": "What a step is called: \"Gate\" shows \"GATE 3\" over each name; empty hides it",
     "readonly": false
