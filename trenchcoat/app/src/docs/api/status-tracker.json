 "elements": [
  {
   "tag": "tc-status-tracker",
   "className": "TcStatusTracker",
   "description": "A status tracker – a fixed sequence of steps on a line, each cleared, pending, blocked or not reached, with the line\nfilling as steps clear, the current step marked, a legend, and a step's record on click or Enter.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Status\"",
     "description": "The heading, and the list's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The line under the heading; by default the count cleared, e.g. \"4 of 9 gates cleared\"",
     "readonly": false
    },
    {
     "name": "hint",
     "attribute": "hint",
     "type": "string | undefined",
     "default": "undefined",
