    {
     "name": "nounPlural",
     "attribute": "noun-plural",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The noun's plural, for the count; by default the noun with an \"s\"",
     "readonly": false
    },
    {
     "name": "orientation",
     "attribute": "orientation",
     "type": "\"horizontal\" | \"vertical\"",
     "default": "\"horizontal\"",
