 "functions": [
  {
   "name": "multimodalKind",
   "signature": "multimodalKind(file: { name: string; type?: string }): MultimodalKind",
   "description": "What kind of attachment a file is: from its MIME type, else its extension"
  },
  {
   "name": "formatBytes",
   "signature": "formatBytes(bytes: number): void",
   "description": "\"840 KB\", \"2.4 MB\" – number and unit joined by a no-break space"
  }
