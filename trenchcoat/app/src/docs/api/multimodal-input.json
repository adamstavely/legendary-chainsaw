{
 "elements": [
  {
   "tag": "tc-multimodal-input",
   "className": "TcMultimodalInput",
   "description": "A message box that takes images, audio, video and documents: upload state and progress, previews, format and size\nchecks, and the app's token estimates per attachment and in total.",
   "properties": [
    {
     "name": "value",
     "attribute": null,
     "type": "MultimodalAttachment[]",
     "default": "[]",
     "description": "The attachments. Changed by the user unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "text",
     "attribute": "text",
     "type": "string",
     "default": "\"\"",
     "description": "The message. Changed by the user unless a tc-text-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "placeholder",
     "attribute": "placeholder",
     "type": "string",
     "default": "\"Write a message, or drop files here\"",
     "description": "The message's placeholder",
     "readonly": false
    },
    {
     "name": "label",
     "attribute": "label",
     "type": "string",
     "default": "\"Message\"",
     "description": "Names the message box for screen readers",
     "readonly": false
    },
    {
     "name": "accept",
     "attribute": null,
     "type": "string[] | undefined",
     "default": "undefined",
     "description": "What it accepts: extensions (\".pdf\"), MIME types (\"image/png\") or families (\"audio/*\"); unset accepts any file",
     "readonly": false
    },
    {
     "name": "maxSize",
     "attribute": "max-size",
     "type": "",
     "default": null,
     "description": "The largest file, in bytes, for any kind without its own limit",
     "readonly": false
    },
    {
     "name": "limits",
     "attribute": null,
     "type": "Partial<Record<MultimodalKind, number>>",
     "default": "{}",
     "description": "The largest file per kind, in bytes – { video: 200 * 1024 * 1024 }",
     "readonly": false
    },
    {
     "name": "maxFiles",
     "attribute": "max-files",
     "type": "number",
     "default": "10",
     "description": "How many attachments fit",
     "readonly": false
    },
    {
     "name": "budget",
     "attribute": "budget",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The token budget for the attachments; over it, Send waits. Unset shows the total alone",
     "readonly": false
    },
    {
     "name": "sendLabel",
     "attribute": "send-label",
     "type": "string",
     "default": "\"Send\"",
     "description": "The Send button's name",
     "readonly": false
    },
    {
     "name": "disabled",
     "attribute": "disabled",
     "type": "boolean",
     "default": "false",
     "description": "Turns the box off",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "The attachments changed ({ value, change }: MultimodalValueChange – change is { type: \"add\", files } with each new File, { type: \"remove\", attachment } or { type: \"clear\" } after a send); cancelable – prevent it to control `value`",
     "cancelable": true
    },
    {
     "name": "tc-text-change",
     "detail": "",
     "description": "The message was edited ({ text }: MultimodalTextChange); cancelable – prevent it to control `text`",
     "cancelable": true
    },
    {
     "name": "tc-send",
     "detail": "",
     "description": "Send was pressed, or Enter in the message ({ text, attachments }: MultimodalSend); cancelable – prevented, the box keeps its text and attachments",
     "cancelable": true
    },
    {
     "name": "tc-retry",
     "detail": "",
     "description": "Retry was pressed on an attachment that failed ({ attachment, file }: MultimodalRetry – `file` when it was added here)",
     "cancelable": false
    },
    {
     "name": "tc-reject",
     "detail": "",
     "description": "Files were turned away ({ rejections }: MultimodalReject)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "addFiles",
     "params": "files: Iterable<File>",
     "returns": "void",
     "description": "Adds files as if they were dropped: checks each, turns away what doesn't fit, and fires tc-value-change for the rest"
    }
   ],
   "ui": "mmi",
