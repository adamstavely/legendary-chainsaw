{
 "elements": [
  {
   "tag": "tc-failure-clusters",
   "className": "TcFailureClusters",
   "description": "Failing chats grouped by topic, biggest first – a size bar, count and share, trend in words and the criteria each\nfails; open a cluster for its summary, quotes, Open chats, Add to dataset and Mark as known.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Failure clusters\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading – the agent and the period",
     "readonly": false
    },
    {
     "name": "clusters",
     "attribute": null,
     "type": "FailureCluster[]",
     "default": "[]",
     "description": "The clusters, in any order – shown biggest first, known ones last",
     "readonly": false
    },
    {
     "name": "total",
     "attribute": "total",
     "type": "number | undefined",
     "default": "undefined",
     "description": "All failing chats in the period; by default the clusters' counts added up",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": "open",
     "type": "string | null",
     "default": "null",
     "description": "The open cluster's id. Changed by the user unless a tc-open-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "known",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The clusters marked as known (ids). Changed by the user unless a tc-known-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "criterion",
     "attribute": "criterion",
     "type": "string | null",
     "default": "null",
     "description": "Only clusters failing this criterion; null for all. Changed by the user unless a tc-criterion-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "view",
     "attribute": "view",
     "type": "FailureClustersView",
     "default": "\"list\"",
     "description": "\"list\" or \"bubbles\". Changed by the user unless a tc-view-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "hideView",
     "attribute": "hide-view",
     "type": "boolean",
     "default": "false",
     "description": "Hides the List / Bubbles switch",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<FailureClustersLabels>",
     "default": "{}",
     "description": "The words used, merged over the defaults",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for numbers, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-open-change",
     "detail": "",
     "description": "A cluster was opened or closed ({ open }: FailureClusterOpenChange); cancelable – prevented, `open` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-known-change",
     "detail": "",
     "description": "Mark as known or Mark as new ({ known, id, isKnown }: FailureClusterKnownChange); cancelable – prevented, `known` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-criterion-change",
     "detail": "",
     "description": "The criterion filter changed ({ criterion }: FailureClusterCriterionChange); cancelable – prevented, `criterion` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-view-change",
     "detail": "",
     "description": "List or Bubbles was chosen ({ view }: FailureClusterViewChange); cancelable – prevented, `view` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-cluster-open",
     "detail": "",
     "description": "Open chats was pressed ({ id, cluster }: FailureClusterAction)",
     "cancelable": false
    },
    {
     "name": "tc-add-to-dataset",
     "detail": "",
     "description": "Add to dataset was pressed ({ id, cluster }: FailureClusterAction); cancelable – prevented, the cluster isn't marked as added",
     "cancelable": true
    }
