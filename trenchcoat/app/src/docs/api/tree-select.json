     "name": "value",
     "attribute": null,
     "type": "TreeSelectValue",
     "default": "null",
     "description": "The picked id (or ids, with `multiple`); null for nothing. Changed by the user unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "multiple",
     "attribute": "multiple",
     "type": "boolean",
     "default": "false",
     "description": "Pick many: every row gets a checkbox",
     "readonly": false
    },
    {
     "name": "cascade",
     "attribute": "cascade",
     "type": "boolean",
     "default": "true",
     "description": "With `multiple`, checking a parent checks everything enabled beneath it; set cascade=\"false\" to check rows on their own",
     "readonly": false
