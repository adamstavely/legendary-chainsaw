{
 "elements": [
  {
   "tag": "tc-tree-select",
   "className": "TcTreeSelect",
   "description": "Pick one or many options from a nested hierarchy, with type-to-filter and parent checkboxes.",
   "properties": [
    {
     "name": "options",
     "attribute": null,
     "type": "TreeOption[]",
     "default": "[]",
     "description": "The hierarchy",
     "readonly": false
    },
