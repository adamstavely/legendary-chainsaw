     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "string[] | undefined",
     "default": "undefined",
     "description": "A label per value, e.g. dates – read in the tooltip and announcements",
     "readonly": false
    },
    {
     "name": "type",
     "attribute": "type",
     "type": "SparklineType",
     "default": "\"line\"",
