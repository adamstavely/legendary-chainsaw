{
 "elements": [
  {
   "tag": "tc-thread-header",
   "className": "TcThreadHeader",
   "description": "The bar at the top of a chat thread – the title renamed in place, model and project chips, Share, side-panel toggles and a menu.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The thread's title. Changed by renaming unless a tc-title-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "level",
     "attribute": "level",
     "type": "number",
     "default": "2",
     "description": "The heading level of the title, 1–6",
     "readonly": false
    },
    {
     "name": "model",
     "attribute": "model",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The model's name, as a chip",
     "readonly": false
    },
    {
     "name": "project",
     "attribute": "project",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The project the thread belongs to, as a chip",
     "readonly": false
    },
    {
     "name": "toggles",
     "attribute": null,
     "type": "ThreadHeaderToggle[]",
     "default": "[]",
     "description": "A toggle button for each side panel",
     "readonly": false
    },
    {
     "name": "panels",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The ids of the open panels. Changed by the toggles unless a tc-panels-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "actions",
     "attribute": null,
     "type": "ThreadHeaderAction[]",
     "default": "[ { id: \"export\", label: \"Export\" }, { id: \"archive\", label: \"Archive\" }, { id: \"delete\", label: \"Delete\", danger: true }, ]",
     "description": "The menu's actions",
     "readonly": false
    },
    {
     "name": "hideShare",
     "attribute": "hide-share",
     "type": "boolean",
     "default": "false",
     "description": "Hides Share",
     "readonly": false
    },
    {
     "name": "noRename",
     "attribute": "no-rename",
     "type": "boolean",
     "default": "false",
     "description": "Turns renaming off: the title is plain text",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<ThreadHeaderLabels>",
     "default": "{}",
     "description": "Rename any of the words, over the defaults",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-title-change",
     "detail": "",
     "description": "The title was renamed ({ title, previous }: ThreadHeaderTitleChange); cancelable – prevented, `heading` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-panels-change",
     "detail": "",
     "description": "A panel toggle was pressed ({ panels, id, open }: ThreadHeaderPanelsChange); cancelable – prevented, `panels` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-share",
     "detail": "",
     "description": "Share was pressed (detail: {})",
     "cancelable": false
    },
    {
     "name": "tc-action",
     "detail": "",
     "description": "A menu action was picked ({ action }: ThreadHeaderActionEvent)",
     "cancelable": false
    }
   ],
