{
 "elements": [
  {
   "tag": "tc-agent-steering",
   "className": "TcAgentSteering",
   "description": "Steer an agent while it works: the run, its plan, the queued notes and a field to add one.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "What the agent is working on, e.g. \"Migrate users table\"",
     "readonly": false
    },
    {
     "name": "agent",
     "attribute": "agent",
     "type": "string",
     "default": "\"\"",
     "description": "Name of the agent or model, e.g. \"Opus 5.5\"",
     "readonly": false
    },
    {
     "name": "steps",
     "attribute": null,
     "type": "SteerStep[]",
     "default": "[]",
     "description": "The plan: done steps, the active one and the steps still to come, in order",
     "readonly": false
    },
    {
     "name": "queue",
     "attribute": null,
     "type": "SteerNote[]",
     "default": "[]",
     "description": "Notes waiting for the next step, oldest first",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "SteerRunStatus",
     "default": "\"running\"",
     "description": "Where the run is: \"running\", \"paused\" or \"done\" – done disables the field",
     "readonly": false
    },
    {
     "name": "startedAt",
     "attribute": null,
     "type": "number | Date | undefined",
     "default": "undefined",
     "description": "When the run started (epoch ms or a Date) – the clock in the header ticks from here",
     "readonly": false
    },
    {
     "name": "draft",
     "attribute": "draft",
     "type": "string",
     "default": "\"\"",
     "description": "The text in the field",
     "readonly": false
    },
    {
     "name": "placeholder",
     "attribute": "placeholder",
     "type": "string",
     "default": "\"Steer the agent…\"",
     "description": "Placeholder of the field while the run is open",
     "readonly": false
    },
    {
     "name": "onQueue",
     "attribute": null,
     "type": "SteerSend | undefined",
     "default": "undefined",
     "description": "↵ in the field: queue this note for the next step. May return a promise (see SteerSend)",
     "readonly": false
    },
    {
     "name": "onInterrupt",
     "attribute": null,
     "type": "SteerSend | undefined",
     "default": "undefined",
     "description": "⌘↵ in the field, or \"Now\" on a queued note (then with its id): apply it to the active step right away. Unset\nhides \"Now\" and the hint",
     "readonly": false
    },
    {
     "name": "removable",
     "attribute": "removable",
     "type": "boolean",
     "default": "false",
     "description": "Shows ✕ on the queued notes (tc-remove)",
     "readonly": false
    },
    {
     "name": "pausable",
     "attribute": "pausable",
     "type": "boolean",
     "default": "false",
     "description": "Shows Pause in the header while running (tc-pause)",
     "readonly": false
    },
    {
     "name": "resumable",
     "attribute": "resumable",
     "type": "boolean",
     "default": "false",
     "description": "Shows Resume in the header while paused (tc-resume)",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-draft-change",
     "detail": "",
     "description": "The text in the field changed; detail `{ draft: string }`. Cancelable: preventDefault() keeps `draft` as it is (controlled use)",
     "cancelable": true
    },
    {
     "name": "tc-remove",
