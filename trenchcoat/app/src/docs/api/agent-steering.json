 "react": [
  {
   "component": "AgentSteering",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": false,
     "description": "What the agent is working on, e.g. \"Migrate users table\""
    },
    {
     "name": "onInterrupt",
     "type": "(text: string, queuedId?: string) => void | Promise<unknown>",
     "optional": true,
     "description": "⌘↵ in the field, or \"Now\" on a queued note (then with its id): apply it to the active step right away. May\nreturn a promise, like onQueue"
    },
    {
     "name": "draft",
     "type": "string",
     "optional": true,
     "description": "The text in the field. Controlled when defined – pair with onDraftChange; otherwise the component keeps it,\nstarting from `defaultDraft`"
    },
    {
     "name": "defaultDraft",
     "type": "string",
     "optional": true,
     "description": "The text in the field at first when uncontrolled"
    },
    {
     "name": "onDraftChange",
     "type": "(text: string) => void",
     "optional": true,
     "description": "Called with the field's new text as it changes"
    },
    {
     "name": "onRemove",
     "type": "(id: string) => void",
     "optional": true,
     "description": "✕ on a queued note"
    },
    {
     "name": "onPause",
     "type": "() => void",
     "optional": true,
     "description": "Called by Pause in the header while the run is running; passing it shows the button"
    },
    {
     "name": "onResume",
     "type": "() => void",
     "optional": true,
     "description": "Called by Resume in the header while the run is paused; passing it shows the button"
    }
