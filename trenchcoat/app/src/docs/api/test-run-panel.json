 "functions": [],
 "react": [
  {
   "component": "TestRunPanel",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading – defaults to \"Test\""
    },
    {
     "name": "turns",
     "type": "TestRunTurn[]",
     "optional": true,
     "description": "The conversation. Controlled when defined; otherwise kept by the component from `defaultTurns`, and Reset clears it"
    },
    {
     "name": "defaultTurns",
     "type": "TestRunTurn[]",
     "optional": true,
     "description": "On mount, when `turns` isn't controlled"
    },
    {
     "name": "onTurnsChange",
     "type": "(turns: TestRunTurn[]) => void",
     "optional": true,
     "description": "Called when Reset clears the conversation"
    },
    {
     "name": "variables",
     "type": "TestRunVariable[]",
     "optional": true,
     "description": "Test inputs sent with every message. Controlled when defined"
    },
    {
     "name": "defaultVariables",
     "type": "TestRunVariable[]",
     "optional": true,
     "description": "On mount, when `variables` isn't controlled"
    },
    {
     "name": "onVariablesChange",
     "type": "(variables: TestRunVariable[]) => void",
     "optional": true,
     "description": "Called with the next `variables`"
    },
    {
     "name": "onSend",
     "type": "(text: string, variables: TestRunVariable[]) => void | boolean",
     "optional": true,
     "description": "Called with the message and the variables when Send is pressed. Return false to keep the text in the field"
    },
    {
     "name": "onSaveCase",
     "type": "(saved: TestRunSaveCase) => void | boolean",
     "optional": true,
     "description": "Called when a reply is saved as a test case. Return false to leave it unsaved"
    }
   ],
   "hides": [
    "heading",
    "turns",
    "variables"
   ],
   "events": {
    "tc-send": "onSend",
    "tc-turns-change": null,
    "tc-variables-change": null,
    "tc-save-case": "onSaveCase"
   }
  }
 ],
