{
 "elements": [
  {
   "tag": "tc-test-run-panel",
   "className": "TcTestRunPanel",
   "description": "Try an agent while editing it: a test conversation with its tool calls, test variables, Reset, and Save as test case.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Test\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "agent",
     "attribute": "agent",
     "type": "string",
     "default": "\"\"",
     "description": "The agent's name, shown under the heading",
     "readonly": false
    },
    {
     "name": "target",
     "attribute": "target",
     "type": "TestRunTarget",
     "default": "\"draft\"",
     "description": "Which version answers: the draft being edited, or the live one",
     "readonly": false
    },
    {
     "name": "version",
     "attribute": "version",
     "type": "string",
     "default": "\"\"",
     "description": "The version's label – \"v14\" – shown in the badge",
     "readonly": false
    },
    {
     "name": "turns",
     "attribute": null,
     "type": "TestRunTurn[]",
     "default": "[]",
     "description": "The conversation so far, oldest first. The page appends to it",
     "readonly": false
    },
    {
     "name": "variables",
     "attribute": null,
     "type": "TestRunVariable[]",
     "default": "[]",
     "description": "Test inputs sent with every message. Changed by the user unless a tc-variables-change listener prevents it",
     "readonly": false
    },
    {
     "name": "saved",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "Ids of the replies already saved as test cases",
     "readonly": false
    },
    {
     "name": "streaming",
     "attribute": "streaming",
     "type": "boolean",
     "default": "false",
     "description": "The agent is answering: the log is busy and Send waits",
     "readonly": false
    },
    {
     "name": "hideVariables",
     "attribute": "hide-variables",
     "type": "boolean",
     "default": "false",
     "description": "Hides the Variables strip",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<TestRunPanelLabels>",
     "default": "{}",
     "description": "Words the page can rename, merged over defaultTestRunPanelLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-send",
     "detail": "",
     "description": "Send was pressed with text ({ text, variables }: TestRunSend); cancelable – prevented, the text stays in the field",
     "cancelable": true
    },
    {
     "name": "tc-turns-change",
     "detail": "",
     "description": "Reset cleared the conversation ({ turns }: TestRunTurnsChange); cancelable – prevented, the turns stay",
     "cancelable": true
    },
    {
     "name": "tc-variables-change",
     "detail": "",
     "description": "A variable was added, edited or removed ({ variables }: TestRunVariablesChange); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-save-case",
     "detail": "",
     "description": "\"Save as test case\" on a reply ({ turn, input, variables }: TestRunSaveCase); cancelable – prevented, the reply isn't marked saved",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
