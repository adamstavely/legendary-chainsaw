 "functions": [],
 "react": [
  {
   "component": "AgentLedger",
   "exported": true,
   "props": [
    {
     "name": "entries",
     "type": "LedgerEntry[]",
     "optional": false,
     "description": "The changes the agent made, in any order – listed newest first; `icon` may be a React node"
    },
    {
     "name": "now",
     "type": "number",
     "optional": true,
     "description": "The clock for \"2m ago\", in epoch ms – defaults to an internal clock"
    },
    {
     "name": "undone",
     "type": "string[]",
     "optional": true,
     "description": "Ids of undone changes. Controlled when defined; otherwise the component keeps them, starting from `defaultUndone`"
    },
    {
     "name": "defaultUndone",
     "type": "string[]",
     "optional": true,
     "description": "Ids undone at first when uncontrolled"
    },
    {
     "name": "onUndoneChange",
     "type": "(ids: string[]) => void",
     "optional": true,
     "description": "Every change to the undone ids, as the whole new list"
    },
    {
     "name": "onUndo",
     "type": "(ids: string[]) => void | Promise<unknown>",
     "optional": true,
     "description": "Undo sends the change and its reversible dependents, Redo the same set back – plus any undone changes that set\nbuilds on. Either may return a promise: the rows show the result at once and wait; if it rejects they go back\nand the bar says so"
    },
    {
     "name": "onRedo",
     "type": "(ids: string[]) => void | Promise<unknown>",
     "optional": true,
     "description": "Called with the ids a Redo brings back; a returned promise holds the rows until it settles, a rejection reverts them"
    },
    {
     "name": "pointAt",
     "type": "string | null",
     "optional": true,
     "description": "Lights up a change and what builds on it, as if its Undo were pointed at – e.g. for a walkthrough"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the list's name – \"Ledger\" by default"
    }
   ],
   "hides": [
    "heading",
    "entries",
    "undone",
    "now",
    "pointAt",
    "onUndo",
    "onRedo"
   ],
   "events": {
    "tc-undone-change": "onUndoneChange"
   }
  }
 ],
