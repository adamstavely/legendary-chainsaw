{
 "elements": [
  {
   "tag": "tc-map-itinerary",
   "className": "TcMapItinerary",
   "description": "A trip planned day by day – the days as tabs, each day's stops in order with times and travel, and the stops on a\nmap drawn from their coordinates, the chosen day's route standing out.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Itinerary\"",
     "description": "The heading, and the map's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "days",
     "attribute": null,
     "type": "ItineraryDay[]",
     "default": "[]",
     "description": "The days, in order, each with its stops in order",
     "readonly": false
    },
    {
     "name": "day",
     "attribute": "day",
     "type": "string | null",
     "default": "null",
     "description": "The chosen day's id; by default the first. Changed by the user unless a tc-day-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "stop",
     "attribute": "stop",
     "type": "string | null",
     "default": "null",
     "description": "The picked stop's id. Changed by the user unless a tc-stop-select listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "fit",
     "attribute": "fit",
     "type": "\"day\" | \"all\"",
     "default": "\"day\"",
     "description": "What the map fits: the chosen \"day\", or \"all\" days",
     "readonly": false
    },
    {
     "name": "kinds",
     "attribute": null,
     "type": "Record<string, { label: string; icon?: ItineraryKindIcon }>",
     "default": "{}",
     "description": "Kinds' names and icons, merged over the defaults (sight, food, stay, transport, venue, other)",
     "readonly": false
    },
