{
 "elements": [
  {
   "tag": "tc-run-inspector",
   "className": "TcRunInspector",
   "description": "One multi-agent run on one screen – its numbers, who started whom as agent cards, each agent's calls as small bars,\nand any call opened right under its row.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Run inspector\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "root",
     "attribute": null,
     "type": "TraceSpan",
     "default": "{ id: \"run\", name: \"Run\", kind: \"agent\", status: \"done\", start: 0, end: 0 }",
     "description": "The run as a span tree: agents and sub-agents are cards, their llm and tool children are calls",
     "readonly": false
    },
    {
     "name": "elapsed",
     "attribute": "elapsed",
     "type": "number | undefined",
     "default": "undefined",
     "description": "For a live run, ms since it started – running spans reach it. The block reads no clock of its own",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "Id of the open call. Changed by the user unless a tc-selected-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "callLimit",
     "attribute": "call-limit",
     "type": "number",
     "default": "6",
     "description": "How many calls each card shows before \"Show N more\"",
     "readonly": false
    },
    {
     "name": "formatCost",
     "attribute": null,
     "type": "(amount: number) => string",
     "default": "dollars",
     "description": "Formats every cost – dollars by default, e.g. \"$0.42\"",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<RunInspectorLabels>",
     "default": "{}",
     "description": "Rename any of the words",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A call was opened or closed ({ selected, span }: RunInspectorSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
