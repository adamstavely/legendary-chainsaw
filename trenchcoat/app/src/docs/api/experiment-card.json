{
 "elements": [
  {
   "tag": "tc-experiment-card",
   "className": "TcExperimentCard",
   "description": "An A/B test that unfolds into the full comparison; pick a winner and run an action on it.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The test's name",
     "readonly": false
    },
    {
     "name": "variants",
     "attribute": null,
     "type": "ExperimentVariant[]",
     "default": "[]",
     "description": "The variants under test, the control first (or marked `control`) – one row and one chart column each",
     "readonly": false
    },
    {
     "name": "metrics",
     "attribute": null,
     "type": "ExperimentMetric[]",
     "default": "[]",
     "description": "The metrics to compare on; with more than one, a switch picks which one the card shows",
     "readonly": false
    },
    {
     "name": "metric",
     "attribute": "metric",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The metric id shown; unset shows the first metric",
     "readonly": false
    },
    {
     "name": "winner",
     "attribute": "winner",
     "type": "string | null",
     "default": "null",
     "description": "The id of the variant picked as the winner, or null",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": null,
     "type": "ExperimentStatus | undefined",
     "default": "undefined",
     "description": "The tag under the title, e.g. { label: \"Running\", tone: \"green\" }",
     "readonly": false
    },
    {
     "name": "note",
     "attribute": "note",
     "type": "string",
     "default": "\"\"",
     "description": "Short text next to the status, e.g. \"Day 9 of 14\"",
     "readonly": false
    },
    {
     "name": "action",
     "attribute": null,
     "type": "ExperimentAction | undefined",
     "default": "undefined",
     "description": "The button that appears on the tray once a winner is picked",
     "readonly": false
    },
    {
     "name": "hint",
     "attribute": "hint",
     "type": "string | Element | undefined",
     "default": "undefined",
     "description": "Replaces the line on the tray while nothing is hovered or picked: text, or an element (cloned)",
     "readonly": false
    },
    {
     "name": "trigger",
     "attribute": "trigger",
     "type": "\"hover\" | \"click\"",
     "default": "\"hover\"",
     "description": "\"hover\" opens under the pointer (taps and the keyboard still toggle), \"click\" only on click",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": "open",
     "type": "boolean",
     "default": "false",
     "description": "Whether the card is unfolded, showing the metric switch, the variants and the tray",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-open-change",
     "detail": "",
     "description": "The card opens or closes; detail `{ open: boolean }`. Cancelable.",
     "cancelable": true
    },
    {
     "name": "tc-metric-change",
     "detail": "",
     "description": "Another metric was picked; detail `{ metric: string }`. Cancelable.",
     "cancelable": true
    },
    {
     "name": "tc-winner-change",
     "detail": "",
     "description": "A variant was picked as the winner, or the pick cleared; detail `{ winner: string | null }`. Cancelable.",
     "cancelable": true
    }
