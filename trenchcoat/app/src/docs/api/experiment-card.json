 "react": [
  {
   "component": "ExperimentCard",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": false,
     "description": "The test's name"
    },
    {
     "name": "variants",
     "type": "ExperimentVariant[]",
     "optional": false,
     "description": "The variants under test, the control first (or marked `control`) – one row and one chart column each"
    },
    {
     "name": "metrics",
     "type": "ExperimentMetric[]",
     "optional": false,
     "description": "The metrics to compare on; with more than one, a switch picks which one the card shows"
    },
    {
     "name": "metric",
     "type": "string",
     "optional": true,
     "description": "Controlled metric id"
    },
    {
     "name": "defaultMetric",
     "type": "string",
     "optional": true,
     "description": "Starting metric id when `metric` isn't controlled – defaults to the first metric"
    },
    {
     "name": "onMetricChange",
     "type": "(id: string) => void",
     "optional": true,
     "description": "Called with the id of the metric picked"
    },
    {
     "name": "winner",
     "type": "string | null",
     "optional": true,
     "description": "Controlled id of the variant picked as the winner"
    },
    {
     "name": "defaultWinner",
     "type": "string | null",
     "optional": true,
     "description": "Starting winner when `winner` isn't controlled – defaults to none"
    },
    {
     "name": "onWinnerChange",
     "type": "(id: string | null) => void",
     "optional": true,
     "description": "Called with the id of the variant picked as the winner, or null when the pick is cleared"
    },
    {
     "name": "status",
     "type": "{ label: string; tone?: ExperimentTone }",
     "optional": true,
     "description": "The tag under the title, e.g. { label: \"Running\", tone: \"green\" }"
    },
    {
     "name": "note",
     "type": "string",
     "optional": true,
     "description": "Short text next to the status, e.g. \"Day 9 of 14\""
    },
    {
     "name": "action",
     "type": "{ label: string | ((variant: ExperimentVariant) => string); onClick: (variant: ExperimentVariant) => void | Promise<unknown> }",
     "optional": true,
     "description": "The button that appears on the tray (Clean: in the last row) once a winner is picked. `label` gets the picked\nvariant. `onClick` may return a promise: the button waits while it runs, and a rejection says so on the tray and\nlets you try again"
    },
    {
     "name": "hint",
     "type": "React.ReactNode",
     "optional": true,
     "description": "Replaces the line on the tray (Clean: in the last row) while nothing is hovered or picked"
    },
    {
     "name": "trigger",
     "type": "\"hover\" | \"click\"",
     "optional": true,
     "description": "\"hover\" opens under the pointer (taps and the keyboard still toggle), \"click\" only on click"
    },
    {
     "name": "open",
     "type": "boolean",
     "optional": true,
     "description": "Controlled open state"
    },
    {
     "name": "defaultOpen",
     "type": "boolean",
     "optional": true,
     "description": "Whether the card starts unfolded when `open` isn't controlled"
    },
    {
     "name": "onOpenChange",
     "type": "(open: boolean) => void",
     "optional": true,
     "description": "Called when the card opens or closes"
    }
