 "functions": [
  {
   "name": "defaultBranchSwitcherLabels",
   "signature": "defaultBranchSwitcherLabels: BranchSwitcherLabels",
   "description": "The words used when the page gives none. `create` takes {name} and {base}; `ahead` and `behind` take {count};\n`aheadOf` joins them to the base as {counts} and {base}"
  },
  {
   "name": "toBranchName",
   "signature": "toBranchName(text: string): void",
   "description": "A typed name as a branch name git accepts (`git check-ref-format --branch`): spaces become dashes, and what git refuses is dropped"
  }
 ],
