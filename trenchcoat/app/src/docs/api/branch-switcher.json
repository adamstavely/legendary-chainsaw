{
 "elements": [
  {
   "tag": "tc-branch-switcher",
   "className": "TcBranchSwitcher",
   "description": "The current branch with ahead and behind counts, and a filterable list of worktrees, local and remote branches to switch to or create from.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Branch\"",
     "description": "The heading; empty draws no header",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "branches",
     "attribute": null,
     "type": "BranchItem[]",
     "default": "[]",
     "description": "Every branch and worktree",
     "readonly": false
    },
    {
     "name": "current",
     "attribute": "current",
     "type": "string",
     "default": "\"\"",
     "description": "The branch in use. Changed by picking one unless a tc-current-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "base",
     "attribute": "base",
     "type": "string",
     "default": "\"main\"",
     "description": "The branch that ahead and behind count against, and new branches start from",
     "readonly": false
    },
    {
     "name": "query",
     "attribute": "query",
     "type": "string",
     "default": "\"\"",
     "description": "What the filter holds. Changed by typing unless a tc-query-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": "open",
     "type": "boolean",
     "default": "false",
     "description": "The list is open. Changed by the trigger, Escape and picking unless a tc-open-change listener prevents opening",
     "readonly": false
    },
    {
     "name": "inline",
     "attribute": "inline",
     "type": "boolean",
     "default": "false",
     "description": "Draws the list in place, without the trigger",
     "readonly": false
    },
    {
     "name": "busy",
     "attribute": "busy",
     "type": "boolean",
     "default": "false",
     "description": "Something is under way: picking and Sync wait",
     "readonly": false
    },
    {
     "name": "syncable",
     "attribute": "syncable",
     "type": "boolean",
     "default": "true",
     "description": "Offers Sync beside the trigger",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<BranchSwitcherLabels>",
     "default": "{}",
     "description": "Rename any of the words, over the defaults",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The time now, epoch ms; by default the element's own clock",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for times, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "bare",
     "attribute": "bare",
     "type": "boolean",
     "default": "false",
     "description": "Drops the tray and card",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-current-change",
     "detail": "",
     "description": "A branch was picked ({ current, branch }: BranchCurrentChange); cancelable – prevented, `current` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-query-change",
     "detail": "",
     "description": "The filter changed ({ query }: BranchQueryChange); cancelable – prevented, the filter keeps its text",
     "cancelable": true
    },
    {
     "name": "tc-open-change",
     "detail": "",
     "description": "The list opened or closed ({ open }: BranchOpenChange); cancelable when opening – prevented, it stays shut",
     "cancelable": true
    },
    {
     "name": "tc-create",
     "detail": "",
     "description": "Create branch was picked ({ name, from }: BranchCreate)",
     "cancelable": false
    },
    {
     "name": "tc-sync",
     "detail": "",
     "description": "Sync was pressed ({ branch, ahead, behind }: BranchSync)",
     "cancelable": false
    }
   ],
   "slots": [],
