 ],
 "functions": [
  {
   "name": "pluralKind",
   "signature": "pluralKind(kind: string): void",
   "description": "A kind's group heading: \"Document\" → \"Documents\", \"Person\" → \"People\", \"Inbox\" → \"Inboxes\""
  },
  {
   "name": "queryTerms",
   "signature": "queryTerms(query: string): void",
   "description": "The query's words worth picking out: two letters or more, longest first so a longer word wins an overlap"
  }
 ],
 "react": [
  {
   "component": "ResultsList",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the list's name"
    },
    {
     "name": "sort",
     "type": "ResultsSort",
     "optional": true,
     "description": "The order – controlled when given"
    },
    {
     "name": "defaultSort",
     "type": "ResultsSort",
     "optional": true,
     "description": "The order on mount when `sort` isn't controlled"
    },
    {
     "name": "onSortChange",
     "type": "(sort: ResultsSort) => void",
     "optional": true,
     "description": "The order changed"
    },
    {
     "name": "selected",
     "type": "string | null",
     "optional": true,
     "description": "The result in focus – controlled when given"
    },
    {
     "name": "defaultSelected",
     "type": "string | null",
     "optional": true,
     "description": "The result in focus on mount when `selected` isn't controlled"
    },
    {
     "name": "onSelectedChange",
     "type": "(selected: string | null, result?: SearchResult) => void",
     "optional": true,
     "description": "The result in focus changed"
    },
    {
     "name": "onOpenResult",
     "type": "(result: SearchResult, event: CustomEvent<ResultsOpen>) => void",
     "optional": true,
     "description": "A result was opened; `event.preventDefault()` stops a link from following"
    },
    {
     "name": "onSuggestion",
     "type": "(suggestion: string) => void",
     "optional": true,
     "description": "\"Did you mean\" was pressed"
    },
    {
     "name": "onMore",
     "type": "(detail: ResultsMore, event: CustomEvent<ResultsMore>) => void",
     "optional": true,
     "description": "Show more was pressed; `event.preventDefault()` when you add the next results yourself"
    }
   ],
   "hides": [
    "heading",
    "sort",
    "selected",
    "children"
   ],
   "events": {
    "tc-open": "onOpenResult",
    "tc-selected-change": "onSelectedChange",
    "tc-sort-change": null,
    "tc-suggestion": "onSuggestion",
    "tc-more": "onMore"
   }
  }
 ],
 "changelog": [
  "**Search** - **Results List** (`tc-results-list`) – results with the query's words marked in their snippets, grouped by kind with counts, Relevance / Date, “Did you mean” and Show more. - **Facet Sidebar** (`tc-facet-sidebar`) – checkbox, radio, range and date filters with counts, active filters as chips with Clear all. - **Saved Search Alerts** (`tc-saved-search-alerts`) – saved searches that report new matches, with frequency, channels, pause, Run now and remove with Undo."
 ],
