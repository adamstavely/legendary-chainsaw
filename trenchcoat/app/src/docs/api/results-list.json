{
 "elements": [
  {
   "tag": "tc-results-list",
   "className": "TcResultsList",
   "description": "Search results to read and open – kind, title, a snippet with the query's words marked, source and date; grouped by\nkind, sorted by relevance or date, \"Did you mean\", Show more and loading rows.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Results\"",
     "description": "The heading, and the list's name",
     "readonly": false
    },
    {
     "name": "query",
     "attribute": "query",
     "type": "string",
     "default": "\"\"",
     "description": "What was searched for; its words are picked out in titles and snippets",
     "readonly": false
    },
    {
     "name": "results",
     "attribute": null,
     "type": "SearchResult[]",
     "default": "[]",
     "description": "The results, in order of relevance",
     "readonly": false
    },
    {
     "name": "group",
     "attribute": "group",
     "type": "ResultsGroup",
     "default": "\"kind\"",
     "description": "Group results under their kind, or list them as they come",
     "readonly": false
    },
    {
     "name": "suggestion",
     "attribute": "suggestion",
     "type": "string | undefined",
     "default": "undefined",
     "description": "\"Did you mean …\" – a corrected query to offer",
     "readonly": false
    },
    {
     "name": "total",
     "attribute": "total",
     "type": "string | undefined",
     "default": "undefined",
     "description": "How many there are in all, in words (\"About 1,240 results\"); by default the count of `results`",
     "readonly": false
    },
    {
     "name": "sort",
     "attribute": "sort",
     "type": "ResultsSort",
     "default": "\"relevance\"",
     "description": "The order. Changed by the user unless a tc-sort-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "loading",
     "attribute": "loading",
     "type": "boolean",
     "default": "false",
     "description": "Waiting for results: placeholder rows",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The result in focus. Changed by the user unless tc-selected-change is prevented",
     "readonly": false
    },
    {
     "name": "pageSize",
     "attribute": "page-size",
     "type": "number",
     "default": "10",
     "description": "How many show at first, and how many Show more adds",
     "readonly": false
    },
    {
     "name": "hasMore",
     "attribute": "has-more",
     "type": "boolean",
     "default": "false",
     "description": "There are more than `results` holds: Show more stays, for the page to load them (tc-more)",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for dates and numbers, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-open",
     "detail": "",
     "description": "A result was opened ({ id, result }: ResultsOpen); cancelable – prevented, a link doesn't follow",
     "cancelable": true
    },
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "The result in focus changed ({ selected, result }: ResultsSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-sort-change",
     "detail": "",
     "description": "Relevance or Date was picked ({ sort }: ResultsSortChange); cancelable – prevented, `sort` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-suggestion",
     "detail": "",
     "description": "\"Did you mean\" was pressed ({ suggestion }: ResultsSuggestion) – search for it",
     "cancelable": false
    },
    {
     "name": "tc-more",
     "detail": "",
     "description": "Show more was pressed ({ shown, total }: ResultsMore); cancelable – prevented, the page adds the next results itself",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "rsl",
   "cssProperties": [
    {
     "name": "--tc-rsl-snippet-lines",
     "value": "3",
     "looks": [
      "clean"
     ]
    }
   ],
