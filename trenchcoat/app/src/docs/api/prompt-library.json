{
 "elements": [
  {
   "tag": "tc-prompt-library",
   "className": "TcPromptLibrary",
   "description": "Saved prompt templates whose variables are filled in place.",
   "properties": [
    {
     "name": "templates",
     "attribute": null,
     "type": "PromptTemplate[]",
     "default": "[]",
     "description": "The saved templates, in list order – each with a title, an optional category and a body with {variables}",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": "value",
     "type": "string",
     "default": "\"\"",
     "description": "Id of the chosen template – unset or unknown shows the first. Changed by the user unless a tc-value-change\nlistener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "values",
     "attribute": null,
     "type": "PromptValues",
     "default": "{}",
     "description": "The variables typed so far, per template; a missing one shows its template default. Changed by the user unless\na tc-values-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "onUse",
     "attribute": null,
     "type": "PromptUseHandler | undefined",
     "default": "undefined",
     "description": "Called with the finished prompt when Use is pressed (only once every variable is filled). A promise keeps Use\npending until it settles; a rejection says so on the tray and Use can be pressed again",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Prompts\"",
     "description": "The heading over the list, and the group's name",
     "readonly": false
    },
    {
     "name": "useLabel",
     "attribute": "use-label",
     "type": "string",
     "default": "\"Use prompt\"",
     "description": "Label of the use button",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
