 "functions": [],
 "react": [
  {
   "component": "ThinkingState",
   "exported": true,
   "props": [
    {
     "name": "steps",
     "type": "ThinkingStep[]",
     "optional": false,
     "description": "The steps and searches to show, in order; a source's icon may be a React node"
    },
    {
     "name": "onProgressChange",
     "type": "(progress: number) => void",
     "optional": true,
     "description": "Reports each step the timeline reveals"
    },
    {
     "name": "onDone",
     "type": "(seconds: number) => void",
     "optional": true,
     "description": "Called once it's finished – by the timeline or by `done` – with the seconds it worked"
    },
    {
     "name": "open",
     "type": "boolean",
     "optional": true,
     "description": "Whether the steps are unfolded (controlled when defined)"
    },
    {
     "name": "defaultOpen",
     "type": "boolean",
     "optional": true,
     "description": "Whether the steps start unfolded when `open` isn't controlled"
    },
    {
     "name": "onOpenChange",
     "type": "(open: boolean) => void",
     "optional": true,
     "description": "Called when the header is clicked, or a new run unfolds the steps, with the new state"
    }
   ],
   "hides": [
    "steps",
    "open"
   ],
   "events": {
    "tc-progress-change": "onProgressChange",
    "tc-done": "onDone",
    "tc-open-change": "onOpenChange"
   }
  }
 ],
 "changelog": [
  "thinking-state no longer reports `onOpenChange(true)` on mount when `open` is held false; date-range-picker doesn't flash its \"Last 30 days\" stand-in before reading today; memory-panel with `undoFor={Infinity}` keeps a failure message instead of clearing it at once; dropzone keeps focus on a row while another row folds away (the React version lost it in real browsers)."
 ],
