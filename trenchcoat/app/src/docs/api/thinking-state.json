{
 "elements": [
  {
   "tag": "tc-thinking-state",
   "className": "TcThinkingState",
   "description": "The \"working…\" panel of an AI chat: steps and searches appear one by one, then \"Worked for …\".",
   "properties": [
    {
     "name": "steps",
     "attribute": null,
     "type": "ThinkingStep[]",
     "default": "[]",
     "description": "The steps and searches to show, in order – `progress` (or the timeline) decides how many have appeared",
     "readonly": false
    },
    {
     "name": "doneLabel",
     "attribute": "done-label",
     "type": "string",
     "default": "\"Finished thinking\"",
     "description": "Label of the final row",
     "readonly": false
    },
    {
     "name": "stepMs",
     "attribute": "step-ms",
     "type": "number",
     "default": "1300",
     "description": "Pause between two steps, in ms (the timeline that runs when `progress` and `done` are unset)",
     "readonly": false
    },
    {
     "name": "progress",
     "attribute": "progress",
     "type": "number | undefined",
     "default": "undefined",
     "description": "How many steps have appeared; unset, the timeline reveals them",
     "readonly": false
    },
    {
     "name": "done",
     "attribute": null,
     "type": "boolean | undefined",
     "default": "undefined",
     "description": "Finished; unset, the timeline decides (when `progress` is unset too)",
     "readonly": false
    },
    {
     "name": "loop",
     "attribute": "loop",
     "type": "boolean",
     "default": "false",
     "description": "Start over after a pause once finished – only while the timeline runs everything. Stops after a few runs, and\nas soon as the pointer or focus is inside (WCAG 2.2.2)",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": "open",
     "type": "boolean",
     "default": "true",
     "description": "Whether the steps are unfolded",
     "readonly": false
    },
    {
     "name": "startedAt",
     "attribute": "started-at",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When the work started, in epoch ms – the header's timer counts from here. Defaults to when the run started",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-progress-change",
     "detail": "",
     "description": "The timeline revealed a step; detail `{ progress: number }`, how many steps show",
     "cancelable": false
    },
    {
     "name": "tc-done",
     "detail": "",
     "description": "It finished (by the timeline or by `done`); detail `{ seconds: number }`, how long it worked",
     "cancelable": false
    },
    {
     "name": "tc-open-change",
     "detail": "",
     "description": "The header was clicked, or a new run unfolded the steps; detail `{ open: boolean }`. Cancelable: preventDefault() keeps `open` as it is (controlled use)",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "think",
   "cssProperties": [
