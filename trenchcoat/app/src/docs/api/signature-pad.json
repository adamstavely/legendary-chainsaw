{
 "elements": [
  {
   "tag": "tc-signature-pad",
   "className": "TcSignaturePad",
   "description": "A signature field: draw with a mouse, pen or finger, or type the name instead, with undo, clear, the signer, the\ndate and a statement – a form control that exports SVG or an image.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Signature\"",
     "description": "The title above the pad",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the title: what is being signed",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": null,
     "type": "SignatureValue | null",
     "default": "null",
     "description": "The signature: drawn strokes or typed text; null when empty",
     "readonly": false
    },
    {
     "name": "allowTyped",
     "attribute": "allow-typed",
     "type": "boolean",
     "default": "false",
     "description": "Shows the “Type instead” toggle to pointer users; keyboard users can always reach it",
     "readonly": false
    },
    {
     "name": "signer",
     "attribute": "signer",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The signer's name, under the pad – also the suggestion when typing",
     "readonly": false
    },
    {
     "name": "date",
     "attribute": "date",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The date shown beside the name (epoch ms); by default today",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "“Now” for today's date (epoch ms); by default the element's own clock",
     "readonly": false
    },
    {
     "name": "statement",
     "attribute": "statement",
     "type": "string | undefined",
     "default": "undefined",
     "description": "What signing means, under the name: a short legal statement",
     "readonly": false
    },
    {
     "name": "required",
     "attribute": "required",
     "type": "boolean",
     "default": "false",
     "description": "Blocks an empty form submit",
     "readonly": false
    },
    {
     "name": "disabled",
     "attribute": "disabled",
     "type": "boolean",
     "default": "false",
     "description": "No input, the buttons disabled",
     "readonly": false
    },
    {
     "name": "readonly",
     "attribute": "readonly",
     "type": "boolean",
     "default": "false",
     "description": "Shows the signature with no way to change it: no buttons, no drawing",
     "readonly": false
    },
    {
     "name": "invalid",
     "attribute": "invalid",
     "type": "boolean",
     "default": "false",
     "description": "Marks the field as wrong and shows `error-message`",
     "readonly": false
    },
    {
     "name": "errorMessage",
     "attribute": "error-message",
     "type": "string",
     "default": "\"Sign to continue.\"",
     "description": "The message under the pad while `invalid`",
     "readonly": false
    },
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"\"",
     "description": "The form field's name; the value is submitted as JSON",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<SignatureLabels>",
     "default": "{}",
     "description": "Words the page can rename (merged over defaultSignatureLabels)",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for the date, e.g. \"de\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "The signature changed: a stroke ended, undo, clear or typing ({ value }: SignatureValueChange); cancelable – prevented, the value stays as it was",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "undo",
     "params": "",
     "returns": "void",
     "description": "Removes the last stroke"
    },
    {
     "name": "clear",
     "params": "",
     "returns": "void",
     "description": "Empties the pad (and the typed name)"
    },
    {
     "name": "toSVG",
     "params": "",
     "returns": "string | null",
     "description": "The signature as a standalone SVG document (the ink in the current text colour); null when unsigned"
    },
    {
     "name": "toDataURL",
     "params": "type: unknown, quality?: number",
     "returns": "string | null",
     "description": "The signature as an image (PNG unless `type` says otherwise), at the screen's pixel density; null when unsigned"
    }
   ],
   "ui": "sigp",
   "cssProperties": [
