{
 "elements": [
  {
   "tag": "tc-judge-bracket",
   "className": "TcJudgeBracket",
   "description": "An LLM judge picking the best of several attempts as a single-elimination bracket – rounds of matches that fill as\nverdicts stream in, a comparison of any match with the judge's reason and confidence, and the champion to use.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Judge's bracket\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "task",
     "attribute": "task",
     "type": "string",
     "default": "\"\"",
     "description": "What every attempt tried to do – the quiet line under the heading",
     "readonly": false
    },
    {
     "name": "attempts",
     "attribute": null,
     "type": "JudgeAttempt[]",
     "default": "[]",
     "description": "The attempts, 2 to 16, in seeding order – the first ones get the byes",
     "readonly": false
    },
    {
     "name": "verdicts",
     "attribute": null,
     "type": "JudgeMatch[]",
     "default": "[]",
     "description": "The judge's matches so far – one verdict per match – streamed in as they're judged (`matches` is the DOM's)",
     "readonly": false
    },
    {
     "name": "match",
     "attribute": "match",
     "type": "string | null",
     "default": "null",
     "description": "The match whose comparison is open – its key, \"<round>-<match>\" (both from 1) – or null",
     "readonly": false
    },
    {
     "name": "accepted",
     "attribute": "accepted",
     "type": "string | null",
     "default": "null",
     "description": "The id of the attempt in use, once \"Use this answer\" was chosen",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<JudgeBracketLabels>",
     "default": "{}",
     "description": "Words the page can rename, merged over defaultJudgeBracketLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-match-change",
     "detail": "",
     "description": "A match was opened or closed ({ match, item }: JudgeMatchChange); cancelable – prevented, `match` stays as it was",
