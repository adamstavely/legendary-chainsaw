{
 "elements": [
  {
   "tag": "tc-structured-output",
   "className": "TcStructuredOutput",
   "description": "Streaming JSON as a collapsible, typed tree, checked against a JSON Schema as it arrives.",
   "properties": [
    {
     "name": "text",
     "attribute": "text",
     "type": "string",
     "default": "\"\"",
     "description": "The JSON as it arrives – it may grow every frame and stop mid-value. A ```json fence around it is ignored",
     "readonly": false
    },
    {
     "name": "schema",
     "attribute": null,
     "type": "StructuredOutputSchema | undefined",
     "default": "undefined",
     "description": "A JSON Schema to check the value against as it arrives (the common keywords – see the docs); unset checks syntax only",
     "readonly": false
    },
    {
     "name": "streaming",
     "attribute": "streaming",
     "type": "boolean",
     "default": "false",
     "description": "The text is still coming in: a caret blinks at the end, and what hasn't arrived isn't flagged yet",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Output\"",
     "description": "The heading, and the tree's accessible name",
     "readonly": false
    },
    {
     "name": "collapsed",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "JSON Pointer paths of folded branches (\"/items/0\"). Changed by the user unless tc-collapsed-change is prevented",
     "readonly": false
    },
    {
     "name": "variableName",
     "attribute": "variable-name",
     "type": "string",
     "default": "\"output\"",
     "description": "The variable name in \"Copy as TypeScript\": `const output = { … };`",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "0",
     "description": "Cap the tree's height in px (0: grow with the value); a capped tree scrolls and follows the end while streaming",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": null,
     "type": "unknown",
     "default": null,
     "description": "The value parsed so far (fields still arriving are left out); undefined before anything has arrived",
     "readonly": true
    },
    {
     "name": "issues",
     "attribute": null,
     "type": "StructuredOutputIssue[]",
     "default": null,
     "description": "Everything the schema check found so far, in document order",
     "readonly": true
    },
    {
     "name": "syntaxError",
     "attribute": null,
     "type": "StructuredOutputSyntaxError | null",
     "default": null,
     "description": "Where the text stopped being JSON, if it did",
     "readonly": true
    },
    {
     "name": "complete",
     "attribute": null,
     "type": "boolean",
     "default": null,
     "description": "The value has arrived in full: its outermost bracket closed",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-collapsed-change",
     "detail": "",
     "description": "A branch was folded or opened ({ collapsed: string[] } – JSON Pointer paths); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-copy",
     "detail": "",
     "description": "The value was copied ({ format: \"json\" | \"ts\", text: string })",
     "cancelable": false
    },
    {
     "name": "tc-validate",
     "detail": "",
     "description": "The text settled (not streaming) and its result changed ({ valid, value, issues, error, complete })",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "so",
   "cssProperties": [
