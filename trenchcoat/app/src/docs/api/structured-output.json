 "functions": [
  {
   "name": "structuredOutputParse",
   "signature": "structuredOutputParse(text: string, final: unknown): StructuredOutputParse",
   "description": "Parses JSON that may still be arriving, tolerantly, as tc-structured-output does – for elements that render\nstructured answers as they stream (tc-generated-ui). `final` says no more text is coming"
  }
 ],
 "react": [
  {
   "component": "StructuredOutput",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the tree's accessible name"
    },
    {
     "name": "collapsed",
     "type": "string[]",
     "optional": true,
     "description": "JSON Pointer paths of folded branches, e.g. \"/items/0\" (controlled)"
    },
    {
     "name": "defaultCollapsed",
     "type": "string[]",
     "optional": true,
     "description": "Folded branches to start with when uncontrolled"
    },
    {
     "name": "onCollapsedChange",
     "type": "(collapsed: string[]) => void",
     "optional": true,
     "description": "Called with the folded paths each time a branch is folded or opened"
    },
    {
     "name": "onCopy",
     "type": "(format: \"json\" | \"ts\", text: string) => void",
     "optional": true,
     "description": "Called after a copy, with the format (\"json\" or \"ts\") and the text that went to the clipboard"
    },
    {
     "name": "onValidate",
     "type": "(result: StructuredOutputValidate) => void",
     "optional": true,
     "description": "Called once the text settles (not streaming) with the check's result: valid, value, issues, syntax error"
    }
   ],
   "hides": [
    "heading",
    "collapsed",
    "onCopy"
   ],
   "events": {
    "tc-collapsed-change": "onCollapsedChange",
    "tc-copy": "onCopy",
    "tc-validate": "onValidate"
   }
  }
 ],
 "changelog": [
