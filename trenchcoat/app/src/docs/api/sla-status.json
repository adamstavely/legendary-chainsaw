     "default": "\"SLA performance\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "split",
     "attribute": null,
     "type": "SlaSplit",
     "default": "{ met: 0, atRisk: 0, breached: 0 }",
     "description": "The counts for the whole period",
     "readonly": false
    },
    {
     "name": "rows",
     "attribute": null,
     "type": "SlaRow[]",
     "default": "[]",
     "description": "Counts per type of request, each drawn as its own bar",
     "readonly": false
    },
    {
     "name": "trend",
     "attribute": null,
     "type": "number[]",
     "default": "[]",
     "description": "The on-time share per week, oldest first, from 0 to 1",
     "readonly": false
    },
