     "name": "labels",
     "attribute": null,
     "type": "Partial<Record<SlaOutcome, string>>",
     "default": "{}",
     "description": "The outcomes' names, merged over the defaults (Met, At risk, Breached)",
     "readonly": false
    },
    {
     "name": "periods",
     "attribute": null,
     "type": "string[]",
     "default": "[\"7d\", \"30d\", \"90d\"]",
