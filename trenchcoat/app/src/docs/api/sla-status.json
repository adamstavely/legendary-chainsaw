{
 "elements": [
  {
   "tag": "tc-sla-status",
   "className": "TcSlaStatus",
   "description": "Service-level performance – the on-time share, a Met / At risk / Breached split in words and marks, a weekly trend,\nper-type rows and a period chooser.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
