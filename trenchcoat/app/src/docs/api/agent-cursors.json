 "functions": [
  {
   "name": "acceptSuggestion",
   "signature": "acceptSuggestion(blocks: DocBlock[], suggestions: DocSuggestion[], id: string): void",
   "description": "Accepts a suggestion: writes it into the text and moves the other suggestions in that block along"
  }
 ],
 "react": [
  {
   "component": "AgentCursors",
   "exported": true,
   "props": [
    {
     "name": "agents",
     "type": "CursorAgent[]",
     "optional": false,
     "description": "The agents in the document; `avatar` takes a React node"
    },
    {
     "name": "onResolveComment",
     "type": "(comment: DocComment) => void",
     "optional": true,
     "description": "Resolves a comment – the black check in its window"
    },
    {
     "name": "onAccept",
     "type": "(suggestion: DocSuggestion) => void",
     "optional": true,
     "description": "Accepts a suggestion – shows Accept in its window; write the change in with `acceptSuggestion`"
    },
    {
     "name": "onReject",
     "type": "(suggestion: DocSuggestion) => void",
     "optional": true,
     "description": "Rejects a suggestion – shows Reject in its window"
    },
    {
     "name": "onAcceptAll",
     "type": "() => void",
     "optional": true,
     "description": "Shows \"Accept all\" in the header; it is disabled while there are no suggestions"
    },
    {
     "name": "following",
     "type": "string | null",
     "optional": true,
     "description": "The agent you follow (the others fade back). Controlled when defined (null = nobody)"
    },
    {
     "name": "defaultFollowing",
     "type": "string | null",
     "optional": true,
     "description": "The agent followed at first, when `following` is not controlled"
    },
    {
     "name": "onFollowingChange",
     "type": "(agent: string | null) => void",
     "optional": true,
     "description": "Called when a face is clicked to follow an agent, or to stop (null)"
    },
    {
     "name": "tab",
     "type": "string",
     "optional": true,
     "description": "The open tab. Controlled when defined; otherwise the component keeps it, starting from `defaultTab`"
    },
    {
     "name": "defaultTab",
     "type": "string",
     "optional": true,
     "description": "The tab open at first, when `tab` is not controlled – defaults to the first"
    },
    {
     "name": "onTabChange",
     "type": "(tab: string) => void",
     "optional": true,
     "description": "Called when another tab is picked"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The document's title in the header (default \"Untitled\")"
    }
   ],
   "hides": [
    "agents",
    "following",
    "tab",
    "heading",
    "canAccept",
    "canReject",
    "canAcceptAll",
    "canResolve"
   ],
   "events": {
    "tc-following-change": null,
    "tc-tab-change": null,
    "tc-accept": "onAccept",
    "tc-reject": "onReject",
    "tc-accept-all": "onAcceptAll",
    "tc-resolve": "onResolveComment"
   }
  }
 ],
