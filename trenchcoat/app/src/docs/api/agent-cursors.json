{
 "elements": [
  {
   "tag": "tc-agent-cursors",
   "className": "TcAgentCursors",
   "description": "Agents working in a document like teammates in a multiplayer editor: pointers, selections, suggestions and comments.",
   "properties": [
    {
     "name": "agents",
     "attribute": null,
     "type": "CursorAgent[]",
     "default": "[]",
     "description": "The agents in the document – each one's name, colour, mark and cost; their faces show in the header",
     "readonly": false
    },
    {
     "name": "blocks",
     "attribute": null,
     "type": "DocBlock[]",
     "default": "[]",
     "description": "The document, block by block – title, headings, paragraphs, list items, code, images and tables",
     "readonly": false
    },
    {
     "name": "suggestions",
     "attribute": null,
     "type": "DocSuggestion[]",
     "default": "[]",
     "description": "Suggested changes, shown inline in the text in the suggesting agent's colour",
     "readonly": false
    },
    {
     "name": "comments",
     "attribute": null,
     "type": "DocComment[]",
     "default": "[]",
     "description": "Comment pins on the page",
     "readonly": false
    },
    {
     "name": "cursors",
     "attribute": null,
     "type": "Record<string, AgentCursor | null | undefined>",
     "default": "{}",
     "description": "Where each agent is – a missing or null entry means the agent has left the document",
     "readonly": false
    },
    {
     "name": "following",
     "attribute": "following",
     "type": "string | null",
     "default": "null",
     "description": "The agent you follow (the others fade back), or null",
     "readonly": false
    },
    {
     "name": "height",
     "attribute": "height",
     "type": "number | undefined",
     "default": "undefined",
     "description": "A fixed page height in px – the rest of the document fades out towards the bottom",
     "readonly": false
    },
    {
     "name": "formatCost",
     "attribute": null,
     "type": "(amount: number) => string",
     "default": "dollars",
     "description": "Formats every cost – defaults to dollars, e.g. \"$0.42\"",
     "readonly": false
    },
    {
     "name": "tabs",
     "attribute": null,
     "type": "DocTab[] | undefined",
     "default": "undefined",
     "description": "Tabs above the page, e.g. the document and a table view of it",
     "readonly": false
    },
    {
     "name": "tab",
     "attribute": "tab",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The open tab – unset is the first. The page content is yours to switch",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Untitled\"",
     "description": "The document's title in the header",
     "readonly": false
    },
    {
     "name": "canAccept",
     "attribute": "can-accept",
     "type": "boolean",
     "default": "false",
     "description": "Shows Accept in a suggestion's window (fires tc-accept)",
     "readonly": false
    },
    {
     "name": "canReject",
     "attribute": "can-reject",
     "type": "boolean",
     "default": "false",
     "description": "Shows Reject in a suggestion's window (fires tc-reject)",
     "readonly": false
    },
    {
     "name": "canAcceptAll",
     "attribute": "can-accept-all",
     "type": "boolean",
     "default": "false",
     "description": "Shows \"Accept all\" in the header (fires tc-accept-all)",
     "readonly": false
    },
    {
     "name": "canResolve",
     "attribute": "can-resolve",
     "type": "boolean",
     "default": "false",
     "description": "Shows the resolve check in a comment's window (fires tc-resolve)",
     "readonly": false
    },
    {
     "name": "onReply",
     "attribute": null,
     "type": "AgentCursorsReply | undefined",
     "default": "undefined",
     "description": "A reply typed into a comment's window and sent with Enter. May return a promise: the field waits while it\nruns, and if it rejects the text comes back so it can be sent again",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-following-change",
     "detail": "",
     "description": "A face was clicked to follow an agent, or to stop ({ following }: AgentFollowingChange); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-tab-change",
     "detail": "",
     "description": "Another tab was picked ({ tab }: AgentTabChange); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-accept",
     "detail": "",
     "description": "A suggestion was accepted; `detail` is the `DocSuggestion`",
     "cancelable": false
    },
    {
     "name": "tc-reject",
     "detail": "",
     "description": "A suggestion was rejected; `detail` is the `DocSuggestion`",
     "cancelable": false
    },
    {
     "name": "tc-accept-all",
     "detail": "",
     "description": "\"Accept all\" was pressed",
     "cancelable": false
    },
    {
     "name": "tc-resolve",
     "detail": "",
     "description": "A comment was resolved; `detail` is the `DocComment`",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "agc",
