{
 "elements": [
  {
   "tag": "tc-friction-profile",
   "className": "TcFrictionProfile",
   "description": "A mode switch – standard, elevated, deadline – that previews how each safeguard changes (on, shortened, deferred,\ntightened or off) against the mode in force before it is applied.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Friction profile\"",
     "description": "The heading, and the region's name",
     "readonly": false
    },
    {
     "name": "scope",
     "attribute": "scope",
     "type": "string",
     "default": "\"\"",
     "description": "What it applies to, a quiet line under the heading – e.g. \"This session\"",
     "readonly": false
    },
    {
     "name": "modes",
     "attribute": null,
     "type": "FrictionMode[]",
     "default": "[ { id: \"standard\", label: \"Standard\", description: \"Every safeguard works as usual.\" }, { id: \"elevated\", label: \"Elevated\", description: \"Higher stakes: more checks before anything is shared.\", tone: \"info\" }, { id: \"deadline\", label: \"Deadline\", description: \"Under time pressure: quicker to start, stricter to finish.\", needsReason: true, needsEnd: true, tone: \"warning\" }, ]",
     "description": "The modes, in switch order – defaults to standard, elevated and deadline",
     "readonly": false
    },
    {
     "name": "mode",
     "attribute": "mode",
     "type": "string",
     "default": "\"standard\"",
