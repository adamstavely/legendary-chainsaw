{
 "elements": [
  {
   "tag": "tc-budget-alerts",
   "className": "TcBudgetAlerts",
   "description": "Budget alerts: alert markers dragged along the month's budget bar – spent so far and the hatched forecast – with each\nalert's channel and recipients and when the forecast crosses it.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Budget alerts\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "budget",
     "attribute": "budget",
     "type": "number",
     "default": "0",
     "description": "The month's budget, in `currency`",
     "readonly": false
    },
    {
     "name": "spent",
     "attribute": "spent",
     "type": "number",
     "default": "0",
     "description": "Spent so far this month, in `currency`",
     "readonly": false
    },
    {
     "name": "forecast",
     "attribute": "forecast",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The forecast for the month's end, in `currency`; unset leaves the hatched forecast out",
     "readonly": false
    },
    {
     "name": "alerts",
     "attribute": null,
     "type": "BudgetAlert[]",
     "default": "[]",
     "description": "The alerts. Changed by dragging, the keys and the fields unless a tc-alerts-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Now, as epoch ms; with `end` it dates the forecast's crossings",
     "readonly": false
    },
    {
     "name": "end",
     "attribute": "end",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The period's last moment, as epoch ms",
     "readonly": false
    },
    {
     "name": "currency",
     "attribute": "currency",
     "type": "string",
     "default": "\"USD\"",
     "description": "The currency, an ISO 4217 code",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for numbers and dates, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-alerts-change",
     "detail": "",
     "description": "An alert was moved, added or removed, or its channel or recipients changed ({ alerts, change, id }: BudgetAlertsChange); cancelable – prevented, `alerts` stays as it was",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "valueText",
     "params": "a: Pick<BudgetAlert, \"at\">",
     "returns": "void",
     "description": "\"Alert at $4,000, 80% of budget\""
    },
    {
     "name": "crossingWords",
     "params": "a: Pick<BudgetAlert, \"at\">",
     "returns": "void",
     "description": "\"Forecast crosses 80% around 24 Nov\", \"Already passed\", or \"\" when it can't be worked out or won't happen"
    }
