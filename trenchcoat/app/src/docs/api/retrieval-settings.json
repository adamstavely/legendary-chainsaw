{
 "elements": [
  {
   "tag": "tc-retrieval-settings",
   "className": "TcRetrievalSettings",
   "description": "Chunking, top-k, a score threshold, keyword ↔ vector balance, reranking, metadata filters and how many chunks go\ninto context – with the pipeline they make and the cost and latency the app reports.",
   "properties": [
    {
     "name": "value",
     "attribute": null,
     "type": "RetrievalSettingsValue",
     "default": "{ chunkSize: 512, chunkOverlap: 64, topK: 40, threshold: 0.3, hybrid: 0.7, rerank: true, rerankModel: \"\", topN: 8, filters: [] }",
     "description": "The config. Changed by the user unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "filterFields",
     "attribute": null,
     "type": "RetrievalFilterField[]",
     "default": "[]",
     "description": "The metadata fields filters can test; without any, a filter's field is typed in",
     "readonly": false
    },
    {
     "name": "rerankModels",
     "attribute": null,
     "type": "RetrievalRerankModel[]",
     "default": "[]",
     "description": "The reranking models to offer; without any, Rerank is a switch only",
     "readonly": false
    },
    {
     "name": "indexed",
     "attribute": null,
     "type": "{ chunkSize: number; chunkOverlap: number } | undefined",
     "default": "undefined",
     "description": "The chunking the sources are indexed with now – a different size or overlap says the sources will be re-indexed",
     "readonly": false
    },
    {
     "name": "estimate",
     "attribute": null,
     "type": "RetrievalEstimate | undefined",
     "default": "undefined",
     "description": "Per-query cost and latency from the app, shown on the pipeline and at the foot; unset shows none",
     "readonly": false
    },
    {
     "name": "stage",
     "attribute": "stage",
     "type": "RetrievalStage",
     "default": "\"retrieve\"",
     "description": "The stage whose settings show under the pipeline: \"retrieve\", \"filter\", \"rerank\" or \"context\"",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Retrieval\"",
     "description": "The heading; also names the group",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "A quieter line under the heading, e.g. which index this is",
     "readonly": false
    },
    {
     "name": "flat",
     "attribute": "flat",
     "type": "boolean",
     "default": "false",
     "description": "Drops the tray and the card, for settings inside another card",
     "readonly": false
    },
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"\"",
     "description": "Submitted with the form: the config as JSON",
     "readonly": false
    },
    {
     "name": "disabled",
     "attribute": "disabled",
     "type": "boolean",
     "default": "false",
     "description": "Turns every control off and leaves the config out of the form; a disabled fieldset does the same",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
