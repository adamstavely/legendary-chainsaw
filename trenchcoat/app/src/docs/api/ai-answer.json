{
 "elements": [
  {
   "tag": "tc-ai-answer",
   "className": "TcAiAnswer",
   "description": "An assistant's answer with its sources, citation chips, actions, feedback and follow-up questions.",
   "properties": [
    {
     "name": "question",
     "attribute": "question",
     "type": "string",
     "default": "\"\"",
     "description": "The question above the answer",
     "readonly": false
    },
    {
     "name": "sources",
     "attribute": null,
     "type": "AnswerSource[]",
     "default": "[]",
     "description": "The sources the answer cites, numbered from 1 in the order given – [1] in the answer is the first",
     "readonly": false
    },
    {
     "name": "answer",
     "attribute": "answer",
     "type": "string",
     "default": "\"\"",
     "description": "The answer text – may grow while `streaming` is set",
     "readonly": false
    },
    {
     "name": "streaming",
     "attribute": "streaming",
     "type": "boolean",
     "default": "false",
     "description": "More text is still coming from your model, keep the cursor going",
     "readonly": false
    },
    {
     "name": "animated",
     "attribute": null,
     "type": "boolean",
     "default": "true",
     "description": "Stream the text in; false shows it at once",
     "readonly": false
    },
    {
     "name": "speed",
     "attribute": "speed",
     "type": "number",
     "default": "38",
     "description": "Words per second while streaming in",
     "readonly": false
    },
    {
     "name": "followUps",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "Follow-up questions offered under the finished answer",
     "readonly": false
    },
    {
     "name": "feedback",
     "attribute": null,
     "type": "AnswerFeedback | null",
     "default": "null",
     "description": "The verdict shown (null: none)",
     "readonly": false
    },
    {
     "name": "feedbackReasons",
     "attribute": null,
     "type": "array",
     "default": "[\"Not accurate\", \"Wrong source\", \"Too long\", \"Out of date\"]",
     "description": "Reasons offered after a thumbs down",
     "readonly": false
    },
    {
     "name": "hideActions",
     "attribute": "hide-actions",
     "type": "boolean",
     "default": "false",
     "description": "Leave out the built-in actions under a finished answer (copy, regenerate, thumbs and the status beside them) –\nfor an app that puts its own row there, such as `tc-message-actions`. Stop still shows while the answer is written",
     "readonly": false
    },
    {
     "name": "onRegenerate",
     "attribute": null,
     "type": "(() => void | Promise<unknown>) | undefined",
     "default": "undefined",
     "description": "Regenerate: may return a promise – a rejection shows in the last row, and Regenerate can be tried again",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-feedback-change",
     "detail": "",
     "description": "The verdict changes (a thumb, a reason, clearing it, a new answer starting over); detail `{ feedback: AnswerFeedback | null }`. Cancelable: preventDefault() keeps `feedback` as it is (controlled use)",
     "cancelable": true
    },
    {
     "name": "tc-feedback",
     "detail": "",
     "description": "A thumb up, or a thumbs down once its reason is picked; detail `{ value: \"up\" | \"down\", reason?: string }`",
     "cancelable": false
    },
    {
     "name": "tc-follow-up",
     "detail": "",
     "description": "A follow-up question was picked; detail `{ question: string }`",
     "cancelable": false
    },
    {
     "name": "tc-stop",
     "detail": "",
     "description": "Stop was pressed while writing",
     "cancelable": false
    },
    {
     "name": "tc-copy",
     "detail": "",
     "description": "The answer is on the clipboard; detail `{ text: string }`",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "ans",
