     "type": "AnswerFeedback | null",
     "optional": true,
     "description": "The verdict on mount when `feedback` isn't controlled"
    },
    {
     "name": "onFeedbackChange",
     "type": "(feedback: AnswerFeedback | null) => void",
     "optional": true,
     "description": "Every change of the verdict, including clearing it and a new answer starting over"
    },
    {
