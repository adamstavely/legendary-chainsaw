{
 "elements": [
  {
   "tag": "tc-partial-results",
   "className": "TcPartialResults",
   "description": "A bulk run that partly finished: what finished, what didn't and why, and a way to retry the rest.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Partial results\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "A line under the heading – what the run was",
     "readonly": false
    },
    {
     "name": "items",
     "attribute": null,
     "type": "PartialResultItem[]",
     "default": "[]",
     "description": "The items: every one, or only the unfinished ones with `done` and `total`",
     "readonly": false
    },
    {
     "name": "total",
     "attribute": "total",
     "type": "number | undefined",
     "default": "undefined",
     "description": "How many there were in all; by default the items' count",
     "readonly": false
    },
    {
     "name": "done",
     "attribute": "done",
     "type": "number | undefined",
     "default": "undefined",
     "description": "How many finished; by default the items marked done",
     "readonly": false
    },
    {
     "name": "variant",
     "attribute": "variant",
     "type": "PartialResultsVariant",
     "default": "\"card\"",
     "description": "\"card\", the whole picture, or \"notice\", one line and a Retry",
     "readonly": false
    },
    {
     "name": "collapsed",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The reasons whose groups are closed. Changed by the user unless a tc-collapsed-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "retrying",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "Ids being retried; set by Retry unless its listener calls preventDefault(), and cleared for an item when the page replaces it",
     "readonly": false
    },
    {
     "name": "hideContinue",
     "attribute": "hide-continue",
     "type": "boolean",
     "default": "false",
     "description": "Hide Continue, for a run with nothing to continue to",
     "readonly": false
    },
    {
     "name": "hideDownload",
     "attribute": "hide-download",
     "type": "boolean",
     "default": "false",
     "description": "Hide Download the list",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The locale for numbers",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<PartialResultsLabels>",
     "default": "{}",
     "description": "Rename any of the words",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-collapsed-change",
     "detail": "",
     "description": "A reason group was opened or closed ({ collapsed }: PartialResultsCollapsedChange); cancelable – prevented, `collapsed` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-retry",
     "detail": "",
     "description": "Retry was pressed, for one item or every failed one ({ ids, items }: PartialResultsRetry); cancelable – prevented, they aren't marked retrying",
     "cancelable": true
    },
    {
     "name": "tc-continue",
     "detail": "",
     "description": "Continue with what finished was pressed ({ done }: PartialResultsContinue)",
     "cancelable": false
    },
    {
     "name": "tc-export",
     "detail": "",
     "description": "Download the list was pressed ({ items, csv }: PartialResultsExport); cancelable – prevented, nothing is saved",
     "cancelable": true
    }
   ],
