 "functions": [
  {
   "name": "formatQuantity",
   "signature": "formatQuantity(n: number): { text: string; spoken: string }",
   "description": "A quantity as cooks write it – \"1⅓\", \"½\" – and as words for screen readers: \"1 and 1/3\""
  },
  {
   "name": "convertQuantity",
   "signature": "convertQuantity(quantity: number, unit: RecipeUnit | undefined, units: RecipeUnits): [number, RecipeUnit | undefined]",
   "description": "A quantity converted to `units`; units that don't convert stay as they are"
  },
  {
   "name": "stepTimer",
   "signature": "stepTimer(step: RecipeStep): number | null",
   "description": "The timer a step names, in seconds: \"Simmer for 20 minutes\" → 1200; a range takes its lower end"
  }
 ],
 "react": [
  {
