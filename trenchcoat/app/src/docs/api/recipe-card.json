{
 "elements": [
  {
   "tag": "tc-recipe-card",
   "className": "TcRecipeCard",
   "description": "A recipe ready to cook from – servings that scale every quantity, metric or imperial, ingredients to tick off, and\nnumbered steps with timers.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Recipe\"",
     "description": "The recipe's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line about it, under the name",
     "readonly": false
    },
    {
     "name": "prepMinutes",
     "attribute": "prep-minutes",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Preparation time in minutes",
     "readonly": false
    },
    {
     "name": "cookMinutes",
     "attribute": "cook-minutes",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Cooking time in minutes",
     "readonly": false
    },
    {
     "name": "baseServings",
     "attribute": "base-servings",
     "type": "number",
     "default": "4",
     "description": "How many the quantities in `ingredients` serve",
     "readonly": false
    },
    {
     "name": "servings",
     "attribute": "servings",
     "type": "number | undefined",
     "default": "undefined",
     "description": "How many to cook for – quantities scale to it. Changed by the user unless tc-servings-change is prevented",
     "readonly": false
    },
    {
     "name": "minServings",
     "attribute": "min-servings",
     "type": "number",
     "default": "1",
     "description": "The fewest servings the stepper allows",
     "readonly": false
    },
    {
     "name": "maxServings",
     "attribute": "max-servings",
     "type": "number",
     "default": "24",
     "description": "The most servings the stepper allows",
     "readonly": false
    },
    {
     "name": "units",
     "attribute": "units",
     "type": "RecipeUnits",
     "default": "\"metric\"",
     "description": "Metric or imperial. Changed by the user unless tc-units-change is prevented",
     "readonly": false
    },
    {
     "name": "ingredients",
     "attribute": null,
     "type": "RecipeIngredient[]",
     "default": "[]",
     "description": "The ingredients, with quantities for `baseServings`",
     "readonly": false
    },
    {
     "name": "steps",
     "attribute": null,
     "type": "RecipeStep[]",
     "default": "[]",
     "description": "The method, in order. A step that names a time gets a timer",
     "readonly": false
    },
    {
     "name": "step",
     "attribute": "step",
     "type": "number",
     "default": "0",
     "description": "The current step's index. Changed by the user unless tc-step-change is prevented",
     "readonly": false
    },
    {
     "name": "checked",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "Ingredient ids ticked off",
     "readonly": false
    },
    {
     "name": "tickMs",
     "attribute": "tick-ms",
     "type": "number",
     "default": "1000",
     "description": "How long one second of a timer lasts, in ms – 1000; shorter for tests and demos",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<RecipeLabels>",
     "default": "{}",
     "description": "Words to use instead of the defaults",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-servings-change",
     "detail": "",
     "description": "The servings changed ({ servings }: RecipeServingsChange); cancelable – prevented, `servings` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-units-change",
     "detail": "",
     "description": "Metric or imperial changed ({ units }: RecipeUnitsChange); cancelable – prevented, `units` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-step-change",
     "detail": "",
     "description": "The current step changed ({ step }: RecipeStepChange, its index); cancelable – prevented, `step` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-timer-done",
     "detail": "",
     "description": "A step's timer reached zero ({ step, text }: RecipeTimerDone)",
     "cancelable": false
    }
   ],
