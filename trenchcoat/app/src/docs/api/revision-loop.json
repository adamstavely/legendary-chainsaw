{
 "elements": [
  {
   "tag": "tc-revision-loop",
   "className": "TcRevisionLoop",
   "description": "An agent improving its own work against a stated bar, round by round, with a visible end.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Revision loop\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "A line under the heading – what's being revised",
     "readonly": false
    },
    {
     "name": "bar",
     "attribute": null,
     "type": "RevisionLoopBar",
     "default": "{ label: \"\", target: 0 }",
     "description": "The bar the work must meet",
     "readonly": false
    },
    {
     "name": "cap",
     "attribute": "cap",
     "type": "number",
     "default": "5",
     "description": "The most rounds it may run",
     "readonly": false
    },
    {
     "name": "rounds",
     "attribute": null,
     "type": "RevisionLoopRound[]",
     "default": "[]",
     "description": "The rounds so far, in order; append one as it starts and update it as it ends",
     "readonly": false
    },
    {
     "name": "outcome",
     "attribute": "outcome",
     "type": "RevisionLoopOutcome",
     "default": "\"running\"",
     "description": "How the loop stands: \"running\", \"met\", \"capped\" or \"stopped\". Set to \"stopped\" by Stop and \"running\" by Run another round, unless their listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "expanded",
     "attribute": "expanded",
     "type": "number | null",
     "default": "null",
     "description": "The open round's number, or null. Changed by the user unless a tc-expanded-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "accepted",
     "attribute": "accepted",
     "type": "boolean",
     "default": "false",
     "description": "Whether the result has been accepted; set by Accept unless a tc-accept listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The locale for numbers",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<RevisionLoopLabels>",
     "default": "{}",
     "description": "Rename any of the words",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-expanded-change",
     "detail": "",
     "description": "A round was opened or closed ({ expanded, round }: RevisionLoopExpandedChange); cancelable – prevented, `expanded` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-stop",
     "detail": "",
     "description": "Stop was pressed while it runs ({ round }: RevisionLoopStop); cancelable – prevented, the outcome stays \"running\"",
     "cancelable": true
    },
    {
     "name": "tc-accept",
     "detail": "",
     "description": "The result was accepted as it is ({ round, score }: RevisionLoopAccept); cancelable – prevented, it isn't marked accepted",
     "cancelable": true
    },
    {
     "name": "tc-extend",
     "detail": "",
     "description": "Run another round was pressed at the cap ({ cap }: RevisionLoopExtend); cancelable – prevented, the cap and outcome stay",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "rvl",
