{
 "elements": [
  {
   "tag": "tc-logo-marquee",
   "className": "TcLogoMarquee",
   "description": "The endless \"Trusted by\" strip: rows of logos that loop, ease to a stop on hover, scrub with inertia and pause for good.",
   "properties": [
    {
     "name": "logos",
     "attribute": null,
     "type": "MarqueeLogo[]",
     "default": "[]",
     "description": "The logos",
     "readonly": false
    },
    {
     "name": "speed",
     "attribute": "speed",
     "type": "number",
     "default": "40",
     "description": "Pixels per second, independent of the strip's width",
     "readonly": false
    },
    {
     "name": "direction",
     "attribute": "direction",
     "type": "\"left\" | \"right\"",
     "default": "\"left\"",
     "description": "Which way the first row runs; a second row runs the other way",
     "readonly": false
    },
    {
     "name": "rows",
     "attribute": "rows",
     "type": "1 | 2",
     "default": "1",
     "description": "1, or 2 for a second row in the opposite direction (the logos are split between the rows)",
     "readonly": false
    },
    {
     "name": "gap",
     "attribute": "gap",
     "type": "number",
     "default": "56",
     "description": "Space between logos in px (smaller on narrow containers)",
     "readonly": false
    },
    {
     "name": "pauseOnHover",
     "attribute": "pause-on-hover",
     "type": "boolean",
     "default": "true",
     "description": "Ease to a stop while the pointer is over the strip or it has keyboard focus",
     "readonly": false
    },
    {
     "name": "paused",
     "attribute": "paused",
     "type": "boolean",
     "default": "false",
     "description": "Stopped for good (the Pause / Play button's state)",
     "readonly": false
    },
    {
     "name": "pauseButton",
     "attribute": "pause-button",
     "type": "boolean",
     "default": "true",
     "description": "Show the Pause / Play button (on by default – moving content needs a way to stop it, WCAG 2.2.2)",
     "readonly": false
    },
    {
     "name": "grayscale",
     "attribute": "grayscale",
     "type": "boolean",
     "default": "true",
     "description": "Muted, colourless logos that lift to full colour on hover",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": "labels",
     "type": "MarqueeLabels",
     "default": "\"none\"",
     "description": "Show the brand name under each mark or beside it, like a wordmark",
     "readonly": false
    },
    {
     "name": "label",
     "attribute": "label",
     "type": "string",
     "default": "\"Logos of companies using the product\"",
     "description": "Accessible name of the strip",
     "readonly": false
    },
    {
     "name": "buttonLabels",
     "attribute": null,
     "type": "{ pause: string; play: string }",
     "default": "{ pause: \"Pause logos\", play: \"Play logos\" }",
     "description": "The Pause button's name, and the Play button's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-paused-change",
