{
 "elements": [
  {
   "tag": "tc-inspect-frame",
   "className": "TcInspectFrame",
   "description": "A component seen like a selection in a design tool – tilted back, with a selection frame, spacing numbers and a\nguide walking through its rows. Its content is its first element child.",
   "properties": [
    {
     "name": "label",
     "attribute": "label",
     "type": "string",
     "default": "\"\"",
     "description": "Accessible name; without it the illustration is decorative and hidden from screen readers",
     "readonly": false
    },
    {
     "name": "targets",
     "attribute": "targets",
     "type": "string",
     "default": "\"\"",
     "description": "CSS selector for the rows to walk through, inside the content; \"\" (the default) picks the root's block children",
     "readonly": false
    },
    {
     "name": "playing",
     "attribute": "playing",
     "type": "boolean",
     "default": "true",
     "description": "Walks the selection through the rows; false holds it on the first row",
     "readonly": false
    },
    {
     "name": "hold",
     "attribute": "hold",
     "type": "number",
     "default": "1600",
     "description": "How long the selection stays on a row, in ms",
     "readonly": false
    },
    {
     "name": "delay",
     "attribute": "delay",
     "type": "number",
     "default": "600",
     "description": "Wait before the first selection, in ms – e.g. until the section around it has come in",
     "readonly": false
    },
    {
     "name": "rounds",
     "attribute": "rounds",
     "type": "number",
     "default": "2",
     "description": "How many times it walks through the rows before it rests on the first one",
     "readonly": false
    },
    {
     "name": "mirror",
     "attribute": "mirror",
     "type": "boolean",
     "default": "false",
     "description": "Tilted the other way and fading out to the left – for the left side of a layout",
     "readonly": false
    },
    {
     "name": "flat",
     "attribute": "flat",
     "type": "boolean",
     "default": "false",
     "description": "No tilt and no fade",
     "readonly": false
    },
    {
     "name": "contentWidth",
     "attribute": "content-width",
     "type": "number",
     "default": "300",
     "description": "The content's width in px, before it's scaled to fit the frame",
