     "name": "tasks",
     "attribute": null,
     "type": "DelegateTask[]",
     "default": "[]",
     "description": "Every task – without an `agentId` it waits under \"Unassigned\"; the first in each agent's queue is the running one",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The clock for the \"Busy until\" times, in epoch ms – without it the board reads the clock while connected",
     "readonly": false
    },
    {
     "name": "mode",
     "attribute": "mode",
     "type": "DelegateMode",
     "default": "\"manual\"",
     "description": "Auto hands every unassigned task to the least busy agent on its own; Manual waits for a drag. Changed by the\nuser unless a tc-mode-change listener calls preventDefault()",
