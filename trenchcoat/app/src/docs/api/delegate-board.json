   "tag": "tc-delegate-board",
   "className": "TcDelegateBoard",
   "description": "Hand work to agents by dragging it onto them – or by click and keyboard.",
   "properties": [
    {
     "name": "agents",
     "attribute": null,
     "type": "DelegateAgent[]",
     "default": "[]",
     "description": "The agents work can go to, in the order they're listed (number keys 1–9 pick them)",
     "readonly": false
    },
