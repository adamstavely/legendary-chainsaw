 "functions": [],
 "react": [
  {
   "component": "DelegateBoard",
   "exported": true,
   "props": [
    {
     "name": "agents",
     "type": "DelegateAgent[]",
     "optional": false,
     "description": "The agents work can go to, in the order they're listed (number keys 1–9 pick them)"
    },
    {
     "name": "tasks",
     "type": "DelegateTask[]",
     "optional": false,
     "description": "Every task – without an `agentId` it waits under \"Unassigned\"; the first in each agent's queue is the running one"
    },
    {
     "name": "onAssign",
     "type": "(taskId: string, agentId: string | null) => void",
     "optional": true,
     "description": "A drop, a keyboard pick or Auto. The board moves the task at once and keeps it there until `tasks` gives that task\nanother agent – so `tasks` stays the source of truth, whether you handle the move or only listen to it"
    },
    {
     "name": "mode",
     "type": "DelegateMode",
     "optional": true,
     "description": "Auto hands every unassigned task to the least busy agent on its own; Manual waits for a drag. Controlled when defined"
    },
    {
     "name": "defaultMode",
     "type": "DelegateMode",
     "optional": true,
     "description": "The mode on mount when `mode` isn't controlled"
    },
    {
     "name": "onModeChange",
     "type": "(mode: DelegateMode) => void",
     "optional": true,
     "description": "Called with the new mode, controlled or not"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading in the bar"
    }
   ],
   "hides": [
    "agents",
    "tasks",
    "mode",
    "heading"
   ],
   "events": {
    "tc-assign": "onAssign",
    "tc-mode-change": "onModeChange"
   }
  }
 ],
