{
 "elements": [
  {
   "tag": "tc-instruction-editor",
   "className": "TcInstructionEditor",
   "description": "System and developer instructions with highlighted variables, missing and unused variable warnings, an\napp-supplied token count, a diff against a chosen version and Save as a new version.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Instructions\"",
     "description": "The heading, and the group's name",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": null,
     "type": "InstructionEditorValue",
     "default": "{ role: \"system\", text: \"\" }",
     "description": "The role and the text. Changed by the user unless tc-value-change is prevented",
     "readonly": false
    },
    {
     "name": "roles",
     "attribute": null,
     "type": "InstructionRole[]",
     "default": "[ { id: \"system\", label: \"System\" }, { id: \"developer\", label: \"Developer\" }, ]",
     "description": "Which instructions these can be; fewer than two hides the switch",
     "readonly": false
    },
    {
     "name": "variables",
     "attribute": null,
     "type": "InstructionVariable[]",
     "default": "[]",
     "description": "The variables the app fills in; the text is checked against them",
     "readonly": false
    },
    {
     "name": "versions",
     "attribute": null,
     "type": "InstructionVersion[]",
     "default": "[]",
     "description": "Saved versions, oldest first. Grows when Save isn't prevented",
     "readonly": false
    },
    {
     "name": "compareTo",
     "attribute": "compare-to",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The id of the version the text is compared with; unset compares with the latest",
     "readonly": false
    },
    {
     "name": "tokenCount",
     "attribute": "token-count",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The text's length in tokens, as the app counts it; unset shows no count",
     "readonly": false
    },
    {
     "name": "tokenLimit",
     "attribute": "token-limit",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The most tokens the instructions should use; past it the count turns red",
     "readonly": false
    },
    {
     "name": "counting",
     "attribute": "counting",
     "type": "boolean",
     "default": "false",
     "description": "The app is counting the tokens for the latest text",
     "readonly": false
    },
    {
     "name": "placeholder",
     "attribute": "placeholder",
     "type": "string",
     "default": "\"Say who the model is working for, what it should do and what it must not do. Use {{name}} for what the app fills in.\"",
     "description": "Placeholder in the empty editor",
     "readonly": false
    },
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"\"",
     "description": "Submitted with the form: the text",
     "readonly": false
    },
    {
     "name": "readonly",
     "attribute": "readonly",
     "type": "boolean",
     "default": "false",
     "description": "Shows everything but nothing can be changed",
     "readonly": false
    },
    {
     "name": "variableUses",
     "attribute": null,
     "type": "InstructionVariableUse[]",
     "default": null,
     "description": "Every variable the text uses or the app defines, with its status",
     "readonly": true
    },
    {
     "name": "comparedVersion",
     "attribute": null,
     "type": "InstructionVersion | undefined",
     "default": null,
     "description": "The version the text is compared with",
     "readonly": true
    },
    {
     "name": "dirty",
     "attribute": null,
     "type": "boolean",
     "default": null,
     "description": "The text differs from the latest version (or there is none yet and the text isn't empty)",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "The text or the role changed, or a version was restored ({ value: InstructionEditorValue }); cancelable – prevent it to control `value`",
     "cancelable": true
    },
    {
     "name": "tc-save",
     "detail": "",
     "description": "Save as a new version was pressed ({ version, versions }: InstructionSaveEvent); cancelable – prevented, `versions` stays as it was",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "insertVariable",
     "params": "name: string",
     "returns": "void",
     "description": "Inserts {{name}} at the caret, or in place of the selection"
    },
    {
     "name": "save",
     "params": "",
     "returns": "void",
     "description": "Saves the text as a new version: fires tc-save and, unless it's prevented, adds the version"
    }
   ],
