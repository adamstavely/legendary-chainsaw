   "name": "schemaFromFields",
   "signature": "schemaFromFields(fields: OutputSchemaField[]): OutputJsonSchema",
   "description": "The JSON Schema for an object with these fields: every object closed (additionalProperties: false)"
  },
  {
   "name": "sampleFromFields",
   "signature": "sampleFromFields(fields: OutputSchemaField[]): Record<string, unknown>",
   "description": "A sample object of this shape: the first allowed value, \"text\", 1.5, 1, true; one item per list"
  },
  {
   "name": "validateOutputSample",
   "signature": "validateOutputSample(value: unknown, schema: OutputJsonSchema, path: unknown, depth: unknown): string[]",
   "description": "Checks a value against a schema from schemaFromFields; one message per problem, \"$.path: …\""
  }
