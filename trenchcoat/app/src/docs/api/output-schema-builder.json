{
 "elements": [
  {
   "tag": "tc-output-schema-builder",
   "className": "TcOutputSchemaBuilder",
   "description": "The shape of a model's structured answer, built as a tree of fields beside a rendered preview of the answer, its\nraw JSON and the JSON Schema it makes.",
   "properties": [
    {
     "name": "value",
     "attribute": null,
     "type": "OutputSchemaField[]",
     "default": "[]",
     "description": "The output object's fields, in order. Changed by the user unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Output schema\"",
     "description": "The heading – what the output is for",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "A quieter line under the heading",
     "readonly": false
    },
    {
     "name": "preview",
     "attribute": "preview",
     "type": "OutputSchemaPreview",
     "default": "\"output\"",
     "description": "What the preview shows: the rendered answer (\"output\"), its raw JSON (\"sample\") or the JSON Schema (\"schema\")",
     "readonly": false
    },
    {
     "name": "flat",
     "attribute": "flat",
     "type": "boolean",
     "default": "false",
     "description": "Drops the tray and the card, for a builder inside another card",
     "readonly": false
    },
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"\"",
     "description": "Submitted with the form: the generated JSON Schema, as JSON",
     "readonly": false
    },
    {
     "name": "disabled",
     "attribute": "disabled",
