{
 "elements": [
  {
   "tag": "tc-retrieval-inspector",
   "className": "TcRetrievalInspector",
   "description": "The chunks retrieved for an answer – score, source and place, freshness, whether the answer used them – and the\nmisses the app reports.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Retrieval\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "query",
     "attribute": "query",
     "type": "string",
     "default": "\"\"",
     "description": "The query the chunks were retrieved for",
     "readonly": false
    },
    {
     "name": "chunks",
     "attribute": null,
     "type": "RetrievalChunk[]",
     "default": "[]",
     "description": "The chunks, in rank order – the first is the best match",
     "readonly": false
    },
    {
     "name": "misses",
     "attribute": null,
     "type": "RetrievalMiss[]",
     "default": "[]",
     "description": "Chunks the app reports should have been retrieved and weren't",
     "readonly": false
    },
    {
     "name": "cutoff",
     "attribute": "cutoff",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The score below which chunks are left out of the prompt – marked on every score bar; unset marks none",
     "readonly": false
    },
    {
     "name": "maxScore",
     "attribute": "max-score",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The top of the score scale – defaults to 1, or the highest score when that is higher",
     "readonly": false
    },
    {
     "name": "show",
     "attribute": "show",
     "type": "RetrievalShow",
     "default": "\"all\"",
     "description": "Which chunks show: \"all\", \"used\" (by the answer) or \"unused\"",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The id of the open chunk, or null",
     "readonly": false
    },
    {
     "name": "profile",
     "attribute": null,
     "type": "ValidityProfileName | ValidityProfile",
     "default": "\"standard\"",
     "description": "How fast sources go stale, for chunks without their own `profile` – see tc-validity-badge",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The moment freshness is counted to, in epoch ms – defaults to when each badge connected",
     "readonly": false
    },
    {
     "name": "openHandled",
     "attribute": "open-handled",
     "type": "boolean",
     "default": "false",
     "description": "Open source fires tc-open-source and the link doesn't navigate on its own; chunks without a url get the button",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "392",
     "description": "The list's height before it scrolls, in px",
     "readonly": false
    },
    {
     "name": "formatScore",
     "attribute": null,
     "type": "(score: number) => string",
     "default": "twoPlaces",
     "description": "Formats a score – defaults to two decimals, e.g. \"0.82\"",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-show-change",
     "detail": "",
     "description": "All, Used or Not used was picked ({ show }: RetrievalShowChange); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A chunk was picked or the open one closed ({ selected, chunk }: RetrievalSelectedChange); cancelable",
