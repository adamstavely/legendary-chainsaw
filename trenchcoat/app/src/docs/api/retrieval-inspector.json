 "react": [
  {
   "component": "RetrievalInspector",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading – defaults to \"Retrieval\""
    },
    {
     "name": "show",
     "type": "RetrievalShow",
     "optional": true,
     "description": "Which chunks show – \"all\", \"used\" or \"unused\". Controlled when defined; otherwise the component keeps it"
    },
    {
     "name": "defaultShow",
     "type": "RetrievalShow",
     "optional": true,
     "description": "Which chunks show at first when `show` isn't controlled"
    },
    {
     "name": "onShowChange",
     "type": "(show: RetrievalShow) => void",
     "optional": true,
     "description": "Called with the filter the user picked, controlled or not"
    },
    {
     "name": "selected",
     "type": "string | null",
     "optional": true,
     "description": "The id of the open chunk, or null. Controlled when defined"
    },
    {
     "name": "defaultSelected",
     "type": "string | null",
     "optional": true,
     "description": "The chunk open at first when `selected` isn't controlled"
    },
    {
     "name": "onSelectedChange",
     "type": "(id: string | null, chunk?: RetrievalChunk) => void",
     "optional": true,
     "description": "Called with the chunk picked (or null when it closes), controlled or not"
    },
    {
     "name": "onOpenSource",
     "type": "(chunk: RetrievalChunk) => void",
     "optional": true,
     "description": "Called by Open source. With it the link doesn't navigate on its own – open the document yourself"
    }
   ],
   "hides": [
    "heading",
    "show",
    "selected",
    "openHandled"
   ],
   "events": {
    "tc-show-change": null,
    "tc-selected-change": "onSelectedChange",
    "tc-open-source": "onOpenSource"
   }
  }
 ],
