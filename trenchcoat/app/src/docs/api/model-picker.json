{
 "elements": [
  {
   "tag": "tc-model-picker",
   "className": "TcModelPicker",
   "description": "The model menu of an AI chat: models with strength bars, extended thinking with its effort, and web search.",
   "properties": [
    {
     "name": "models",
     "attribute": null,
     "type": "PickerModel[]",
     "default": "[]",
     "description": "The models to choose from, in menu order – each with its strengths, first-token time and price",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": "value",
     "type": "string",
     "default": "\"\"",
     "description": "Id of the chosen model – unset or unknown shows the first",
     "readonly": false
    },
    {
     "name": "thinking",
     "attribute": "thinking",
     "type": "boolean",
     "default": "false",
     "description": "Extended thinking switch",
     "readonly": false
    },
    {
     "name": "webSearch",
     "attribute": "web-search",
     "type": "boolean",
     "default": "false",
     "description": "Web search switch",
     "readonly": false
    },
    {
     "name": "effort",
     "attribute": "effort",
     "type": "ModelEffort",
     "default": "\"medium\"",
     "description": "How hard the model thinks – only shown while extended thinking is on",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": "open",
     "type": "boolean",
     "default": "false",
     "description": "Whether the menu is open",
     "readonly": false
    },
    {
     "name": "align",
     "attribute": "align",
     "type": "\"start\" | \"end\"",
     "default": "\"start\"",
     "description": "Which edge of the trigger the menu lines up with",
     "readonly": false
    },
    {
     "name": "side",
     "attribute": "side",
     "type": "\"bottom\" | \"top\"",
     "default": "\"bottom\"",
     "description": "Whether the menu opens below or above the trigger – above suits a composer at the bottom of the screen",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
