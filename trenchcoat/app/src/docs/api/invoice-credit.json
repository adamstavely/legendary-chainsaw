{
 "elements": [
  {
   "tag": "tc-invoice-credit",
   "className": "TcInvoiceCredit",
   "description": "An invoice and its credit note stacked like paper – switch between them, pick lines to credit, adjust amounts and issue.",
   "properties": [
    {
     "name": "seller",
     "attribute": null,
     "type": "DocParty",
     "default": "{ name: \"Lumen Labs, Inc.\", lines: [\"48 Harbour Street\", \"Bristol\", \"BS1 4RN\", \"United Kingdom\"] }",
     "description": "Who sends the invoice",
     "readonly": false
    },
    {
     "name": "buyer",
     "attribute": null,
     "type": "DocParty",
     "default": "{ name: \"Northwind Logistics GmbH\", lines: [\"Speicherstraße 12\", \"Hamburg\", \"20457\", \"Germany\"] }",
     "description": "Who pays it",
     "readonly": false
    },
    {
     "name": "invoiceNo",
     "attribute": "invoice-no",
     "type": "string",
     "default": "\"INV-2041\"",
     "description": "The invoice's number",
     "readonly": false
    },
    {
     "name": "creditNo",
     "attribute": "credit-no",
     "type": "string",
     "default": "\"CN-0117\"",
     "description": "The credit note's number",
     "readonly": false
    },
    {
     "name": "invoiceDate",
     "attribute": "invoice-date",
     "type": "string",
     "default": "\"1 Oct 2026\"",
     "description": "The date of the invoice (and of issue for the credit note), as written",
     "readonly": false
    },
    {
     "name": "dueDate",
     "attribute": "due-date",
     "type": "string",
     "default": "\"31 Oct 2026\"",
     "description": "When the invoice is due, as written",
     "readonly": false
    },
    {
     "name": "period",
     "attribute": "period",
     "type": "string",
     "default": "\"1 Sep – 30 Sep 2026\"",
     "description": "The billing period, as written",
     "readonly": false
    },
    {
     "name": "lines",
     "attribute": null,
     "type": "InvoiceLine[]",
     "default": "[ { id: \"plan\", name: \"Growth plan\", qty: 1, rate: 1250, tax: 0.2 }, { id: \"seats\", name: \"Extra seats\", qty: 12, rate: 40, tax: 0.2 }, { id: \"api\", name: \"API calls (per 1k)\", qty: 18420, rate: 0.42, tax: 0.2, group: \"Metered usage\" }, ]",
     "description": "The invoice's lines – lines with a `group` are listed under it",
     "readonly": false
    },
    {
     "name": "currency",
     "attribute": "currency",
     "type": "string",
     "default": "\"$\"",
     "description": "The currency sign before amounts",
     "readonly": false
    },
    {
     "name": "currencyCode",
     "attribute": "currency-code",
     "type": "string",
     "default": "\"USD\"",
     "description": "The currency code after the amount applied to the invoice",
     "readonly": false
    },
    {
     "name": "payHref",
     "attribute": "pay-href",
     "type": "string",
     "default": "\"\"",
     "description": "Where \"Pay online\" goes; unset, the link only fires tc-pay",
     "readonly": false
    },
    {
     "name": "view",
     "attribute": "view",
     "type": "InvoiceView",
     "default": "\"invoice\"",
     "description": "The sheet in front",
     "readonly": false
    },
    {
     "name": "onIssue",
     "attribute": null,
     "type": "InvoiceIssueHandler | undefined",
     "default": "undefined",
     "description": "Issues the credit note, with the credited amount per line (before tax). Return a promise to show Issuing… until it\nsettles; a rejection keeps the note editable and shows its message so it can be issued again",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-view-change",
     "detail": "",
     "description": "The other sheet was brought forward (`{ view }`: InvoiceViewChange); cancelable – prevented, `view` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-issue",
     "detail": "",
