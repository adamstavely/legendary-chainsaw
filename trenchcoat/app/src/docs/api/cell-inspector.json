{
 "elements": [
  {
   "tag": "tc-cell-inspector",
   "className": "TcCellInspector",
   "description": "Why one AI-filled cell says what it says – the value and confidence, the prompt with the row filled in, reasoning,\nsources, tokens and cost, and history – with Accept, Edit value, Re-run and Mark as wrong.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Cell\"",
     "description": "The heading – the column's name – and the region's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "A quiet line under the heading – which row: \"Northwind Analytics · row 214\"",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": "value",
     "type": "string",
     "default": "\"\"",
     "description": "The cell's value. Changed by Edit value unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "CellStatus",
     "default": "\"new\"",
     "description": "Where the cell stands. Changed by the actions unless a tc-status-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "prompt",
     "attribute": "prompt",
     "type": "string",
     "default": "\"\"",
     "description": "The column's prompt, with {{variable}} where the row's values go",
     "readonly": false
    },
    {
     "name": "variables",
     "attribute": null,
     "type": "Record<string, string>",
     "default": "{}",
     "description": "This row's values, by variable name",
     "readonly": false
    },
    {
     "name": "model",
     "attribute": "model",
     "type": "string",
     "default": "\"\"",
     "description": "The model that filled the cell",
     "readonly": false
    },
    {
     "name": "at",
     "attribute": "at",
     "type": "number | null",
     "default": "null",
     "description": "When it was filled, epoch ms",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | null",
     "default": "null",
     "description": "The time now, epoch ms – turns times into \"3 min ago\"; unset shows dates",
     "readonly": false
    },
    {
     "name": "reasoning",
     "attribute": "reasoning",
     "type": "string",
     "default": "\"\"",
     "description": "The model's reasoning summary, folded away until opened",
     "readonly": false
    },
    {
     "name": "sources",
     "attribute": null,
     "type": "CellSource[]",
     "default": "[]",
     "description": "The sources the model used",
     "readonly": false
    },
    {
     "name": "confidence",
     "attribute": "confidence",
     "type": "number | null",
     "default": "null",
     "description": "How sure the model was, 0–1; unset hides it",
     "readonly": false
    },
    {
     "name": "tokensIn",
     "attribute": "tokens-in",
     "type": "number | null",
     "default": "null",
     "description": "Input tokens this cell used",
     "readonly": false
    },
    {
     "name": "tokensOut",
     "attribute": "tokens-out",
     "type": "number | null",
     "default": "null",
     "description": "Output tokens this cell used",
     "readonly": false
    },
    {
     "name": "cost",
     "attribute": "cost",
     "type": "number | null",
     "default": "null",
     "description": "What this cell cost, in `currency`",
     "readonly": false
    },
    {
     "name": "history",
     "attribute": null,
     "type": "CellHistoryEntry[]",
     "default": "[]",
     "description": "Earlier values, newest first",
     "readonly": false
    },
    {
     "name": "closable",
     "attribute": "closable",
     "type": "boolean",
     "default": "false",
     "description": "Show a close button – the panel's own; Escape fires tc-close either way",
     "readonly": false
    },
    {
     "name": "statusLabels",
     "attribute": null,
     "type": "Partial<Record<CellStatus, string>>",
     "default": "{}",
     "description": "Words for each status",
     "readonly": false
    },
    {
     "name": "currency",
     "attribute": "currency",
     "type": "string",
     "default": "\"USD\"",
     "description": "ISO 4217 currency of the cost",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string",
     "default": "\"en-US\"",
     "description": "Locale for numbers, money and dates",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "The value was edited and saved ({ value, previous }: CellValueChange); cancelable – prevented, `value` stays as it was",
