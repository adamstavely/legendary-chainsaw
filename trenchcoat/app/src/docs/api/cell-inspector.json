     "cancelable": true
    },
    {
     "name": "tc-rerun",
     "detail": "",
     "description": "Re-run this cell was pressed ({ value }: CellRerun); cancelable – prevented, nothing changes",
     "cancelable": true
    },
    {
     "name": "tc-flag",
     "detail": "",
     "description": "Marked as wrong, with the reason ({ reason, value }: CellFlag); cancelable – prevented, nothing changes",
     "cancelable": true
    },
    {
     "name": "tc-close",
     "detail": "",
     "description": "Escape with nothing open inside, or the close button (detail: {})",
     "cancelable": false
    }
