{
 "elements": [
  {
   "tag": "tc-terminal",
   "className": "TcTerminal",
   "description": "A command line for a panel: output in colour above a prompt with history; the page runs the commands.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Terminal\"",
     "description": "The heading; empty leaves the header out",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "Small text under the heading – the machine or working directory",
     "readonly": false
    },
    {
     "name": "output",
     "attribute": "output",
     "type": "string",
     "default": "\"\"",
     "description": "Everything printed so far, with ANSI escape codes; pass a longer string as it streams",
     "readonly": false
    },
    {
     "name": "prompt",
     "attribute": "prompt",
     "type": "string",
     "default": "\"$\"",
     "description": "What stands before the command",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": "value",
     "type": "string",
     "default": "\"\"",
     "description": "The text in the prompt. Changed by typing unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "history",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "Earlier commands, oldest first, for ↑ and ↓; commands entered here are added to it",
     "readonly": false
    },
    {
     "name": "running",
     "attribute": "running",
     "type": "boolean",
     "default": "false",
     "description": "A command is running: Enter waits, and Stop and Ctrl+C fire tc-interrupt",
     "readonly": false
    },
    {
     "name": "disabled",
     "attribute": "disabled",
     "type": "boolean",
     "default": "false",
     "description": "The prompt can't be used: for a closed session, or output to read only",
     "readonly": false
    },
    {
     "name": "masked",
     "attribute": "masked",
     "type": "boolean",
     "default": "false",
     "description": "Hides what's typed, for a password prompt, and keeps it out of the history",
     "readonly": false
    },
    {
     "name": "height",
     "attribute": "height",
     "type": "number",
     "default": "280",
     "description": "Height of the output in px",
     "readonly": false
