     "attribute": "stop-label",
     "type": "string",
     "default": "\"Stop\"",
     "description": "Names the Stop button",
     "readonly": false
    },
    {
     "name": "text",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "The output's lines as plain text",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-command",
     "detail": "",
     "description": "Enter was pressed on a command ({ command }: TerminalCommand); cancelable – prevented, the command stays in the prompt",
     "cancelable": true
