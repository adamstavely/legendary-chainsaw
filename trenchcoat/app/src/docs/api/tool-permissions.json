{
 "elements": [
  {
   "tag": "tc-tool-permissions",
   "className": "TcToolPermissions",
   "description": "A matrix of which agent may use which tools and scopes – Allow, Ask or Deny per cell – with presets and a summary of\nwhat changed.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Tool permissions\"",
     "description": "The heading, and the grid's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "agents",
     "attribute": null,
     "type": "ToolPermissionAgent[]",
     "default": "[]",
     "description": "The columns",
     "readonly": false
    },
    {
     "name": "tools",
     "attribute": null,
     "type": "ToolPermissionTool[]",
     "default": "[]",
     "description": "The rows: each tool's scopes, grouped under the tool",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": null,
     "type": "ToolPermissionMatrix",
     "default": "{}",
     "description": "The matrix. Changed by the user unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "saved",
     "attribute": null,
     "type": "ToolPermissionMatrix | undefined",
     "default": "undefined",
     "description": "What was last saved – the summary lists the differences. Unset: the value the element first showed",
     "readonly": false
    },
    {
     "name": "defaultLevel",
     "attribute": "default-level",
     "type": "ToolPermissionLevel",
     "default": "\"ask\"",
     "description": "A cell missing from the value",
     "readonly": false
    },
    {
     "name": "presets",
     "attribute": null,
     "type": "ToolPermissionPreset[]",
     "default": "[ { id: \"read-only\", label: \"Read only\", description: \"Safe scopes allowed, everything else denied\", level: (s) => ((s.risk ?? \"safe\") === \"safe\" ? \"allow\" : \"deny\") }, { id: \"ask-first\", label: \"Ask first\", description: \"Safe scopes allowed, the rest ask every time\", level: (s) => ((s.risk ?? \"safe\") === \"safe\" ? \"allow\" : \"ask\") }, { id: \"trusted\", label: \"Trusted\", description: \"Only destructive scopes ask\", level: (s) => (s.risk === \"destructive\" ? \"ask\" : \"allow\") }, { id: \"locked\", label: \"Locked\", description: \"Every scope asks\", level: () => \"ask\" }, ]",
     "description": "One-click setups; [] hides the row",
     "readonly": false
    },
    {
     "name": "changesLimit",
     "attribute": "changes-limit",
     "type": "number",
     "default": "4",
     "description": "Changes listed before \"N more\"",
     "readonly": false
    },
    {
     "name": "saveLabel",
     "attribute": "save-label",
     "type": "string",
     "default": "\"Save\"",
     "description": "The Save button's text; the number of changes is shown beside it",
     "readonly": false
    },
    {
     "name": "resetLabel",
     "attribute": "reset-label",
     "type": "string",
     "default": "\"Reset\"",
     "description": "The text of the button that puts back what was last saved",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "A cell, a preset or Reset changed the matrix ({ value, changes, cause }: ToolPermissionValueChange); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-save",
     "detail": "",
     "description": "Save was pressed ({ value, changes }: ToolPermissionSave); cancelable – unless prevented, `saved` becomes the value",
     "cancelable": true
    }
