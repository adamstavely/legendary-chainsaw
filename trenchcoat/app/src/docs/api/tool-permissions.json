    },
    {
     "name": "defaultValue",
     "type": "ToolPermissionMatrix",
     "optional": true,
     "description": "The matrix on mount when `value` isn't controlled – a missing cell is `defaultLevel`"
    },
    {
     "name": "onChange",
     "type": "(value: ToolPermissionMatrix, detail: Omit<ToolPermissionValueChange, \"value\">) => void",
     "optional": true,
     "description": "A cell, a preset or Reset changed the matrix; `detail` says which and lists the changes since the last save"
    },
    {
     "name": "saved",
     "type": "ToolPermissionMatrix",
     "optional": true,
     "description": "What was last saved – controlled when given; otherwise the first value, then whatever Save stores"
    },
    {
     "name": "onSave",
     "type": "(value: ToolPermissionMatrix, changes: ToolPermissionChange[]) => void",
     "optional": true,
     "description": "Save was pressed – store the value; the summary then starts from it"
    }
   ],
