{
 "elements": [
  {
   "tag": "tc-run-log",
   "className": "TcRunLog",
   "description": "Every agent run on one line – status, agent, trigger, when, duration, steps, tokens, cost and user – with filters, search, a time range, errors that open in place, and new runs held behind Show new.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Runs\"",
     "description": "The heading; empty leaves the header out",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "Small text under the heading",
     "readonly": false
    },
    {
     "name": "runs",
     "attribute": null,
     "type": "RunLogRun[]",
     "default": "[]",
     "description": "The runs, in any order – the list shows the newest first",
     "readonly": false
    },
    {
     "name": "filter",
     "attribute": null,
     "type": "RunLogFilter",
     "default": "{ status: [], agents: [], triggers: [] }",
     "description": "The status, agent and trigger chips that are on; an empty list means all",
     "readonly": false
    },
    {
     "name": "query",
     "attribute": "query",
     "type": "string",
     "default": "\"\"",
     "description": "The search text",
     "readonly": false
    },
    {
     "name": "range",
     "attribute": "range",
     "type": "RunLogRange",
     "default": "\"all\"",
     "description": "How far back runs show, from `now` (or the newest run when `now` isn't given)",
     "readonly": false
    },
    {
     "name": "expanded",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The failed runs whose error is open",
     "readonly": false
    },
    {
     "name": "live",
     "attribute": "live",
     "type": "boolean",
     "default": "false",
     "description": "Holds runs that arrive after the first render behind Show new",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | null",
     "default": "null",
     "description": "The current time, epoch ms – \"Started\" reads relative to it; without it, a date and time",
     "readonly": false
    },
    {
     "name": "currency",
     "attribute": "currency",
     "type": "string",
     "default": "\"USD\"",
     "description": "ISO 4217 currency code for costs",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Locale for dates, numbers and amounts",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "420",
     "description": "Height in px at which the list scrolls",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<RunLogLabels>",
     "default": "{}",
     "description": "Renames the words it uses",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-filter-change",
     "detail": "",
     "description": "A status, agent or trigger chip was toggled, or the filters cleared ({ filter }: RunLogFilterChange); cancelable – prevented, `filter` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-query-change",
     "detail": "",
     "description": "The search changed ({ query }: RunLogQueryChange); cancelable – prevented, `query` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-range-change",
     "detail": "",
     "description": "The time range changed ({ range }: RunLogRangeChange); cancelable – prevented, `range` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-expanded-change",
     "detail": "",
     "description": "A failed run's error was shown or hidden ({ expanded, id, open }: RunLogExpandedChange); cancelable – prevented, `expanded` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-run-open",
     "detail": "",
     "description": "A run was opened: Enter on its line, or a click ({ id, run }: RunLogOpen)",
     "cancelable": false
    },
    {
     "name": "tc-show-new",
     "detail": "",
