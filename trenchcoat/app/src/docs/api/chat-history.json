{
 "elements": [
  {
   "tag": "tc-chat-history",
   "className": "TcChatHistory",
   "description": "The conversation list: search, pinning, folders, rename and delete with Undo, grouped by date; windowed.",
   "properties": [
    {
     "name": "conversations",
     "attribute": null,
     "type": "ChatConversation[]",
     "default": "[]",
     "description": "Every conversation",
     "readonly": false
    },
    {
     "name": "folders",
     "attribute": null,
     "type": "ChatFolder[]",
     "default": "[]",
     "description": "Folders, in the order they show; chats name theirs with `folder`",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": "value",
     "type": "string | null",
     "default": "null",
     "description": "The open chat's id",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": null,
     "type": "number | Date | undefined",
     "default": "undefined",
     "description": "\"Now\" for the date groups (epoch ms or a Date). Unset: the time the element was connected",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Chats\"",
     "description": "The heading, and the tree's name",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "420",
     "description": "Height of the list before it scrolls, in px",
     "readonly": false
    },
    {
     "name": "undoFor",
     "attribute": "undo-for",
     "type": "number",
     "default": "6000",
     "description": "How long Undo stays after a delete, in ms. It waits while the pointer or focus is on it and starts over after;\n`Infinity` keeps it until the next delete (WCAG 2.2.1)",
     "readonly": false
    },
    {
     "name": "hints",
     "attribute": "hints",
     "type": "boolean",
     "default": "true",
     "description": "Show the keyboard hints (hints=\"false\" hides them)",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Locale for the month names; unset uses the page's",
     "readonly": false
    },
    {
     "name": "context",
     "attribute": null,
     "type": "ChatContextItem[]",
     "default": "[]",
     "description": "What's loaded into the current chat as context – summary items from earlier chats. The app decides what's sent",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "A chat was opened (click, Enter); detail `{ value: string | null }`. Cancelable: prevent it to control `value`",
     "cancelable": true
    },
    {
     "name": "tc-conversations-change",
     "detail": "",
     "description": "The list changed (renamed, pinned, moved, deleted, restored); detail `{ conversations }`. Cancelable: prevent it to control `conversations`",
     "cancelable": true
    },
    {
     "name": "tc-rename",
     "detail": "",
     "description": "A chat was renamed; detail `{ id, title }`",
     "cancelable": false
    },
    {
     "name": "tc-pin",
     "detail": "",
     "description": "A chat was pinned or unpinned; detail `{ id, pinned }`",
     "cancelable": false
    },
    {
     "name": "tc-move",
     "detail": "",
     "description": "A chat was moved to a folder, or out of one (`folder: null`); detail `{ id, folder }`",
     "cancelable": false
    },
    {
     "name": "tc-delete",
     "detail": "",
     "description": "A chat was deleted (Undo may still bring it back); detail `{ id, conversation }`",
     "cancelable": false
    },
    {
     "name": "tc-restore",
     "detail": "",
     "description": "Undo brought a deleted chat back; detail `{ id, conversation }`",
     "cancelable": false
    },
    {
     "name": "tc-new-chat",
     "detail": "",
     "description": "New chat was pressed",
     "cancelable": false
    },
    {
     "name": "tc-context-change",
     "detail": "",
     "description": "A chat's summary was loaded as context, or items were removed; detail `{ context, action, chat, items }`: ChatContextChange. Cancelable: prevent it to control `context`",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
