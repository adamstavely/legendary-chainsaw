 "react": [
  {
   "component": "ChatHistory",
   "exported": true,
   "props": [
    {
     "name": "conversations",
     "type": "ChatConversation[]",
     "optional": true,
     "description": "Every conversation. Controlled when defined; otherwise the list keeps them, starting at `defaultConversations`"
    },
    {
     "name": "defaultConversations",
     "type": "ChatConversation[]",
     "optional": true,
     "description": "The starting list when `conversations` is not controlled"
    },
    {
     "name": "onConversationsChange",
     "type": "(conversations: ChatConversation[]) => void",
     "optional": true,
     "description": "Called with the whole list after any change (rename, pin, move, delete, Undo)"
    },
    {
     "name": "value",
     "type": "string | null",
     "optional": true,
     "description": "The open chat's id. Controlled when defined (null for none)"
    },
    {
     "name": "defaultValue",
     "type": "string | null",
     "optional": true,
     "description": "The chat open at first, when `value` is not controlled"
    },
    {
     "name": "onChange",
     "type": "(value: string | null) => void",
     "optional": true,
     "description": "Called with the id of the chat that was opened"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading above the list, and the tree's name (default \"Chats\")"
    },
    {
     "name": "onRename",
     "type": "(id: string, title: string) => void",
     "optional": true,
     "description": "Called when a chat is renamed in place, with its new title"
    },
    {
     "name": "onPin",
     "type": "(id: string, pinned: boolean) => void",
     "optional": true,
     "description": "Called when a chat is pinned or unpinned"
    },
    {
     "name": "onMove",
     "type": "(id: string, folder: string | null) => void",
     "optional": true,
     "description": "Called when a chat is moved to a folder, or out of one (null)"
    },
    {
     "name": "onDelete",
     "type": "(id: string, conversation: ChatConversation) => void",
     "optional": true,
     "description": "Called when a chat is deleted – Undo may still bring it back (onRestore)"
    },
    {
     "name": "onRestore",
     "type": "(id: string, conversation: ChatConversation) => void",
     "optional": true,
     "description": "Called when Undo brings a deleted chat back"
    },
    {
     "name": "onNewChat",
     "type": "() => void",
     "optional": true,
     "description": "Called when New chat is pressed"
    },
    {
     "name": "context",
     "type": "ChatContextItem[]",
     "optional": true,
     "description": "What's loaded as context now. Controlled when defined; otherwise the list keeps it, starting at `defaultContext`"
    },
    {
     "name": "defaultContext",
     "type": "ChatContextItem[]",
     "optional": true,
     "description": "The starting context when `context` is not controlled"
    },
    {
     "name": "onContextChange",
     "type": "(context: ChatContextItem[], change: ChatContextChange) => void",
     "optional": true,
     "description": "Called when a chat's summary is loaded as context or items are removed – send what's in `context` with the next message"
    }
   ],
   "hides": [
    "conversations",
    "value",
    "defaultValue",
    "heading",
    "onChange",
    "context"
