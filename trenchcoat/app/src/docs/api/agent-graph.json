{
 "elements": [
  {
   "tag": "tc-agent-graph",
   "className": "TcAgentGraph",
   "description": "Agents and the tools they use, drawn as a living network with pulses along the links.",
   "properties": [
    {
     "name": "nodes",
     "attribute": null,
     "type": "GraphNode[]",
     "default": "[]",
     "description": "The agents, tools and people in the graph – the lead agent in the middle, the other agents around it, the rest outside",
     "readonly": false
    },
    {
     "name": "calls",
     "attribute": null,
     "type": "GraphCall[]",
     "default": "[]",
     "description": "Recent calls, newest last – every new id sends a pulse. Calls also draw the links they need",
     "readonly": false
    },
    {
     "name": "edges",
     "attribute": null,
     "type": "[string, string][]",
     "default": "[]",
     "description": "Links that are always there, even before their first call",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The clock for calls per minute and link heat, in epoch ms – defaults to an internal clock that ticks every second\nwhile the graph is on screen",
     "readonly": false
    },
    {
     "name": "heatWindow",
     "attribute": "heat-window",
     "type": "number",
     "default": "20000",
     "description": "How far back calls make a link thicker (ms)",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The node whose card is open (null = none). Changed by the user unless a tc-selected-change listener calls\npreventDefault()",
     "readonly": false
    },
    {
     "name": "height",
     "attribute": "height",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Fixed height of the graph in px – defaults to one that fits the width",
     "readonly": false
    },
    {
     "name": "formatCost",
     "attribute": null,
     "type": "(amount: number) => string",
     "default": "dollars",
     "description": "Formats every cost – defaults to dollars, e.g. \"$0.42\"",
     "readonly": false
    },
    {
     "name": "paused",
     "attribute": "paused",
     "type": "boolean",
     "default": "false",
     "description": "Stops the moving parts, as the bar's Pause button does. Changed by the user unless a tc-paused-change listener\ncalls preventDefault()",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Agent graph\"",
     "description": "The heading in the bar, and the start of the graph's name",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A card opened or closed ({ selected, removed }: GraphSelectedChange; removed when the open node went away); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-select",
     "detail": "",
     "description": "A node or a chip was clicked, or the card was closed ({ node }: GraphSelect, null when closed)",
     "cancelable": false
    },
    {
     "name": "tc-paused-change",
     "detail": "",
     "description": "The Pause button was pressed ({ paused }: GraphPausedChange); cancelable",
     "cancelable": true
    }
   ],
