 "functions": [],
 "react": [
  {
   "component": "AgentGraph",
   "exported": true,
   "props": [
    {
     "name": "nodes",
     "type": "GraphNode[]",
     "optional": false,
     "description": "The agents, tools and people in the graph; icons can be React nodes"
    },
    {
     "name": "onSelect",
     "type": "(node: GraphNode | null) => void",
     "optional": true,
     "description": "A click on a node – it also opens its card; null when the card closes"
    },
    {
     "name": "selected",
     "type": "string | null",
     "optional": true,
     "description": "The node whose card is open. Controlled when defined (null = none); otherwise the component keeps it, starting\nfrom `defaultSelected`. Changes are reported to `onSelectedChange` (and `onSelect`, with the node)"
    },
    {
     "name": "defaultSelected",
     "type": "string | null",
     "optional": true,
     "description": "The node whose card is open at first, when `selected` isn't set"
    },
    {
     "name": "onSelectedChange",
     "type": "(id: string | null) => void",
     "optional": true,
     "description": "Called with the node id when a card opens, and null when it closes"
    },
    {
     "name": "paused",
     "type": "boolean",
     "optional": true,
     "description": "Stops the moving parts – pulses, ripples, floating and the breathing rings – as the bar's Pause button does.\nControlled when defined; otherwise the component keeps it, starting from `defaultPaused`"
    },
    {
     "name": "defaultPaused",
     "type": "boolean",
     "optional": true,
     "description": "Whether the motion starts paused, when `paused` isn't set"
    },
    {
     "name": "onPausedChange",
     "type": "(paused: boolean) => void",
     "optional": true,
     "description": "Called when the Pause button is pressed, with the new paused state"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading in the bar, and the start of the graph's accessible name – \"Agent graph\" by default"
    }
   ],
   "hides": [
    "nodes",
    "selected",
    "paused",
    "heading",
    "onSelect"
   ],
   "events": {
    "tc-selected-change": null,
    "tc-select": "onSelect",
    "tc-paused-change": "onPausedChange"
   }
  }
 ],
