{
 "elements": [
  {
   "tag": "tc-progress-tracker",
   "className": "TcProgressTracker",
   "description": "A checklist with a progress bar.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Getting started\"",
     "description": "The heading, and the progress bar's name",
     "readonly": false
    },
    {
     "name": "steps",
     "attribute": null,
     "type": "ProgressStep[]",
     "default": "[]",
     "description": "The checklist. Each step's `done` flag is where it starts; when the flags change, the tracker follows them",
     "readonly": false
    },
    {
     "name": "done",
     "attribute": null,
     "type": "string[] | undefined",
     "default": "undefined",
     "description": "Ids of the ticked steps; unset, the tracker keeps its own",
     "readonly": false
    },
    {
     "name": "defaultDone",
     "attribute": null,
     "type": "string[] | undefined",
     "default": "undefined",
     "description": "Ids ticked at first when `done` is unset – defaults to the steps marked `done`",
     "readonly": false
    },
    {
     "name": "autoPlay",
     "attribute": "auto-play",
     "type": "boolean",
     "default": "false",
     "description": "Ticks the open steps one after another, then starts over",
     "readonly": false
    },
    {
     "name": "interval",
     "attribute": "interval",
     "type": "number",
     "default": "2200",
     "description": "Pause between two automatic steps, in ms",
     "readonly": false
    },
    {
     "name": "readonly",
     "attribute": "readonly",
     "type": "boolean",
     "default": "false",
     "description": "A status list: every step shows its state as text, nothing can be ticked and auto play stays off",
     "readonly": false
    },
    {
     "name": "doneStyle",
     "attribute": "done-style",
     "type": "ProgressDoneStyle",
     "default": "\"strike\"",
     "description": "How done steps look: \"strike\" draws a line through them, \"plain\" only grays them",
     "readonly": false
    },
    {
     "name": "fit",
     "attribute": "fit",
     "type": "ProgressFit",
     "default": "\"compact\"",
     "description": "The card's width: \"compact\" (up to 360 px), \"wide\" (up to 560 px) or \"fill\" (no maximum)",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-done-change",
     "detail": "",
     "description": "A step was ticked or cleared (by a click or auto play); detail `{ done: string[], steps }` – the ticked ids and every step with its new `done` flag. Cancelable: preventDefault() leaves the ticks as they are (controlled use)",
     "cancelable": true
    }
