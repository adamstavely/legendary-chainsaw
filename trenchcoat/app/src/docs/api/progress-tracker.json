 "react": [
  {
   "component": "ProgressTracker",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the progress bar's name"
    },
    {
     "name": "steps",
     "type": "ProgressStep[]",
     "optional": false,
     "description": "The checklist. Each step's `done` flag is where it starts; when the flags change, the tracker follows them"
    },
    {
     "name": "done",
     "type": "string[]",
     "optional": true,
     "description": "Ids of the ticked steps. Controlled when defined – pair it with `onDoneChange`"
    },
    {
     "name": "defaultDone",
     "type": "string[]",
     "optional": true,
     "description": "Ids ticked on mount when `done` isn't controlled – defaults to the steps marked `done`"
    },
    {
     "name": "onDoneChange",
     "type": "(done: string[]) => void",
     "optional": true,
     "description": "Called with the ticked ids whenever a step is ticked or cleared"
    },
    {
     "name": "onChange",
     "type": "(steps: ProgressStep[]) => void",
     "optional": true,
     "description": "Called with every step and its new `done` flag whenever a step is ticked or cleared"
    }
   ],
   "hides": [
    "heading",
    "steps",
    "done",
    "defaultDone",
    "onChange"
   ],
   "events": {
    "tc-done-change": "onDoneChange"
   }
  }
 ],
