 "react": [
  {
   "component": "SideNav",
   "exported": true,
   "props": [
    {
     "name": "current",
     "type": "string | null",
     "optional": true,
     "description": "The current page's item id – controlled when given; your router sets it"
    },
    {
     "name": "defaultCurrent",
     "type": "string | null",
     "optional": true,
     "description": "The current item at first, when `current` isn't controlled; then a click moves it"
    },
    {
     "name": "onNavigate",
     "type": "(id: string, href: string | undefined, event: CustomEvent<SideNavNavigate>) => void",
     "optional": true,
     "description": "An item or the linked brand (id \"brand\", `event.detail.brand`) was clicked; call `event.preventDefault()` to route a link yourself instead of following it"
    },
    {
     "name": "collapsed",
     "type": "boolean",
     "optional": true,
     "description": "Folded into an icon-only rail – controlled when given"
    },
    {
     "name": "defaultCollapsed",
     "type": "boolean",
     "optional": true,
     "description": "Folded at first, when `collapsed` isn't controlled"
    },
    {
     "name": "onCollapsedChange",
     "type": "(collapsed: boolean) => void",
     "optional": true,
     "description": "The collapse button was pressed"
    }
   ],
   "hides": [
    "current",
    "collapsed"
   ],
   "events": {
    "tc-navigate": "onNavigate",
    "tc-collapsed-change": null
   }
  }
 ],
 "changelog": [
  "**Side Nav** (`tc-side-nav`): an app's main navigation down the side – the brand at the top, places with icons, badges and section captions, one of them the current page (`aria-current=\"page\"`), and the page's own children at the bottom. Items with `href` are real links; a plain click fires a cancelable `tc-navigate` ({ id, href, item }) for a router, and ⌘/Ctrl- or Shift-clicks are left to the browser. `collapsible` folds it into an icon-only rail (`collapsed`, cancelable `tc-collapsed-change`). React `SideNav`, Angular `SideNav`."
 ],
