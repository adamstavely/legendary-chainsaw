 "functions": [
  {
   "name": "parseColorHex",
   "signature": "parseColorHex(text: string | null | undefined): ColorPickerRgb | null",
   "description": "\"#3a6df0\", \"3a6df0\", \"#36f\", \"#3a6df080\" → rgb with alpha 0–1, or null when it isn't a hex colour"
  },
  {
   "name": "colorToHex",
   "signature": "colorToHex({ r, g, b, a }: ColorPickerRgb, withAlpha: unknown): void",
   "description": "rgb → \"#rrggbb\", or \"#rrggbbaa\" when `withAlpha`"
  },
  {
   "name": "colorRgbToCmyk",
   "signature": "colorRgbToCmyk({ r, g, b }: Pick<ColorPickerRgb, \"r\" | \"g\" | \"b\">): ColorPickerCmyk",
   "description": "sRGB → CMYK percentages – a plain conversion, not a print profile"
  },
  {
   "name": "colorCmykToRgb",
   "signature": "colorCmykToRgb({ c, m, y, k }: ColorPickerCmyk): ColorPickerRgb",
   "description": "CMYK percentages → sRGB, alpha 1"
  }
 ],
 "react": [
  {
   "component": "ColorPicker",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading; by default \"Colour\""
    },
    {
     "name": "value",
     "type": "string",
     "optional": true,
     "description": "The colour, \"#rrggbb\" (\"#rrggbbaa\" with `alpha`) – controlled when given"
    },
    {
     "name": "defaultValue",
     "type": "string",
     "optional": true,
     "description": "The colour on mount when `value` isn't controlled; by default black"
    },
    {
     "name": "onValueChange",
     "type": "(value: string, detail: ColorPickerValueChange) => void",
     "optional": true,
     "description": "The colour changed; `detail` has it as rgb and CMYK too"
    },
    {
     "name": "format",
     "type": "ColorPickerFormat",
     "optional": true,
     "description": "Which fields show – controlled when given"
    },
    {
     "name": "defaultFormat",
     "type": "ColorPickerFormat",
     "optional": true,
     "description": "The fields on mount when `format` isn't controlled; by default \"hex\""
    },
    {
     "name": "onFormatChange",
     "type": "(format: ColorPickerFormat) => void",
     "optional": true,
     "description": "Another format was picked"
    },
    {
     "name": "onCopyColor",
     "type": "(text: string, format: ColorPickerFormat) => void | false",
     "optional": true,
     "description": "Copy was pressed with the colour as text; return false to copy it yourself"
    }
   ],
   "hides": [
    "heading",
    "value",
    "defaultValue",
    "format",
    "children"
   ],
   "events": {
    "tc-value-change": null,
    "tc-format-change": null,
    "tc-copy": "onCopyColor"
   }
  }
 ],
 "changelog": [
  "`tc-color-picker` – a saturation and brightness square, hue and opacity sliders, HEX / RGB / CMYK fields, an eyedropper where the browser has one (`EyeDropper`), swatches and Copy. A form control, so Angular gets a ValueAccessor. CMYK is a plain device-independent conversion, not an ICC print profile."
 ],
