{
 "elements": [
  {
   "tag": "tc-color-picker",
   "className": "TcColorPicker",
   "description": "Pick a colour – a saturation and brightness square, hue and opacity sliders, HEX / RGB / CMYK fields, an eyedropper,\nswatches and Copy.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The heading; by default the labels' heading, \"Colour\"",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "A line under the heading",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": "value",
     "type": "string",
     "default": "\"#000000\"",
     "description": "The colour, \"#rrggbb\" – \"#rrggbbaa\" with `alpha`. Changed by the user unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "previous",
     "attribute": "previous",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The colour shown beside the new one, which the chip puts back; by default the value when the element first rendered",
     "readonly": false
    },
    {
     "name": "format",
     "attribute": "format",
     "type": "ColorPickerFormat",
     "default": "\"hex\"",
     "description": "Which fields show: \"hex\", \"rgb\" or \"cmyk\". Changed by the user unless a tc-format-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "alpha",
     "attribute": "alpha",
     "type": "boolean",
     "default": "false",
     "description": "Adds an opacity slider and field; the value then carries alpha (\"#rrggbbaa\")",
     "readonly": false
    },
    {
     "name": "eyedropper",
     "attribute": "eyedropper",
     "type": "boolean",
     "default": "true",
     "description": "Shows the eyedropper where the browser has one (Chromium); set false to hide it everywhere",
     "readonly": false
    },
    {
     "name": "swatches",
     "attribute": null,
     "type": "ColorPickerSwatch[]",
     "default": "[]",
     "description": "Colours to pick from in one press: hex strings, or { value, name }",
     "readonly": false
    },
    {
     "name": "disabled",
     "attribute": "disabled",
     "type": "boolean",
     "default": "false",
     "description": "Nothing can be changed or focused except Copy",
     "readonly": false
    },
    {
     "name": "readonly",
     "attribute": "readonly",
     "type": "boolean",
     "default": "false",
     "description": "The colour shows and can be copied, but not changed",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<ColorPickerLabels>",
     "default": "{}",
     "description": "The picker's words, merged over defaultColorPickerLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "The colour changed ({ value, rgb, cmyk }: ColorPickerValueChange); cancelable – prevented, `value` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-format-change",
     "detail": "",
     "description": "Another format was picked ({ format }: ColorPickerFormatChange); cancelable – prevented, `format` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-copy",
     "detail": "",
     "description": "Copy was pressed ({ text, format }: ColorPickerCopy); cancelable – prevented, nothing is written to the clipboard",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "clp",
