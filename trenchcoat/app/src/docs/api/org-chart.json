     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "people",
     "attribute": null,
     "type": "OrgChartPerson[]",
     "default": "[]",
     "description": "Everyone, in the order their manager lists them; `manager` joins them up",
     "readonly": false
