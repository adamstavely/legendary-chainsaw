{
 "elements": [
  {
   "tag": "tc-org-chart",
   "className": "TcOrgChart",
   "description": "Who reports to whom: people's cards joined by reporting lines, branches that fold, search, a picked person's manager\nand reports, pan and zoom, and an outline when narrow.",
   "properties": [
    {
