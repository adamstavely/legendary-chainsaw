{
 "elements": [
  {
   "tag": "tc-diff-table",
   "className": "TcDiffTable",
   "description": "An AI's proposed edits to a table, reviewed in place: struck and new values per cell, added and removed rows, and accept, reject and undo per edit, per row or for all.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Proposed changes\"",
     "description": "The heading; empty draws no header",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "columns",
     "attribute": null,
     "type": "DiffTableColumn[]",
     "default": "[]",
     "description": "The columns, in order; the first one names each row",
     "readonly": false
    },
    {
     "name": "rows",
     "attribute": null,
     "type": "DiffTableRow[]",
     "default": "[]",
     "description": "The rows, in order",
     "readonly": false
    },
    {
     "name": "edits",
     "attribute": null,
     "type": "DiffTableEdit[]",
     "default": "[]",
     "description": "The proposed edits to single cells",
     "readonly": false
    },
    {
     "name": "decisions",
     "attribute": null,
     "type": "DiffTableDecisions",
     "default": "{}",
     "description": "The verdicts so far. Changed by the buttons and keys unless a tc-decisions-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "streaming",
     "attribute": "streaming",
     "type": "boolean",
     "default": "false",
     "description": "The edits are still arriving: they sweep in a row at a time, and Accept all waits until they're all in",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<DiffTableLabels>",
     "default": "{}",
     "description": "Rename any of the words, over the defaults",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-edit-change",
     "detail": "",
     "description": "One edit was accepted or rejected ({ edit, decision }: DiffTableEditChange); cancelable – prevented, nothing changes",
     "cancelable": true
    },
    {
     "name": "tc-decisions-change",
     "detail": "",
     "description": "Any decision, row, all or undo, with every verdict ({ decisions }: DiffTableDecisionsChange); cancelable – prevented, `decisions` stays as it was",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "decide",
     "params": "key: string, decision: DiffTableVerdict",
     "returns": "void",
     "description": "One edit, or a row's own add or remove"
    },
    {
     "name": "decideRow",
     "params": "id: string, decision: DiffTableVerdict",
     "returns": "void",
     "description": "Everything still pending in a row"
    },
    {
     "name": "decideAll",
     "params": "decision: DiffTableVerdict",
     "returns": "void",
     "description": "Everything still pending – once every edit has arrived"
    },
    {
     "name": "undo",
     "params": "",
     "returns": "void",
     "description": "Restores the verdicts before the last change"
    }
