 "functions": [
  {
   "name": "qualityBand",
   "signature": "qualityBand(score: QualityScore, spread: unknown, z: unknown): void",
   "description": "Half the width of a score's band: z × standard error, from its own spread or the element's `spread`"
  },
  {
   "name": "qualityShift",
   "signature": "qualityShift(days: readonly QualityDay[], id: string, at: number): QualityShift",
   "description": "A criterion's mean on the days before `at` and on the days from it, each weighted by the day's chats"
  }
 ],
