{
 "elements": [
  {
   "tag": "tc-quality-trend",
   "className": "TcQualityTrend",
   "description": "Judge scores on live chats day by day, a line per criterion with a band from its sample size, the changes pinned on\nthe time axis, a 7 / 30 / 90-day switch, and a table view.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Quality on live chats\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "A line under the heading – the agent, the judge",
     "readonly": false
    },
    {
     "name": "criteria",
     "attribute": null,
     "type": "QualityCriterion[]",
     "default": "[]",
     "description": "The criteria the judge scores, in legend order",
     "readonly": false
    },
    {
     "name": "days",
     "attribute": null,
     "type": "QualityDay[]",
     "default": "[]",
     "description": "One entry per day, any order – the last day is the end of every range",
     "readonly": false
    },
    {
     "name": "changes",
     "attribute": null,
     "type": "QualityChange[]",
     "default": "[]",
     "description": "The changes made to the agent – prompts, models, tools – pinned where they went live",
     "readonly": false
    },
    {
     "name": "range",
     "attribute": "range",
     "type": "QualityRange",
     "default": "\"30d\"",
     "description": "How many days show: \"7d\", \"30d\" or \"90d\"",
     "readonly": false
    },
    {
     "name": "shown",
     "attribute": null,
     "type": "string[] | null",
     "default": "null",
     "description": "The ids of the criteria drawn; null draws every one",
     "readonly": false
    },
    {
     "name": "view",
     "attribute": "view",
     "type": "QualityTrendView",
     "default": "\"chart\"",
     "description": "\"chart\", or \"table\" for the same days as a table",
     "readonly": false
    },
    {
     "name": "min",
     "attribute": "min",
     "type": "number",
     "default": "1",
     "description": "The lowest score on the scale",
     "readonly": false
    },
    {
     "name": "max",
     "attribute": "max",
     "type": "number",
     "default": "5",
     "description": "The highest score on the scale",
     "readonly": false
    },
    {
     "name": "spread",
     "attribute": "spread",
     "type": "number",
     "default": "1",
     "description": "A score's spread (standard deviation) when a day gives none – sets the band's width with the day's chats",
     "readonly": false
    },
    {
     "name": "threshold",
     "attribute": "threshold",
     "type": "number",
     "default": "0.1",
     "description": "How far a mean must move for the summary to call it a change",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string",
     "default": "\"en-US\"",
     "description": "Formats dates and numbers",
     "readonly": false
    },
    {
     "name": "timeZone",
     "attribute": "time-zone",
     "type": "string",
     "default": "\"UTC\"",
     "description": "The time zone dates are read in – UTC by default, so a day's midnight stays that day",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-range-change",
     "detail": "",
     "description": "7, 30 or 90 days was picked ({ range }: QualityTrendRangeChange); cancelable – prevented, `range` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-shown-change",
     "detail": "",
     "description": "A criterion was shown or hidden ({ shown }: QualityTrendShownChange); cancelable – prevented, `shown` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-view-change",
     "detail": "",
     "description": "Table was pressed ({ view }: QualityTrendViewChange); cancelable – prevented, `view` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-change-open",
     "detail": "",
     "description": "A change pin was clicked or picked with Enter ({ id, change }: QualityTrendChangeOpen)",
     "cancelable": false
    }
   ],
