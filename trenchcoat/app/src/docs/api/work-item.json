{
 "elements": [
  {
   "tag": "tc-work-item",
   "className": "TcWorkItem",
   "description": "A work item card – title, status, a note, progress, due date, people, what it delivers, spent against budget and\neffort – that opens as a link or a button.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The work's title, and the card's control",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "WorkStatus",
     "default": "\"active\"",
     "description": "Where the work stands: active, blocked, review, done or paused – shown in words with a mark",
     "readonly": false
    },
    {
     "name": "statusLabels",
     "attribute": null,
     "type": "Partial<Record<WorkStatus, string>>",
     "default": "{}",
     "description": "The statuses' names, merged over the defaults (Active, Blocked, In review, Done, Paused)",
     "readonly": false
    },
    {
     "name": "note",
     "attribute": "note",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the title: the blocker, the next step",
     "readonly": false
    },
    {
     "name": "progress",
     "attribute": "progress",
     "type": "number | undefined",
     "default": "undefined",
     "description": "How far along, from 0 to 1; no bar when unset",
     "readonly": false
    },
    {
     "name": "due",
     "attribute": "due",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When it's due, as epoch ms",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The time to compare `due` with, as epoch ms; today when unset",
     "readonly": false
    },
    {
     "name": "people",
     "attribute": null,
     "type": "WorkPerson[]",
     "default": "[]",
     "description": "Who's on it",
     "readonly": false
    },
    {
     "name": "outcome",
     "attribute": "outcome",
     "type": "string | undefined",
     "default": "undefined",
     "description": "What it delivers, as a tag, e.g. \"fills 1 gap\"",
     "readonly": false
    },
    {
     "name": "spent",
     "attribute": "spent",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Money spent so far",
     "readonly": false
    },
    {
     "name": "budget",
     "attribute": "budget",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The money it has; spent is shown against it",
     "readonly": false
    },
    {
     "name": "currency",
     "attribute": "currency",
     "type": "string",
     "default": "\"USD\"",
     "description": "The currency of `spent` and `budget`, as an ISO 4217 code",
     "readonly": false
    },
    {
     "name": "effort",
     "attribute": "effort",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The effort, written as shown, e.g. \"1.5 FTE\"",
     "readonly": false
    },
    {
     "name": "source",
     "attribute": "source",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Where the item comes from when it's mirrored, e.g. \"Synced · read-only\"",
     "readonly": false
    },
    {
     "name": "href",
     "attribute": "href",
     "type": "string | undefined",
     "default": "undefined",
