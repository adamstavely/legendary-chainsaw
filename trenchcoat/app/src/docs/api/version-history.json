 "functions": [],
 "react": [
  {
   "component": "VersionHistory",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the region's name"
    },
    {
     "name": "versions",
     "type": "VersionEntry[]",
     "optional": true,
     "description": "The versions, newest first – controlled when defined; pair it with `onVersionsChange`"
    },
    {
     "name": "defaultVersions",
     "type": "VersionEntry[]",
     "optional": true,
     "description": "The versions at first, when `versions` isn't controlled – the element applies activations itself"
    },
    {
     "name": "onVersionsChange",
     "type": "(versions: VersionEntry[]) => void",
     "optional": true,
     "description": "Called with the whole list after a draft is activated"
    },
    {
     "name": "selected",
     "type": "string | null",
     "optional": true,
     "description": "The version whose detail shows – controlled when defined"
    },
    {
     "name": "defaultSelected",
     "type": "string | null",
     "optional": true,
     "description": "The version shown at first (default: the draft, else the active version, else the newest)"
    },
    {
     "name": "onSelectedChange",
     "type": "(id: string) => void",
     "optional": true,
     "description": "Called when another version is selected"
    },
    {
     "name": "onCompare",
     "type": "(detail: VersionCompareDetail, event: CustomEvent<VersionCompareDetail>) => void",
     "optional": true,
     "description": "Called when two versions are picked to compare; call `event.preventDefault()` to show the comparison yourself"
    },
    {
     "name": "onRestore",
     "type": "(version: VersionEntry, event: CustomEvent<VersionRestoreDetail>) => void",
     "optional": true,
     "description": "Called when Restore is pressed – add the new draft to `versions` to answer it; `event.preventDefault()` declines"
    },
    {
     "name": "onActivate",
     "type": "(detail: VersionActivateDetail) => void",
     "optional": true,
     "description": "Called when a draft's activation is confirmed, with the draft, the version it replaces and the list after"
    }
   ],
   "hides": [
    "versions",
    "selected",
    "heading"
   ],
   "events": {
    "tc-select-change": null,
    "tc-compare": "onCompare",
    "tc-restore": "onRestore",
    "tc-activate": "onActivate"
   }
  }
 ],
