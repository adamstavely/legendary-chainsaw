{
 "elements": [
  {
   "tag": "tc-version-history",
   "className": "TcVersionHistory",
   "description": "The versions of an agent, prompt or workflow on a timeline – draft, active or deprecated, who and when, and what\neach changed in behaviour – with compare, restore and a confirmed approve-and-activate.",
   "properties": [
    {
     "name": "versions",
     "attribute": null,
     "type": "VersionEntry[]",
     "default": "[]",
     "description": "The versions, newest first",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Version history\"",
     "description": "The heading, and the region's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"What each version does differently\"",
     "description": "The quiet line under the heading",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The version whose detail shows; unset follows the draft, else the active version, else the newest",
     "readonly": false
    },
    {
     "name": "resolveCompare",
     "attribute": null,
     "type": "VersionCompareResolver | undefined",
     "default": "undefined",
     "description": "Answers a comparison with the changes between two versions; unset, the element gathers them from the versions in between",
     "readonly": false
    },
    {
     "name": "activateBlocked",
     "attribute": "activate-blocked",
     "type": "string",
     "default": "\"\"",
     "description": "Why the draft can't be activated by this person; set, Approve and activate stays unavailable and says so",
     "readonly": false
    },
    {
     "name": "canRestore",
     "attribute": "can-restore",
     "type": "boolean",
     "default": "true",
     "description": "Restore is offered on past versions (default true)",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "360",
     "description": "The tallest the timeline grows, in px, before it scrolls",
     "readonly": false
    },
    {
     "name": "statusLabels",
     "attribute": null,
     "type": "Partial<Record<VersionStatus, string>>",
     "default": "{}",
     "description": "The names of the statuses – in place of Draft, Active and Deprecated",
     "readonly": false
    },
    {
     "name": "changeLabels",
     "attribute": null,
     "type": "Partial<Record<VersionChangeKind, string>>",
     "default": "{}",
     "description": "What screen readers hear before each change – in place of Added, Removed and Changed",
     "readonly": false
    },
    {
     "name": "activateLabel",
     "attribute": "activate-label",
     "type": "string",
     "default": "\"Approve and activate\"",
     "description": "The approve button and the confirmation's action",
     "readonly": false
    },
    {
     "name": "restoreLabel",
     "attribute": "restore-label",
     "type": "string",
     "default": "\"Restore as draft\"",
     "description": "The restore button",
     "readonly": false
    },
    {
     "name": "compareLabel",
     "attribute": "compare-label",
     "type": "string",
     "default": "\"Compare\"",
     "description": "The compare toggle",
     "readonly": false
    },
    {
     "name": "cancelLabel",
     "attribute": "cancel-label",
     "type": "string",
     "default": "\"Cancel\"",
     "description": "The confirmation's cancel button",
     "readonly": false
    },
    {
     "name": "activeVersion",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "The version in use, if any",
     "readonly": true
    },
    {
     "name": "current",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "The version the detail shows",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-select-change",
     "detail": "",
     "description": "The version shown in the detail changed; detail `{ id, version }` (VersionSelectDetail). Cancelable – prevented, `selected` stays.",
     "cancelable": true
    },
    {
     "name": "tc-compare",
     "detail": "",
     "description": "Two versions were picked to compare; detail `{ from, to, changes }` (VersionCompareDetail). Cancelable – prevented, the app shows the comparison itself.",
     "cancelable": true
    },
    {
     "name": "tc-restore",
     "detail": "",
     "description": "Restore was pressed on a past version; detail `{ version }` (VersionRestoreDetail). Cancelable – not prevented, the version shows \"Restore requested\" until `versions` changes.",
     "cancelable": true
    },
    {
     "name": "tc-activate",
     "detail": "",
     "description": "A draft's activation was confirmed; detail `{ version, previous, versions }` (VersionActivateDetail). Cancelable – not prevented, `versions` becomes the list after the change.",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "vhist",
   "cssProperties": [
    {
