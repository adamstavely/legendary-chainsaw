{
 "elements": [
  {
   "tag": "tc-point-and-ask",
   "className": "TcPointAndAsk",
   "description": "Pin or box parts of an image, ask about each and about all of them – marks you can move, resize and remove from the\nkeyboard, and answers streamed back per mark.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Ask about the image\"",
     "description": "The title above the image",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the title",
     "readonly": false
    },
    {
     "name": "src",
     "attribute": "src",
     "type": "string",
     "default": "\"\"",
     "description": "The image",
     "readonly": false
    },
    {
     "name": "alt",
     "attribute": "alt",
     "type": "string",
     "default": "\"\"",
     "description": "What the image shows, for screen readers",
     "readonly": false
    },
    {
     "name": "marks",
     "attribute": null,
     "type": "PointMark[]",
     "default": "[]",
     "description": "The marks, in order; their numbers follow it",
     "readonly": false
    },
    {
     "name": "question",
     "attribute": "question",
     "type": "string",
     "default": "\"\"",
     "description": "The question over all the marks",
     "readonly": false
    },
    {
     "name": "answers",
     "attribute": null,
     "type": "Record<string, string>",
     "default": "{}",
     "description": "Answers by mark id, shown under each mark (update it as the text streams in)",
     "readonly": false
    },
    {
     "name": "answer",
     "attribute": "answer",
     "type": "string",
     "default": "\"\"",
     "description": "The answer to the overall question",
     "readonly": false
    },
    {
     "name": "busy",
     "attribute": "busy",
     "type": "boolean",
     "default": "false",
     "description": "Holds everything while the page answers; Ask turns it on unless tc-ask is prevented",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<PointAndAskLabels>",
     "default": "{}",
     "description": "Words the page can rename (merged over defaultPointAndAskLabels)",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-marks-change",
     "detail": "",
     "description": "A mark was added, moved, resized, removed or given a question ({ marks, reason, id }: PointMarksChange); cancelable – prevented, the marks stay as they were",
     "cancelable": true
    },
    {
     "name": "tc-question-change",
     "detail": "",
     "description": "The overall question was edited ({ question }: PointQuestionChange); cancelable – prevented, the text goes back",
     "cancelable": true
    },
    {
     "name": "tc-ask",
     "detail": "",
     "description": "Ask was pressed ({ marks, question }: PointAsk); cancelable – not prevented, the element turns `busy` until the page clears it",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "addMark",
     "params": "kind: \"pin\" | \"box\", at?: Partial<PointMark>",
     "returns": "void",
     "description": "Adds a mark (a pin in the middle, or a box around it, by default) and selects it"
    },
    {
     "name": "removeMark",
     "params": "id: string",
     "returns": "void",
     "description": "Removes a mark"
    }
   ],
   "ui": "paq",
   "cssProperties": [
    {
     "name": "--tc-paq-pin",
     "value": "var(--tc-space-6)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-paq-side-min",
     "value": "260px",
     "looks": [
      "both"
     ]
    }
   ],
