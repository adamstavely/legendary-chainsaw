{
 "elements": [
  {
   "tag": "tc-tool-configuration",
   "className": "TcToolConfiguration",
   "description": "A tool as its API reference entry: the name as the title, the signature and description, a doc table of the\nparameters edited in place, an example call, the JSON Schema on request, a validation strip and the approval a\ncall needs.",
   "properties": [
    {
     "name": "value",
     "attribute": null,
     "type": "ToolConfigurationValue",
     "default": "{ name: \"\", description: \"\", parameters: [], approval: \"inherit\" }",
     "description": "The definition. Changed by the user unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "approvals",
     "attribute": null,
     "type": "ToolApprovalOption[]",
     "default": "[ { id: \"inherit\", label: \"Follows tool permissions\", description: \"Each agent's access is set where tool permissions are managed\" }, { id: \"ask\", label: \"Ask every time\", description: \"A person approves each call before it runs\" }, { id: \"auto\", label: \"Runs on its own\", description: \"For tools that only read – lookups and searches\" }, ]",
     "description": "The approvals offered in the head's picker; empty hides it",
     "readonly": false
    },
    {
     "name": "types",
     "attribute": null,
     "type": "{ id: ToolParameterType; label: string }[]",
     "default": "[ { id: \"string\", label: \"Text\" }, { id: \"number\", label: \"Number\" }, { id: \"integer\", label: \"Integer\" }, { id: \"boolean\", label: \"Yes / no\" }, { id: \"array\", label: \"List\" }, { id: \"object\", label: \"Object\" }, ]",
     "description": "The parameter types offered, with their labels",
     "readonly": false
    },
    {
     "name": "example",
     "attribute": null,
     "type": "Record<string, unknown> | undefined",
     "default": "undefined",
     "description": "The arguments Example call shows; unset, they're made from the parameters (toolExampleCall)",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"New tool\"",
     "description": "The title while the tool has no name; the tool's name replaces it",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "A quieter line under the title",
     "readonly": false
    },
    {
     "name": "showSchema",
     "attribute": "show-schema",
     "type": "boolean",
     "default": "true",
     "description": "Shows the JSON Schema disclosure",
     "readonly": false
    },
    {
     "name": "showExample",
     "attribute": "show-example",
     "type": "boolean",
     "default": "true",
     "description": "Shows the Example call panel",
     "readonly": false
    },
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"\"",
     "description": "Submitted with the form: the definition as JSON",
     "readonly": false
    },
    {
     "name": "disabled",
     "attribute": "disabled",
     "type": "boolean",
     "default": "false",
     "description": "Turns every control off and leaves the definition out of the form; a disabled fieldset does the same",
     "readonly": false
    },
    {
     "name": "issues",
     "attribute": null,
     "type": "ToolIssue[]",
     "default": null,
     "description": "What's wrong or missing, as the strip lists it",
     "readonly": true
    },
    {
     "name": "schema",
     "attribute": null,
     "type": "Record<string, unknown>",
     "default": null,
     "description": "The JSON Schema the parameters produce",
     "readonly": true
    },
    {
     "name": "exampleCall",
     "attribute": null,
     "type": "Record<string, unknown>",
     "default": null,
     "description": "The arguments Example call shows: `example`, or ones made from the parameters",
     "readonly": true
    },
    {
     "name": "signature",
     "attribute": null,
     "type": "string",
     "default": null,
     "description": "The tool as the model sees it: name(param: type, optional?: type)",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
