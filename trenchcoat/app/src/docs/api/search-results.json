    {
     "name": "options",
     "attribute": null,
     "type": "SearchResultsOptions",
     "default": "{ caseSensitive: false, wholeWord: false, regex: false }",
     "description": "Match case, whole word and regular expression",
     "readonly": false
    },
    {
     "name": "results",
     "attribute": null,
     "type": "SearchResultsFile[]",
     "default": "[]",
     "description": "The files that matched, each with its matching lines",
     "readonly": false
