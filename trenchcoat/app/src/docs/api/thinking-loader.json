{
 "elements": [
  {
   "tag": "tc-thinking-loader",
   "className": "TcThinkingLoader",
   "description": "A \"the model is working\" pill: a mark (rays or a pixel grid) and a label that walks through phases, then a check and a done label – or a cross on error.",
   "properties": [
    {
     "name": "phases",
     "attribute": null,
     "type": "string[]",
     "default": "[\"Thinking\", \"Searching the web\", \"Reading sources\", \"Writing response\"]",
     "description": "Labels to walk through, one after another",
     "readonly": false
    },
    {
     "name": "label",
     "attribute": "label",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One fixed label instead of `phases` – it stays when the work ends, and the status says how it ended",
     "readonly": false
    },
    {
     "name": "interval",
     "attribute": "interval",
     "type": "number",
     "default": "2200",
     "description": "Time per phase, in ms",
     "readonly": false
    },
    {
     "name": "phase",
     "attribute": "phase",
     "type": "number",
     "default": "0",
     "description": "The phase shown. The timer moves it on unless a tc-phase-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "manual",
     "attribute": "manual",
     "type": "boolean",
     "default": "false",
     "description": "The phase is set from outside (e.g. from stream events): no timer",
     "readonly": false
    },
    {
     "name": "startedAt",
     "attribute": "startedAt",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When the work started, in epoch ms – the done label and the time count from here. Defaults to when the loader connected (or work restarted)",
     "readonly": false
    },
    {
     "name": "started",
     "attribute": "started",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The same as `startedAt`, kept from Pixel Loader",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The current time, in epoch ms – given, the loader keeps no clock of its own and counts up to it",
     "readonly": false
    },
    {
     "name": "loop",
     "attribute": "loop",
     "type": "boolean",
     "default": "false",
     "description": "Start over after the last phase instead of holding it – at most twice, then it holds the last phase (WCAG 2.2.2)",
     "readonly": false
    },
    {
     "name": "state",
     "attribute": "state",
     "type": "ThinkingLoaderState",
     "default": "\"working\"",
     "description": "How the work stands: \"working\" animates and counts; \"done\" turns the mark into a check; \"error\" into a cross",
     "readonly": false
    },
    {
     "name": "done",
     "attribute": "done",
     "type": "boolean",
     "default": "false",
     "description": "Finished – the same as state=\"done\", kept for existing pages",
     "readonly": false
    },
    {
     "name": "doneLabel",
     "attribute": null,
     "type": "string | ((seconds: number) => string)",
     "default": null,
     "description": "Label once done (with `phases`) – a string, or a function that gets the seconds since the loader started",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<ThinkingLoaderLabels>",
     "default": "{}",
     "description": "Rename the words for how it ended, over the defaults",
     "readonly": false
    },
    {
     "name": "mark",
     "attribute": "mark",
     "type": "ThinkingLoaderMark",
     "default": "\"rays\"",
     "description": "The mark: \"rays\" (the default) or \"pixels\", a 5 × 5 grid lit in `pattern`",
     "readonly": false
    },
    {
     "name": "pattern",
     "attribute": "pattern",
     "type": "ThinkingLoaderPattern",
     "default": "\"wave\"",
     "description": "How the pixels move: a diagonal \"wave\", a lit dot that \"drive\"s a snake path, a seeded \"dots\" twinkle, or an \"orbit\" round the edge",
     "readonly": false
    },
    {
     "name": "hideTime",
     "attribute": "hide-time",
     "type": "boolean",
     "default": "false",
     "description": "Hides the time since the work started (shown with mark=\"pixels\")",
     "readonly": false
    },
    {
     "name": "size",
     "attribute": "size",
     "type": "\"sm\" | \"md\"",
     "default": "\"md\"",
     "description": "\"md\" is the default pill; \"sm\" is smaller, e.g. inside a chat bubble",
     "readonly": false
    },
    {
     "name": "variant",
     "attribute": "variant",
     "type": "\"pill\" | \"plain\"",
     "default": "\"pill\"",
     "description": "\"pill\" = bordered capsule, \"plain\" = just the mark and the label, e.g. inside a chat bubble",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": null,
     "type": "ThinkingLoaderState",
     "default": null,
     "description": "How the work stands, from `state` or the older `done`",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-phase-change",
     "detail": "",
     "description": "The timer moved to another phase (detail: { phase: number }); cancelable – the phase stays if a listener calls preventDefault()",
     "cancelable": true
    }
   ],
