{
 "elements": [
  {
   "tag": "tc-moderation-queue",
   "className": "TcModerationQueue",
   "description": "Reported replies, one decision each – the report or automatic flag, the policy, the conversation with the reported\nreply marked, and Keep, Remove reply, Restrict user or Escalate from buttons or keys, with Undo.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Moderation\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "items",
     "attribute": null,
     "type": "ModerationItem[]",
     "default": "[]",
     "description": "The reported replies, oldest first",
     "readonly": false
    },
    {
     "name": "index",
     "attribute": "index",
     "type": "number",
     "default": "0",
     "description": "The item on screen. Changed by deciding and moving unless a tc-index-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "decisions",
     "attribute": null,
     "type": "Record<string, ModerationVerdict>",
     "default": "{}",
     "description": "Every decision so far, by item id. Changed by deciding and Undo unless a tc-decisions-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "decisionLabels",
     "attribute": null,
     "type": "Partial<ModerationDecisionLabels>",
     "default": "{}",
     "description": "The buttons' words, merged over defaultModerationDecisionLabels",
     "readonly": false
    },
    {
     "name": "noShortcuts",
     "attribute": "no-shortcuts",
     "type": "boolean",
     "default": "false",
     "description": "Turns off the single-letter keys",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "For dates",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-decide",
     "detail": "",
     "description": "A decision was made ({ id, decision, note, item }: ModerationDecide); cancelable – prevented, nothing is recorded",
     "cancelable": true
    },
    {
     "name": "tc-decisions-change",
     "detail": "",
     "description": "The decisions changed, by a decision or Undo ({ decisions, id }: ModerationDecisionsChange); cancelable – prevented, `decisions` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-index-change",
     "detail": "",
     "description": "Another item opened ({ index, item }: ModerationIndexChange); cancelable – prevented, `index` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-undo",
     "detail": "",
     "description": "Undo took the last decision back ({ id, decision }: ModerationUndo); cancelable – prevented, the decision stays",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "decide",
     "params": "decision: ModerationDecision",
     "returns": "void",
     "description": "Decides the item on screen; a decision that needs a note and has none asks for it instead"
    },
    {
     "name": "undo",
     "params": "",
     "returns": "void",
     "description": "Takes the last decision made here back"
    }
