   "className": "TcFacetSidebar",
   "description": "Search filters with counts – checkbox, radio, range and date facets that fold, the filters in use as removable\nchips with Clear all, Show more, and a search box in long facets.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Filters\"",
