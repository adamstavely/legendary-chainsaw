     "optional": true,
     "description": "The filters on mount when `value` isn't controlled"
    },
    {
     "name": "onValueChange",
     "type": "(value: FacetValues, facet: string) => void",
     "optional": true,
     "description": "A filter changed; `facet` is the facet's id (\"\" for Clear all)"
    },
    {
     "name": "collapsed",
     "type": "string[]",
     "optional": true,
     "description": "Folded facets – controlled when given"
    },
    {
     "name": "defaultCollapsed",
     "type": "string[]",
     "optional": true,
     "description": "Folded facets on mount when `collapsed` isn't controlled"
    },
    {
     "name": "onCollapsedChange",
     "type": "(collapsed: string[]) => void",
     "optional": true,
     "description": "A facet was folded or opened"
    }
   ],
   "hides": [
    "heading",
    "value",
    "defaultValue",
    "collapsed",
    "children"
   ],
   "events": {
    "tc-value-change": "onValueChange",
    "tc-collapsed-change": null
   }
  }
 ],
 "changelog": [
  "**Search** - **Results List** (`tc-results-list`) – results with the query's words marked in their snippets, grouped by kind with counts, Relevance / Date, “Did you mean” and Show more. - **Facet Sidebar** (`tc-facet-sidebar`) – checkbox, radio, range and date filters with counts, active filters as chips with Clear all. - **Saved Search Alerts** (`tc-saved-search-alerts`) – saved searches that report new matches, with frequency, channels, pause, Run now and remove with Undo."
 ],
