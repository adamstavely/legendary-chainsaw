     "name": "facets",
     "attribute": null,
     "type": "Facet[]",
     "default": "[]",
     "description": "The facets, in order",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": null,
     "type": "FacetValues",
     "default": "{}",
     "description": "The filters in use, by facet id. Changed by the user unless tc-value-change is prevented",
     "readonly": false
    },
    {
     "name": "collapsed",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The ids of folded facets. Changed by the user unless tc-collapsed-change is prevented",
     "readonly": false
    },
    {
     "name": "showCount",
     "attribute": "show-count",
     "type": "number",
     "default": "5",
     "description": "How many options a facet shows before \"Show n more\"",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for numbers and dates, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
