     "optional": true,
     "description": "Opened or closed (the badge, the hotkey, Escape, Close)"
    },
    {
     "name": "onBreakpointChange",
     "type": "(detail: BreakpointOverlayBreakpointChange) => void",
     "optional": true,
     "description": "The breakpoint in force changed as the width changed"
    }
   ],
