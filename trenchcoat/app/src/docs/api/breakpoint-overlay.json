{
 "elements": [
  {
   "tag": "tc-breakpoint-overlay",
   "className": "TcBreakpointOverlay",
   "description": "Which breakpoint the page is at – a badge in the window's corner that opens a panel of every breakpoint, with a\nruler across the top of the window; ⌥⇧O to open it.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Breakpoints\"",
     "description": "The panel's heading",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": "open",
     "type": "boolean",
     "default": "false",
     "description": "Whether the panel is open. Changed by the user unless a tc-open-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "breakpoints",
     "attribute": null,
     "type": "BreakpointOverlayBreakpoint[]",
     "default": "defaultBreakpoints",
     "description": "The breakpoints, in px: min only, max only, or a range. Tailwind's by default",
     "readonly": false
    },
    {
     "name": "hotkey",
     "attribute": null,
     "type": "string | false",
     "default": "\"alt+shift+o\"",
     "description": "Opens and closes it from anywhere (\"alt+shift+o\" is ⌥⇧O on Apple keyboards, Alt Shift O elsewhere); false turns it off",
     "readonly": false
    },
    {
     "name": "showRuler",
     "attribute": "show-ruler",
     "type": "boolean",
     "default": "true",
     "description": "While open, a ruler across the top of the window with each breakpoint and the width. Only when it follows the window",
     "readonly": false
    },
    {
     "name": "floating",
     "attribute": "floating",
     "type": "boolean",
     "default": "true",
     "description": "The badge and panel float at the window's corner; off, it's a card in the page, always open",
     "readonly": false
    },
    {
     "name": "corner",
     "attribute": "corner",
     "type": "BreakpointOverlayCorner",
     "default": "\"bottom-left\"",
     "description": "Which corner of the window it floats in",
     "readonly": false
    },
    {
     "name": "target",
     "attribute": null,
     "type": "Element | null",
     "default": "null",
     "description": "Follow this element's width instead of the window's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-open-change",
     "detail": "",
     "description": "Opened or closed ({ open }: BreakpointOverlayOpenChange), by the badge, the hotkey, Escape or Close; cancelable – prevented, `open` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-breakpoint-change",
     "detail": "",
     "description": "The breakpoint in force changed as the width changed ({ breakpoint, width }: BreakpointOverlayBreakpointChange)",
     "cancelable": false
    }
   ],
