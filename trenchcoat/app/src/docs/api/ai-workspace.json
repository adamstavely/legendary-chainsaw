  {
   "name": "aiWorkspaceDemoRespond",
   "signature": "aiWorkspaceDemoRespond(message: string): void",
   "description": "Demo answers – swap for a real model via `respond`"
  },
  {
   "name": "defaultAiWorkspaceConversations",
   "signature": "defaultAiWorkspaceConversations: AiWorkspaceConversation[]",
   "description": "The sample conversations shown when `conversations` isn't set"
  },
