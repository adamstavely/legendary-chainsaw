   "signature": "defaultAiWorkspaceProjects: AiWorkspaceProject[]",
   "description": "The sample projects shown when `projects` isn't set"
  }
 ],
 "react": [
  {
   "component": "AiWorkspace",
   "exported": true,
   "props": [
    {
     "name": "conversations",
     "type": "AiWorkspaceConversation[]",
     "optional": true,
     "description": "The conversations (controlled) – pass `onConversationsChange` with it. Leave undefined to start from `defaultConversations`"
    },
    {
     "name": "defaultConversations",
     "type": "AiWorkspaceConversation[]",
     "optional": true,
     "description": "The conversations on mount when `conversations` isn't controlled"
    },
    {
     "name": "onConversationsChange",
     "type": "(conversations: AiWorkspaceConversation[]) => void",
     "optional": true,
     "description": "Called with the whole list after a message is sent or answered, or a chat is deleted"
    },
    {
     "name": "projects",
     "type": "AiWorkspaceProject[]",
     "optional": true,
     "description": "The projects (controlled) – pass `onProjectsChange` with it. Leave undefined to start from `defaultProjects`"
    },
    {
     "name": "defaultProjects",
     "type": "AiWorkspaceProject[]",
     "optional": true,
     "description": "The projects on mount when `projects` isn't controlled"
    },
    {
     "name": "onProjectsChange",
     "type": "(projects: AiWorkspaceProject[]) => void",
     "optional": true,
     "description": "Called with the whole list after a project is created, renamed, pinned or unpinned"
    },
    {
     "name": "onShareChat",
     "type": "(conversation: AiWorkspaceConversation | null) => void",
     "optional": true,
     "description": "Share chat was picked in the More menu"
    }
   ],
   "hides": [
    "conversations",
    "projects",
    "children"
   ],
   "events": {
    "tc-conversations-change": null,
    "tc-projects-change": null,
    "tc-share-chat": "onShareChat"
   }
  }
 ],
 "changelog": [
  "All 18 blocks are now elements – `tc-agent-gallery`, `tc-ai-side-pane`, `tc-ai-workspace`, `tc-app-directory`, `tc-client-context`, `tc-evidence-gallery`, `tc-header-nav`, `tc-invoice-credit`, `tc-kpi-board`, `tc-logo-marquee`, `tc-metrics-dashboard`, `tc-oversight-home`, `tc-pricing-plans`, `tc-publish-readiness`, `tc-red-team-finding`, `tc-task-board`, `tc-testimonial-wall`, `tc-uncertainty-mix` – so Angular (`trenchcoat/angular`), Vue, Svelte, plain HTML and generative UI get them like any component, with docs pages."
 ],
