{
 "elements": [
  {
   "tag": "tc-ai-workspace",
   "className": "TcAiWorkspace",
   "description": "A complete assistant app – sidebar, welcome, streaming chat and projects, built on the Chat Composer.",
   "properties": [
    {
     "name": "userName",
     "attribute": "user-name",
     "type": "string",
     "default": "\"Lena\"",
     "description": "The signed-in person's name – the welcome greets them",
     "readonly": false
    },
    {
     "name": "userAvatar",
     "attribute": "user-avatar",
     "type": "string",
     "default": "\"\"",
     "description": "Their avatar's URL; their initial shows without one",
     "readonly": false
    },
    {
     "name": "workspace",
     "attribute": "workspace",
     "type": "string",
     "default": "\"N\"",
     "description": "The workspace's initial in the top-left tile",
     "readonly": false
    },
    {
     "name": "pinned",
     "attribute": null,
     "type": "string[]",
     "default": "[\"Writing assistant\", \"Data analyst\", \"Knowledge base\"]",
     "description": "Pinned items listed in the sidebar, above the pinned projects",
     "readonly": false
    },
    {
     "name": "conversations",
     "attribute": null,
     "type": "AiWorkspaceConversation[]",
     "default": "[ { id: \"c1\", title: \"Summarize interview notes\", messages: [ { id: \"m1\", role: \"user\", text: \"Summarize the notes from this week's customer interviews.\" }, { id: \"m2\", role: \"assistant\", text: \"Three themes stood out:\\n\\n1. People compare plans in a table before they read anything else.\\n2. Seat pricing feels fair once the per-seat price is visible.\\n3. Two interviewees asked for an annual invoice for their finance team.\", }, ], }, { id: \"c2\", title: \"Draft launch email\", messages: [ { id: \"m3\", role: \"user\", text: \"Draft a launch email for the new pricing.\" }, { id: \"m4\", role: \"assistant\", text: \"Subject: Pricing is live\\n\\nHi everyone – our new plans are out today. Existing customers keep their price.\" }, ], }, { id: \"c3\", title: \"Rewrite onboarding copy\", messages: [ { id: \"m5\", role: \"user\", text: \"Make the onboarding copy shorter.\" }, { id: \"m6\", role: \"assistant\", text: \"Here's a tighter version: “Create your first project – it takes a minute.”\" }, ], }, { id: \"c4\", title: \"Plan sprint goals\", messages: [ { id: \"m7\", role: \"user\", text: \"Help me plan goals for the next sprint.\" }, { id: \"m8\", role: \"assistant\", text: \"Pick one outcome per team and two stretch goals. Want a template?\" }, ], }, ]",
     "description": "The conversations, newest first",
     "readonly": false
    },
    {
     "name": "projects",
     "attribute": null,
     "type": "AiWorkspaceProject[]",
     "default": "[ { id: \"p1\", name: \"Brand Refresh\", description: \"Logo, colors and type for the new identity\", updatedDaysAgo: 2 }, { id: \"p2\", name: \"Customer Research\", description: \"Interview notes and survey results\", updatedDaysAgo: 5 }, { id: \"p3\", name: \"Pricing Page\", description: \"Plans, copy and the comparison table\", updatedDaysAgo: 7 }, { id: \"p4\", name: \"Mobile App\", description: \"Navigation patterns and offline mode\", updatedDaysAgo: 10 }, { id: \"p5\", name: \"Help Center\", description: \"Guides, FAQs and release notes\", updatedDaysAgo: 12 }, { id: \"p6\", name: \"Q4 Planning\", description: \"Goals, budgets and the launch calendar\", updatedDaysAgo: 14 }, ]",
     "description": "The projects",
     "readonly": false
    },
    {
     "name": "respond",
     "attribute": null,
     "type": "AiWorkspaceRespond | undefined",
     "default": "undefined",
     "description": "Your model call – resolve with the full answer; a rejection shows an error with Try again. The demo answers without it",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-conversations-change",
     "detail": "",
     "description": "The conversations changed – a message sent or answered, a chat deleted (`AiWorkspaceConversationsChange`: `{ conversations }`); cancelable – prevented, `conversations` stays (controlled use)",
     "cancelable": true
    },
    {
     "name": "tc-projects-change",
     "detail": "",
     "description": "The projects changed – created, renamed, pinned or unpinned (`AiWorkspaceProjectsChange`: `{ projects }`); cancelable – prevented, `projects` stays (controlled use)",
     "cancelable": true
    },
    {
     "name": "tc-share-chat",
     "detail": "",
     "description": "Share chat was picked in the More menu (`AiWorkspaceShare`: `{ conversation }`)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "send",
     "params": "text: string",
     "returns": "void",
     "description": "Sends a message: a new conversation from the welcome screen, else a reply in the open one"
    }
