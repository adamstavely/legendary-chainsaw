{
 "elements": [
  {
   "tag": "tc-voice-mode",
   "className": "TcVoiceMode",
   "description": "A voice conversation: the orb, live captions for every turn, and Mute, Captions, Interrupt and End.",
   "properties": [
    {
     "name": "state",
     "attribute": "state",
     "type": "VoiceModeState",
     "default": "\"idle\"",
     "description": "What the assistant is doing: idle · listening · thinking · speaking",
     "readonly": false
    },
    {
     "name": "turns",
     "attribute": null,
     "type": "VoiceTurn[]",
     "default": "[]",
     "description": "The conversation so far, oldest first. A turn still coming in has `partial` set",
     "readonly": false
    },
    {
     "name": "level",
     "attribute": "level",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Input or output loudness from 0 to 1, for the orb – unset, the orb fakes a natural level",
     "readonly": false
    },
    {
     "name": "muted",
     "attribute": "muted",
     "type": "boolean",
     "default": "false",
     "description": "The microphone is muted. Changed by the element unless a tc-muted-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "captions",
     "attribute": null,
     "type": "boolean",
     "default": "true",
     "description": "The captions are shown. Changed by the element unless a tc-captions-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "A title over the orb – unset, there's none",
     "readonly": false
    },
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"Assistant\"",
     "description": "The assistant's name on its turns and in what screen readers hear",
     "readonly": false
    },
    {
     "name": "userName",
     "attribute": "user-name",
     "type": "string",
     "default": "\"You\"",
     "description": "The person's name on their turns",
     "readonly": false
    },
    {
     "name": "placeholder",
     "attribute": "placeholder",
     "type": "string",
     "default": "\"Start talking – your words show up here.\"",
     "description": "Shown while there are no turns yet",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "VoiceModeLabels",
     "default": "{}",
     "description": "The line under the orb, per state and while muted",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-muted-change",
     "detail": "",
     "description": "Mute was switched (`{ muted: boolean }`); cancelable – prevent it to keep `muted` (controlled use)",
     "cancelable": true
    },
    {
     "name": "tc-captions-change",
     "detail": "",
     "description": "Captions were shown or hidden (`{ captions: boolean }`); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-interrupt",
     "detail": "",
     "description": "Interrupt was pressed (or Esc) while the assistant thinks or speaks; detail: null",
     "cancelable": false
    },
    {
     "name": "tc-end",
     "detail": "",
     "description": "End was pressed; detail: null",
     "cancelable": false
    }
