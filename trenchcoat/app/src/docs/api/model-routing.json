{
 "elements": [
  {
   "tag": "tc-model-routing",
   "className": "TcModelRouting",
   "description": "Model routing as a route: rules in order, then the fallback chain, with each target's health, breaker and region,\nand a route test the app answers.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Model routing\"",
     "description": "The heading, and the group's name",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": null,
     "type": "ModelRoutingValue",
     "default": "{ rules: [], fallbacks: [] }",
     "description": "The rules and the fallback chain. Changed by the user unless tc-value-change is prevented",
     "readonly": false
    },
    {
     "name": "targets",
     "attribute": null,
     "type": "RouteTarget[]",
     "default": "[]",
     "description": "Every model or deployment a rule or the chain can name",
     "readonly": false
    },
    {
     "name": "health",
     "attribute": null,
     "type": "Record<string, RouteTargetHealth>",
     "default": "{}",
     "description": "Each target's health and breaker, by target id, as the app reports them",
     "readonly": false
    },
    {
     "name": "residency",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The regions requests may be sent to; targets elsewhere are flagged. Empty means no constraint",
     "readonly": false
    },
    {
     "name": "testResult",
     "attribute": null,
     "type": "RouteTestResult | null",
     "default": "null",
     "description": "The app's answer to the last route test; setting it ends the pending state",
     "readonly": false
    },
    {
     "name": "testPlaceholder",
     "attribute": "test-placeholder",
     "type": "string",
     "default": "\"Describe a request, e.g. 140k-token contract from an EU customer\"",
     "description": "Placeholder in the route test's field",
     "readonly": false
    },
    {
     "name": "readonly",
     "attribute": "readonly",
     "type": "boolean",
     "default": "false",
     "description": "Shows the route without reorder handles or remove buttons",
     "readonly": false
    },
    {
     "name": "path",
     "attribute": null,
     "type": "{ rules: RoutePathStep[]; fallbacks: RoutePathStep[]; fellBack: boolean } | null",
     "default": null,
     "description": "Where the last test went: each rule's and each fallback's part in it",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "The rules or the fallback chain changed ({ value: ModelRoutingValue }); cancelable – prevent it to control `value`",
     "cancelable": true
    },
    {
     "name": "tc-route-test",
     "detail": "",
     "description": "Test a route was submitted ({ input, value }: RouteTestRequest); answer by setting `testResult`; cancelable – prevented, nothing shows as pending",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "test",
     "params": "input: unknown",
     "returns": "void",
     "description": "Runs a route test: the app answers by setting `testResult`"
    }
   ],
