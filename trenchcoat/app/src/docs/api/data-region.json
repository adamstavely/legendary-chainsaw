{
 "elements": [
  {
   "tag": "tc-data-region",
   "className": "TcDataRegion",
   "description": "Where a workspace's data lives, item by item, and a flow to move it – choose a region, see the impact, schedule it,\nconfirm by typing the workspace's name, and follow the migration's progress.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Data region\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "workspace",
     "attribute": "workspace",
     "type": "string",
     "default": "\"\"",
     "description": "The workspace's name: shown in the summary, and typed to confirm a move",
     "readonly": false
    },
    {
     "name": "current",
     "attribute": "current",
     "type": "string",
     "default": "\"\"",
     "description": "The id of the region the data lives in now",
     "readonly": false
    },
    {
     "name": "regions",
     "attribute": null,
     "type": "DataRegionOption[]",
     "default": "[]",
     "description": "Every region, the current one included",
     "readonly": false
    },
    {
     "name": "stored",
     "attribute": null,
     "type": "DataRegionItem[]",
     "default": "[]",
     "description": "What the current region holds, and what it doesn't",
     "readonly": false
    },
    {
     "name": "step",
     "attribute": "step",
     "type": "DataRegionStep",
     "default": "\"choose\"",
     "description": "The flow's step. Changed by the user unless a tc-step-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "target",
     "attribute": "target",
     "type": "string | null",
     "default": "null",
     "description": "The region chosen to move to. Changed by the user unless a tc-target-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "impact",
     "attribute": null,
     "type": "DataRegionImpact",
     "default": "{}",
     "description": "What the move means, from the page once a region is chosen",
     "readonly": false
    },
    {
     "name": "timeZones",
     "attribute": null,
     "type": "string[]",
     "default": "[\"UTC\", \"Europe/London\", \"Europe/Berlin\", \"America/New_York\", \"Asia/Singapore\", \"Australia/Sydney\"]",
     "description": "The time zones offered for the schedule",
     "readonly": false
    },
    {
     "name": "progress",
     "attribute": null,
     "type": "DataRegionProgressStep[]",
     "default": "[]",
     "description": "The migration's steps and where each stands, from the page",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for the date in the summary, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "DataRegionLabelsInput",
     "default": "{}",
     "description": "The card's words, merged over defaultDataRegionLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-step-change",
     "detail": "",
     "description": "The flow moved to another step ({ step, previous }: DataRegionStepChange); cancelable – prevented, `step` stays as it was",
     "cancelable": true
