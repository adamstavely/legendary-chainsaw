{
 "elements": [
  {
   "tag": "tc-risk-register",
   "className": "TcRiskRegister",
   "description": "A risk register – a 5 × 5 likelihood × impact heat grid with counts and moves since the last review, beside a\nsortable register whose risks open with their mitigation and can be rescored.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Risk register\"",
     "description": "The heading, and the grid's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "risks",
     "attribute": null,
     "type": "Risk[]",
     "default": "[]",
     "description": "The risks. Rescoring changes them unless tc-risks-change is prevented",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The risk whose detail is open. Changed by the user unless tc-selected-change is prevented",
     "readonly": false
    },
    {
     "name": "cell",
     "attribute": null,
     "type": "RiskCell | null",
     "default": "null",
     "description": "The grid cell the register is filtered to, or null for all. Changed by the user unless tc-cell-change is prevented",
     "readonly": false
    },
    {
     "name": "sort",
     "attribute": "sort",
     "type": "RiskSortKey",
     "default": "\"score\"",
     "description": "The register's order. Changed by the user unless tc-sort-change is prevented",
     "readonly": false
    },
    {
     "name": "sortDir",
     "attribute": "sort-dir",
     "type": "RiskSortDir",
     "default": "\"desc\"",
     "description": "Which way the register is sorted",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<RiskLabels>",
     "default": "{}",
     "description": "The words for the five likelihood and impact levels",
     "readonly": false
    },
    {
     "name": "readonly",
     "attribute": "readonly",
     "type": "boolean",
     "default": "false",
     "description": "Read only: risks can be opened but not rescored",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A risk was opened or closed ({ selected, risk }: RiskSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-cell-change",
     "detail": "",
     "description": "The grid's filter changed ({ cell }: RiskCellChange); cancelable – prevented, `cell` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-sort-change",
     "detail": "",
     "description": "The register's order changed ({ sort, sortDir }: RiskSortChange); cancelable – prevented, the order stays",
     "cancelable": true
    },
    {
     "name": "tc-risks-change",
     "detail": "",
     "description": "A risk was rescored ({ risks, change }: RiskRisksChange); cancelable – prevented, `risks` stays as it was",
     "cancelable": true
    }
   ],
