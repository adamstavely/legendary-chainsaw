     "type": "(next: Risk[], change: RiskRisksChange[\"change\"]) => void",
     "optional": true,
     "description": "A risk was rescored; `next` is the list as it will be"
    },
    {
     "name": "selected",
     "type": "string | null",
     "optional": true,
     "description": "The risk whose detail is open – controlled when given"
    },
    {
     "name": "defaultSelected",
     "type": "string | null",
     "optional": true,
     "description": "The risk open on mount when `selected` isn't controlled"
    },
    {
     "name": "onSelectedChange",
     "type": "(selected: string | null, risk?: Risk) => void",
     "optional": true,
     "description": "A risk was opened or closed"
    },
    {
     "name": "cell",
     "type": "RiskCell | null",
     "optional": true,
     "description": "The grid cell the register is filtered to – controlled when given"
    },
    {
     "name": "defaultCell",
     "type": "RiskCell | null",
     "optional": true,
     "description": "The filter on mount when `cell` isn't controlled"
    },
    {
     "name": "onCellChange",
     "type": "(cell: RiskCell | null) => void",
     "optional": true,
     "description": "The filter changed"
    },
    {
     "name": "sort",
     "type": "RiskSortKey",
     "optional": true,
     "description": "The register's order – controlled when given"
    },
    {
     "name": "sortDir",
     "type": "RiskSortDir",
     "optional": true,
     "description": "Which way – controlled with `sort`"
    },
    {
     "name": "onSortChange",
     "type": "(sort: RiskSortKey, sortDir: RiskSortDir) => void",
     "optional": true,
     "description": "The order changed"
    }
