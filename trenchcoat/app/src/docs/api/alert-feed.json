{
 "elements": [
  {
   "tag": "tc-alert-feed",
   "className": "TcAlertFeed",
   "description": "A live feed of alerts – category, severity, title, subject and a fresh relative time, with actions per alert,\ncounts in the header, Pause feed, and polite announcements of new alerts.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Live alerts\"",
     "description": "The heading, and the feed's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "items",
     "attribute": null,
     "type": "AlertItem[]",
     "default": "[]",
     "description": "The alerts, in any order – shown newest first",
     "readonly": false
    },
    {
     "name": "actions",
     "attribute": null,
     "type": "AlertAction[]",
     "default": "[ { id: \"escalate\", label: \"Escalate\", tone: \"danger\" }, { id: \"acknowledge\", label: \"Acknowledge\" }, ]",
     "description": "Every alert's actions, unless it names its own (Escalate and Acknowledge by default)",
     "readonly": false
    },
    {
     "name": "paused",
     "attribute": "paused",
     "type": "boolean",
     "default": "false",
     "description": "Holds new alerts back behind a \"Show N new\" button. Changed by the user unless a tc-paused-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "\"Now\" for the relative times and today's count, epoch ms; unset, the element keeps its own clock",
     "readonly": false
    },
    {
     "name": "todayCount",
     "attribute": "today-count",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The events counted today, in the header; by default the alerts given since midnight",
     "readonly": false
    },
    {
     "name": "severityLabels",
     "attribute": null,
     "type": "Partial<Record<AlertSeverity, string>>",
     "default": "{}",
     "description": "The severities' names, merged over the defaults (Critical, High, Medium, Info)",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for times, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "empty",
     "attribute": "empty",
     "type": "string",
     "default": "\"No alerts. All quiet.\"",
     "description": "Shown when there are no alerts",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-action",
     "detail": "",
     "description": "An alert's action was used ({ id, action, item }: AlertActionEvent); cancelable – for \"acknowledge\", prevented means the alert isn't quieted",
     "cancelable": true
    },
    {
     "name": "tc-paused-change",
     "detail": "",
     "description": "Pause feed or Resume was pressed ({ paused }: AlertPausedChange); cancelable – prevented, `paused` stays as it was",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
