  }
 ],
 "react": [
  {
   "component": "AlertFeed",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the feed's name"
    },
    {
     "name": "paused",
     "type": "boolean",
     "optional": true,
     "description": "Whether new alerts are held back – controlled when given"
    },
    {
     "name": "defaultPaused",
     "type": "boolean",
     "optional": true,
     "description": "Paused on mount when `paused` isn't controlled"
    },
    {
     "name": "onPausedChange",
     "type": "(paused: boolean) => void",
     "optional": true,
     "description": "Pause feed or Resume was pressed"
    },
    {
     "name": "onAction",
     "type": "(id: string, action: string, item: AlertItem) => boolean | void",
     "optional": true,
     "description": "An alert's action was used; return false to stop the element acting on it (Acknowledge quieting the alert)"
    }
   ],
   "hides": [
    "heading",
    "paused",
    "children"
   ],
   "events": {
    "tc-action": "onAction",
    "tc-paused-change": null
   }
  }
 ],
 "changelog": [
  "**`tc-alert-feed`:** a live feed of alerts. - **Each alert:** a category, severity shown as an edge, a mark and a word, and a relative time that stays fresh. - **Actions:** Escalate and Acknowledge. - **Pausing:** Pause feed holds new alerts back, and arrivals are announced politely."
 ],
