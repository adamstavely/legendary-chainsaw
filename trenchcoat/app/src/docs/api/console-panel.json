     "cancelable": true
    },
    {
     "name": "tc-filter-change",
     "detail": "",
     "description": "The text filter changed ({ filter }: ConsoleFilterChange); cancelable – prevented, `filter` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-expanded-change",
     "detail": "",
     "description": "A stack was opened or closed ({ expanded, id }: ConsoleExpandedChange); cancelable – prevented, `expanded` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-clear",
     "detail": "",
     "description": "Clear was pressed (detail: null); cancelable – prevented, `entries` stay; otherwise the element empties them, and those messages stay hidden if the same list is passed again (new ones show)",
