    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "Small text under the heading – the page or tab it belongs to",
     "readonly": false
    },
    {
     "name": "entries",
     "attribute": null,
     "type": "ConsoleEntry[]",
     "default": "[]",
     "description": "The messages, oldest first",
     "readonly": false
    },
    {
     "name": "levels",
     "attribute": null,
     "type": "ConsoleLevel[]",
     "default": "[...consoleLevels]",
     "description": "The levels that show",
     "readonly": false
    },
    {
     "name": "filter",
     "attribute": "filter",
     "type": "string",
     "default": "\"\"",
