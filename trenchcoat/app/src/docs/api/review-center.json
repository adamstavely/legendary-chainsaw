{
 "elements": [
  {
   "tag": "tc-review-center",
   "className": "TcReviewCenter",
   "description": "Human in the loop: the queue of what your agents want to do, one item at a time.",
   "properties": [
    {
     "name": "items",
     "attribute": null,
     "type": "ReviewItem[]",
     "default": "[]",
     "description": "Everything waiting for review – decided items hide themselves, new ids slide in",
     "readonly": false
    },
    {
     "name": "onDecide",
     "attribute": null,
     "type": "ReviewDecide | undefined",
     "default": "undefined",
     "description": "Decides an item; may return a promise (see ReviewDecide)",
     "readonly": false
    },
    {
     "name": "reviewed",
     "attribute": "reviewed",
     "type": "number",
     "default": "0",
     "description": "How many were reviewed before (e.g. today) – the header counts on from here",
     "readonly": false
    },
    {
     "name": "total",
     "attribute": "total",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The total for the header – defaults to reviewed + waiting",
     "readonly": false
    },
    {
     "name": "sla",
     "attribute": "sla",
     "type": "",
     "default": null,
     "description": "How long an item may wait, in ms – the waiting time turns amber at 75% and red past it (default 30 min)",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The clock (epoch ms) – defaults to the real one, read after connecting",
     "readonly": false
    },
    {
     "name": "lowConfidence",
     "attribute": "low-confidence",
     "type": "number",
     "default": "0.7",
     "description": "Below this confidence an item counts as unsure (default 0.7)",
     "readonly": false
    },
    {
     "name": "reasons",
     "attribute": null,
     "type": "string[]",
     "default": "[\"Wrong info\", \"Tone\", \"Not allowed\", \"Other\"]",
     "description": "The quick reasons for a rejection, picked with 1–4",
     "readonly": false
    },
    {
     "name": "order",
     "attribute": "order",
     "type": "\"risk\" | \"oldest\" | \"given\"",
     "default": "\"risk\"",
     "description": "\"risk\" (default): high risk first, then oldest · \"oldest\" · \"given\": as passed",
     "readonly": false
    },
    {
     "name": "filter",
     "attribute": "filter",
     "type": "ReviewFilter",
     "default": "\"all\"",
     "description": "Which items the queue shows: \"all\", \"high\" (high risk only) or \"unsure\" (below `lowConfidence`). Changed by the user unless a tc-filter-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Review center\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "undoTimeout",
     "attribute": null,
     "type": "number | false",
     "default": "6000",
     "description": "How long the Undo chip stays after a decision, in ms – false keeps it until the next decision",
     "readonly": false
    },
    {
     "name": "shortcuts",
     "attribute": "shortcuts",
     "type": "boolean",
     "default": "true",
     "description": "The single-key shortcuts while focus is inside – false turns them off; Esc and ⌘/Ctrl combinations keep working",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-filter-change",
     "detail": "",
     "description": "The filter changes; detail `{ filter }`. Cancelable: preventDefault() keeps the current one",
     "cancelable": true
    },
    {
     "name": "tc-undo",
     "detail": "",
     "description": "A decision was taken back; detail `{ item, result }` – put the item back if you dropped it",
     "cancelable": false
    },
    {
     "name": "tc-skip",
     "detail": "",
     "description": "An item was skipped; detail `{ item }`",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "approve",
     "params": "",
     "returns": "void",
     "description": ""
    },
    {
     "name": "reject",
     "params": "reason?: string",
     "returns": "void",
     "description": "Opens the reason picker, or rejects right away with a reason"
    },
    {
     "name": "edit",
     "params": "focus: unknown",
     "returns": "void",
     "description": "Edits the current item in place"
    },
    {
     "name": "setDraft",
     "params": "text: string, field?: string",
     "returns": "void",
     "description": "Replaces the draft of the body (or of a field, by its label) while editing"
    },
    {
     "name": "save",
     "params": "",
     "returns": "void",
     "description": "Approves with the edits"
    },
    {
     "name": "cancel",
     "params": "",
     "returns": "void",
     "description": ""
    },
    {
     "name": "skip",
     "params": "",
     "returns": "void",
     "description": ""
    },
    {
     "name": "next",
     "params": "",
     "returns": "void",
     "description": ""
    },
    {
     "name": "previous",
     "params": "",
     "returns": "void",
     "description": ""
    },
    {
     "name": "undo",
     "params": "",
     "returns": "void",
     "description": ""
    },
    {
     "name": "peek",
     "params": "index: number | null",
     "returns": "void",
     "description": "Shows the note of the n-th flagged span of the current item – null hides it"
    },
    {
     "name": "select",
     "params": "id: string",
     "returns": "void",
     "description": ""
    }
   ],
