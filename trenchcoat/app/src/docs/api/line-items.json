{
 "elements": [
  {
   "tag": "tc-line-items",
   "className": "TcLineItems",
   "description": "Rows a model reads off a document, for a person to fix, total and confirm.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Line items\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "source",
     "attribute": "source",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The document the rows came from – shown under the heading",
     "readonly": false
    },
    {
     "name": "items",
     "attribute": null,
     "type": "LineItem[]",
     "default": "[]",
     "description": "The rows",
     "readonly": false
    },
    {
     "name": "streaming",
     "attribute": "streaming",
     "type": "boolean",
     "default": "false",
     "description": "Rows are still arriving: the grid is busy and Confirm waits",
     "readonly": false
    },
    {
     "name": "currency",
     "attribute": "currency",
     "type": "string",
     "default": "\"USD\"",
     "description": "The ISO 4217 currency of the amounts",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The locale for numbers and amounts, and for reading what's typed",
     "readonly": false
    },
    {
     "name": "taxRate",
     "attribute": "tax-rate",
     "type": "number",
     "default": "0",
     "description": "Tax as a fraction of the subtotal – 0.08 for 8 %; 0 hides the tax row",
     "readonly": false
    },
    {
     "name": "statedTotal",
     "attribute": "stated-total",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The total the document itself states; a different total is called out",
     "readonly": false
    },
    {
     "name": "threshold",
     "attribute": "threshold",
     "type": "number",
     "default": "0.8",
     "description": "Confidence below this (0–1) marks a row \"Low confidence\"",
     "readonly": false
    },
    {
     "name": "confirmLabel",
     "attribute": "confirm-label",
     "type": "string",
     "default": "\"Confirm\"",
     "description": "The label of the button that hands the rows back",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
