{
 "elements": [
  {
   "tag": "tc-data-controls",
   "className": "TcDataControls",
   "description": "A person's own data – switches for training, chat history and memory with what each means, Export my data, Delete\nall chats behind a confirmation, and Delete account.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Data controls\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": null,
     "type": "DataControlsValue",
     "default": "{ training: false, history: true, memory: true }",
     "description": "The switches. Changed by the user unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "changed",
     "attribute": null,
     "type": "Partial<Record<DataControlsField, number>>",
     "default": "{}",
     "description": "When each switch was last changed, epoch ms – the page records the change and passes it back",
     "readonly": false
    },
    {
     "name": "chatCount",
     "attribute": "chat-count",
     "type": "number",
     "default": "0",
     "description": "How many chats Delete all chats removes",
     "readonly": false
    },
    {
     "name": "memoryHref",
     "attribute": "memory-href",
     "type": "string",
     "default": "\"\"",
     "description": "Where memories are managed; leave it unset and Manage memory isn't shown",
     "readonly": false
    },
    {
     "name": "deleteAccountHref",
     "attribute": "delete-account-href",
     "type": "string",
     "default": "\"\"",
     "description": "Where deleting the account starts; unset, Delete account fires tc-delete-account",
     "readonly": false
    },
    {
     "name": "exportStatus",
     "attribute": "export-status",
     "type": "DataExportStatus",
     "default": "\"idle\"",
     "description": "Where the export stands: idle, requested (a link will be emailed), ready or failed. Set to requested by Export my data unless prevented",
     "readonly": false
    },
    {
     "name": "exportHref",
     "attribute": "export-href",
     "type": "string",
     "default": "\"\"",
     "description": "The finished export's link, shown when `exportStatus` is ready",
     "readonly": false
    },
    {
     "name": "hideDeleteAccount",
     "attribute": "hide-delete-account",
     "type": "boolean",
     "default": "false",
     "description": "Hides Delete account",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for dates, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<DataControlsLabels>",
     "default": "{}",
     "description": "The card's words, merged over defaultDataControlsLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
