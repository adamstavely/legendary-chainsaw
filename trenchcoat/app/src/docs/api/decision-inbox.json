 "react": [
  {
   "component": "DecisionInbox",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The inbox's name, in the header (default \"Decisions\")"
    },
    {
     "name": "answers",
     "type": "Record<string, DecisionAnswer>",
     "optional": true,
     "description": "The answers given so far, by decision id. Controlled when defined – pair it with `onAnswersChange`"
    },
    {
     "name": "defaultAnswers",
     "type": "Record<string, DecisionAnswer>",
     "optional": true,
     "description": "Answers already given on mount when `answers` isn't controlled – those rows start folded away"
    },
    {
     "name": "onAnswersChange",
     "type": "(answers: Record<string, DecisionAnswer>) => void",
     "optional": true,
     "description": "Called with every answer, controlled or not"
    },
    {
     "name": "onDecide",
     "type": "(decision: InboxDecision, answer: DecisionAnswer) => void | Promise<unknown>",
     "optional": true,
     "description": "Called with the decision and the chosen answer. Return a promise to hold the row until it settles: it answers on\nsuccess, and on a rejection says so and offers both buttons again"
    }
   ],
   "hides": [
    "title",
    "heading",
    "answers",
    "decide"
   ],
   "events": {
    "tc-answers-change": "onAnswersChange",
    "tc-decide": null
   }
  }
 ],
