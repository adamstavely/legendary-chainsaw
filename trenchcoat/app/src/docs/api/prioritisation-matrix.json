     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the plot's name"
    },
    {
     "name": "items",
     "type": "PrioritisationItem[]",
     "optional": true,
     "description": "The items – controlled when given: every move reports the next list through onItemsChange"
    },
