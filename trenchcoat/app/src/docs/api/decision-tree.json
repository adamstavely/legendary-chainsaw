{
 "elements": [
  {
   "tag": "tc-decision-tree",
   "className": "TcDecisionTree",
   "description": "An agent's open decision drawn as a tree of options and consequences – pick a path or write your own instruction.",
   "properties": [
    {
     "name": "decisions",
     "attribute": null,
     "type": "TreeDecision[]",
     "default": "[]",
     "description": "Everything waiting for a call – decided ones leave on their own, new ids join at the end",
     "readonly": false
    },
    {
     "name": "decision",
     "attribute": "decision",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The id of the decision on show – unset shows the first",
     "readonly": false
    },
    {
     "name": "onChoose",
     "attribute": null,
     "type": "((decision: TreeDecision, choice: TreeDecisionChoice) => string | void | Promise<string | void>) | undefined",
     "default": "undefined",
     "description": "A branch was picked or an instruction written – return the agent's short answer to an instruction (or a promise\nof it). A promise holds the picked path until it settles; a rejection lets go of the pick and says so",
     "readonly": false
    },
    {
     "name": "allowOther",
     "attribute": "allow-other",
     "type": "boolean",
     "default": "true",
     "description": "Shows the \"Other…\" branch; allow-other=\"false\" hides it",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Decisions\"",
     "description": "The heading in the bar, before how many decisions wait",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-decision-change",
     "detail": "",
     "description": "The decision on show changes (paging, or the shown one was decided); detail `{ decision: string }`. Cancelable: prevent it to control `decision`",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "choose",
     "params": "i: number",
     "returns": "void",
     "description": "Picks the n-th option – or, after a pick, the n-th option of its follow-up; the index after the last option opens \"Other…\""
    },
    {
     "name": "send",
     "params": "",
     "returns": "void",
     "description": "Sends the \"Other…\" field"
    },
    {
     "name": "hover",
     "params": "index: number | null",
     "returns": "void",
     "description": "Lights up the n-th branch (or, after a pick, the n-th option of its follow-up) as if pointed at – null lets go"
    },
    {
     "name": "setOther",
     "params": "text: string",
     "returns": "void",
     "description": "Fills the \"Other…\" field"
    },
    {
     "name": "next",
     "params": "",
     "returns": "void",
     "description": "Shows the next decision"
    },
    {
     "name": "previous",
     "params": "",
     "returns": "void",
     "description": "Shows the previous decision"
    },
    {
     "name": "peek",
     "params": "index: number | null",
     "returns": "void",
     "description": "Shows the note of the n-th flagged part – null hides it"
    }
   ],
   "ui": "dct",
