{
 "elements": [
  {
   "tag": "tc-stepper-form",
   "className": "TcStepperForm",
   "description": "A multi-step flow: numbered steps, sliding panes, checks on Continue and a success state.",
   "properties": [
    {
     "name": "steps",
     "attribute": null,
     "type": "StepperFormStep[]",
     "default": "[]",
     "description": "The steps in order: id, title, content and the check Continue runs",
     "readonly": false
    },
    {
     "name": "values",
     "attribute": null,
     "type": "Values",
     "default": "{}",
     "description": "The values of every step",
     "readonly": false
    },
    {
     "name": "step",
     "attribute": "step",
     "type": "number",
     "default": "0",
     "description": "The open step's index",
     "readonly": false
    },
    {
     "name": "onComplete",
     "attribute": null,
     "type": "StepperComplete | undefined",
     "default": "undefined",
     "description": "Runs with all values on the last step; return a promise to show \"Creating…\" until it settles (throw to show an error that can be retried). The signal aborts when the form is removed mid-way",
     "readonly": false
    },
    {
     "name": "submitLabel",
     "attribute": "submit-label",
     "type": "string",
     "default": "\"Finish\"",
     "description": "Label of the last button",
     "readonly": false
    },
    {
     "name": "submittingLabel",
     "attribute": "submitting-label",
     "type": "string",
     "default": "\"Creating…\"",
     "description": "Label while onComplete runs",
     "readonly": false
    },
    {
     "name": "success",
     "attribute": null,
     "type": "((values: Values, reset: () => void) => unknown) | null | undefined",
     "default": "undefined",
     "description": "What shows once onComplete is done: a render function, unset for a short \"All set\", or null to leave the pane empty for the app",
     "readonly": false
    },
    {
     "name": "panes",
     "attribute": null,
     "type": "StepperPane[]",
     "default": null,
     "description": "The panes shown: the current one, and one sliding out",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-values-change",
     "detail": "",
     "description": "A step changed the values; detail `{ values }`. Cancelable.",
     "cancelable": true
    },
    {
     "name": "tc-step-change",
     "detail": "",
     "description": "Another step opens; detail `{ step: number }`. Cancelable.",
     "cancelable": true
    },
    {
     "name": "tc-panes-change",
     "detail": "",
     "description": "The panes shown or the current step's errors changed (for apps that render the step content themselves); detail `{ panes: StepperPane[] }`.",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "setValues",
     "params": "patch: Partial<Values>",
     "returns": "void",
     "description": "Merges a patch into the values"
    },
    {
     "name": "goTo",
     "params": "id: string",
     "returns": "void",
     "description": "Jumps to a step by id – forward jumps need the current step to pass first"
    },
    {
     "name": "next",
     "params": "",
     "returns": "void",
     "description": "Same as pressing Continue"
    },
    {
     "name": "reset",
     "params": "",
     "returns": "void",
     "description": "Back to the start: the first values and step, nothing checked, not done"
    }
   ],
   "ui": "sf",
   "cssProperties": [
    {
     "name": "--tc-stepper-form-halo",
     "value": "light-dark(rgba(23, 23, 23, 0.08), rgba(255, 255, 255, 0.08))",
     "looks": [
      "standard"
     ]
    }
   ],
