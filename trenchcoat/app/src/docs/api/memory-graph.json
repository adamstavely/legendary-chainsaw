{
 "elements": [
  {
   "tag": "tc-memory-graph",
   "className": "TcMemoryGraph",
   "description": "What an agent remembers and the tools it can reach, around it – each memory with where it came from, each tool with\nwhat it may do – with a light along the way it's using, switches and forget with Undo.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Memory\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "agent",
     "attribute": null,
     "type": "MemoryGraphAgent | null",
     "default": "null",
     "description": "The agent in the middle",
     "readonly": false
    },
    {
     "name": "memories",
     "attribute": null,
     "type": "MemoryGraphMemory[]",
     "default": "[]",
     "description": "What it remembers, on the left of the ring from the top. Ids are unique across memories and tools",
     "readonly": false
    },
    {
     "name": "tools",
     "attribute": null,
     "type": "MemoryGraphTool[]",
     "default": "[]",
     "description": "The tools it can reach, on the right of the ring from the top",
     "readonly": false
    },
    {
     "name": "using",
     "attribute": "using",
     "type": "string | null",
     "default": "null",
     "description": "The id of the tool it's using right now – a light runs out to it",
     "readonly": false
    },
    {
     "name": "learning",
     "attribute": "learning",
     "type": "string | null",
     "default": "null",
     "description": "The id of a memory it's learning right now – a light runs in from its `via` tool, through the agent, out to it",
     "readonly": false
    },
    {
     "name": "recalling",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The ids of memories it's recalling right now – a light runs in from each",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": null,
     "type": "string | null",
     "default": "null",
     "description": "The card whose details are open (a memory's or tool's id, or MEMORY_GRAPH_MORE). Changed by the user unless a tc-selected-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "undoFor",
     "attribute": "undo-for",
     "type": "number",
     "default": "5000",
     "description": "How long Undo stays after a memory is forgotten, in ms",
     "readonly": false
    },
    {
     "name": "kindLabels",
     "attribute": null,
     "type": "Partial<Record<MemoryGraphSourceKind, string>>",
     "default": "{}",
     "description": "The source kinds' words, merged over defaultMemoryGraphKindLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-memories-change",
     "detail": "",
     "description": "A memory was switched off or on, forgotten or brought back ({ memories, memory, change }: MemoryGraphMemoriesChange); cancelable – prevented, `memories` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-tools-change",
     "detail": "",
     "description": "A tool was switched off or on ({ tools, tool, change }: MemoryGraphToolsChange); cancelable – prevented, `tools` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A card's details were opened or closed ({ selected, memory, tool }: MemoryGraphSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-action",
     "detail": "",
     "description": "Add a file or Connect a tool was chosen on the agent ({ id }: MemoryGraphAction)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
