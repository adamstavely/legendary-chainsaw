{
 "elements": [
  {
   "tag": "tc-panel-dock",
   "className": "TcPanelDock",
   "description": "One side panel beside a chat with a tab per open item – resizable, collapsible to a rail, a full-width sheet when narrow.",
   "properties": [
    {
     "name": "items",
     "attribute": null,
     "type": "PanelDockItem[]",
     "default": "[]",
     "description": "The items open in the panel, in tab order",
     "readonly": false
    },
    {
     "name": "active",
     "attribute": "active",
     "type": "string | null",
     "default": "null",
     "description": "The shown item's id. Changed by the tabs unless a tc-active-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": "open",
     "type": "boolean",
     "default": "true",
     "description": "Whether the panel shows at all. Closed by its Close button or Escape unless a tc-open-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "collapsed",
     "attribute": "collapsed",
     "type": "boolean",
     "default": "false",
     "description": "Folded to a rail of icons. Changed by Collapse and Expand unless a tc-collapsed-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "width",
     "attribute": "width",
     "type": "number",
     "default": "420",
     "description": "The panel's width, px. Changed by the splitter unless a tc-width-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "minWidth",
     "attribute": "min-width",
     "type": "number",
     "default": "280",
     "description": "The narrowest the splitter goes, px",
     "readonly": false
    },
    {
     "name": "maxWidth",
     "attribute": "max-width",
     "type": "number",
     "default": "760",
     "description": "The widest the splitter goes, px",
     "readonly": false
    },
    {
     "name": "breakpoint",
     "attribute": "breakpoint",
     "type": "number",
     "default": "640",
     "description": "Below this width of its parent, px, the panel becomes a full-width sheet over the page; 0 never",
     "readonly": false
    },
    {
     "name": "side",
     "attribute": "side",
     "type": "PanelDockSide",
     "default": "\"right\"",
     "description": "Which side of the chat the panel docks on – the splitter is on the other edge",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<PanelDockLabels>",
     "default": "{}",
     "description": "Rename any of the words, over the defaults",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-active-change",
     "detail": "",
     "description": "Another item was shown ({ active, item }: PanelDockActiveChange); cancelable – prevented, `active` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-close",
     "detail": "",
     "description": "An item's close button or Delete was pressed ({ id, item }: PanelDockClose); cancelable – the page removes the item",
     "cancelable": true
    },
    {
     "name": "tc-width-change",
     "detail": "",
     "description": "The panel was resized – once a drag ends, and on every key step ({ width }: PanelDockWidthChange); cancelable – prevented, `width` stays",
     "cancelable": true
    },
    {
     "name": "tc-open-change",
     "detail": "",
     "description": "The panel was closed ({ open }: PanelDockOpenChange); cancelable – prevented, it stays open",
     "cancelable": true
    },
    {
     "name": "tc-collapsed-change",
     "detail": "",
     "description": "The panel was folded to a rail or opened out ({ collapsed }: PanelDockCollapsedChange); cancelable – prevented, it stays as it was",
     "cancelable": true
    }
   ],
   "slots": [
    {
     "name": "<item",
     "description": "id> - Each item's content: a child with `slot` set to the item's id"
    }
   ],
   "methods": [],
   "ui": "pdk",
   "cssProperties": [
    {
     "name": "--tc-pdk-w",
     "value": "420px",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-pdk-rail",
