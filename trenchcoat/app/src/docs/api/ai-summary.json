{
 "elements": [
  {
   "tag": "tc-ai-summary",
   "className": "TcAiSummary",
   "description": "An AI summary of a set of sources – a thread, a meeting, documents, a ticket's history – with a TL;DR, key points\nciting their sources, open questions, a note when the sources have moved on, feedback, Copy and Regenerate.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Summary\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "subject",
     "attribute": "subject",
     "type": "string | undefined",
     "default": "undefined",
     "description": "What was summarised, named before the counts: \"#launch-q3\"",
     "readonly": false
    },
    {
     "name": "sources",
     "attribute": null,
     "type": "AiSummarySource[]",
     "default": "[]",
     "description": "The sources summarised, in citation order – a point's chip shows its source's number in this list",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "AiSummaryStatus",
     "default": "\"idle\"",
     "description": "Where the summary is: \"idle\", \"summarising\", \"done\" or \"error\"",
     "readonly": false
    },
    {
     "name": "tldr",
     "attribute": "tldr",
     "type": "string",
     "default": "\"\"",
     "description": "The one-line gist, shown first and emphasised",
     "readonly": false
    },
    {
     "name": "summary",
     "attribute": "summary",
     "type": "string",
     "default": "\"\"",
     "description": "The summary; may grow while \"summarising\". Blank lines split paragraphs",
     "readonly": false
    },
    {
     "name": "points",
     "attribute": null,
     "type": "AiSummaryPoint[]",
     "default": "[]",
     "description": "The key points, each with the sources it comes from",
     "readonly": false
    },
    {
     "name": "questions",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "What the sources leave open",
     "readonly": false
    },
    {
     "name": "length",
     "attribute": "length",
     "type": "AiSummaryLength",
     "default": "\"short\"",
     "description": "Short or detailed. Changed by the user unless a tc-length-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "model",
     "attribute": "model",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The model that wrote it, e.g. \"Claude Sonnet\"",
     "readonly": false
    },
    {
     "name": "generatedAt",
     "attribute": "generated-at",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When it was generated, epoch ms",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "\"Now\" for the relative time and freshness, epoch ms; unset, the element keeps its own clock",
     "readonly": false
    },
    {
     "name": "stale",
     "attribute": null,
     "type": "boolean | number",
     "default": "false",
     "description": "The sources have moved on since the summary: true, or how many new items there are. Sources dated after `generatedAt` count too",
     "readonly": false
    },
    {
     "name": "staleLabel",
     "attribute": "stale-label",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The banner's words in place of \"3 new messages since this summary\"",
     "readonly": false
    },
    {
     "name": "feedback",
     "attribute": null,
     "type": "AiSummaryFeedbackValue",
     "default": "null",
     "description": "Whether it helped: \"up\", \"down\" or null. Changed by the user unless a tc-feedback listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "sourcesOpen",
     "attribute": "sources-open",
     "type": "boolean",
     "default": "false",
     "description": "The list of sources under the footer is open",
     "readonly": false
    },
    {
     "name": "error",
     "attribute": "error",
     "type": "string | undefined",
     "default": "undefined",
     "description": "What went wrong, shown with \"error\"",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for dates and numbers, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-summarise",
     "detail": "",
     "description": "Summarise was pressed while `status` is \"idle\" – start summarising; detail: null",
     "cancelable": false
    },
    {
     "name": "tc-retry",
     "detail": "",
     "description": "Regenerate, Retry after an error, or Update when stale ({ reason: \"regenerate\" | \"error\" | \"stale\" }: AiSummaryRetry)",
     "cancelable": false
    },
    {
     "name": "tc-length-change",
     "detail": "",
     "description": "Short or Detailed was picked ({ length }: AiSummaryLengthChange); cancelable – prevented, `length` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-cite-open",
     "detail": "",
     "description": "A citation chip was used ({ sourceId, pointId }: AiSummaryCiteOpen); cancelable – prevented, a link to the source doesn't open",
     "cancelable": true
    },
    {
     "name": "tc-feedback",
     "detail": "",
     "description": "Helpful or not helpful was pressed, or pressed again to take it back ({ value }: AiSummaryFeedback); cancelable – prevented, `feedback` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-copy",
     "detail": "",
     "description": "The summary is on the clipboard ({ text })",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
