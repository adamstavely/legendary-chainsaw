 "react": [
  {
   "component": "AiSummary",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading (\"Summary\" by default)"
    },
    {
     "name": "length",
     "type": "AiSummaryLength",
     "optional": true,
     "description": "Short or detailed – controlled when given"
    },
    {
     "name": "defaultLength",
     "type": "AiSummaryLength",
     "optional": true,
     "description": "The length on mount when `length` isn't controlled"
    },
    {
     "name": "onLengthChange",
     "type": "(length: AiSummaryLength) => void",
     "optional": true,
     "description": "Short or Detailed was picked – summarise again"
    },
    {
     "name": "feedback",
     "type": "AiSummaryFeedbackValue",
     "optional": true,
     "description": "Whether it helped – controlled when given (\"up\", \"down\" or null)"
    },
    {
     "name": "defaultFeedback",
     "type": "AiSummaryFeedbackValue",
     "optional": true,
     "description": "The feedback on mount when `feedback` isn't controlled"
    },
    {
     "name": "onFeedbackChange",
     "type": "(value: AiSummaryFeedbackValue) => void",
     "optional": true,
     "description": "Helpful or not helpful was pressed, or taken back (null)"
    },
    {
     "name": "onSummarise",
     "type": "() => void",
     "optional": true,
     "description": "Summarise was pressed – start summarising"
    },
    {
     "name": "onRetry",
     "type": "(reason: AiSummaryRetry[\"reason\"]) => void",
     "optional": true,
     "description": "Regenerate, Retry after an error, or Update when the sources have moved on"
    },
    {
     "name": "onCiteOpen",
     "type": "(cite: AiSummaryCiteOpen) => boolean | void",
     "optional": true,
     "description": "A citation chip was used; return false to keep a link to the source from opening"
    },
    {
     "name": "onCopy",
     "type": "(text: string) => void",
     "optional": true,
     "description": "Called with the copied text once the summary is on the clipboard"
    }
   ],
   "hides": [
    "heading",
    "length",
    "feedback",
    "onCopy",
    "children"
   ],
   "events": {
    "tc-summarise": "onSummarise",
    "tc-retry": "onRetry",
    "tc-length-change": null,
    "tc-cite-open": "onCiteOpen",
    "tc-feedback": null,
    "tc-copy": "onCopy"
   }
  }
 ],
 "changelog": [
  "**`tc-ai-summary`** (AI & chat): the gist of a thread, meeting or set of documents. - **Summary:** a TL;DR, then a summary that streams in. - **Sources:** key points cite their sources as numbered chips with previews, plus open questions. - **Freshness:** a note when the sources have moved on, with Update. - **Controls:** Short / Detailed, feedback, a Sources list, Copy and Regenerate."
 ],
