 "functions": [],
 "react": [
  {
   "component": "TaskBoard",
   "exported": true,
   "props": [
    {
     "name": "tasks",
     "type": "Task[]",
     "optional": true,
     "description": "The tasks (controlled) – pass `onTasksChange` with it. Leave undefined to start from `defaultTasks`"
    },
    {
     "name": "defaultTasks",
     "type": "Task[]",
     "optional": true,
     "description": "The tasks to start from when uncontrolled"
    },
    {
     "name": "onTasksChange",
     "type": "(tasks: Task[]) => void",
     "optional": true,
     "description": "Called with all tasks after every change"
    },
    {
     "name": "statuses",
     "type": "TaskStatus[]",
     "optional": false,
     "description": "The columns, in order – an icon may be any React node"
    },
    {
     "name": "onChange",
     "type": "(tasks: Task[]) => void",
     "optional": true,
     "description": "Any change to the tasks (added, edited, moved or deleted) – the same as `onTasksChange`, kept from the block"
    }
   ],
   "hides": [
    "tasks",
    "statuses",
    "onChange"
   ],
   "events": {
    "tc-tasks-change": "onTasksChange"
   }
  }
 ],
 "changelog": [
  "All 18 blocks are now elements – `tc-agent-gallery`, `tc-ai-side-pane`, `tc-ai-workspace`, `tc-app-directory`, `tc-client-context`, `tc-evidence-gallery`, `tc-header-nav`, `tc-invoice-credit`, `tc-kpi-board`, `tc-logo-marquee`, `tc-metrics-dashboard`, `tc-oversight-home`, `tc-pricing-plans`, `tc-publish-readiness`, `tc-red-team-finding`, `tc-task-board`, `tc-testimonial-wall`, `tc-uncertainty-mix` – so Angular (`trenchcoat/angular`), Vue, Svelte, plain HTML and generative UI get them like any component, with docs pages."
 ],
