 "functions": [
  {
   "name": "skillRisks",
   "signature": "skillRisks(tools: readonly SkillDetailTool[]): Exclude<SkillPermission, \"read\">[]",
   "description": "The risky permissions among a skill's tools, in a fixed order"
  }
 ],
 "react": [
  {
   "component": "SkillDetail",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The skill's name, shown as the heading"
    },
    {
     "name": "enabled",
     "type": "boolean",
     "optional": true,
     "description": "It's on – controlled when given"
    },
    {
     "name": "defaultEnabled",
     "type": "boolean",
     "optional": true,
     "description": "Whether it's on at mount, when `enabled` isn't controlled"
    },
    {
     "name": "onEnabledChange",
     "type": "(enabled: boolean) => void",
     "optional": true,
     "description": "Called when it's turned on (after a risky skill's Turn on) or off"
    },
    {
     "name": "file",
     "type": "string | null",
     "optional": true,
     "description": "The file shown, or null for the first – controlled when given"
    },
    {
     "name": "defaultFile",
     "type": "string | null",
     "optional": true,
     "description": "The file shown at mount, when `file` isn't controlled"
    },
    {
     "name": "onFileChange",
     "type": "(file: string) => void",
     "optional": true,
     "description": "Called with the path of the file picked"
    },
    {
     "name": "onUpdate",
     "type": "(version: string) => void",
     "optional": true,
     "description": "Update was pressed: install `version`"
    },
    {
     "name": "onExport",
     "type": "() => void",
     "optional": true,
     "description": "Export was pressed"
    },
    {
     "name": "onRemove",
     "type": "(name: string, usedBy: string[]) => boolean | void",
     "optional": true,
     "description": "Remove was confirmed: remove it; return false to skip the announcement"
    }
   ],
   "hides": [
    "heading",
    "enabled",
    "file",
    "children"
   ],
   "events": {
    "tc-enabled-change": "onEnabledChange",
    "tc-file-change": null,
    "tc-update": "onUpdate",
    "tc-export": "onExport",
    "tc-remove": "onRemove"
   }
  }
 ],
