{
 "elements": [
  {
   "tag": "tc-skill-detail",
   "className": "TcSkillDetail",
   "description": "One skill: who made it and its version, when a model picks it, the tools it may use and what they can do, its files,\nrecent runs, and Enable, Update, Export and Remove – asking first before turning on anything risky or removing it.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The skill's name, shown as the heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "What it does, under the name",
     "readonly": false
    },
    {
     "name": "author",
     "attribute": "author",
     "type": "string",
     "default": "\"\"",
     "description": "Who made it: \"Built-in\", \"Your team\", a plugin's name, \"Community\"",
     "readonly": false
    },
    {
     "name": "version",
     "attribute": "version",
     "type": "string",
     "default": "\"\"",
     "description": "Its version, e.g. \"1.4.0\"",
     "readonly": false
    },
    {
     "name": "available",
     "attribute": "available",
     "type": "string",
     "default": "\"\"",
     "description": "A newer version that's available, e.g. \"1.5.0\"; shows Update",
     "readonly": false
    },
    {
     "name": "enabled",
     "attribute": "enabled",
     "type": "boolean",
     "default": "false",
     "description": "It's on. Changed by the switch unless a tc-enabled-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "triggers",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "When a model picks it: the phrases from its description",
     "readonly": false
    },
    {
     "name": "tools",
     "attribute": null,
     "type": "SkillDetailTool[]",
     "default": "[]",
     "description": "The tools it may use, with what each is allowed to do",
     "readonly": false
    },
    {
     "name": "files",
     "attribute": null,
     "type": "SkillDetailFile[]",
     "default": "[]",
     "description": "Its files, paths from the skill's root",
     "readonly": false
    },
    {
     "name": "file",
     "attribute": "file",
     "type": "string | null",
     "default": "null",
     "description": "The file shown; null shows the first. Changed by picking unless a tc-file-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "runs",
     "attribute": null,
     "type": "SkillDetailRun[]",
     "default": "[]",
     "description": "Recent runs, newest first",
     "readonly": false
    },
    {
     "name": "usedBy",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The agents that use it – named when removing",
     "readonly": false
    },
    {
     "name": "noRemove",
     "attribute": "no-remove",
     "type": "boolean",
     "default": "false",
     "description": "Hide Remove",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The time now, epoch ms, for \"3 h ago\"; without it, runs show their date",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "For dates and relative times",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<SkillDetailLabels>",
     "default": "{}",
     "description": "Words to rename, merged over defaultSkillDetailLabels; {name}, {version} and {agents} are filled in",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-enabled-change",
     "detail": "",
     "description": "The skill was turned on or off ({ enabled }: SkillDetailEnabledChange); cancelable – prevented, `enabled` stays as it was. Turning on a risky skill fires it only after Turn on is pressed",
     "cancelable": true
    },
    {
     "name": "tc-file-change",
     "detail": "",
     "description": "Another file was picked ({ file }: SkillDetailFileChange); cancelable – prevented, `file` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-update",
     "detail": "",
     "description": "Update was pressed ({ version }: SkillDetailUpdate)",
     "cancelable": false
    },
    {
     "name": "tc-export",
     "detail": "",
     "description": "Export was pressed (detail: {})",
     "cancelable": false
    },
    {
     "name": "tc-remove",
     "detail": "",
     "description": "Remove was confirmed ({ name, usedBy }: SkillDetailRemove); cancelable – prevented, nothing is announced",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "skd",
   "cssProperties": [
    {
     "name": "--tc-skd-files-w",
     "value": "200px",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-skd-mark",
     "value": "8px",
     "looks": [
      "both"
     ]
    }
   ],
