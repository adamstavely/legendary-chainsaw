{
 "elements": [
  {
   "tag": "tc-share-panel",
   "className": "TcSharePanel",
   "description": "Shares something with people and groups, at a level for each, after checking each is entitled to see it.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The heading; by default \"Share\", or \"Share {resource-name}\"",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "A line under the heading, such as the data's classification",
     "readonly": false
    },
    {
     "name": "resourceName",
     "attribute": "resource-name",
     "type": "string",
     "default": "\"\"",
     "description": "What's being shared",
     "readonly": false
    },
    {
     "name": "directory",
     "attribute": null,
     "type": "ShareRecipient[]",
     "default": "[]",
     "description": "The people and groups to choose from, filtered as you type. Ignored when `search` is set",
     "readonly": false
    },
    {
     "name": "search",
     "attribute": null,
     "type": "ShareSearch | undefined",
     "default": "undefined",
     "description": "Looks people and groups up on the server",
     "readonly": false
    },
    {
     "name": "access",
     "attribute": null,
     "type": "ShareGrant[]",
     "default": "[]",
     "description": "Who has access now. Updated on Share unless a tc-share listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "levels",
     "attribute": null,
     "type": "ShareLevel[]",
     "default": "[ { id: \"view\", label: \"Can view\" }, { id: \"comment\", label: \"Can comment\" }, { id: \"edit\", label: \"Can edit\" }, ]",
     "description": "The levels of access, least first",
     "readonly": false
    },
    {
     "name": "defaultLevel",
     "attribute": "default-level",
     "type": "string",
     "default": "\"\"",
     "description": "The level someone starts at; by default the first",
     "readonly": false
    },
    {
     "name": "checkEntitlement",
     "attribute": null,
     "type": "ShareEntitlementCheck | undefined",
     "default": "undefined",
     "description": "Asks whether a recipient may see the data at a level. Without it nobody can be added",
     "readonly": false
    },
    {
     "name": "sending",
     "attribute": "sending",
     "type": "boolean",
     "default": "false",
     "description": "The page is sending the share: controls are locked",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<SharePanelLabels>",
     "default": "{}",
     "description": "Rename any of the words",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-share",
     "detail": "",
     "description": "Share was pressed ({ access, add, change, remove, excluded, partial }: ShareSubmit); cancelable – prevented, `access` stays as it was and the rows stay pending",
     "cancelable": true
    },
    {
     "name": "tc-share-denied",
     "detail": "",
     "description": "A check found someone isn't entitled ({ recipient, level, entitlement }: ShareDenied)",
     "cancelable": false
    }
