  {
   "component": "SharePanel",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading; by default \"Share\", or \"Share {resourceName}\""
    },
    {
     "name": "access",
     "type": "ShareGrant[]",
     "optional": true,
     "description": "Who has access now – controlled when given"
    },
    {
     "name": "defaultAccess",
     "type": "ShareGrant[]",
     "optional": true,
     "description": "Who has access on mount when `access` isn't controlled"
    },
    {
     "name": "onShare",
     "type": "(detail: ShareSubmit) => void",
     "optional": true,
     "description": "Share was pressed; `detail` says who was added, changed, removed and left out"
    }
