{
 "elements": [
  {
   "tag": "tc-file-summary",
   "className": "TcFileSummary",
   "description": "An AI summary of a file – the file's type, size and length, a summary that streams in, key points citing their\npages or times, the people, organisations, dates and amounts it mentions, and Copy, Regenerate and Open file.",
   "properties": [
    {
     "name": "file",
     "attribute": null,
     "type": "FileSummaryFile",
     "default": "{ name: \"Untitled\" }",
     "description": "The file summarised",
     "readonly": false
    },
    {
     "name": "href",
     "attribute": "href",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Where the file opens; makes Open file and the citation chips links",
     "readonly": false
    },
    {
     "name": "openable",
     "attribute": "openable",
     "type": "boolean",
     "default": "false",
     "description": "Show Open file without `href` – it then only fires tc-open",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "FileSummaryStatus",
     "default": "\"idle\"",
     "description": "Where the summary is: \"idle\", \"summarising\", \"done\" or \"error\"",
     "readonly": false
    },
    {
     "name": "summary",
     "attribute": "summary",
     "type": "string",
     "default": "\"\"",
     "description": "The summary; may grow while \"summarising\". Blank lines split paragraphs",
     "readonly": false
    },
    {
     "name": "points",
     "attribute": null,
     "type": "FileSummaryPoint[]",
     "default": "[]",
     "description": "The key points, each with the pages or times it comes from",
     "readonly": false
    },
    {
     "name": "entities",
     "attribute": null,
     "type": "FileSummaryEntity[]",
     "default": "[]",
     "description": "People, organisations, dates and amounts the file mentions",
     "readonly": false
    },
    {
     "name": "coverage",
     "attribute": "coverage",
     "type": "string | undefined",
     "default": "undefined",
     "description": "How much of the file the summary covers, e.g. \"Covers 42 of 48 pages · 3 pages unreadable\"",
     "readonly": false
    },
    {
     "name": "summarisedAt",
     "attribute": "summarised-at",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When it was summarised, as epoch ms",
     "readonly": false
    },
    {
     "name": "model",
     "attribute": "model",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The model that wrote it, e.g. \"Claude Sonnet\"",
     "readonly": false
    },
    {
     "name": "length",
     "attribute": "length",
     "type": "FileSummaryLength",
     "default": "\"short\"",
     "description": "Short or detailed. Changed by the user unless a tc-length-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "error",
     "attribute": "error",
     "type": "string | undefined",
     "default": "undefined",
     "description": "What went wrong, shown with \"error\"",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for dates and numbers, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-summarise",
     "detail": "",
     "description": "Summarise was pressed while `status` is \"idle\" – start summarising",
     "cancelable": false
    },
    {
     "name": "tc-retry",
     "detail": "",
     "description": "Regenerate, or Retry after an error ({ reason: \"regenerate\" | \"error\" }: FileSummaryRetry)",
     "cancelable": false
    },
    {
     "name": "tc-length-change",
     "detail": "",
     "description": "Short or Detailed was picked ({ length }: FileSummaryLengthChange); cancelable – prevented, `length` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-cite-open",
     "detail": "",
     "description": "A citation chip was used ({ pointId, page, time }: FileSummaryCiteOpen); cancelable – prevented, a link to the file doesn't open",
     "cancelable": true
    },
    {
     "name": "tc-entity-select",
     "detail": "",
     "description": "A person, organisation, date or amount was picked ({ entity }: { entity: FileSummaryEntity })",
     "cancelable": false
    },
    {
     "name": "tc-copy",
     "detail": "",
     "description": "The summary is on the clipboard ({ text })",
     "cancelable": false
    },
    {
     "name": "tc-open",
     "detail": "",
     "description": "Open file was used; cancelable – prevented, a link to the file doesn't open",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "fsum",
