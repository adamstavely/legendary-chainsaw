 "functions": [
  {
   "name": "fileSummaryKind",
   "signature": "fileSummaryKind(file: Pick<FileSummaryFile, \"name\" | \"kind\">): FileSummaryKind",
   "description": "The kind of a file: given, else from its extension"
  }
 ],
 "react": [
  {
   "component": "FileSummary",
   "exported": true,
   "props": [
    {
     "name": "length",
     "type": "FileSummaryLength",
     "optional": true,
     "description": "Short or detailed – controlled when given"
    },
    {
     "name": "defaultLength",
     "type": "FileSummaryLength",
     "optional": true,
     "description": "The length on mount when `length` isn't controlled"
    },
    {
     "name": "onLengthChange",
     "type": "(length: FileSummaryLength) => void",
     "optional": true,
     "description": "Short or Detailed was picked – summarise again"
    },
    {
     "name": "onSummarise",
     "type": "() => void",
     "optional": true,
     "description": "Summarise was pressed – start summarising"
    },
    {
     "name": "onRetry",
     "type": "(reason: FileSummaryRetry[\"reason\"]) => void",
     "optional": true,
     "description": "Regenerate, or Retry after an error"
    },
    {
     "name": "onCiteOpen",
     "type": "(cite: FileSummaryCiteOpen) => boolean | void",
     "optional": true,
     "description": "A citation chip was used; return false to keep a link to the file from opening (jump inside your own viewer)"
    },
    {
     "name": "onEntitySelect",
     "type": "(entity: FileSummaryEntity) => void",
     "optional": true,
     "description": "A person, organisation, date or amount was picked"
    },
    {
     "name": "onCopy",
     "type": "(text: string) => void",
     "optional": true,
     "description": "Called with the copied text once the summary is on the clipboard"
    },
    {
     "name": "onOpen",
     "type": "() => boolean | void",
     "optional": true,
     "description": "Open file was used; return false to keep the link from opening"
    }
   ],
   "hides": [
    "length",
    "onCopy",
    "children"
   ],
   "events": {
    "tc-summarise": "onSummarise",
    "tc-retry": "onRetry",
    "tc-length-change": null,
    "tc-cite-open": "onCiteOpen",
    "tc-entity-select": "onEntitySelect",
    "tc-copy": "onCopy",
    "tc-open": "onOpen"
   }
  }
 ],
 "changelog": [
  "**`tc-file-summary`:** an AI summary of a file that streams in. - **Content:** key points citing their pages or times, plus the people, organisations, dates and amounts mentioned. - **Controls:** Short / Detailed, coverage, and Copy, Regenerate and Open file."
 ],
