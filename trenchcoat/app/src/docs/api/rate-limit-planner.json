    "--tc-status-danger-solid",
    "--tc-status-success-bg",
    "--tc-status-success-fg",
    "--tc-surface-on-tray",
    "--tc-surface-raised",
    "--tc-surface-tray",
    "--tc-text-muted",
    "--tc-text-on-accent",
    "--tc-text-primary",
    "--tc-text-secondary",
    "--tc-tray-inset",
    "--tc-tray-radius"
   ]
  }
 ],
 "functions": [
  {
   "name": "rateLoad",
   "signature": "rateLoad(runs: readonly PlannedRun[], from: number, minutes: number, step: unknown): number[]",
   "description": "The total load in each `step`-minute slot from `from` for `minutes`"
  },
  {
   "name": "spreadRuns",
   "signature": "spreadRuns(runs: readonly PlannedRun[], { day, hours = 24, step = 15 }: { day: number; hours?: number; step?: number }): PlannedRun[]",
   "description": "Start times that lower the day's peak: fixed runs stay; the others, biggest first, each go where the load they'd add\nto is lowest, nearest their own start on a tie. Runs come back in the order given"
  }
 ],
 "react": [
  {
   "component": "RateLimitPlanner",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading"
    },
    {
     "name": "runs",
     "type": "PlannedRun[]",
     "optional": true,
     "description": "The runs – controlled when given"
    },
    {
     "name": "defaultRuns",
     "type": "PlannedRun[]",
     "optional": true,
     "description": "The runs on mount when `runs` isn't controlled"
    },
    {
     "name": "onRunsChange",
     "type": "(runs: PlannedRun[], change: RateLimitRunsChange[\"change\"], id: string | null) => void",
     "optional": true,
     "description": "A run was moved, or Spread out proposed new start times"
    }
   ],
   "hides": [
    "heading",
    "runs",
    "children"
   ],
   "events": {
    "tc-runs-change": null
   }
  }
 ],
