{
 "elements": [
  {
   "tag": "tc-rate-limit-planner",
   "className": "TcRateLimitPlanner",
   "description": "Plan agent runs under one API rate limit – the day's load against the limit, overflow hatched, a draggable bar per\nrun and Spread out to lower the peak.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Rate limit plan\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "runs",
     "attribute": null,
     "type": "PlannedRun[]",
     "default": "[]",
     "description": "The runs. Changed by dragging, the keys and Spread out unless a tc-runs-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "limit",
     "attribute": "limit",
     "type": "number",
     "default": "0",
     "description": "The limit, in tokens per minute",
     "readonly": false
    },
    {
     "name": "day",
     "attribute": "day",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Where the time axis starts, as epoch ms; by default the UTC midnight before the first run",
     "readonly": false
    },
    {
     "name": "hours",
     "attribute": "hours",
     "type": "number",
     "default": "24",
     "description": "How many hours the axis covers",
     "readonly": false
    },
    {
     "name": "step",
     "attribute": "step",
     "type": "number",
     "default": "15",
     "description": "The minutes a run moves by, and the chart's resolution",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for numbers and times, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "timeZone",
     "attribute": "time-zone",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The time zone times are shown in, e.g. \"Europe/London\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "summary",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "The peak, when it is, and the stretches over the limit",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-runs-change",
     "detail": "",
     "description": "A run was moved, or Spread out proposed new start times ({ runs, change, id }: RateLimitRunsChange); cancelable – prevented, `runs` stays as it was",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "peakWords",
     "params": "",
     "returns": "void",
     "description": "\"Peak 520K a minute at 01:15 – 30% over the limit\" or \"Peak 310K a minute at 04:00 – 78% of the limit\""
    },
    {
     "name": "overWords",
     "params": "",
     "returns": "void",
     "description": "\"Over the limit for 1 h 15 min: 01:00–02:15\" or \"Under the limit all day\""
    },
    {
     "name": "valueText",
     "params": "r: PlannedRun",
     "returns": "void",
     "description": ""
    },
    {
     "name": "moveTo",
     "params": "id: string, start: number, announce: unknown",
     "returns": "void",
     "description": "Moves a run to start at `start`, snapped to `step` and kept inside the day"
    },
    {
     "name": "spread",
     "params": "",
     "returns": "void",
     "description": "Proposes start times that lower the peak, and applies them unless the page prevents it"
    }
   ],
   "ui": "rlp",
   "cssProperties": [
    {
     "name": "--tc-rlp-names",
     "value": "148px",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-rlp-chart-h",
     "value": "140px",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-rlp-bar-h",
     "value": "18px",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-rlp-min",
     "value": "640px",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-rlp-bg",
     "value": "var(--tc-surface-raised)",
     "looks": [
      "standard",
      "clean"
     ]
    }
   ],
