   "description": "The agent's screen, live: its clicks and typing drawn on top, a caption per step, and Pause / Take over.",
   "properties": [
    {
     "name": "actions",
     "attribute": null,
     "type": "LiveViewAction[]",
     "default": "[]",
     "description": "What the agent did, oldest first, in the frame's pixels – the last one is where the pointer is now",
     "readonly": false
    },
    {
     "name": "src",
     "attribute": "src",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The latest frame as an image URL",
     "readonly": false
