     "name": "alt",
     "attribute": "alt",
     "type": "string",
     "default": "\"The agent's screen\"",
     "description": "The frame's text alternative, for `src`",
     "readonly": false
    },
    {
     "name": "source",
     "attribute": null,
     "type": "| HTMLVideoElement | HTMLCanvasElement | HTMLImageElement | undefined",
     "default": "undefined",
     "description": "A live element to show instead – a <video>, <canvas> or <img> the app keeps drawing into (it is moved here)",
     "readonly": false
    },
    {
     "name": "frameWidth",
     "attribute": "frame-width",
     "type": "| number | undefined",
     "default": "undefined",
     "description": "The frame's width in its own pixels – the actions' coordinate space. Unset: the image's, video's or canvas's own.\nThe screen takes the frame's shape and the overlays follow it; give a stream of the same shape (a different one\nis letterboxed inside the frame, and actions land on the frame, not on the picture)",
     "readonly": false
    },
    {
     "name": "frameHeight",
     "attribute": "frame-height",
     "type": "| number | undefined",
     "default": "undefined",
     "description": "The frame's height in its own pixels",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "What the agent is doing overall – e.g. \"Booking a table for four\"",
     "readonly": false
    },
    {
     "name": "caption",
     "attribute": "caption",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The step's caption – unset uses the latest action's `caption`",
     "readonly": false
    },
    {
     "name": "step",
     "attribute": "step",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The step's number, from 1",
     "readonly": false
    },
    {
     "name": "steps",
     "attribute": "steps",
     "type": "number | undefined",
     "default": "undefined",
     "description": "How many steps there are, when known",
     "readonly": false
    },
    {
     "name": "agent",
     "attribute": "agent",
     "type": "string",
     "default": "\"\"",
     "description": "The name on the pointer's flag – e.g. \"Operator\"; unset shows the flag only for typing, keys and scrolls",
     "readonly": false
    },
    {
     "name": "color",
     "attribute": "color",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The pointer's color – defaults to the accent",
     "readonly": false
    },
    {
     "name": "paused",
     "attribute": "paused",
     "type": "boolean",
     "default": "false",
     "description": "The agent is paused – the screen dims and says so",
     "readonly": false
    },
    {
     "name": "control",
     "attribute": "control",
     "type": "LiveViewControl",
     "default": "\"agent\"",
     "description": "Who drives the screen; \"user\" after Take over",
     "readonly": false
    },
    {
     "name": "ended",
     "attribute": "ended",
     "type": "boolean",
     "default": "false",
