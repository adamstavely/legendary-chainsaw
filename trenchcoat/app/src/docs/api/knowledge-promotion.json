 "functions": [],
 "react": [
  {
   "component": "KnowledgePromotion",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the region's name"
    },
    {
     "name": "status",
     "type": "KnowledgeStatus",
     "optional": true,
     "description": "\"candidate\", \"promoting\" or \"promoted\". Controlled when defined: Promote only reports through onPromote, and you\npass the new status back. Otherwise the component marks the fact promoted itself"
    },
    {
     "name": "defaultStatus",
     "type": "KnowledgeStatus",
     "optional": true,
     "description": "The status at first, when uncontrolled"
    },
    {
     "name": "onPromote",
     "type": "(fact: KnowledgeFact, unmetRecommended: string[]) => void",
     "optional": true,
     "description": "Promote was pressed with every required condition met: the fact and the ids of recommended conditions not met"
    },
    {
     "name": "onDispute",
     "type": "(reason: string, version: string) => void",
     "optional": true,
     "description": "Shows Dispute; called with the reason and the corrected wording (\"\" when none) when the form is sent"
    }
   ],
   "hides": [
    "heading",
    "status",
    "noDispute"
   ],
   "events": {
    "tc-promote": "onPromote",
    "tc-dispute": "onDispute"
   }
  }
 ],
 "changelog": [
  "**Trust & calibration**, from THEMIS and built domain-neutral: - `tc-agreement-tracker`, `tc-confidence-brief`, `tc-capability-notice`, `tc-transcript-review`, `tc-version-history`, `tc-session-context-bar`, `tc-evidence-coverage`, `tc-review-conflict`; - `tc-handoff-brief`, `tc-engagement-quality`, `tc-knowledge-promotion`, `tc-friction-profile`, `tc-reasoning-flags`."
