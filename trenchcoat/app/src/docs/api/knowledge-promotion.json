{
 "elements": [
  {
   "tag": "tc-knowledge-promotion",
   "className": "TcKnowledgePromotion",
   "description": "Promote a verified fact into shared team knowledge: the fact with any disputed versions beside it, a checklist of\nrequired and recommended conditions with who met them and when, and Promote and Dispute.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Promote to team knowledge\"",
     "description": "The heading, and the region's name",
     "readonly": false
    },
    {
     "name": "scope",
     "attribute": "scope",
     "type": "string",
     "default": "\"\"",
     "description": "Where the knowledge goes or what it covers, a quiet line under the heading – e.g. \"Acme lease review\"",
     "readonly": false
    },
    {
     "name": "fact",
     "attribute": null,
     "type": "KnowledgeFact",
     "default": "{ text: \"\" }",
     "description": "The fact to promote",
     "readonly": false
    },
    {
     "name": "conditions",
     "attribute": null,
     "type": "KnowledgeCondition[]",
     "default": "[]",
     "description": "The checklist, in order – required conditions block Promote, recommended ones only warn",
     "readonly": false
    },
    {
     "name": "versions",
     "attribute": null,
     "type": "KnowledgeVersion[]",
     "default": "[]",
     "description": "Disputed versions of the fact, shown side by side with it",
     "readonly": false
    },
    {
     "name": "threshold",
     "attribute": "threshold",
     "type": "number",
     "default": "0.8",
     "description": "Confidence the fact needs, 0–1 – checked when `fact.confidence` is set",
     "readonly": false
    },
    {
     "name": "thresholdOptional",
     "attribute": "threshold-optional",
     "type": "boolean",
     "default": "false",
     "description": "Makes the confidence condition recommended instead of required",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "KnowledgeStatus",
     "default": "\"candidate\"",
     "description": "\"candidate\" (default), \"promoting\" while the app saves, or \"promoted\"",
     "readonly": false
    },
    {
     "name": "error",
     "attribute": "error",
     "type": "string",
     "default": "\"\"",
     "description": "Why the last promotion failed – shown above the actions; Promote tries again",
     "readonly": false
    },
    {
     "name": "disputing",
     "attribute": "disputing",
     "type": "boolean",
     "default": "false",
     "description": "The dispute form is open – set false to close it after a prevented tc-dispute",
     "readonly": false
    },
    {
     "name": "noDispute",
     "attribute": "no-dispute",
     "type": "boolean",
     "default": "false",
     "description": "Hides Dispute, for people who can promote but not dispute",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string",
     "default": "\"en-US\"",
     "description": "Locale for numbers",
     "readonly": false
    },
    {
     "name": "ready",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "Every required condition is met",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-promote",
     "detail": "",
     "description": "Promote was pressed with every required condition met (detail: { fact, unmetRecommended: ids of recommended conditions not met }); cancelable – prevent it to save first and set `status` yourself",
     "cancelable": true
    },
    {
     "name": "tc-dispute",
     "detail": "",
     "description": "The dispute form was sent (detail: { reason, version: the corrected wording, or \"\" }); cancelable – prevent it to keep the form open, e.g. while saving",
     "cancelable": true
    }
   ],
