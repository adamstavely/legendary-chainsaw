 "functions": [],
 "react": [
  {
   "component": "SmartRecommendation",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the region's name – \"Smart recommendation\" by default"
    },
    {
     "name": "options",
     "type": "Recommendation[]",
     "optional": false,
     "description": "First entry is the recommendation, the rest are offered as alternatives. A new set of options starts over\n(uncontrolled choice and acceptance go back to the recommendation); an empty list shows the card with nothing to accept"
    },
    {
     "name": "value",
     "type": "string",
     "optional": true,
     "description": "Id of the option on show (controlled when defined) – the recommendation or an alternative"
    },
    {
     "name": "defaultValue",
     "type": "string",
     "optional": true,
     "description": "The option on show at first when uncontrolled – defaults to the recommendation"
    },
    {
     "name": "onValueChange",
     "type": "(id: string) => void",
     "optional": true,
     "description": "Called when an alternative (or the recommendation again) is picked from the menu"
    },
    {
     "name": "accepted",
     "type": "string | null",
     "optional": true,
     "description": "Id of the accepted option, or null (controlled when defined). onAccept / onUndo report the changes"
    },
    {
     "name": "defaultAccepted",
     "type": "string | null",
     "optional": true,
     "description": "The accepted option at first when uncontrolled – null by default"
    },
    {
     "name": "onAccept",
     "type": "(option: Recommendation) => void | Promise<unknown>",
     "optional": true,
     "description": "Accepts the option. Return a promise to keep the button pending until it settles: the option counts as\naccepted once it resolves, and a rejection says so and lets you try again"
    },
    {
     "name": "onUndo",
     "type": "(option: Recommendation) => void | Promise<unknown>",
     "optional": true,
     "description": "Takes the acceptance back – may return a promise, like onAccept"
    },
    {
     "name": "open",
     "type": "boolean",
     "optional": true,
     "description": "Whether the reason is unfolded (controlled when defined)"
    },
    {
     "name": "defaultOpen",
     "type": "boolean",
     "optional": true,
     "description": "Whether the reason starts unfolded when uncontrolled – true by default"
    },
    {
     "name": "onOpenChange",
     "type": "(open: boolean) => void",
     "optional": true,
     "description": "Called when the reason is folded or unfolded"
    }
   ],
