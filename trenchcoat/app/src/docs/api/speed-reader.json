{
 "elements": [
  {
   "tag": "tc-speed-reader",
   "className": "TcSpeedReader",
   "description": "Speed reading, one word at a time in a fixed frame, with the recognition point on a guide mark, the speed, words at\na time, a scrubber and the time left.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Speed reader\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "A quiet line under the heading – the source or what the passage is",
     "readonly": false
    },
    {
     "name": "text",
     "attribute": "text",
     "type": "string",
     "default": "\"\"",
     "description": "The passage: plain text; a blank line starts a new paragraph",
     "readonly": false
    },
    {
     "name": "wpm",
     "attribute": "wpm",
     "type": "number",
     "default": "300",
     "description": "Words a minute, 100–1000. Changed by the element unless a tc-wpm-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "chunk",
     "attribute": "chunk",
     "type": "number",
     "default": "1",
     "description": "Words shown at a time, 1–3. Changed by the element unless a tc-chunk-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "position",
     "attribute": "position",
     "type": "number",
     "default": "0",
     "description": "The first word on screen (0-based). Changed by the element unless a tc-position-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "scheduler",
     "attribute": null,
     "type": "SpeedReaderScheduler",
     "default": "{ set: (run, ms) => setTimeout(run, ms), clear: (handle) => clearTimeout(handle as ReturnType<typeof setTimeout>), }",
     "description": "When the next word is due – setTimeout unless given; tests and pages that sync to something else pass their own",
     "readonly": false
    },
    {
     "name": "playing",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "Whether it's reading",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-wpm-change",
     "detail": "",
     "description": "The speed was changed ({ wpm }: SpeedReaderWpmChange); cancelable – prevented, `wpm` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-chunk-change",
     "detail": "",
     "description": "The words at a time were changed ({ chunk }: SpeedReaderChunkChange); cancelable – prevented, `chunk` stays",
     "cancelable": true
    },
    {
     "name": "tc-position-change",
     "detail": "",
     "description": "The place moved, by reading on, stepping or the scrubber ({ position }: SpeedReaderPositionChange); cancelable – prevented, `position` stays",
     "cancelable": true
    },
    {
     "name": "tc-finish",
     "detail": "",
     "description": "The last word was shown ({ words }: SpeedReaderFinish)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "play",
     "params": "",
     "returns": "void",
     "description": "Starts reading (from the start again when at the end)"
    },
    {
     "name": "pause",
     "params": "",
     "returns": "void",
     "description": "Pauses on the current word"
    }
   ],
   "ui": "spr",
   "cssProperties": [
    {
     "name": "--tc-spr-frame-h",
     "value": "112px",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-spr-guide",
     "value": "var(--tc-border-strong)",
     "looks": [
      "both"
     ]
    }
   ],
