 "functions": [
  {
   "name": "readerWords",
   "signature": "readerWords(text: string): Word[]",
   "description": "Splits a passage into words, numbering their sentences; a blank line also ends one"
  },
  {
   "name": "recognitionPoint",
   "signature": "recognitionPoint(word: string): void",
   "description": "The optimal recognition point: the index of the letter to fix the eye on"
  },
  {
   "name": "wordWeight",
   "signature": "wordWeight(word: string): void",
   "description": "How long a word stays up, in words: longer after a sentence end, a comma, or a long word"
  }
 ],
 "react": [
  {
   "component": "SpeedReader",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading; \"Speed reader\" by default"
    },
    {
     "name": "wpm",
     "type": "number",
     "optional": true,
     "description": "Words a minute, 100–1000 – controlled when given"
    },
    {
     "name": "defaultWpm",
     "type": "number",
     "optional": true,
     "description": "The speed on mount when `wpm` isn't controlled"
    },
    {
     "name": "onWpmChange",
     "type": "(wpm: number) => void",
     "optional": true,
     "description": "The speed was changed"
    },
    {
     "name": "chunk",
     "type": "number",
     "optional": true,
     "description": "Words shown at a time, 1–3 – controlled when given"
    },
    {
     "name": "defaultChunk",
     "type": "number",
     "optional": true,
     "description": "The words at a time on mount when `chunk` isn't controlled"
    },
    {
     "name": "onChunkChange",
     "type": "(chunk: number) => void",
     "optional": true,
     "description": "The words at a time were changed"
    },
    {
     "name": "position",
     "type": "number",
     "optional": true,
     "description": "The first word on screen, 0-based – controlled when given"
    },
    {
     "name": "defaultPosition",
     "type": "number",
     "optional": true,
     "description": "The place on mount when `position` isn't controlled"
    },
    {
     "name": "onPositionChange",
     "type": "(position: number) => void",
     "optional": true,
     "description": "The place moved – reading on, stepping or the scrubber"
    },
    {
     "name": "onFinish",
     "type": "(words: number) => void",
     "optional": true,
     "description": "The last word was shown"
    }
   ],
   "hides": [
    "heading",
    "wpm",
    "chunk",
    "position",
    "children"
   ],
   "events": {
    "tc-wpm-change": "onWpmChange",
    "tc-chunk-change": "onChunkChange",
    "tc-position-change": "onPositionChange",
    "tc-finish": "onFinish"
   }
  }
 ],
