{
 "elements": [
  {
   "tag": "tc-kpi-chart",
   "className": "TcKpiChart",
   "description": "A metric card with a multi-line chart, a legend and a hover tooltip.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The card's title",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": "value",
     "type": "string",
     "default": "\"\"",
     "description": "Headline value, already formatted, e.g. \"$96.4k\"",
     "readonly": false
    },
    {
     "name": "delta",
     "attribute": "delta",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Change against the previous period – a rise is green and a drop red, unless `lowerIsBetter`",
     "readonly": false
    },
    {
     "name": "lowerIsBetter",
     "attribute": "lower-is-better",
     "type": "boolean",
     "default": "false",
     "description": "A drop is the good direction (latency, cost, error rate): a negative `delta` shows green, a positive one red",
     "readonly": false
    },
    {
     "name": "deltaFormat",
     "attribute": null,
     "type": "((n: number) => string) | undefined",
     "default": "undefined",
     "description": "Formats the change on its own, e.g. as a percentage – unset uses `format`",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "Short labels along the x-axis, e.g. \"Mar 4\"",
     "readonly": false
    },
    {
     "name": "tooltipLabels",
     "attribute": null,
     "type": "string[] | undefined",
     "default": "undefined",
     "description": "Longer labels for the tooltip header, e.g. \"Tue, Mar 4\" – falls back to `labels`",
     "readonly": false
    },
    {
     "name": "series",
     "attribute": null,
     "type": "KpiSeries[]",
     "default": "[]",
     "description": "The lines, each with a label, an optional colour and one value per label – every line also gets its own stroke pattern",
     "readonly": false
    },
    {
     "name": "format",
     "attribute": null,
     "type": "(n: number) => string",
     "default": "compact",
     "description": "Formats the axis, tooltip and delta values",
     "readonly": false
    },
    {
     "name": "footer",
     "attribute": "footer",
     "type": "string",
     "default": "\"\"",
     "description": "Line under the chart",
     "readonly": false
    },
    {
     "name": "legend",
     "attribute": "legend",
     "type": "boolean | undefined",
     "default": "undefined",
     "description": "A legend naming each line – unset shows it when there are two or more lines; legend=\"false\" hides it",
     "readonly": false
    },
    {
     "name": "defaultIndex",
     "attribute": "default-index",
     "type": "number | undefined",
     "default": "undefined",
     "description": "Point that stays highlighted while nobody hovers – unset hides the tooltip at rest",
     "readonly": false
    },
    {
     "name": "index",
     "attribute": "index",
     "type": "number | null",
     "default": "null",
     "description": "The highlighted point, or null for none (then `defaultIndex` shows)",
     "readonly": false
    },
    {
     "name": "fill",
     "attribute": "fill",
     "type": "boolean",
     "default": "false",
     "description": "Fill the container: no max-width, the card stretches and the plot grows with its height",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-index-change",
     "detail": "",
     "description": "The highlighted point changes by pointer or keyboard; detail `{ index: number | null }`. Cancelable: prevent it to control `index`",
