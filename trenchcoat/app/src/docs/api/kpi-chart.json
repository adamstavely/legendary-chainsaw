 "functions": [
  {
   "name": "niceRange",
   "signature": "niceRange(values: number[]): [min: number, max: number]",
   "description": "Picks an axis range that halves cleanly and always includes 0: 30 → 15 → 0, $8k → $4k → $0, 10 → 0 → −10.\nEmpty or non-finite data falls back to 0–2 instead of NaN."
  }
 ],
