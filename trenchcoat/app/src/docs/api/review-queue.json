{
 "elements": [
  {
   "tag": "tc-review-queue",
   "className": "TcReviewQueue",
   "description": "Grade real outputs one at a time from the keyboard: per-criterion grades, a note and a verdict, with progress and undo.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Review queue\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "items",
     "attribute": null,
     "type": "ReviewQueueItem[]",
     "default": "[]",
     "description": "The outputs to grade, in order",
     "readonly": false
    },
    {
     "name": "criteria",
     "attribute": null,
     "type": "ReviewQueueCriterion[]",
     "default": "[ { id: \"correct\", label: \"Correct\", description: \"Is everything it says true?\" }, { id: \"grounded\", label: \"Grounded\", description: \"Does it stick to the policy text?\" }, { id: \"helpful\", label: \"Helpful\", description: \"How well does it answer what was asked?\", kind: \"scale\", min: 1, max: 5 }, ]",
     "description": "What each output is graded on",
     "readonly": false
    },
    {
     "name": "index",
     "attribute": "index",
     "type": "number",
     "default": "0",
     "description": "The item showing. Changed by the user unless a tc-index-change listener prevents it",
     "readonly": false
    },
    {
     "name": "results",
     "attribute": null,
     "type": "Record<string, ReviewQueueResult>",
     "default": "{}",
     "description": "Where each item stands, by id. Changed by submits, skips and undo unless a tc-results-change listener prevents it",
     "readonly": false
    },
    {
     "name": "noShortcuts",
     "attribute": "no-shortcuts",
     "type": "boolean",
     "default": "false",
     "description": "Turns the single-key shortcuts off (buttons still work)",
     "readonly": false
    },
    {
     "name": "current",
     "attribute": null,
     "type": "ReviewQueueItem | undefined",
     "default": null,
     "description": "The item showing",
     "readonly": true
    },
    {
     "name": "counts",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "How many are graded and skipped",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-grade",
     "detail": "",
     "description": "An item was submitted ({ id, grades, verdict, note }: ReviewQueueGrade); cancelable – prevented, it stays open",
     "cancelable": true
    },
    {
     "name": "tc-skip",
     "detail": "",
     "description": "An item was skipped ({ id }); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-undo",
     "detail": "",
     "description": "The last submit was undone ({ id }); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-index-change",
     "detail": "",
     "description": "Another item came up ({ index, item }: ReviewQueueIndexChange); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-results-change",
     "detail": "",
     "description": "An item was graded, skipped or undone ({ results, id }: ReviewQueueResultsChange); cancelable",
     "cancelable": true
    }
   ],
   "slots": [],
