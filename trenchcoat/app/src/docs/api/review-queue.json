 "functions": [
  {
   "name": "suggestVerdict",
   "signature": "suggestVerdict(criteria: ReviewQueueCriterion[], grades: Record<string, ReviewQueueGradeValue>): ReviewQueueVerdict | null",
   "description": "The verdict the grades suggest: fail when any pass/fail criterion failed or a scale sits in its lower half"
  }
 ],
 "react": [
  {
   "component": "ReviewQueue",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading – defaults to \"Review queue\""
    },
    {
     "name": "index",
     "type": "number",
     "optional": true,
     "description": "The item showing. Controlled when defined"
    },
    {
     "name": "defaultIndex",
     "type": "number",
     "optional": true,
     "description": "On mount, when `index` isn't controlled"
    },
    {
     "name": "onIndexChange",
     "type": "(index: number, item: ReviewQueueItem | undefined) => void",
     "optional": true,
     "description": "Called with the next `index`"
    },
    {
     "name": "results",
     "type": "Record<string, ReviewQueueResult>",
     "optional": true,
     "description": "Where each item stands, by id. Controlled when defined"
    },
    {
     "name": "defaultResults",
     "type": "Record<string, ReviewQueueResult>",
     "optional": true,
     "description": "On mount, when `results` isn't controlled"
    },
    {
     "name": "onResultsChange",
     "type": "(results: Record<string, ReviewQueueResult>) => void",
     "optional": true,
     "description": "Called with the next `results`"
    },
    {
     "name": "onGrade",
     "type": "(grade: ReviewQueueGrade) => void | boolean",
     "optional": true,
     "description": "Called when an item is submitted. Return false to keep it open"
    },
    {
     "name": "onSkip",
     "type": "(id: string) => void | boolean",
     "optional": true,
     "description": "Called when an item is skipped. Return false to stay on it"
    },
    {
     "name": "onUndo",
     "type": "(id: string) => void | boolean",
     "optional": true,
     "description": "Called when the last submit is undone. Return false to keep it"
    }
   ],
   "hides": [
    "heading",
    "index",
    "results"
   ],
   "events": {
    "tc-grade": "onGrade",
    "tc-skip": "onSkip",
    "tc-undo": "onUndo",
    "tc-index-change": "onIndexChange",
    "tc-results-change": null
   }
  }
 ],
