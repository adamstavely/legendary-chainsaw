 "functions": [
  {
   "name": "defaultRedactKeys",
   "signature": "defaultRedactKeys: array",
   "description": "Keys masked by default, in headers and bodies, compared without case, - or _"
  },
  {
   "name": "statusClass",
   "signature": "statusClass(status: number): RequestStatusClass",
   "description": "The status class a code belongs to: 429 is its own; no response counts with the 5xx"
  },
  {
   "name": "statusWords",
   "signature": "statusWords(status: number): void",
   "description": "An error status in words, \"\" for a success"
  },
  {
   "name": "redact",
   "signature": "redact(value: T, keys: string[]): T",
   "description": "A copy of headers or a body with every key in `keys` masked, however deep"
  },
  {
   "name": "curlCommand",
   "signature": "curlCommand(r: ProviderRequest, baseUrl: unknown, keys: string[]): void",
   "description": "The request as a cURL command, its secrets redacted"
  }
 ],
