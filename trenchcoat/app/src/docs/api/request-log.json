{
 "elements": [
  {
   "tag": "tc-request-log",
   "className": "TcRequestLog",
   "description": "Every request an app made to a model provider, one line each – time, model, endpoint, status, latency, tokens, cost and cache – with status and model filters and a detail of bodies and headers, secrets masked, and Copy as cURL.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Requests\"",
     "description": "The heading; empty leaves the header out",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "Small text under the heading",
     "readonly": false
    },
    {
     "name": "requests",
     "attribute": null,
     "type": "ProviderRequest[]",
     "default": "[]",
     "description": "The requests, in any order – the list shows the newest first",
     "readonly": false
    },
    {
     "name": "classes",
     "attribute": null,
     "type": "RequestStatusClass[]",
     "default": "[]",
     "description": "The status classes that show; empty shows them all",
     "readonly": false
    },
    {
     "name": "models",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The models that show; empty shows them all",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The open request's id",
     "readonly": false
    },
    {
     "name": "baseUrl",
     "attribute": "base-url",
     "type": "string",
     "default": "\"\"",
     "description": "Put before each request's endpoint for Copy as cURL, when it has no `url`",
     "readonly": false
    },
    {
     "name": "redact",
     "attribute": null,
     "type": "string[]",
     "default": "[\"authorization\", \"proxy-authorization\", \"x-api-key\", \"api-key\", \"apikey\", \"token\", \"access-token\", \"secret\", \"client-secret\", \"password\", \"cookie\", \"set-cookie\"]",
     "description": "Header and body keys to mask, compared without case, - or _",
     "readonly": false
    },
    {
     "name": "currency",
     "attribute": "currency",
     "type": "string",
     "default": "\"USD\"",
     "description": "ISO 4217 currency code for costs",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Locale for times, numbers and amounts",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "360",
     "description": "Height in px at which the list scrolls",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<RequestLogLabels>",
     "default": "{}",
     "description": "Renames the words it uses",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-classes-change",
     "detail": "",
     "description": "A status class chip was toggled ({ classes }: RequestLogClassesChange); empty means all; cancelable – prevented, `classes` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-models-change",
     "detail": "",
     "description": "A model chip was toggled ({ models }: RequestLogModelsChange); empty means all; cancelable – prevented, `models` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A request was opened or its details closed ({ selected, request }: RequestLogSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-request-open",
     "detail": "",
     "description": "A request was chosen, before tc-selected-change ({ id, request }: RequestLogOpen)",
     "cancelable": false
    },
    {
     "name": "tc-copy",
     "detail": "",
     "description": "Copy as cURL was pressed ({ field, text, id }: RequestLogCopy); cancelable – prevent it to write the clipboard yourself",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
