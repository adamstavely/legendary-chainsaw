 "elements": [
  {
   "tag": "tc-ai-search",
   "className": "TcAiSearch",
   "description": "A search box with an AI mode – suggestions in search mode, a multi-line prompt with examples in AI mode, a \"Search\nwithin file contents\" switch, removable scope chips, Clear and a ⌘K hotkey.",
   "properties": [
    {
     "name": "label",
