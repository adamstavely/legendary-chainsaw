    {
     "name": "tc-select",
     "detail": "",
     "description": "A search was picked to run again ({ id, search }: SearchHistorySelect)",
     "cancelable": false
    },
    {
     "name": "tc-saved-change",
     "detail": "",
     "description": "A search was saved or unsaved ({ id, saved, searches }: SearchHistorySavedChange); cancelable – prevented, `searches` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-remove",
     "detail": "",
     "description": "A search was removed ({ id, search, searches }: SearchHistoryRemove); cancelable – prevented, it stays until the page takes it out of `searches`",
     "cancelable": true
    },
    {
     "name": "tc-restore",
     "detail": "",
     "description": "A removed search was put back with Undo ({ id, search, searches }: SearchHistoryRemove); cancelable – prevented, it comes back when the page puts it in `searches`",
     "cancelable": true
    },
    {
     "name": "tc-tab-change",
     "detail": "",
     "description": "The tab changed ({ tab }: SearchHistoryTabChange); cancelable – prevented, `tab` stays as it was",
     "cancelable": true
    }
