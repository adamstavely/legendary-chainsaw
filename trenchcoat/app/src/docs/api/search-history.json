     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "searches",
     "attribute": null,
     "type": "SearchHistoryEntry[]",
     "default": "[]",
     "description": "The searches, any order; shown newest first. Saving and removing change it unless their events are prevented",
     "readonly": false
    },
    {
     "name": "tab",
     "attribute": "tab",
     "type": "SearchHistoryTab",
     "default": "\"recent\"",
