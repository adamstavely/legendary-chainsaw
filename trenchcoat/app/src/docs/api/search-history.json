{
 "elements": [
  {
   "tag": "tc-search-history",
   "className": "TcSearchHistory",
   "description": "Recent and saved searches – tabs with counts, a filter, searches grouped by day with scope chips, result counts and\ntimes, and Run again, a save star and Remove with Undo on each.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
