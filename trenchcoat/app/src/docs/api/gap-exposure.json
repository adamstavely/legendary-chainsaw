{
 "elements": [
  {
   "tag": "tc-gap-exposure",
   "className": "TcGapExposure",
   "description": "Gaps or risks and whether anyone is working on them – severity, the item and its priority, coverage, owner and\nwhat's invested – with the severe uncovered ones called out, groups by priority or severity, and an uncovered-only\nfilter.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Gaps & coverage\"",
     "description": "The heading, and the list's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "gaps",
     "attribute": null,
     "type": "ExposureGap[]",
     "default": "[]",
