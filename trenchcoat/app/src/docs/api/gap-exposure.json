    },
    {
     "name": "groupBy",
     "attribute": "group-by",
     "type": "GapGroupBy",
     "default": "\"priority\"",
     "description": "Groups the list by the item's priority or by severity. Changed by the user unless a tc-group-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "uncoveredOnly",
     "attribute": "uncovered-only",
     "type": "boolean",
     "default": "false",
     "description": "Shows only gaps with no work on them. Changed by the user unless a tc-filter-change listener calls preventDefault()",
     "readonly": false
