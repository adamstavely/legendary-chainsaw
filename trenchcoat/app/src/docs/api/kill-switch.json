{
 "elements": [
  {
   "tag": "tc-kill-switch",
   "className": "TcKillSwitch",
   "description": "System posture and the emergency stop: what's running, a confirmed Stop that names what it halts, and the active\nstops with Resume.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Emergency stop\"",
     "description": "The heading",
