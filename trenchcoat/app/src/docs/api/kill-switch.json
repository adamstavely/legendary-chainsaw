     "readonly": false
    },
    {
     "name": "postureNote",
     "attribute": "posture-note",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The line under the heading; unset says what the posture means",
     "readonly": false
    },
    {
     "name": "running",
     "attribute": null,
     "type": "KillRunning[]",
     "default": "[]",
