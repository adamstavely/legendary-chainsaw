{
 "elements": [
  {
   "tag": "tc-kpi-board",
   "className": "TcKpiBoard",
   "description": "A dashboard's top: a date range, three trend cards, an overview that compares two periods, and a focus card.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "Heading on the left of the bar above the cards – none by default",
     "readonly": false
    },
    {
     "name": "data",
     "attribute": null,
     "type": "Record<string, KpiBoardData>",
     "default": "{}",
     "description": "One data set per range id",
     "readonly": false
    },
    {
     "name": "ranges",
     "attribute": null,
     "type": "KpiOption[]",
     "default": "[]",
     "description": "The date ranges, e.g. Last 7 / 30 / 90 days",
     "readonly": false
    },
    {
     "name": "range",
     "attribute": "range",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The range shown – unset, the first one",
     "readonly": false
    },
    {
     "name": "segments",
     "attribute": null,
     "type": "KpiOption[] | undefined",
     "default": "undefined",
     "description": "A filter inside the overview card, e.g. All plans / Pro / Team – it only switches the overview's lines",
     "readonly": false
    },
    {
     "name": "segment",
     "attribute": "segment",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The segment shown – unset, the first one",
     "readonly": false
    },
    {
     "name": "compareLabel",
     "attribute": "compare-label",
     "type": "string",
     "default": "\"vs. last period\"",
     "description": "Words after every change, e.g. \"vs. last month\"",
     "readonly": false
    },
    {
     "name": "currentLabel",
     "attribute": "current-label",
     "type": "string",
     "default": "\"This period\"",
     "description": "Name of this period's line",
     "readonly": false
    },
    {
     "name": "previousLabel",
     "attribute": "previous-label",
     "type": "string",
     "default": "\"Last period\"",
     "description": "Name of the last period's line",
     "readonly": false
    },
    {
     "name": "formatMoney",
     "attribute": null,
     "type": "(value: number) => string",
     "default": "kpiMoney",
     "description": "Formats money amounts – \"$1,234.50\" by default",
     "readonly": false
    },
    {
     "name": "icon",
     "attribute": null,
     "type": "Element | TemplateResult | undefined",
     "default": "undefined",
     "description": "Icon in the focus card: a DOM node (cloned) or a Lit template – a box by default",
     "readonly": false
    },
    {
     "name": "setup",
     "attribute": null,
     "type": "KpiButton | undefined",
     "default": "undefined",
     "description": "The small button at the top right of the focus card, e.g. Set up",
     "readonly": false
    },
    {
     "name": "action",
     "attribute": null,
     "type": "KpiButton | undefined",
     "default": "undefined",
     "description": "The button at the bottom of the focus card",
     "readonly": false
    },
    {
     "name": "rangeId",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "The range in effect: `range`, else the first",
     "readonly": true
    },
    {
     "name": "segmentId",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "The segment in effect: `segment`, else the first (\"\" when there is no filter)",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-range-change",
     "detail": "",
     "description": "Another date range was picked (`{ range }`: KpiRangeChange); cancelable – prevented, `range` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-segment-change",
     "detail": "",
