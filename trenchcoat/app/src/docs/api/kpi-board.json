  {
   "name": "kpiMoney",
   "signature": "kpiMoney(n: number): void",
   "description": "\"$1,234.50\" under ten thousand, \"$12,345\" above"
  },
  {
   "name": "kpiResample",
   "signature": "kpiResample(values: number[] | undefined, n: number): number[]",
   "description": "A series stretched or squeezed to a fixed number of points, so lines of different lengths can glide into each other"
  },
  {
   "name": "kpiTrace",
   "signature": "kpiTrace(values: number[], lo: number, hi: number, top: unknown, bottom: unknown): void",
   "description": "Straight segments through evenly spaced points in a 0–100 box: the line, and the same shape closed to the floor"
  }
 ],
