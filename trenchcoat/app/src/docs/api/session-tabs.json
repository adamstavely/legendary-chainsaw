{
 "elements": [
  {
   "tag": "tc-session-tabs",
   "className": "TcSessionTabs",
   "description": "Open chats as a row of tabs above a chat thread – status, unread, close, reorder by drag or keys, and a menu of the tabs out of view.",
   "properties": [
    {
     "name": "tabs",
     "attribute": null,
     "type": "SessionTab[]",
     "default": "[]",
     "description": "The open chats",
     "readonly": false
    },
    {
     "name": "active",
     "attribute": "active",
     "type": "string | null",
     "default": "null",
     "description": "The open tab's id. Changed by the user unless a tc-active-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "order",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The tabs' ids in the order shown; empty follows `tabs`. Changed by moving a tab unless a tc-order-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "hideCreate",
     "attribute": "hide-create",
     "type": "boolean",
     "default": "false",
     "description": "Hides the \"+\" button",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<SessionTabsLabels>",
     "default": "{}",
     "description": "Rename any of the words, over the defaults",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-active-change",
     "detail": "",
     "description": "A tab was opened ({ active, tab }: SessionTabsActiveChange); cancelable – prevented, `active` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-order-change",
     "detail": "",
     "description": "A tab was moved ({ order, id }: SessionTabsOrderChange); cancelable – prevented, `order` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-close",
     "detail": "",
     "description": "A tab's close button or Delete was pressed ({ id, tab }: SessionTabsClose); cancelable – the page removes the tab",
     "cancelable": true
    },
    {
     "name": "tc-new",
     "detail": "",
     "description": "The \"+\" button was pressed (detail: {})",
     "cancelable": false
    }
   ],
