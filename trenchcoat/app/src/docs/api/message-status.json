{
 "elements": [
  {
   "tag": "tc-message-status",
   "className": "TcMessageStatus",
   "description": "The row under a sent message: its read receipt, a relative time, and Copy, Send again, Branch and Edit.",
   "properties": [
    {
     "name": "receipt",
     "attribute": "receipt",
     "type": "MessageReceipt",
     "default": "\"sent\"",
     "description": "Where the message is: \"sending\", \"sent\", \"delivered\", \"read\" or \"failed\"",
     "readonly": false
    },
    {
     "name": "time",
     "attribute": null,
     "type": "Date | string | number | undefined",
     "default": "undefined",
     "description": "When it was sent – a Date, an ISO string or epoch ms. Unset, no time shows",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The current time in epoch ms, for tests and stories; unset, the row keeps its own clock",
     "readonly": false
    },
    {
     "name": "text",
     "attribute": "text",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The message text – what Copy puts on the clipboard",
     "readonly": false
    },
    {
     "name": "actions",
     "attribute": null,
     "type": "MessageStatusAction[]",
     "default": "[\"copy\", \"retry\", \"branch\"]",
     "description": "Which controls to show, in this order. Retry shows anyway while the message has failed",
     "readonly": false
    },
    {
     "name": "onRetry",
     "attribute": null,
     "type": "(() => void | Promise<unknown>) | undefined",
     "default": "undefined",
     "description": "Called after tc-retry when it isn't prevented. Return a promise to keep the arrow spinning until it settles",
     "readonly": false
    },
    {
     "name": "align",
     "attribute": "align",
     "type": "\"start\" | \"end\"",
     "default": "\"end\"",
     "description": "\"end\" for the person's own message (the default), \"start\" to line up on the left",
     "readonly": false
    },
    {
     "name": "quiet",
     "attribute": "quiet",
     "type": "boolean",
     "default": "true",
     "description": "Controls stay hidden until the message is hovered or focused (default true; quiet=\"false\" shows them always). Put data-ui-message on the message wrapper",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<MessageStatusLabels>",
     "default": "{}",
     "description": "Every word the row shows or says, merged over the defaults",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The locale for dates older than yesterday",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-copy",
     "detail": "",
     "description": "`text` is on the clipboard (or Copy was pressed without `text`); detail `{ text?: string }`",
     "cancelable": false
    },
    {
     "name": "tc-retry",
     "detail": "",
     "description": "Send again or Retry was pressed; detail `{ receipt }`. Cancelable: preventDefault() skips `onRetry`",
     "cancelable": true
    },
    {
     "name": "tc-branch",
     "detail": "",
     "description": "Branch into a new chat was pressed; detail `{}`. Cancelable",
     "cancelable": true
    },
    {
     "name": "tc-edit",
     "detail": "",
     "description": "Edit was pressed; detail `{}`. Cancelable",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "mst",
   "cssProperties": [
    {
     "name": "--tc-mst-btn",
     "value": "36px",
     "looks": [
      "standard",
      "clean",
      "both"
     ]
    },
    {
