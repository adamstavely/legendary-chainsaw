    "--tc-tooltip-bg",
    "--tc-tooltip-fg",
    "--tc-tooltip-radius"
   ]
  }
 ],
 "functions": [
  {
   "name": "relativeMessageTime",
   "signature": "relativeMessageTime(at: number, now: number, labels: MessageStatusLabels, locale?: string): void",
   "description": "\"Just now\", \"2 min ago\", \"3 hr ago\", \"Yesterday\" or a short date"
  }
 ],
 "react": [
  {
   "component": "MessageStatus",
   "exported": true,
   "props": [
    {
     "name": "onCopyText",
     "type": "(text?: string) => void",
     "optional": true,
     "description": "Called once `text` is on the clipboard (or right away when there's no `text`)"
    },
    {
     "name": "onBranch",
     "type": "() => void",
     "optional": true,
     "description": "Called when Branch into a new chat is pressed"
    },
    {
     "name": "onEdit",
     "type": "() => void",
     "optional": true,
     "description": "Called when Edit is pressed"
    }
   ],
   "hides": [
    "children"
   ],
   "events": {
    "tc-copy": "onCopyText",
    "tc-retry": "onTcRetry",
    "tc-branch": "onBranch",
    "tc-edit": "onEdit"
   }
  }
 ],
 "changelog": [
  "**Message Status** (`tc-message-status`): the quiet row under a sent message – a read receipt (sending, sent, delivered, read, or Not sent with Retry), a relative time that keeps itself fresh, and Copy, Send again, Branch into a new chat and Edit, with cancelable `tc-retry`, `tc-branch` and `tc-edit`."
 ],
