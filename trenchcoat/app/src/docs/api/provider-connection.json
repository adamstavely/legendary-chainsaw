{
 "elements": [
  {
   "tag": "tc-provider-connection",
   "className": "TcProviderConnection",
   "description": "A connection to a model provider: provider, endpoint, deployment and a masked credential reference, with an\napp-run connection test, its health, when it was checked and the models the endpoint reports.",
   "properties": [
    {
     "name": "value",
     "attribute": null,
     "type": "ProviderConnectionValue",
     "default": "{ provider: \"\", endpoint: \"\", deployment: \"\", credentialRef: \"\" }",
     "description": "The connection. Changed by the user unless a tc-value-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "providers",
     "attribute": null,
     "type": "ProviderConnectionOption[]",
     "default": "[]",
     "description": "The providers to choose from; with none, the Provider row is hidden",
     "readonly": false
    },
    {
     "name": "credentials",
     "attribute": null,
     "type": "ProviderConnectionCredential[]",
     "default": "[]",
     "description": "The credential references to choose from; with none, the reference is typed in",
     "readonly": false
    },
    {
     "name": "check",
     "attribute": null,
     "type": "ProviderConnectionCheck | null",
     "default": "null",
     "description": "The app's answer to the last test; setting it ends Testing…",
     "readonly": false
    },
    {
     "name": "stateLabels",
     "attribute": null,
     "type": "Partial<Record<ProviderConnectionState, string>>",
     "default": "{}",
     "description": "The states' short names, merged over PROVIDER_CONNECTION_LABELS",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Model provider\"",
     "description": "Names the group, shown at the top",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "A quieter line under the heading",
     "readonly": false
    },
    {
     "name": "testLabel",
     "attribute": "test-label",
     "type": "string",
     "default": "\"Test connection\"",
     "description": "The test button's text",
     "readonly": false
    },
    {
     "name": "originLabel",
     "attribute": "origin-label",
     "type": "string",
     "default": "\"Your app\"",
     "description": "The first stop on the path, before the endpoint",
     "readonly": false
    },
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"\"",
     "description": "Submitted with the form: the connection as JSON",
     "readonly": false
    },
    {
     "name": "disabled",
     "attribute": "disabled",
     "type": "boolean",
     "default": "false",
     "description": "Turns every control off and leaves the connection out of the form; a disabled fieldset does the same",
     "readonly": false
    },
    {
     "name": "health",
     "attribute": null,
     "type": "ProviderConnectionState",
     "default": null,
     "description": "The health shown now",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "The connection changed ({ value: ProviderConnectionValue }); cancelable – prevent it to control `value`",
     "cancelable": true
    },
    {
     "name": "tc-test",
     "detail": "",
     "description": "Test connection was pressed ({ value, signal }: ProviderConnectionTestEvent); try the connection and set `check`. Cancelable – prevented, nothing shows as testing",
