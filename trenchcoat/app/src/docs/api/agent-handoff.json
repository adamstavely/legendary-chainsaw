     "type": "string | null",
     "optional": true,
     "description": "The open handoff on mount when `selected` isn't controlled"
    },
    {
     "name": "onSelectedChange",
     "type": "(selected: string | null, handoff: AgentHandoffLink | null) => void",
     "optional": true,
     "description": "A handoff was opened or closed"
    },
    {
     "name": "itemSelected",
     "type": "string | null",
     "optional": true,
     "description": "The picked queue item's id – controlled when given"
    },
    {
     "name": "defaultItemSelected",
     "type": "string | null",
     "optional": true,
     "description": "The picked queue item on mount when `itemSelected` isn't controlled"
    },
    {
     "name": "onItemSelectedChange",
     "type": "(itemSelected: string | null, item: AgentHandoffQueueItem | null) => void",
     "optional": true,
     "description": "A queue's item was picked or cleared"
    }
   ],
   "hides": [
    "heading",
    "selected",
    "itemSelected",
    "children"
   ],
   "events": {
    "tc-selected-change": "onSelectedChange",
    "tc-item-selected-change": "onItemSelectedChange"
   }
  }
 ],
 "changelog": [
  "**Conflict Radar** (`tc-conflict-radar`), **Scheduled Runs** (`tc-scheduled-runs`), **Fallback Chain** (`tc-fallback-chain`), **Agent Handoff** (`tc-agent-handoff`), **Agent Findings** (`tc-agent-findings`) and **Agent Monitor** (`tc-agent-monitor`): where parallel agents collide, tasks across a week's sessions, one request finding a model, what's lost between agents, what a group of agents found, and one agent at work."
 ],
