   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading; by default \"Agent handoffs\""
    },
    {
     "name": "selected",
     "type": "string | null",
     "optional": true,
     "description": "The open handoff's id – controlled when given"
    },
    {
