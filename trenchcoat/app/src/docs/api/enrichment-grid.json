{
 "elements": [
  {
   "tag": "tc-enrichment-grid",
   "className": "TcEnrichmentGrid",
   "description": "A table a model fills in, cell by cell, with the run's progress, Pause / Resume and Retry failed.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
