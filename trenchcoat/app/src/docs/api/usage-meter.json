 "functions": [],
 "react": [
  {
   "component": "UsageMeter",
   "exported": true,
   "props": [
    {
     "name": "total",
     "type": "number",
     "optional": false,
     "description": "Credits included in the plan"
    },
    {
     "name": "used",
     "type": "NonNullable<RawUsageMeterProps[\"used\"]>",
     "optional": false,
     "description": "What the credits were spent on in the shown period"
    },
    {
     "name": "period",
     "type": "string",
     "optional": true,
     "description": "The chosen period id. Controlled when defined; otherwise the meter keeps its own, starting at `defaultPeriod`"
    },
    {
     "name": "defaultPeriod",
     "type": "string",
     "optional": true,
     "description": "First period when uncontrolled – defaults to the first of `periods`"
    },
    {
     "name": "onPeriodChange",
     "type": "(id: string) => void",
     "optional": true,
     "description": "Called with the new period id – pass the matching `used`, `limits` and `daily` back in"
    },
    {
     "name": "onUpgrade",
     "type": "(state: UsageState) => void",
     "optional": true,
     "description": "Called by the button, with the current state"
    },
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the region's name – \"Usage\" by default"
    }
   ],
   "hides": [
    "heading",
    "period",
    "total",
    "used"
   ],
   "events": {
    "tc-period-change": null,
    "tc-upgrade": "onUpgrade"
   }
  }
 ],
 "changelog": [
  "usage-meter: the `--tc-usage-meter-track`, `-fill` and `-action-bg-hover` custom properties are gone; it uses the meter and action tokens."
