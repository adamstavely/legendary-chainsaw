{
 "elements": [
  {
   "tag": "tc-usage-meter",
   "className": "TcUsageMeter",
   "description": "A usage card: a credits meter split into categories, a daily sparkline, plan limits and an upgrade button.",
   "properties": [
    {
     "name": "layout",
     "attribute": "layout",
     "type": "\"stacked\" | \"wide\"",
     "default": "\"stacked\"",
     "description": "\"stacked\" (default): one column at most 460px wide · \"wide\": full width, two columns from 640px",
     "readonly": false
    },
    {
     "name": "total",
     "attribute": "total",
     "type": "number",
     "default": "0",
     "description": "Credits included in the plan",
     "readonly": false
    },
    {
     "name": "used",
     "attribute": null,
     "type": "UsageItem[]",
     "default": "[]",
     "description": "What the credits were spent on in the shown period",
     "readonly": false
    },
    {
     "name": "limits",
     "attribute": null,
     "type": "UsageLimit[]",
     "default": "[]",
     "description": "Thin meters below, e.g. seats, storage, projects",
     "readonly": false
    },
    {
     "name": "periods",
     "attribute": null,
     "type": "UsagePeriod[] | undefined",
     "default": "undefined",
     "description": "Options of the period switch – no switch when left out",
     "readonly": false
    },
    {
     "name": "period",
     "attribute": "period",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The chosen period id – unset is the first of `periods`",
     "readonly": false
    },
    {
     "name": "resetAt",
     "attribute": "reset-at",
     "type": "Date | string | number | undefined",
     "default": "undefined",
     "description": "When the credits reset – shown as \"Resets in 9 days\"",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The current time in epoch ms, for \"Resets in …\" – unset reads the clock after the element connects",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string",
     "default": "\"en-US\"",
     "description": "Locale for numbers and dates",
     "readonly": false
    },
    {
     "name": "daily",
     "attribute": null,
     "type": "UsageDay[] | undefined",
     "default": "undefined",
     "description": "Usage per day for the sparkline under the meter",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Usage\"",
     "description": "The heading, and the region's name",
     "readonly": false
    },
    {
     "name": "plan",
     "attribute": "plan",
     "type": "string",
     "default": "\"\"",
     "description": "Plan name next to the reset date, e.g. \"Pro plan\"",
     "readonly": false
    },
    {
     "name": "unit",
     "attribute": "unit",
     "type": "string",
     "default": "\"credits\"",
     "description": "Unit of the credits",
     "readonly": false
    },
    {
     "name": "warnAt",
     "attribute": "warn-at",
     "type": "number",
     "default": "0.8",
     "description": "Share from which the meter warns (0–1)",
     "readonly": false
    },
    {
     "name": "upgradeLabel",
     "attribute": "upgrade-label",
     "type": "string",
     "default": "\"Upgrade\"",
     "description": "Button text while there is room left",
     "readonly": false
    },
    {
     "name": "topUpLabel",
     "attribute": "top-up-label",
     "type": "string",
     "default": "\"Add credits\"",
     "description": "Button text near and at the limit",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-period-change",
     "detail": "",
     "description": "A period is picked in the switch; detail `{ period: string }`. Cancelable: prevent it to control `period`",
     "cancelable": true
    },
    {
     "name": "tc-upgrade",
     "detail": "",
     "description": "The button is pressed; detail `{ state: \"ok\" | \"warn\" | \"limit\" }`",
     "cancelable": false
    }
