{
 "elements": [
  {
   "tag": "tc-channel-setup",
   "className": "TcChannelSetup",
   "description": "Connect one channel and set when the agent replies there – Connect, Where, When it replies, Test and Go live, each checked in words before the next.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Set up a channel\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading",
     "readonly": false
    },
    {
     "name": "channel",
     "attribute": "channel",
     "type": "string",
     "default": "\"this channel\"",
     "description": "The channel's name, used in the words: \"Team chat\"",
     "readonly": false
    },
    {
     "name": "agent",
     "attribute": "agent",
     "type": "string",
     "default": "\"The agent\"",
     "description": "The agent's name, used in the words: \"Policy Q&A\"",
     "readonly": false
    },
    {
     "name": "step",
     "attribute": "step",
     "type": "ChannelSetupStep",
     "default": "\"connect\"",
     "description": "The current step. Changed by Next, Back and the step list unless a tc-step-change listener prevents it",
     "readonly": false
    },
    {
     "name": "value",
     "attribute": null,
     "type": "ChannelSetupValue",
     "default": null,
     "description": "The settings. Changed by the user unless a tc-value-change listener prevents it",
     "readonly": false
    },
    {
     "name": "account",
     "attribute": "account",
     "type": "string",
     "default": "\"\"",
     "description": "The connected account's name; empty while not connected",
     "readonly": false
    },
    {
     "name": "connecting",
     "attribute": "connecting",
     "type": "boolean",
     "default": "false",
     "description": "The page is authorizing: Connect waits",
     "readonly": false
    },
    {
     "name": "targets",
     "attribute": null,
     "type": "ChannelTarget[]",
     "default": "[]",
     "description": "The places to pick in Where",
     "readonly": false
    },
    {
     "name": "timeZones",
     "attribute": null,
     "type": "string[]",
     "default": "[\"UTC\", \"Europe/London\", \"Europe/Lisbon\", \"Europe/Berlin\", \"America/New_York\", \"America/Chicago\", \"America/Los_Angeles\", \"Asia/Singapore\", \"Australia/Sydney\"]",
     "description": "The time zones offered for business hours",
     "readonly": false
    },
    {
     "name": "testMessage",
     "attribute": "test-message",
     "type": "string",
     "default": "\"Hello! Can you tell me what you help with?\"",
     "description": "The message Send test sends; editable in the Test step",
     "readonly": false
    },
    {
     "name": "testing",
     "attribute": "testing",
     "type": "boolean",
     "default": "false",
     "description": "A test is on its way: Send test waits",
     "readonly": false
    },
    {
     "name": "testResult",
     "attribute": null,
     "type": "ChannelTestResult | null",
     "default": "null",
     "description": "The page's result for the last test; null before one",
     "readonly": false
    },
    {
     "name": "live",
     "attribute": "live",
     "type": "boolean",
     "default": "false",
     "description": "The channel is live: the setup shows its done state",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "ChannelSetupLabelsInput",
     "default": "{}",
     "description": "Words the component uses, merged over defaultChannelSetupLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-connect",
     "detail": "",
     "description": "Connect was pressed; the page authorizes, then sets `account` ({ step }: { step: \"connect\" })",
     "cancelable": false
    },
    {
     "name": "tc-step-change",
     "detail": "",
     "description": "The step is changing ({ step, previous }: ChannelStepChange); cancelable – prevented, the step stays",
     "cancelable": true
    },
    {
     "name": "tc-value-change",
     "detail": "",
     "description": "The settings changed ({ value }: ChannelValueChange); cancelable – prevented, `value` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-test",
     "detail": "",
     "description": "Send test was pressed ({ message, value }: ChannelTest); cancelable – not prevented, `testing` turns on until the page sets `testResult`",
     "cancelable": true
    },
    {
     "name": "tc-go-live",
     "detail": "",
     "description": "Go live was pressed ({ value, account }: ChannelGoLive); cancelable – not prevented, the setup shows it's live",
     "cancelable": true
    }
   ],
   "slots": [],
