     "attribute": null,
     "type": "((agent: TreeAgent, action: AgentTreeResolution) => void | Promise<unknown>) | undefined",
     "default": "undefined",
     "description": "Passed to the open tree: called with each answer from its \"needs you\" or \"failed\" window; may return a promise",
