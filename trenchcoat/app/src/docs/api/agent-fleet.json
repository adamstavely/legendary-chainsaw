 "elements": [
  {
   "tag": "tc-agent-fleet",
   "className": "TcAgentFleet",
   "description": "Several top-level agents side by side – each card sums up its sub-agents; a click opens its tree beside it.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Fleet\"",
     "description": "The heading",
     "readonly": false
