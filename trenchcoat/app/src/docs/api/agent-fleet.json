    {
     "name": "agents",
     "attribute": null,
     "type": "FleetAgent[]",
     "default": "[]",
     "description": "The top-level agents, each with its sub-agents nested in `children`",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": null,
     "type": "string | null",
     "default": "null",
     "description": "The id of the agent whose tree is open, or null. Changed by the cards unless tc-open-change is prevented",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
