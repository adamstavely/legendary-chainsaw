{
 "elements": [
  {
   "tag": "tc-score-summary",
   "className": "TcScoreSummary",
   "description": "NPS or CSAT results: the score, the bands, the answers per score, the change and the target.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The heading; defaults to \"Net Promoter Score\" or \"Customer satisfaction\"",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "The line under the heading – the survey and the period",
     "readonly": false
    },
    {
     "name": "kind",
     "attribute": "kind",
     "type": "ScoreSurveyKind",
     "default": "\"nps\"",
     "description": "\"nps\" for 0–10 answers, \"csat\" for 1–5",
     "readonly": false
    },
    {
     "name": "responses",
     "attribute": null,
     "type": "number[]",
     "default": "[]",
     "description": "Answers per score, lowest score first: 11 for NPS (0–10), 5 for CSAT (1–5)",
     "readonly": false
    },
    {
     "name": "scores",
     "attribute": null,
     "type": "number[]",
     "default": "[]",
     "description": "Or the answers themselves, one score each – used when `responses` is empty",
     "readonly": false
    },
    {
     "name": "previous",
     "attribute": "previous",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The score last time, for the change; defaults to the last `trend` point",
     "readonly": false
    },
    {
     "name": "trend",
     "attribute": null,
     "type": "ScoreTrendPoint[]",
     "default": "[]",
     "description": "Earlier scores, oldest first – drawn as a sparkline ending at the current score",
     "readonly": false
    },
    {
     "name": "comparedTo",
     "attribute": "compared-to",
     "type": "string",
     "default": "\"\"",
     "description": "What the change is compared with – \"last quarter\"; defaults to the last `trend` label, else \"last time\"",
     "readonly": false
    },
    {
     "name": "target",
     "attribute": "target",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The score to reach, shown as a marker",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "number | null",
     "default": "null",
     "description": "The picked score. Changed by the user unless a tc-score-select listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<ScoreSummaryLabels>",
     "default": "{}",
     "description": "Words the page can rename, merged over `defaultScoreSummaryLabels`",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The locale for numbers",
     "readonly": false
    },
    {
     "name": "summary",
     "attribute": null,
     "type": "ScoreSummaryResult",
     "default": null,
     "description": "The numbers shown: the total, NPS or CSAT, the bands and the counts",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
