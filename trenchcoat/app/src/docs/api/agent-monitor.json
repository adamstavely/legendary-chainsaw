{
 "elements": [
  {
   "tag": "tc-agent-monitor",
   "className": "TcAgentMonitor",
   "description": "One agent at work: its current step, a clock, the cost so far, a strip of its steps and the finished ones.",
   "properties": [
    {
     "name": "name",
     "attribute": "name",
     "type": "string",
     "default": "\"Agent\"",
     "description": "The agent's name",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "A line under the name",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "AgentMonitorStatus",
     "default": "\"running\"",
     "description": "Where the run stands: \"running\", \"paused\", \"done\" or \"failed\"",
     "readonly": false
    },
    {
     "name": "currentStep",
     "attribute": "current-step",
     "type": "string | undefined",
     "default": "undefined",
     "description": "What it's doing now; by default the label of the step still running",
     "readonly": false
    },
    {
     "name": "startedAt",
     "attribute": "started-at",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When the run started, epoch ms",
     "readonly": false
    },
    {
     "name": "endedAt",
     "attribute": "ended-at",
     "type": "number | undefined",
     "default": "undefined",
     "description": "When it finished or paused, epoch ms; by default when its last step ended",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "\"Now\", epoch ms; unset, the element keeps its own clock",
     "readonly": false
    },
    {
     "name": "cost",
     "attribute": "cost",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The cost so far",
     "readonly": false
    },
    {
     "name": "currency",
     "attribute": "currency",
     "type": "string",
     "default": "\"USD\"",
     "description": "The cost's currency, an ISO 4217 code",
     "readonly": false
    },
    {
     "name": "steps",
     "attribute": null,
     "type": "AgentMonitorStep[]",
     "default": "[]",
     "description": "The steps, in order",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The picked step's id, or null. Changed by the user unless a tc-selected-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "actions",
     "attribute": "actions",
     "type": "boolean",
     "default": "true",
     "description": "Offer Pause, Resume and Stop; set actions=\"false\" to only watch",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The locale for the cost",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<AgentMonitorLabels>",
     "default": "{}",
     "description": "Rename any of the words",
     "readonly": false
    },
    {
     "name": "ticking",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "Whether the clock is ticking, for the page and for tests",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A step was picked or closed ({ selected, step }: AgentMonitorSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-action",
     "detail": "",
     "description": "Pause, Resume or Stop was pressed ({ action }: AgentMonitorActionDetail); cancelable – prevented, Pause and Resume leave `status` as it was",
     "cancelable": true
    }
   ],
