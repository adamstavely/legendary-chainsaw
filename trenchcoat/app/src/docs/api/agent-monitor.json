 "react": [
  {
   "component": "AgentMonitor",
   "exported": true,
   "props": [
    {
     "name": "selected",
     "type": "string | null",
     "optional": true,
     "description": "The picked step's id – controlled when given"
    },
    {
     "name": "defaultSelected",
     "type": "string | null",
     "optional": true,
     "description": "The picked step on mount when `selected` isn't controlled"
    },
    {
     "name": "onSelectedChange",
     "type": "(selected: string | null, step: AgentMonitorStep | null) => void",
     "optional": true,
     "description": "A step was picked or closed"
    }
   ],
   "hides": [
    "selected",
    "children"
   ],
   "events": {
    "tc-selected-change": "onSelectedChange",
    "tc-action": "onTcAction"
   }
  }
 ],
 "changelog": [
  "**Conflict Radar** (`tc-conflict-radar`), **Scheduled Runs** (`tc-scheduled-runs`), **Fallback Chain** (`tc-fallback-chain`), **Agent Handoff** (`tc-agent-handoff`), **Agent Findings** (`tc-agent-findings`) and **Agent Monitor** (`tc-agent-monitor`): where parallel agents collide, tasks across a week's sessions, one request finding a model, what's lost between agents, what a group of agents found, and one agent at work."
 ],
