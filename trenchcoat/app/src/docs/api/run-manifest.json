    },
    {
     "name": "modelIcon",
     "type": "Element",
     "optional": true,
     "description": "An icon for the model badge – an Element, cloned in"
    },
    {
     "name": "onCopy",
     "type": "(field: RunManifestCopyField, text: string) => void | false",
     "optional": true,
     "description": "A copy button was pressed: which field and the text copied. Return false to copy it yourself instead (this replaces React's clipboard onCopy on this component)"
    },
    {
     "name": "onExport",
     "type": "(manifest: RunManifestRecord) => void",
     "optional": true,
     "description": "Export was pressed, with the whole record"
    }
   ],
   "hides": [
    "heading",
    "modelIcon",
    "onCopy"
   ],
   "events": {
    "tc-copy": "onCopy",
    "tc-export": "onExport"
   }
  }
 ],
 "changelog": [
  "**Trust & calibration**, from THEMIS and built domain-neutral: - claims and their reliability: `tc-claim-answer`, `tc-verification-queue`, `tc-reflection-gate`, `tc-reliance-gauge`, `tc-disagreement-banner`, `tc-synthesis-notes`; - where outputs came from: `tc-lineage-graph`, `tc-validity-badge`, `tc-provenance-summary`, `tc-correction-propagation`, `tc-attestation-check`, `tc-run-manifest`; - policy and control: `tc-policy-simulator`, `tc-gate-config`, `tc-coverage-matrix`, `tc-kill-switch`, `tc-playbook-canvas`."
 ],
