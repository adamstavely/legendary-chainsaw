{
 "elements": [
  {
   "tag": "tc-run-manifest",
   "className": "TcRunManifest",
   "description": "A run's reproducibility record: model, settings, instruction hash, sources, intent and the verification summary,\nwith copy and export.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Run manifest\"",
     "description": "The heading, and the region's name",
     "readonly": false
    },
    {
     "name": "runId",
     "attribute": "run-id",
     "type": "string",
     "default": "\"\"",
     "description": "The run's id – shown under the heading, with a copy button",
     "readonly": false
    },
    {
     "name": "timestamp",
     "attribute": "timestamp",
     "type": "string",
     "default": "\"\"",
     "description": "When the run happened, shown as given – e.g. \"Oct 24, 14:02 UTC\"",
     "readonly": false
    },
    {
     "name": "model",
     "attribute": "model",
     "type": "string",
     "default": "\"\"",
     "description": "The model's display name, shown as a badge in the head",
     "readonly": false
    },
    {
     "name": "modelId",
     "attribute": "model-id",
     "type": "string",
     "default": "\"\"",
     "description": "The model's exact id or version – what reproducing the run needs; shown in full with a copy button",
     "readonly": false
    },
    {
     "name": "modelIcon",
     "attribute": null,
     "type": "Element | undefined",
     "default": "undefined",
     "description": "An icon for the model badge, cloned in (an svg or img)",
     "readonly": false
    },
    {
     "name": "settings",
     "attribute": null,
     "type": "RunManifestSetting[]",
     "default": "[]",
     "description": "Sampling and other settings, in order: temperature, top-p, maximum tokens, seed…",
     "readonly": false
    },
    {
     "name": "instructionLabel",
     "attribute": "instruction-label",
     "type": "string",
     "default": "\"\"",
     "description": "The instruction's name or version, e.g. \"Analyst v4\"",
     "readonly": false
    },
    {
     "name": "instructionHash",
     "attribute": "instruction-hash",
     "type": "string",
     "default": "\"\"",
     "description": "The instruction's hash – shown shortened, copied in full",
     "readonly": false
    },
    {
     "name": "sources",
     "attribute": null,
     "type": "RunManifestSource[]",
     "default": "[]",
     "description": "The sources and corpus the run drew on",
     "readonly": false
    },
    {
     "name": "sourceLimit",
     "attribute": "source-limit",
     "type": "number",
     "default": "3",
     "description": "How many sources show before \"Show all\"",
     "readonly": false
    },
    {
     "name": "intent",
     "attribute": "intent",
     "type": "string",
     "default": "\"\"",
     "description": "The intent the session was started with, in the person's words",
     "readonly": false
    },
    {
     "name": "verification",
     "attribute": null,
     "type": "RunVerification",
     "default": "{}",
     "description": "Claims per verification state: verified, unverifiable, incorrect, dismissed, pending",
     "readonly": false
    },
    {
     "name": "stateLabels",
     "attribute": null,
     "type": "Partial<Record<RunVerificationState, string>>",
     "default": "{}",
     "description": "Names of the verification states",
     "readonly": false
    },
    {
     "name": "noun",
     "attribute": "noun",
     "type": "string",
     "default": "\"claims\"",
     "description": "What the verified things are called, plural – \"claims\"",
     "readonly": false
    },
    {
     "name": "manifest",
     "attribute": null,
     "type": "RunManifestRecord",
     "default": null,
     "description": "The whole record as data – what Copy writes as JSON and Export hands to the app",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-copy",
     "detail": "",
     "description": "A copy button was pressed (detail: { field: \"run\" | \"model\" | \"instruction\" | \"manifest\", text: string }); cancelable – prevent it to write the clipboard yourself",
     "cancelable": true
    },
    {
     "name": "tc-export",
     "detail": "",
     "description": "Export was pressed (detail: { manifest: RunManifestRecord })",
     "cancelable": false
