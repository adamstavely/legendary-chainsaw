     "readonly": false
    },
    {
     "name": "scope",
     "attribute": "scope",
     "type": "PermissionScope",
     "default": "\"once\"",
     "description": "How long an Allow holds",
     "readonly": false
    },
    {
     "name": "duration",
     "attribute": "duration",
     "type": "number",
     "default": "60",
     "description": "Minutes a timed right holds",
     "readonly": false
    },
    {
     "name": "decision",
     "attribute": null,
     "type": "PermissionDecision | null",
     "default": "null",
     "description": "The decision – null while it waits",
     "readonly": false
