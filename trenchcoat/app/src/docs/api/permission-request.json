{
 "elements": [
  {
   "tag": "tc-permission-request",
   "className": "TcPermissionRequest",
   "description": "An agent asks for one specific right: what will happen, for how long, Allow or Deny – then one line with a countdown.",
   "properties": [
    {
     "name": "agent",
     "attribute": null,
     "type": "PermissionAgent",
     "default": "{ name: \"\" }",
     "description": "Who asks",
     "readonly": false
    },
    {
     "name": "action",
     "attribute": "action",
     "type": "string",
     "default": "\"\"",
     "description": "What it wants to do, lower case after \"wants to\", e.g. \"push to main\"",
     "readonly": false
    },
    {
     "name": "target",
     "attribute": "target",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Where, e.g. \"acme/web\" – shown with the tool's mark",
     "readonly": false
    },
    {
     "name": "toolIcon",
     "attribute": null,
     "type": "Element | undefined",
     "default": "undefined",
     "description": "The tool's mark next to the target (cloned)",
     "readonly": false
    },
    {
     "name": "risk",
     "attribute": "risk",
     "type": "PermissionRisk",
     "default": "\"risky\"",
     "description": "How much harm the action can do: safe shows no pill, risky a warning, destructive a danger pill and no \"always\"",
     "readonly": false
    },
    {
     "name": "reason",
     "attribute": "reason",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The agent's own words on why it needs this",
     "readonly": false
    },
    {
     "name": "preview",
     "attribute": null,
     "type": "PermissionPreviewItem[]",
     "default": "[]",
     "description": "What will happen if you allow it – files, recipients, amounts",
     "readonly": false
    },
    {
     "name": "previewTitle",
     "attribute": "preview-title",
     "type": "string",
     "default": "\"What will happen\"",
     "description": "The heading over the preview list, e.g. \"5 files will change\"",
     "readonly": false
    },
    {
     "name": "previewLimit",
     "attribute": "preview-limit",
     "type": "number",
     "default": "3",
     "description": "Rows shown before \"N more\"",
     "readonly": false
    },
    {
     "name": "scopes",
     "attribute": null,
     "type": "PermissionScope[]",
     "default": "[\"once\", \"timed\", \"always\"]",
     "description": "The choices offered; \"always\" is never offered for destructive actions, \"emergency\" only when listed here",
     "readonly": false
    },
    {
     "name": "scope",
     "attribute": "scope",
     "type": "PermissionScope",
     "default": "\"once\"",
     "description": "How long an Allow holds",
     "readonly": false
    },
    {
     "name": "duration",
     "attribute": "duration",
     "type": "number",
     "default": "60",
     "description": "Minutes a timed right holds",
     "readonly": false
    },
    {
     "name": "decision",
     "attribute": null,
     "type": "PermissionDecision | null",
     "default": "null",
     "description": "The decision – null while it waits",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The clock for the countdown, epoch ms – unset uses an internal clock",
     "readonly": false
    },
    {
     "name": "urgencies",
     "attribute": null,
     "type": "PermissionUrgency[]",
     "default": "[ { id: \"standard\", label: \"Standard\", window: \"30 min\" }, { id: \"urgent\", label: \"Urgent\", window: \"15 min\" }, { id: \"critical\", label: \"Critical\", window: \"5 min\" }, ]",
     "description": "Emergency access: the urgency windows to pick from, as data",
     "readonly": false
    },
    {
     "name": "emergencyNote",
     "attribute": "emergency-note",
     "type": "string",
     "default": "\"Emergency access is logged, time-limited and reviewed afterwards.\"",
     "description": "Emergency access: what it means, said above the justification",
     "readonly": false
    },
    {
     "name": "emergencyRemaining",
     "attribute": "emergency-remaining",
     "type": "string",
     "default": "\"\"",
     "description": "Emergency access: the time left as the app reports it, e.g. \"3 h 12 min\" – shown in the banner, never computed here",
     "readonly": false
    },
    {
     "name": "emergencyEnded",
     "attribute": "emergency-ended",
     "type": "boolean",
     "default": "false",
     "description": "Emergency access: the app says it has ended – the banner turns into the review-due note",
     "readonly": false
    },
    {
     "name": "reviewDue",
     "attribute": "review-due",
     "type": "string",
     "default": "\"\"",
     "description": "Emergency access: when the review afterwards is due, as text, e.g. \"by Fri 31 Oct\"",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-decision-change",
     "detail": "",
     "description": "Allow, Deny or Revoke ({ decision: PermissionDecision | null }); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-scope-change",
     "detail": "",
     "description": "The user picked how long ({ scope: PermissionScope }); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-expire",
     "detail": "",
     "description": "A timed right ran out, once per decision ({ decision: PermissionDecision })",
     "cancelable": false
    },
    {
     "name": "tc-emergency-request",
     "detail": "",
     "description": "Emergency access was asked for, with a justification ({ justification, urgency, decision }: PermissionEmergencyRequest); cancelable – prevented, nothing is granted",
     "cancelable": true
    }
   ],
