     "type": "string",
     "default": "\"What will happen\"",
     "description": "The heading over the preview list, e.g. \"5 files will change\"",
     "readonly": false
    },
    {
     "name": "previewLimit",
     "attribute": "preview-limit",
     "type": "number",
     "default": "3",
     "description": "Rows shown before \"N more\"",
     "readonly": false
    },
    {
     "name": "scopes",
     "attribute": null,
     "type": "PermissionScope[]",
     "default": "[\"once\", \"timed\", \"always\"]",
