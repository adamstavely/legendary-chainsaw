{
 "elements": [
  {
   "tag": "tc-score-survey",
   "className": "TcScoreSurvey",
   "description": "The NPS or CSAT question a person answers, with an optional follow-up and a thank-you.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Your feedback\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "kind",
     "attribute": "kind",
     "type": "ScoreSurveyKind",
     "default": "\"nps\"",
     "description": "\"nps\" for 0–10 likelihood to recommend, \"csat\" for 1–5 satisfaction",
     "readonly": false
    },
    {
     "name": "question",
     "attribute": "question",
     "type": "string",
     "default": "\"\"",
     "description": "The question; defaults to the standard wording for the kind",
     "readonly": false
    },
    {
     "name": "score",
     "attribute": "score",
     "type": "number | null",
     "default": "null",
     "description": "The answer. Changed by the user unless a tc-score-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "followUp",
     "attribute": "follow-up",
     "type": "string",
     "default": "\"\"",
     "description": "The follow-up question asked after a pick; \"\" asks none",
     "readonly": false
    },
    {
     "name": "followUps",
     "attribute": null,
     "type": "ScoreSurveyFollowUps",
     "default": "{}",
     "description": "Follow-up questions by NPS band or CSAT score, ahead of `followUp`",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<ScoreSurveyLabels>",
     "default": "{}",
     "description": "Words the page can rename, merged over `defaultScoreSurveyLabels`",
     "readonly": false
    },
    {
     "name": "hideBands",
     "attribute": "hide-bands",
     "type": "boolean",
     "default": "false",
     "description": "Hides the NPS band names under the scale",
     "readonly": false
    },
    {
     "name": "dismissible",
     "attribute": "dismissible",
     "type": "boolean",
     "default": "false",
     "description": "Shows a dismiss button in the header, which fires tc-dismiss",
     "readonly": false
    },
    {
     "name": "submitted",
     "attribute": "submitted",
     "type": "boolean",
     "default": "false",
     "description": "The answer was submitted: the thank-you shows. Set by Submit and Skip; the app may set it too",
     "readonly": false
    },
    {
     "name": "submitting",
     "attribute": "submitting",
     "type": "boolean",
     "default": "false",
     "description": "Shows Submit as busy while the app saves the answer",
     "readonly": false
    },
    {
     "name": "values",
     "attribute": null,
     "type": "number[]",
     "default": null,
     "description": "The scores on the scale, lowest first",
     "readonly": true
    },
    {
     "name": "followUpQuestion",
     "attribute": null,
     "type": "string",
     "default": null,
     "description": "The follow-up question for the current score, or \"\"",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-score-change",
     "detail": "",
     "description": "A score was picked ({ score }: ScoreSurveyScoreChange); cancelable – prevented, `score` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-submit",
     "detail": "",
     "description": "Submit or Skip was pressed (ScoreSurveySubmit); cancelable – prevent it to stay on the question",
     "cancelable": true
    },
    {
     "name": "tc-edit",
     "detail": "",
     "description": "\"Change answer\" reopened a submitted answer; detail: null",
     "cancelable": false
    },
    {
     "name": "tc-dismiss",
     "detail": "",
     "description": "The dismiss button was pressed; remove the survey; detail: null",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
