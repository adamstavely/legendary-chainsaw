 "functions": [
  {
   "name": "npsBand",
   "signature": "npsBand(score: number): NpsBand",
   "description": "The NPS band a score from 0 to 10 falls in"
  }
 ],
 "react": [
  {
   "component": "ScoreSurvey",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading – defaults to \"Your feedback\""
    },
    {
     "name": "score",
     "type": "number | null",
     "optional": true,
     "description": "The answer. Controlled when defined (null for none); otherwise the component keeps it, starting from `defaultScore`"
    },
    {
     "name": "defaultScore",
     "type": "number | null",
     "optional": true,
     "description": "The answer at first when `score` isn't controlled"
    },
    {
     "name": "onScoreChange",
     "type": "(score: number | null) => void",
     "optional": true,
     "description": "Called with the new score after every pick, controlled or not"
    },
    {
     "name": "onSubmit",
     "type": "(answer: ScoreSurveySubmit) => void | boolean",
     "optional": true,
     "description": "Called when Submit or Skip is pressed – the score, the comment and the kind. Return false to stay on the question"
    },
    {
     "name": "onEdit",
     "type": "() => void",
     "optional": true,
     "description": "Called when \"Change answer\" reopens a submitted answer – set `submitted` back to false if you control it"
    },
    {
     "name": "onDismiss",
     "type": "() => void",
     "optional": true,
     "description": "Called when the dismiss button is pressed – remove the survey"
    }
   ],
   "hides": [
    "heading",
    "score",
    "onSubmit",
    "children"
   ],
   "events": {
    "tc-score-change": null,
    "tc-submit": "onSubmit",
    "tc-edit": "onEdit",
    "tc-dismiss": "onDismiss"
   }
  }
 ],
 "changelog": [
  "`tc-score-survey` – the NPS (0–10) or CSAT (1–5) question with a follow-up per band, Submit and a thank-you."
 ],
