     "name": "onGatesChange",
     "type": "(gates: ApprovalGate[], change: { gate: ApprovalGate; decision: GatesChange[\"decision\"]; note: string }) => void",
     "optional": true,
     "description": "Called with every request after a decision went through, and the decision itself"
    },
    {
     "name": "expanded",
     "type": "string | null",
     "optional": true,
     "description": "The decided row folded open, by gate id. Controlled when defined"
    },
    {
     "name": "defaultExpanded",
     "type": "string | null",
     "optional": true,
     "description": "The row folded open at first, when `expanded` isn't controlled"
    },
    {
     "name": "onExpandedChange",
     "type": "(expanded: string | null) => void",
     "optional": true,
     "description": "Called when a decided row is folded open (its id) or shut (null)"
    }
   ],
