{
 "elements": [
  {
   "tag": "tc-approval-gates",
   "className": "TcApprovalGates",
   "description": "The approval requests of an agent run as a stack of cards – decide the top one, and it drops into the decided list.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Approvals\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "run",
     "attribute": "run",
     "type": "string",
     "default": "\"\"",
     "description": "The run the requests come from, shown under the heading",
     "readonly": false
    },
    {
     "name": "gates",
     "attribute": null,
     "type": "ApprovalGate[]",
     "default": "[]",
     "description": "The requests, in the order they should be decided",
     "readonly": false
    },
    {
     "name": "onDecide",
     "attribute": null,
     "type": "((decision: GateDecide) => void | Promise<unknown>) | undefined",
     "default": "undefined",
     "description": "Called with each decision before it's applied. Return a promise to show a spinner until it settles; a rejection keeps the request open and says so",
     "readonly": false
    },
    {
     "name": "expanded",
     "attribute": "expanded",
     "type": "string | null",
     "default": "null",
     "description": "The decided row folded open, by gate id",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The clock for \"6m ago\", in epoch ms – unset shows the time of day instead",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Locale for the time of day",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<ApprovalGatesLabels>",
     "default": "{}",
     "description": "Words the page can rename, merged over defaultApprovalGatesLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-decide",
     "detail": "",
     "description": "Approve, Reject or Send (Ask for changes) was pressed ({ gate, decision, note }: GateDecide); cancelable – prevented, nothing is decided and onDecide isn't called",
     "cancelable": true
    },
    {
     "name": "tc-gates-change",
     "detail": "",
     "description": "A decision went through ({ gates, gate, decision, note }: GatesChange); cancelable – prevented, `gates` stays as it was (controlled use)",
     "cancelable": true
    },
    {
     "name": "tc-expanded-change",
     "detail": "",
     "description": "A decided row was folded open or shut ({ expanded }: GatesExpandedChange); cancelable – prevented, `expanded` stays as it was",
     "cancelable": true
    }
   ],
