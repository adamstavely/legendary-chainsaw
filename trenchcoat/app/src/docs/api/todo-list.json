 "react": [
  {
   "component": "TodoList",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the list's name"
    },
    {
     "name": "items",
     "type": "TodoItem[]",
     "optional": true,
     "description": "The to-dos – controlled when given: every change reports the next list through onItemsChange"
    },
    {
     "name": "defaultItems",
     "type": "TodoItem[]",
     "optional": true,
     "description": "The to-dos on mount when `items` isn't controlled"
    },
    {
     "name": "onItemsChange",
     "type": "(next: TodoItem[], change: TodoItemsChange[\"change\"]) => void",
     "optional": true,
     "description": "The list changed; `next` is the list as it will be, `change` what happened"
    },
    {
     "name": "filter",
     "type": "TodoFilter",
     "optional": true,
     "description": "The tab shown – controlled when given"
    },
    {
     "name": "defaultFilter",
     "type": "TodoFilter",
     "optional": true,
     "description": "The tab on mount when `filter` isn't controlled"
    },
    {
     "name": "onFilterChange",
     "type": "(filter: TodoFilter) => void",
     "optional": true,
     "description": "The tab changed"
    }
   ],
   "hides": [
    "heading",
    "items",
    "filter",
    "children"
   ],
   "events": {
    "tc-items-change": "onItemsChange",
    "tc-filter-change": null
   }
  }
 ],
 "changelog": [
  "**To-do List** (`tc-todo-list`) – add a to-do (Enter), tick it off, click its words to edit them, move it with Alt + ↑ / ↓, remove it with Undo; All / To do / Done tabs with counts, a done bar and Clear done. One cancelable `tc-items-change` carries the whole next list and what changed, so a page can keep it in its own store."
 ],
