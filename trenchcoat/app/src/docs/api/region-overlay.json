{
 "elements": [
  {
   "tag": "tc-region-overlay",
   "className": "TcRegionOverlay",
   "description": "What a vision model read, drawn on the image: numbered boxes linked to a list with each region's kind, confidence and\nread text, filtered by kind and a confidence threshold.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"What the model read\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "A quiet line under the heading – the file or the model",
     "readonly": false
    },
    {
     "name": "src",
     "attribute": "src",
     "type": "string",
     "default": "\"\"",
     "description": "The image the model read – a data: URL works too",
     "readonly": false
    },
    {
     "name": "alt",
     "attribute": "alt",
     "type": "string",
     "default": "\"\"",
     "description": "What the image is, for people who can't see it",
     "readonly": false
    },
    {
     "name": "regions",
     "attribute": null,
     "type": "OverlayRegion[]",
     "default": "[]",
     "description": "The regions the model found",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The selected region's id, or null",
     "readonly": false
    },
    {
     "name": "threshold",
     "attribute": "threshold",
     "type": "number",
     "default": "0",
     "description": "Regions under this confidence (0–1) are hidden",
     "readonly": false
    },
    {
     "name": "kinds",
     "attribute": null,
     "type": "string[] | null",
     "default": "null",
     "description": "The kinds shown; null shows every kind",
     "readonly": false
    },
    {
     "name": "showBoxes",
     "attribute": "show-boxes",
