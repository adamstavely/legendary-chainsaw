{
 "elements": [
  {
   "tag": "tc-knowledge-source-manager",
   "className": "TcKnowledgeSourceManager",
   "description": "The sources a knowledge base answers from – ingestion state and progress, documents and chunks, last sync and\nschedule, stale and duplicate warnings – with add, resync, pause, remove and a handoff to chunk review.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Knowledge sources\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "sources",
     "attribute": null,
     "type": "KnowledgeSource[]",
     "default": "[]",
     "description": "The sources. Changed by the user (remove, schedule) unless a tc-sources-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "schedules",
     "attribute": null,
     "type": "KnowledgeSchedule[]",
     "default": "[ { id: \"manual\", label: \"Manually\" }, { id: \"hourly\", label: \"Every hour\" }, { id: \"daily\", label: \"Daily\" }, { id: \"weekly\", label: \"Weekly\" }, ]",
     "description": "The sync schedules a source can be set to",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The id of the open source, or null",
     "readonly": false
    },
    {
     "name": "show",
     "attribute": "show",
     "type": "KnowledgeShow",
     "default": "\"all\"",
     "description": "Which sources show: \"all\", or \"attention\" – the failed, stale and duplicate ones",
     "readonly": false
    },
    {
     "name": "now",
     "attribute": "now",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The moment last syncs are counted to, in epoch ms; unset shows their dates",
     "readonly": false
    },
    {
     "name": "addLabel",
     "attribute": "add-label",
     "type": "string",
     "default": "\"Add source\"",
     "description": "The Add source button's text",
     "readonly": false
    },
    {
     "name": "noAdd",
     "attribute": "no-add",
     "type": "boolean",
     "default": "false",
     "description": "Hides Add source, for a read-only view",
     "readonly": false
    },
    {
     "name": "noReview",
     "attribute": "no-review",
     "type": "boolean",
     "default": "false",
     "description": "Hides Review chunks, when the app has no chunk review",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "420",
     "description": "The list's height before it scrolls, in px",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-sources-change",
     "detail": "",
     "description": "A source was removed or its schedule changed ({ sources, change: { type, source } }: KnowledgeSourcesChange); cancelable – prevent it to control `sources`",
     "cancelable": true
    },
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A source was picked or the open one closed ({ selected, source }: KnowledgeSelectedChange); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-show-change",
     "detail": "",
     "description": "All or Needs attention was picked ({ show }: KnowledgeShowChange); cancelable",
     "cancelable": true
    },
    {
     "name": "tc-add",
     "detail": "",
     "description": "Add source was pressed – open your own picker; detail: null",
     "cancelable": false
    },
    {
     "name": "tc-resync",
     "detail": "",
     "description": "Resync (or Retry, for a failed source) was pressed ({ source }: KnowledgeSourceEvent)",
     "cancelable": false
    },
    {
     "name": "tc-pause",
     "detail": "",
     "description": "Pause or Resume was pressed ({ source, paused }: KnowledgePauseEvent – `paused` is what was asked for)",
     "cancelable": false
    },
    {
     "name": "tc-review-chunks",
     "detail": "",
     "description": "Review chunks was pressed – open your chunk review for the source ({ source }: KnowledgeSourceEvent)",
     "cancelable": false
    }
   ],
   "slots": [],
