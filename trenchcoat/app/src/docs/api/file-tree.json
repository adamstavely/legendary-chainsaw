{
 "elements": [
  {
   "tag": "tc-file-tree",
   "className": "TcFileTree",
   "description": "A project's files: folders that fold, a filter, an icon per kind of file and an optional Git status.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Files\"",
     "description": "The heading; empty leaves the header out",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "Small text under the heading – the project or branch",
     "readonly": false
    },
    {
     "name": "nodes",
     "attribute": null,
     "type": "FileTreeNode[]",
     "default": "[]",
     "description": "The top level of the tree; `fileTreeFromPaths` builds it from paths",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The chosen file's path, or null",
     "readonly": false
    },
    {
     "name": "expanded",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The paths of the open folders",
     "readonly": false
    },
    {
     "name": "query",
     "attribute": "query",
     "type": "string",
     "default": "\"\"",
     "description": "The filter's text",
     "readonly": false
    },
    {
     "name": "sort",
     "attribute": "sort",
     "type": "boolean",
     "default": "true",
     "description": "Folders first, then by name with numbers in order; off keeps the order given",
     "readonly": false
    },
    {
     "name": "hideFilter",
     "attribute": "hide-filter",
     "type": "boolean",
     "default": "false",
     "description": "Leaves out the filter",
     "readonly": false
    },
    {
     "name": "searchable",
     "attribute": "searchable",
     "type": "boolean",
     "default": "false",
     "description": "\"?\" then text and Enter fires tc-search, for searching inside files",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "480",
     "description": "Height in px at which the tree scrolls",
     "readonly": false
    },
    {
     "name": "actions",
     "attribute": null,
     "type": "FileTreeActionItem[]",
     "default": "[]",
     "description": "Buttons in the header",
