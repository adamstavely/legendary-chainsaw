     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "Another file was chosen ({ selected, node }: FileTreeSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-expanded-change",
     "detail": "",
     "description": "A folder opened or closed ({ expanded, path }: FileTreeExpandedChange); cancelable – prevented, `expanded` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-query-change",
     "detail": "",
     "description": "The filter's text changed ({ query }: FileTreeQueryChange); cancelable – prevented, `query` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-open",
     "detail": "",
