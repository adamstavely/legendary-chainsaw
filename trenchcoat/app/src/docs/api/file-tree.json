     "cancelable": false
    },
    {
     "name": "tc-load",
     "detail": "",
     "description": "A lazy folder was opened and needs its children ({ path, node }: FileTreeLoad)",
     "cancelable": false
    },
    {
     "name": "tc-search",
     "detail": "",
     "description": "\"?\" and text then Enter, with `searchable` ({ query }: FileTreeSearch)",
     "cancelable": false
    },
    {
     "name": "tc-action",
     "detail": "",
     "description": "A header button was pressed ({ id }: FileTreeAction)",
