{
 "elements": [
  {
   "tag": "tc-stories",
   "className": "TcStories",
   "description": "A row of story avatars – a gradient ring for something new, a gray ring once seen – and the modal viewer they open,\nwith progress bars, auto-advance, tap and arrow-key stepping, and swipe down to close.",
   "properties": [
    {
     "name": "people",
     "attribute": null,
     "type": "StoryPerson[]",
     "default": "[]",
     "description": "The people with stories, in the order the row shows them; people with no items are left out",
     "readonly": false
    },
    {
     "name": "seen",
     "attribute": null,
     "type": "StorySeen",
     "default": "new Set<string>()",
     "description": "The item ids that have been seen, as a Set or a record of id → true; the app owns it",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": null,
     "type": "StoryOpen",
     "default": "null",
     "description": "What the viewer shows ({ person, item } ids), or null when it's closed",
     "readonly": false
    },
    {
     "name": "addable",
     "attribute": "addable",
     "type": "boolean",
     "default": "false",
     "description": "Show the \"add\" tile first in the row",
     "readonly": false
    },
    {
     "name": "addLabel",
     "attribute": "add-label",
     "type": "string",
     "default": "\"Add story\"",
     "description": "The \"add\" tile's text",
     "readonly": false
    },
    {
     "name": "addAvatar",
     "attribute": "add-avatar",
     "type": "string",
     "default": "\"\"",
     "description": "An image for the \"add\" tile (the person's own avatar); without one it shows a plus",
     "readonly": false
    },
    {
     "name": "replyable",
     "attribute": "replyable",
     "type": "boolean",
     "default": "false",
     "description": "Show a reply field at the foot of the viewer; sending fires tc-reply",
     "readonly": false
    },
    {
     "name": "duration",
     "attribute": "duration",
     "type": "number",
     "default": "5000",
     "description": "How long an image or text card shows, in milliseconds, unless the item sets its own",
     "readonly": false
    },
    {
     "name": "autoplay",
     "attribute": "autoplay",
     "type": "boolean",
     "default": "true",
     "description": "Advance on its own; off (or with reduced motion) items change only when the person steps",
     "readonly": false
    },
    {
     "name": "muted",
     "attribute": "muted",
     "type": "boolean",
     "default": "true",
     "description": "Whether videos start muted; the viewer's mute toggle changes it",
     "readonly": false
    },
    {
     "name": "label",
     "attribute": "label",
     "type": "string",
     "default": "\"Stories\"",
     "description": "The row's accessible name",
     "readonly": false
    },
    {
     "name": "newLabel",
     "attribute": "new-label",
     "type": "string",
     "default": "\"new\"",
     "description": "Said after a person's name when they have something new (\"Maya Chen, 2 new\")",
     "readonly": false
    },
    {
     "name": "seenLabel",
     "attribute": "seen-label",
     "type": "string",
     "default": "\"seen\"",
     "description": "Said after a person's name when everything's been seen (\"Maya Chen, seen\")",
     "readonly": false
    },
    {
     "name": "emptyLabel",
     "attribute": "empty-label",
     "type": "string",
     "default": "\"No stories yet.\"",
     "description": "Shown when there are no stories and no \"add\" tile",
     "readonly": false
    },
    {
     "name": "replyLabel",
     "attribute": "reply-label",
     "type": "string",
     "default": "\"Reply to\"",
     "description": "The reply field's placeholder and name, before the person's name (\"Reply to Maya Chen\")",
     "readonly": false
    },
    {
     "name": "sendLabel",
     "attribute": "send-label",
     "type": "string",
     "default": "\"Send\"",
     "description": "The send button's name",
     "readonly": false
    },
    {
     "name": "closeLabel",
     "attribute": "close-label",
     "type": "string",
     "default": "\"Close\"",
     "description": "The close button's name",
     "readonly": false
    },
    {
     "name": "pauseLabel",
     "attribute": "pause-label",
     "type": "string",
     "default": "\"Pause\"",
     "description": "The pause button's name",
     "readonly": false
    },
    {
     "name": "playLabel",
     "attribute": "play-label",
     "type": "string",
     "default": "\"Play\"",
     "description": "The play button's name",
     "readonly": false
    },
    {
     "name": "muteLabel",
     "attribute": "mute-label",
     "type": "string",
     "default": "\"Mute\"",
     "description": "The mute button's name",
     "readonly": false
    },
    {
     "name": "unmuteLabel",
     "attribute": "unmute-label",
     "type": "string",
     "default": "\"Unmute\"",
     "description": "The unmute button's name",
     "readonly": false
    },
    {
     "name": "previousLabel",
     "attribute": "previous-label",
     "type": "string",
     "default": "\"Previous\"",
     "description": "The previous-item button's name",
     "readonly": false
    },
    {
     "name": "nextLabel",
     "attribute": "next-label",
     "type": "string",
     "default": "\"Next\"",
     "description": "The next-item button's name",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-open-change",
     "detail": "",
     "description": "The viewer is opening, stepping or closing ({ open }: StoryOpenChangeEvent – the next `open`, or null); cancelable – prevented, `open` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-seen-change",
     "detail": "",
     "description": "An unseen item was shown ({ seen, person, item }: StorySeenChangeEvent – `seen` with the item added, in the same shape); cancelable – prevented, `seen` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-reply",
     "detail": "",
     "description": "A reply was sent from the viewer ({ text, person, item }: StoryReplyEvent)",
     "cancelable": false
    },
    {
     "name": "tc-add",
     "detail": "",
     "description": "The \"add\" tile was activated (no detail)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "sty",
   "cssProperties": [
    {
     "name": "--tc-story-size",
     "value": "var(--tc-space-14)",
     "looks": [
      "both"
     ]
    },
    {
     "name": "--tc-story-ring-width",
     "value": "calc(var(--tc-space-0-5) + var(--tc-hairline))",
     "looks": [
      "both"
     ]
    },
    {
