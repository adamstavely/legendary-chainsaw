 "functions": [],
 "react": [
  {
   "component": "Stories",
   "exported": true,
   "props": [
    {
     "name": "seen",
     "type": "StorySeen",
     "optional": true,
     "description": "The item ids that have been seen – controlled when given"
    },
    {
     "name": "defaultSeen",
     "type": "StorySeen",
     "optional": true,
     "description": "The seen item ids on mount when `seen` isn't controlled"
    },
    {
     "name": "onSeenChange",
     "type": "(seen: StorySeen, item: StoryItem, person: StoryPerson) => void",
     "optional": true,
     "description": "An unseen item was shown: `seen` is the set (or record) with it added"
    },
    {
     "name": "open",
     "type": "StoryOpen",
     "optional": true,
     "description": "What the viewer shows ({ person, item } ids), or null when closed – controlled when given"
    },
    {
     "name": "defaultOpen",
     "type": "StoryOpen",
     "optional": true,
     "description": "What the viewer shows on mount when `open` isn't controlled"
    },
    {
     "name": "onOpenChange",
     "type": "(open: StoryOpen) => void",
     "optional": true,
     "description": "The viewer is opening, stepping to another item, or closing (null)"
    },
    {
     "name": "onAdd",
     "type": "() => void",
     "optional": true,
     "description": "Shows the \"add\" tile first in the row; called when it's activated"
    },
    {
     "name": "onReply",
     "type": "(text: string, item: StoryItem, person: StoryPerson) => void",
     "optional": true,
     "description": "Shows a reply field in the viewer; called with the text when a reply is sent"
    }
   ],
   "hides": [
    "seen",
    "open",
    "addable",
    "replyable",
    "children"
   ],
   "events": {
    "tc-open-change": null,
    "tc-seen-change": "onSeenChange",
    "tc-reply": "onReply",
    "tc-add": "onAdd"
   }
  }
 ],
 "changelog": [
  "**Feedback and onboarding:** - `tc-stories`: a gradient ring for new updates that opens a modal viewer; - `tc-background-tasks`."
