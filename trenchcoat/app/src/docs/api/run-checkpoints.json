{
 "elements": [
  {
   "tag": "tc-run-checkpoints",
   "className": "TcRunCheckpoints",
   "description": "An agent run's restore points: pick a step, see what it captured and what going back discards, and go back.",
   "properties": [
    {
     "name": "checkpoints",
     "attribute": null,
     "type": "RunCheckpoint[]",
     "default": "[]",
     "description": "The checkpoints, oldest first – one before each step of the run",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "RunCheckpointsStatus",
     "default": "\"done\"",
     "description": "The run: \"running\" (a live run), \"paused\", \"done\", \"failed\" – always set by the app",
     "readonly": false
    },
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"\"",
     "description": "The run's goal, shown as the heading",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The picked checkpoint's id. Picks apply unless a tc-selected-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "elapsed",
     "attribute": "elapsed",
     "type": "number | undefined",
     "default": "undefined",
     "description": "How long the run has gone on, in ms – the strip's length (defaults to the last checkpoint)",
     "readonly": false
    },
    {
     "name": "placeholder",
     "attribute": "placeholder",
     "type": "string",
     "default": "\"What should it do differently? (optional)\"",
     "description": "Placeholder of the note that goes along with the restore",
     "readonly": false
    },
    {
     "name": "currency",
     "attribute": "currency",
     "type": "string",
     "default": "\"USD\"",
     "description": "Currency of `cost`, an ISO 4217 code",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string",
     "default": "\"en-US\"",
     "description": "Locale for money",
     "readonly": false
    },
    {
     "name": "restorer",
     "attribute": null,
     "type": "((checkpointId: string, instruction: string) => void | Promise<unknown>) | undefined",
     "default": "undefined",
     "description": "Called on restore (as well as tc-restore). May return a promise: the button waits, and says so if it rejects",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
