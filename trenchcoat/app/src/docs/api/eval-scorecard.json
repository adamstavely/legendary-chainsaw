{
 "elements": [
  {
   "tag": "tc-eval-scorecard",
   "className": "TcEvalScorecard",
   "description": "Test cases run against prompt or model versions – pass or fail per case per version, the pass rate across versions,\nfilters by tag, and a case opened beside its expected answer.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Evals\"",
     "description": "The heading – the eval set's name",
     "readonly": false
    },
    {
     "name": "versions",
     "attribute": null,
     "type": "EvalVersion[]",
     "default": "[]",
     "description": "The versions in the order they were made – the last one is judged by the Failing and Regressed filters",
     "readonly": false
    },
    {
     "name": "cases",
     "attribute": null,
     "type": "EvalCase[]",
     "default": "[]",
     "description": "The test cases, each with its results per version",
     "readonly": false
    },
    {
     "name": "tags",
     "attribute": null,
     "type": "string[]",
     "default": "[]",
     "description": "The picked tags – a case with any of them shows; none picked shows every case",
     "readonly": false
    },
    {
     "name": "show",
     "attribute": "show",
     "type": "EvalScorecardShow",
     "default": "\"all\"",
     "description": "Which cases show: \"all\", \"failing\" (on the latest version) or \"regressed\" (passed on the one before, fails now)",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": null,
     "type": "EvalScorecardOpen | null",
     "default": "null",
     "description": "The open case and version, or null for none",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "360",
     "description": "The grid's height before it scrolls, in px",
     "readonly": false
    },
    {
     "name": "formatRate",
     "attribute": null,
     "type": "(rate: number) => string",
     "default": "percent",
     "description": "Formats a pass rate (0–1) – defaults to a whole percentage, e.g. \"86%\"",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
