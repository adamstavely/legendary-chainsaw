{
 "elements": [
  {
   "tag": "tc-problem-list",
   "className": "TcProblemList",
   "description": "Diagnostics from a build, type check or linter: grouped by file, a severity filter with counts, a text filter, and quick fixes.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Problems\"",
     "description": "The heading; empty leaves the header out",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "Small text under the heading – what was checked",
     "readonly": false
    },
    {
     "name": "problems",
     "attribute": null,
     "type": "ProblemItem[]",
     "default": "[]",
     "description": "What was found",
     "readonly": false
    },
    {
     "name": "filter",
     "attribute": "filter",
     "type": "ProblemFilter",
     "default": "\"all\"",
     "description": "Which severities show: all, error, warning or info",
     "readonly": false
    },
    {
     "name": "query",
     "attribute": "query",
     "type": "string",
     "default": "\"\"",
     "description": "The text filter: matches the message, path, source or code",
     "readonly": false
    },
    {
     "name": "groupBy",
     "attribute": "group-by",
     "type": "\"file\" | \"none\"",
     "default": "\"file\"",
     "description": "\"file\" groups problems under their file; \"none\" lists them with their path",
     "readonly": false
    },
    {
     "name": "expanded",
     "attribute": null,
     "type": "string[] | null",
     "default": "null",
     "description": "The open files' paths; null opens them all",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | null",
     "default": "null",
     "description": "The chosen problem's key (its id, or `problemKey`)",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "ProblemListStatus",
     "default": "\"done\"",
     "description": "idle, running or done",
     "readonly": false
    },
    {
     "name": "hideFilter",
     "attribute": "hide-filter",
     "type": "boolean",
     "default": "false",
     "description": "Leaves out the severity and text filters",
     "readonly": false
    },
    {
     "name": "maxHeight",
     "attribute": "max-height",
     "type": "number",
     "default": "480",
     "description": "Height in px at which the list scrolls",
     "readonly": false
    },
    {
     "name": "actions",
     "attribute": null,
     "type": "ProblemListActionItem[]",
     "default": "[]",
     "description": "Buttons in the header",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<ProblemListLabels>",
     "default": "{}",
     "description": "Renames the words it uses",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "Another problem was chosen ({ selected, problem }: ProblemSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-filter-change",
     "detail": "",
     "description": "The severity filter changed ({ filter }: ProblemFilterChange); cancelable – prevented, `filter` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-query-change",
     "detail": "",
     "description": "The text filter changed ({ query }: ProblemQueryChange); cancelable – prevented, `query` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-expanded-change",
     "detail": "",
     "description": "A file was opened or closed ({ expanded, path }: ProblemExpandedChange); cancelable – prevented, `expanded` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-open",
     "detail": "",
     "description": "A problem was clicked, or Enter or Space pressed on it ({ path, line, column, problem }: ProblemOpen)",
     "cancelable": false
    },
    {
     "name": "tc-fix",
     "detail": "",
     "description": "A problem's fix was pressed ({ problem }: ProblemFix); cancelable – prevented, the page has dealt with it and nothing else is said",
     "cancelable": true
    },
    {
     "name": "tc-action",
     "detail": "",
     "description": "A header button was pressed ({ id }: ProblemListAction)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "prob",
