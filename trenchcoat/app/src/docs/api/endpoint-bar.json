{
 "elements": [
  {
   "tag": "tc-endpoint-bar",
   "className": "TcEndpointBar",
   "description": "One API endpoint on one line – the method badge, the base URL or an environment select, the path with its\n{params} picked out and described, Copy URL and Try it, with Deprecated and Beta badges.",
   "properties": [
    {
     "name": "method",
     "attribute": "method",
     "type": "EndpointMethod",
     "default": "\"GET\"",
     "description": "The HTTP method",
     "readonly": false
    },
    {
     "name": "path",
     "attribute": "path",
     "type": "string",
     "default": "\"/\"",
     "description": "The path, with parameters in braces, e.g. \"/v1/records/{record_id}\"",
     "readonly": false
    },
    {
     "name": "params",
     "attribute": null,
     "type": "EndpointParam[]",
     "default": "[]",
     "description": "The path parameters' descriptions, by name",
     "readonly": false
    },
    {
     "name": "environments",
     "attribute": null,
     "type": "EndpointEnvironment[]",
     "default": "[]",
     "description": "The environments to pick between; with one or none, the base URL is plain text",
     "readonly": false
    },
    {
     "name": "environment",
     "attribute": "environment",
     "type": "string",
     "default": "\"\"",
     "description": "The picked environment's id; by default the first. Changed by the select unless a tc-environment-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "baseUrl",
     "attribute": "base-url",
     "type": "string",
     "default": "\"\"",
     "description": "The base URL when there are no environments",
     "readonly": false
    },
    {
     "name": "summary",
     "attribute": "summary",
     "type": "string",
     "default": "\"\"",
     "description": "A short summary after the path, e.g. \"Get a record\"",
     "readonly": false
    },
    {
     "name": "deprecated",
     "attribute": "deprecated",
     "type": "boolean",
     "default": "false",
     "description": "Marks the endpoint deprecated",
     "readonly": false
    },
    {
     "name": "beta",
     "attribute": "beta",
     "type": "boolean",
     "default": "false",
     "description": "Marks the endpoint beta",
     "readonly": false
    },
    {
     "name": "hideTry",
     "attribute": "hide-try",
     "type": "boolean",
     "default": "false",
     "description": "Hides Try it",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<EndpointBarLabels>",
     "default": "{}",
     "description": "The element's words, merged over defaultEndpointBarLabels",
     "readonly": false
    },
    {
     "name": "current",
     "attribute": null,
     "type": "EndpointEnvironment | null",
     "default": null,
     "description": "The environment in use, or null without environments",
     "readonly": true
    },
    {
     "name": "url",
     "attribute": null,
     "type": "",
     "default": null,
     "description": "The full URL: the base and the path, parameters left in braces",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-environment-change",
     "detail": "",
     "description": "An environment was picked ({ environment }: EndpointEnvironmentChange); cancelable – prevented, `environment` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-copy",
     "detail": "",
     "description": "Copy URL was pressed ({ text }: EndpointCopy); cancelable – prevented, nothing is copied",
     "cancelable": true
    },
    {
     "name": "tc-try",
     "detail": "",
     "description": "Try it was pressed ({ method, url, environment }: EndpointTry); cancelable",
     "cancelable": true
    }
   ],
   "slots": [],
   "methods": [],
   "ui": "epb",
   "cssProperties": [],
