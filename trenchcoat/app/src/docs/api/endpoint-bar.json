 "functions": [
  {
   "name": "endpointPathParts",
   "signature": "endpointPathParts(path: string): void",
   "description": "The path cut into text and {param} parts"
  }
 ],
 "react": [
  {
   "component": "EndpointBar",
   "exported": true,
   "props": [
    {
     "name": "environment",
     "type": "string",
     "optional": true,
     "description": "The picked environment's id – controlled when given"
    },
    {
     "name": "defaultEnvironment",
     "type": "string",
     "optional": true,
     "description": "The environment on mount, when `environment` isn't controlled; by default the first"
    },
    {
     "name": "onEnvironmentChange",
     "type": "(environment: string) => void",
     "optional": true,
     "description": "Called with the environment the user picked"
    },
    {
     "name": "onCopyUrl",
     "type": "(url: string) => boolean | void",
     "optional": true,
     "description": "Copy URL was pressed; return false to stop the copy"
    },
    {
     "name": "onTry",
     "type": "(request: EndpointTry) => void",
     "optional": true,
     "description": "Try it was pressed"
    }
   ],
   "hides": [
    "environment",
    "children"
   ],
   "events": {
    "tc-environment-change": null,
    "tc-copy": "onCopyUrl",
    "tc-try": "onTry"
   }
  }
 ],
