     "cancelable": true
    },
    {
     "name": "tc-try",
     "detail": "",
     "description": "\"Try on sample\" with nothing wrong ({ criteria, prompt }: EvalCriteriaTry)",
     "cancelable": false
    },
    {
     "name": "tc-prompt-copy",
     "detail": "",
     "description": "The judge prompt was copied ({ prompt }); cancelable – prevented, nothing is copied",
     "cancelable": true
    }
   ],
