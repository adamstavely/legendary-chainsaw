 "react": [
  {
   "component": "EvalCriteriaEditor",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading – defaults to \"Judge criteria\""
    },
    {
     "name": "criteria",
     "type": "JudgeCriterion[]",
     "optional": true,
     "description": "The criteria. Controlled when defined; otherwise kept by the component from `defaultCriteria`"
    },
    {
     "name": "defaultCriteria",
     "type": "JudgeCriterion[]",
     "optional": true,
     "description": "On mount, when `criteria` isn't controlled"
    },
    {
     "name": "onCriteriaChange",
     "type": "(criteria: JudgeCriterion[]) => void",
     "optional": true,
     "description": "Called with the next `criteria`"
    },
    {
     "name": "onTry",
     "type": "(criteria: JudgeCriterion[], prompt: string) => void",
     "optional": true,
     "description": "Called by \"Try on sample\" when nothing is wrong, with the assembled prompt"
    },
    {
     "name": "onPromptCopy",
     "type": "(prompt: string) => void | boolean",
     "optional": true,
     "description": "Called when the judge prompt is copied. Return false to stop the copy"
    }
   ],
   "hides": [
    "heading",
    "criteria"
   ],
   "events": {
    "tc-criteria-change": null,
    "tc-try": "onTry",
    "tc-prompt-copy": "onPromptCopy"
   }
  }
 ],
