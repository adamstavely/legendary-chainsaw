{
 "elements": [
  {
   "tag": "tc-eval-criteria-editor",
   "className": "TcEvalCriteriaEditor",
   "description": "Define an LLM judge's criteria: questions, answer kinds, weights as shares and examples, with the assembled prompt.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Judge criteria\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "criteria",
     "attribute": null,
     "type": "JudgeCriterion[]",
     "default": "[]",
     "description": "The criteria, in the order the judge asks them. Changed by the user unless a tc-criteria-change listener prevents it",
     "readonly": false
    },
    {
     "name": "open",
     "attribute": null,
     "type": "string[] | undefined",
     "default": "undefined",
     "description": "Ids of the criteria shown open; unset, the first is open",
     "readonly": false
    },
    {
     "name": "hideTry",
     "attribute": "hide-try",
     "type": "boolean",
     "default": "false",
     "description": "Hides \"Try on sample\"",
     "readonly": false
    },
    {
     "name": "trying",
     "attribute": "trying",
     "type": "boolean",
     "default": "false",
     "description": "Shows Try as busy while the page runs the judge",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-criteria-change",
     "detail": "",
