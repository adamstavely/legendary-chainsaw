 "functions": [],
 "react": [
  {
   "component": "ConversationBranches",
   "exported": true,
   "props": [
    {
     "name": "messages",
     "type": "BranchMessage[]",
     "optional": true,
     "description": "Every message of every branch. Controlled when defined; otherwise the element keeps them, starting at `defaultMessages`"
    },
    {
     "name": "defaultMessages",
     "type": "BranchMessage[]",
     "optional": true,
     "description": "The messages at first when uncontrolled"
    },
    {
     "name": "onMessagesChange",
     "type": "(messages: BranchMessage[]) => void",
     "optional": true,
     "description": "Called with the whole list when messages are added (a new branch, its replies)"
    },
    {
     "name": "selected",
     "type": "BranchSelection",
     "optional": true,
     "description": "The picked child per parent id (\"\" for the first messages). Controlled when defined"
    },
    {
     "name": "defaultSelected",
     "type": "BranchSelection",
     "optional": true,
     "description": "The picked branches at first when uncontrolled – unset shows the newest child at every fork"
    },
    {
     "name": "onSelectedChange",
     "type": "(selected: BranchSelection, change: { messageId: string; index: number; count: number }) => void",
     "optional": true,
     "description": "Called when a branch is picked, or a new branch was made"
    },
    {
     "name": "onEdit",
     "type": "(edit: ConversationEdit) => BranchMessage[] | Promise<BranchMessage[]> | void | false",
     "optional": true,
     "description": "Called when an edited message is sent. Return the new branch's replies (or a promise of them) to answer it;\nreturn false to drop the edit"
    }
   ],
   "hides": [
    "messages",
    "selected",
    "onChange"
   ],
   "events": {
    "tc-selected-change": "onSelectedChange",
    "tc-messages-change": "onMessagesChange",
    "tc-edit": "onEdit"
   }
  }
 ],
 "changelog": [
  "`tc-conversation-branches` – edit a past message to fork the conversation; a 2 / 3 switcher on the edited message, each branch's replies (with `tc-message-actions`) below, and `tc-edit` answered with the new replies or a promise of them."
 ],
