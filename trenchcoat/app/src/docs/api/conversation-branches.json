{
 "elements": [
  {
   "tag": "tc-conversation-branches",
   "className": "TcConversationBranches",
   "description": "A conversation that forks when a past message is edited: a \"‹ 2 / 3 ›\" switcher on each message with siblings, and\nthe picked branch's messages below it.",
   "properties": [
    {
     "name": "messages",
     "attribute": null,
     "type": "BranchMessage[]",
     "default": "[]",
     "description": "Every message of every branch, in the order they were written; each names its parent",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": null,
     "type": "BranchSelection",
     "default": "{}",
     "description": "The picked child per parent id (\"\" for the first messages); a parent without an entry shows its newest child",
     "readonly": false
    },
    {
     "name": "editable",
     "attribute": "editable",
     "type": "boolean",
     "default": "true",
     "description": "Your messages can be edited (default true; editable=\"false\" turns it off)",
     "readonly": false
    },
    {
     "name": "replyActions",
     "attribute": null,
     "type": "MessageActionKey[]",
     "default": "[\"copy\", \"feedback\"]",
     "description": "The actions under each reply (message-actions' keys); an empty list hides the bar",
     "readonly": false
    },
    {
     "name": "renderContent",
     "attribute": null,
     "type": "((message: BranchMessage) => Node | string) | undefined",
     "default": "undefined",
     "description": "Draws a message's content – a Node or a string. Default: the text, a paragraph per blank line",
     "readonly": false
    },
    {
     "name": "label",
     "attribute": "label",
     "type": "string",
     "default": "\"Conversation\"",
     "description": "Accessible name of the conversation",
     "readonly": false
    },
    {
     "name": "userName",
     "attribute": "user-name",
     "type": "string",
     "default": "\"You\"",
     "description": "Who \"you\" are, for screen readers",
     "readonly": false
    },
    {
     "name": "assistantName",
     "attribute": "assistant-name",
     "type": "string",
     "default": "\"Assistant\"",
     "description": "Who answers, for screen readers",
     "readonly": false
    },
    {
     "name": "caption",
     "attribute": "caption",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The caption line (Standard: on the tray, Clean: the card's last row); unset, it sums up the branches",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "A branch was picked in a switcher, or a new branch was made; detail `{ selected, messageId, index, count }`. Cancelable: prevent it to control `selected`",
     "cancelable": true
    },
    {
     "name": "tc-messages-change",
     "detail": "",
     "description": "Messages were added (a new branch, its replies); detail `{ messages: BranchMessage[] }`. Cancelable: prevent it to control `messages`",
     "cancelable": true
    },
    {
     "name": "tc-edit",
     "detail": "",
