     "name": "label",
     "attribute": "label",
     "type": "string",
     "default": "\"Notices\"",
     "description": "The region's name",
     "readonly": false
    },
    {
     "name": "quiet",
     "attribute": "quiet",
     "type": "boolean",
     "default": "false",
