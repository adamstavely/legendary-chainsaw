 "functions": [],
 "react": [
  {
   "component": "CorrectionPropagation",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading, and the component's name"
    },
    {
     "name": "states",
     "type": "Record<string, CorrectionState>",
     "optional": true,
     "description": "Each item's state by id. Controlled when defined; otherwise the component keeps it, starting at `defaultStates`"
    },
    {
     "name": "defaultStates",
     "type": "Record<string, CorrectionState>",
     "optional": true,
     "description": "The states when uncontrolled"
    },
    {
     "name": "onStatesChange",
     "type": "(states: Record<string, CorrectionState>, id: string, state: CorrectionState) => void",
     "optional": true,
     "description": "Called with the whole new map, the item that changed and its new state"
    },
    {
     "name": "onReview",
     "type": "(id: string, candidate: CorrectionCandidate) => void",
     "optional": true,
     "description": "Review was pressed – open the item for a person to check"
    },
    {
     "name": "onSupersede",
     "type": "(id: string, candidate: CorrectionCandidate) => void",
     "optional": true,
     "description": "Mark superseded was pressed"
    },
    {
     "name": "onDismiss",
     "type": "(id: string, candidate: CorrectionCandidate) => void",
     "optional": true,
     "description": "Dismiss was pressed – the item doesn't rely on the claim"
    }
   ],
   "hides": [
    "heading",
    "states"
   ],
   "events": {
    "tc-states-change": null,
    "tc-review": "onReview",
    "tc-supersede": "onSupersede",
    "tc-dismiss": "onDismiss"
   }
  }
 ],
 "changelog": [
  "**Trust & calibration**, from THEMIS and built domain-neutral: - claims and their reliability: `tc-claim-answer`, `tc-verification-queue`, `tc-reflection-gate`, `tc-reliance-gauge`, `tc-disagreement-banner`, `tc-synthesis-notes`; - where outputs came from: `tc-lineage-graph`, `tc-validity-badge`, `tc-provenance-summary`, `tc-correction-propagation`, `tc-attestation-check`, `tc-run-manifest`; - policy and control: `tc-policy-simulator`, `tc-gate-config`, `tc-coverage-matrix`, `tc-kill-switch`, `tc-playbook-canvas`."
 ],
