{
 "elements": [
  {
   "tag": "tc-correction-propagation",
   "className": "TcCorrectionPropagation",
   "description": "How far a correction reaches: every artifact and released package that cites the corrected claim, each sent for\nreview – nothing rewritten automatically.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Correction reach\"",
     "description": "The heading, and the component's name",
     "readonly": false
    },
    {
     "name": "claim",
     "attribute": "claim",
     "type": "string",
     "default": "\"\"",
     "description": "The claim as it was, before the correction",
     "readonly": false
    },
    {
     "name": "correction",
     "attribute": "correction",
     "type": "string",
     "default": "\"\"",
     "description": "The claim as corrected",
     "readonly": false
    },
    {
     "name": "reason",
     "attribute": "reason",
     "type": "string",
     "default": "\"\"",
     "description": "Why it was corrected",
     "readonly": false
    },
    {
     "name": "meta",
     "attribute": "meta",
     "type": "string",
     "default": "\"\"",
     "description": "Who corrected it and when, as one line – e.g. \"Dana Okafor · today, 10:42\"",
     "readonly": false
    },
    {
     "name": "candidates",
     "attribute": null,
     "type": "CorrectionCandidate[]",
     "default": "[]",
     "description": "The artifacts and released packages that cite the corrected claim",
     "readonly": false
    },
    {
     "name": "states",
     "attribute": null,
     "type": "Record<string, CorrectionState>",
     "default": "{}",
     "description": "Each item's state by id; an item not named here uses its own `state`, else \"pending\". Changed by the user unless a\ntc-states-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "note",
     "attribute": "note",
     "type": "string",
     "default": "\"Nothing is changed automatically – each item waits for a person.\"",
     "description": "The line under the list – what the component won't do",
     "readonly": false
    },
    {
     "name": "emptyText",
     "attribute": "empty-text",
     "type": "string",
     "default": "\"Nothing else cites this claim.\"",
     "description": "Shown when nothing cites the claim",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-states-change",
     "detail": "",
     "description": "An item's state changed ({ states, id, state, candidate }: CorrectionStatesChange – states is the whole new map); cancelable – prevent it to keep `states` as it is (controlled use)",
     "cancelable": true
    },
    {
     "name": "tc-review",
     "detail": "",
     "description": "Review was pressed on an item ({ id, candidate }: CorrectionAction) – open it for a person to check",
     "cancelable": false
    },
    {
     "name": "tc-supersede",
     "detail": "",
     "description": "Mark superseded was pressed on an item ({ id, candidate }: CorrectionAction)",
     "cancelable": false
    },
    {
     "name": "tc-dismiss",
     "detail": "",
     "description": "Dismiss was pressed on an item – it doesn't rely on the claim ({ id, candidate }: CorrectionAction)",
     "cancelable": false
    }
   ],
