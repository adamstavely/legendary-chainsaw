    "status",
    "children"
   ],
   "events": {
    "tc-status-change": null,
    "tc-set-limit": "onSetLimit",
    "tc-investigate": "onInvestigate",
    "tc-evidence-open": "onEvidenceOpen"
   }
  }
 ],
