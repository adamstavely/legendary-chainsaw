    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading"
    },
    {
     "name": "status",
     "type": "AnomalyStatus",
     "optional": true,
     "description": "\"open\" or \"expected\" – controlled when given"
    },
    {
     "name": "defaultStatus",
     "type": "AnomalyStatus",
     "optional": true,
     "description": "The status on mount, when `status` isn't controlled"
    },
    {
     "name": "onStatusChange",
     "type": "(status: AnomalyStatus) => void",
     "optional": true,
     "description": "Marked as expected, or back to open"
    },
    {
     "name": "onSetLimit",
     "type": "(target: AnomalyCause | null) => void",
     "optional": true,
     "description": "Set a limit was pressed, for the likely cause"
    },
    {
     "name": "onInvestigate",
     "type": "(target: AnomalyCause | null) => void",
     "optional": true,
     "description": "Investigate was pressed, for the likely cause"
    },
    {
     "name": "onEvidenceOpen",
     "type": "(id: string, evidence: AnomalyEvidence) => void",
     "optional": true,
     "description": "An evidence row was opened"
    }
   ],
   "hides": [
