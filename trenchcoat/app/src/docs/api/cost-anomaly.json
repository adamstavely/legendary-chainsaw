{
 "elements": [
  {
   "tag": "tc-cost-anomaly",
   "className": "TcCostAnomaly",
   "description": "Cost anomaly: one spend spike – how far over expected, a chart of daily spend with the expected band, the likely\ncause and its share of the extra cost, the evidence, and Set a limit, Investigate and Mark as expected.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Cost spike\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string | undefined",
     "default": "undefined",
     "description": "One line under the heading, e.g. the workspace",
     "readonly": false
    },
    {
     "name": "days",
     "attribute": null,
     "type": "CostDay[]",
     "default": "[]",
     "description": "Daily spend around the spike, oldest first",
     "readonly": false
    },
    {
     "name": "spike",
     "attribute": "spike",
     "type": "number | undefined",
     "default": "undefined",
     "description": "The spike's day, epoch ms; by default the day furthest above what was expected",
     "readonly": false
    },
    {
     "name": "causes",
     "attribute": null,
     "type": "AnomalyCause[]",
     "default": "[]",
     "description": "What drove the extra cost, the likeliest first",
     "readonly": false
    },
    {
     "name": "evidence",
     "attribute": null,
     "type": "AnomalyEvidence[]",
     "default": "[]",
     "description": "The costliest runs or requests during the spike",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "AnomalyStatus",
     "default": "\"open\"",
     "description": "\"open\", or \"expected\" once marked. Changed by Mark as expected and Undo unless a tc-status-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "currency",
     "attribute": "currency",
     "type": "string",
     "default": "\"USD\"",
     "description": "The spend's currency, an ISO 4217 code",
     "readonly": false
    },
    {
     "name": "locale",
     "attribute": "locale",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The language for numbers and dates, e.g. \"en-GB\"; by default the browser's",
     "readonly": false
    },
    {
     "name": "timeZone",
     "attribute": "time-zone",
     "type": "string",
     "default": "\"UTC\"",
     "description": "The time zone the days are counted in",
     "readonly": false
    },
    {
     "name": "causeLabels",
     "attribute": null,
     "type": "Partial<Record<AnomalyCauseKind, string>>",
     "default": "{}",
     "description": "The words for each kind of cause, merged over defaultAnomalyCauseLabels",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-status-change",
     "detail": "",
     "description": "Marked as expected, or back to open ({ status }: AnomalyStatusChange); cancelable – prevented, `status` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-set-limit",
     "detail": "",
     "description": "Set a limit was pressed ({ target }: AnomalyTarget)",
     "cancelable": false
    },
    {
     "name": "tc-investigate",
     "detail": "",
     "description": "Investigate was pressed ({ target }: AnomalyTarget)",
     "cancelable": false
    },
    {
     "name": "tc-evidence-open",
     "detail": "",
     "description": "An evidence row was opened ({ id, evidence }: AnomalyEvidenceOpen)",
     "cancelable": false
    }
   ],
   "slots": [],
