{
 "elements": [
  {
   "tag": "tc-message-drafts",
   "className": "TcMessageDrafts",
   "description": "Text-message drafts in two to four variants – edit in place with the SMS length, then Copy, Send or Open in\nMessages.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "",
     "default": null,
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "recipient",
     "attribute": "recipient",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Who it's for, by name",
     "readonly": false
    },
    {
     "name": "to",
     "attribute": "to",
     "type": "string | undefined",
     "default": "undefined",
     "description": "Their number – used in Send's event and the sms: link",
     "readonly": false
    },
    {
     "name": "variants",
     "attribute": null,
     "type": "MessageVariant[]",
     "default": "[]",
     "description": "The drafts, two to four; more are left out",
     "readonly": false
    },
    {
     "name": "selected",
     "attribute": "selected",
     "type": "string | undefined",
     "default": "undefined",
     "description": "The variant shown, by id. Changed by the user unless tc-selected-change is prevented",
     "readonly": false
    },
    {
     "name": "openLink",
     "attribute": "open-link",
     "type": "boolean",
     "default": "false",
     "description": "Shows Open in Messages, an sms: link with the text filled in",
     "readonly": false
    },
    {
     "name": "status",
     "attribute": "status",
     "type": "\"draft\" | \"sent\"",
     "default": "\"draft\"",
     "description": "Draft or sent – Send moves it to sent; set it back to \"draft\" to write again",
     "readonly": false
    },
    {
     "name": "labels",
     "attribute": null,
     "type": "Partial<MessageDraftsLabels>",
     "default": "{}",
     "description": "Words to use instead of the defaults",
     "readonly": false
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-selected-change",
     "detail": "",
     "description": "Another variant was picked ({ selected }: MessageSelectedChange); cancelable – prevented, `selected` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-variants-change",
     "detail": "",
     "description": "A variant's text was edited ({ variants, id }: MessageVariantsChange); cancelable – prevented, `variants` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-send",
     "detail": "",
     "description": "Send was pressed ({ variant, text, to }: MessageSend); cancelable – prevented, the draft stays open",
     "cancelable": true
    },
    {
     "name": "tc-copy-text",
     "detail": "",
     "description": "Copy was pressed ({ variant, text }: MessageCopy); cancelable – prevented, nothing is copied here",
     "cancelable": true
    }
   ],
