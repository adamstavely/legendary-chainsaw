 "react": [
  {
   "component": "MessageDrafts",
   "exported": true,
   "props": [
    {
     "name": "title",
     "type": "string",
     "optional": true,
     "description": "The heading"
    },
    {
     "name": "variants",
     "type": "MessageVariant[]",
     "optional": true,
     "description": "The drafts – controlled when given: every edit reports the next list through onVariantsChange"
    },
    {
     "name": "defaultVariants",
     "type": "MessageVariant[]",
     "optional": true,
     "description": "The drafts on mount when `variants` isn't controlled"
    },
    {
     "name": "onVariantsChange",
     "type": "(next: MessageVariant[], id: string) => void",
     "optional": true,
     "description": "A draft was edited; `next` is the list as it will be"
    },
    {
     "name": "selected",
     "type": "string",
     "optional": true,
     "description": "The variant shown, by id – controlled when given"
    },
    {
     "name": "defaultSelected",
     "type": "string",
     "optional": true,
     "description": "The variant on mount when `selected` isn't controlled"
    },
    {
     "name": "onSelectedChange",
     "type": "(selected: string) => void",
     "optional": true,
     "description": "Another variant was picked"
    },
    {
     "name": "onSend",
     "type": "(send: MessageSend) => boolean | void",
     "optional": true,
     "description": "Send was pressed; return false to keep the draft open (to send it yourself, then set `status`)"
    },
    {
     "name": "onCopyText",
     "type": "(copy: MessageCopy) => boolean | void",
     "optional": true,
     "description": "Copy was pressed; return false to copy it yourself"
    }
   ],
   "hides": [
    "heading",
    "variants",
    "selected",
    "children"
   ],
   "events": {
    "tc-selected-change": null,
    "tc-variants-change": "onVariantsChange",
    "tc-send": "onSend",
    "tc-copy-text": "onCopyText"
   }
  }
 ],
