{
 "elements": [
  {
   "tag": "tc-text-to-speech",
   "className": "TcTextToSpeech",
   "description": "Reads a passage aloud – the sentence and word being spoken marked in the text, with play, pause, stop, sentence\nskips, a voice picker, speed and pitch.",
   "properties": [
    {
     "name": "heading",
     "attribute": "heading",
     "type": "string",
     "default": "\"Read aloud\"",
     "description": "The heading",
     "readonly": false
    },
    {
     "name": "description",
     "attribute": "description",
     "type": "string",
     "default": "\"\"",
     "description": "A quiet line under the heading – the source or what the passage is",
     "readonly": false
    },
    {
     "name": "text",
     "attribute": "text",
     "type": "string",
     "default": "\"\"",
     "description": "The passage to read: plain text; a blank line starts a new paragraph",
     "readonly": false
    },
    {
     "name": "rate",
     "attribute": "rate",
     "type": "number",
     "default": "1",
     "description": "Speaking speed from 0.5 to 2 (1 is normal). Changed by the element unless a tc-rate-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "pitch",
     "attribute": "pitch",
     "type": "number",
     "default": "1",
     "description": "Pitch from 0 to 2 (1 is normal). Changed by the element unless a tc-pitch-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "voice",
     "attribute": "voice",
     "type": "string",
     "default": "\"\"",
     "description": "The chosen voice's `voiceURI`, or \"\" for the browser's default. Changed unless a tc-voice-change listener calls preventDefault()",
     "readonly": false
    },
    {
     "name": "lang",
     "attribute": "lang",
     "type": "string",
     "default": "\"\"",
     "description": "The passage's language (a BCP 47 tag) – picks a default voice and splits sentences; unset, the browser decides",
     "readonly": false
    },
    {
     "name": "state",
     "attribute": null,
     "type": "TextToSpeechState",
     "default": null,
     "description": "Whether it's reading, paused or idle",
     "readonly": true
    },
    {
     "name": "look",
     "attribute": "look",
     "type": "Look | undefined",
     "default": "undefined",
     "description": "Visual style: \"standard\" or \"clean\"; unset follows <tc-look-provider>, else \"standard\"",
     "readonly": false
    }
   ],
   "events": [
    {
     "name": "tc-rate-change",
     "detail": "",
     "description": "The speed was changed ({ rate }: TextToSpeechRateChange); cancelable – prevented, `rate` stays as it was",
     "cancelable": true
    },
    {
     "name": "tc-pitch-change",
     "detail": "",
     "description": "The pitch was changed ({ pitch }: TextToSpeechPitchChange); cancelable – prevented, `pitch` stays",
     "cancelable": true
    },
    {
     "name": "tc-voice-change",
     "detail": "",
     "description": "A voice was picked ({ voice }: TextToSpeechVoiceChange); cancelable – prevented, `voice` stays",
     "cancelable": true
    },
    {
     "name": "tc-start",
     "detail": "",
     "description": "Reading began ({ sentence }: TextToSpeechStart)",
     "cancelable": false
    },
    {
     "name": "tc-end",
     "detail": "",
     "description": "Reading stopped, at the end or by Stop ({ completed, sentence }: TextToSpeechEnd)",
     "cancelable": false
    }
   ],
   "slots": [],
   "methods": [
    {
     "name": "play",
     "params": "from: unknown",
     "returns": "void",
     "description": "Starts reading from a sentence (0-based), or from the current one"
    },
    {
     "name": "pause",
     "params": "",
     "returns": "void",
     "description": "Pauses; Resume starts the sentence again"
    },
    {
     "name": "stop",
     "params": "",
     "returns": "void",
     "description": "Stops and goes back to the start"
    }
   ],
   "ui": "tts",
   "cssProperties": [
