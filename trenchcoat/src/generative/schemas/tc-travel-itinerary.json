{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trenchcoat/generative/schemas/tc-travel-itinerary.json",
  "title": "tc-travel-itinerary",
  "description": "Trips as legs – route, mode and carrier, document, confidence, source and grade, and flags – grouped into\njourneys headed by their route.",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string",
      "description": "The heading, and the list's name"
    },
    "description": {
      "type": "string",
      "description": "One line under the heading"
    },
    "legs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TravelLeg"
      },
      "description": "The legs, in any order – the element sorts them by date"
    },
    "flags": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "tone": {
            "$ref": "#/definitions/TravelFlagTone"
          }
        },
        "required": [
          "label",
          "tone"
        ],
        "additionalProperties": false
      },
      "description": "Flags' words and tones, merged over the defaults (no-record, cash, mismatch)"
    },
    "grouped": {
      "type": "boolean",
      "description": "Groups legs into journeys: by their `journey` id, else consecutive legs that connect within `gap-days`"
    },
    "gapDays": {
      "type": "number",
      "description": "How many days may pass between two connecting legs of one journey, when they have no journey id"
    },
    "order": {
      "type": "string",
      "enum": [
        "newest",
        "oldest"
      ],
      "description": "\"oldest\" first (the default) or \"newest\" first"
    },
    "lowConfidence": {
      "type": "number",
      "description": "Confidence below this reads as low and is drawn in warning; at or above 0.9 it reads as high"
    },
    "locale": {
      "type": "string",
      "description": "The language for dates and numbers, e.g. \"en-GB\"; by default the browser's"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "TravelLeg": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "number",
          "description": "When it departed, as epoch ms"
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/definitions/TravelPlace"
            },
            {
              "type": "string"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/definitions/TravelPlace"
            },
            {
              "type": "string"
            }
          ]
        },
        "mode": {
          "$ref": "#/definitions/TravelMode"
        },
        "carrier": {
          "type": "string",
          "description": "The flight, train or road: \"TK1814\", \"TGV 6612\", \"A40\""
        },
        "document": {
          "type": "string",
          "description": "The document it was booked or crossed on: \"Passport ••4471\""
        },
        "confidence": {
          "type": "number",
          "description": "How sure the record is, 0–1"
        },
        "source": {
          "$ref": "#/definitions/TravelSource"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Keys of `flags`, e.g. \"no-record\", \"cash\", \"mismatch\" – or the page's own"
        },
        "journey": {
          "type": "string",
          "description": "Legs with the same journey id are grouped together; without ids, consecutive connecting legs are"
        }
      },
      "required": [
        "id",
        "date",
        "from",
        "to",
        "mode"
      ],
      "additionalProperties": false
    },
    "TravelPlace": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false,
      "description": "A place: its short code (\"LYS\") and, optionally, its name (\"Lyon Saint-Exupéry\")"
    },
    "TravelMode": {
      "type": "string",
      "enum": [
        "air",
        "rail",
        "road",
        "sea",
        "other"
      ]
    },
    "TravelSource": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "description": "Where a record came from: any label, with an optional Admiralty grade"
    },
    "TravelFlagTone": {
      "type": "string",
      "enum": [
        "warning",
        "danger",
        "info"
      ]
    }
  }
}
