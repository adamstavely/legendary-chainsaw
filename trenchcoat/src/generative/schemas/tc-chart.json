{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "@adamstavely/trenchcoat/generative/schemas/tc-chart.json",
  "title": "tc-chart",
  "description": "Any chart from a JSON spec – checked first, then drawn with the chart the spec names; what's wrong is shown instead\nof a chart, and reported.",
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "data": {
          "$ref": "#/definitions/SpecData"
        },
        "encoding": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": {}
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false,
      "description": "The chart as JSON: { type, data, encoding?, options?, title?, description? }"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "SpecData": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        {
          "type": "object",
          "properties": {
            "csv": {
              "type": "string"
            }
          },
          "required": [
            "csv"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "format": {
              "type": "string",
              "enum": [
                "auto",
                "csv",
                "json"
              ]
            },
            "select": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "values"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
