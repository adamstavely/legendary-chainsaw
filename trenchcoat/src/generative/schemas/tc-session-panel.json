{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "@adamstavely/trenchcoat/generative/schemas/tc-session-panel.json",
  "title": "tc-session-panel",
  "description": "The side panel of a working session: tools, environment, context, connectors, outputs, subagents, changes and background tasks.",
  "type": "object",
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/IconRailItem"
      },
      "description": "The tool buttons at the top; without any, the rail is left out"
    },
    "tool": {
      "type": "string",
      "description": "The id of the chosen tool. Changed by the user unless a tc-selected-change listener calls preventDefault()"
    },
    "moreTools": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/IconRailMoreItem"
      },
      "description": "The rail's More menu"
    },
    "environment": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EnvironmentItem"
      },
      "description": "Where the session runs"
    },
    "toggles": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "The environment rows' switches. Changed by the user unless a tc-toggles-change listener calls preventDefault()"
    },
    "context": {
      "type": "number",
      "description": "How full the context is, from 0 to 1; without it, the row is left out"
    },
    "connectors": {
      "type": "string",
      "description": "The Connectors row's value, such as \"14 to reconnect\"; without it, the row is left out"
    },
    "outputs": {
      "type": "string",
      "description": "The Outputs row's value, such as \"51\"; without it, the row is left out"
    },
    "subagents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Subagent"
      },
      "description": "The subagents the session started; without any, the section is left out"
    },
    "subagent": {
      "type": "string",
      "description": "The id of the chosen subagent. Changed by the user unless a tc-subagent-change listener calls preventDefault()"
    },
    "now": {
      "type": "number",
      "description": "The time now for the subagents' clocks, epoch ms; by default the list's own clock, which ticks"
    },
    "changes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ChangeItem"
      },
      "description": "The changes the session has made"
    },
    "changeActions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ChangeRowAction"
      },
      "description": "The menu on each change"
    },
    "changeLimit": {
      "type": "number",
      "description": "How many changes show before Show more"
    },
    "background": {
      "type": "string",
      "description": "The Background tasks row's value, such as \"4 running\"; without it, the row is left out"
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SessionPanelSection"
      },
      "description": "The sections folded open. Changed by the user unless a tc-sections-change listener calls preventDefault()"
    },
    "labels": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "tools": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "connectors": {
          "type": "string"
        },
        "outputs": {
          "type": "string"
        },
        "subagents": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "subagentsActive": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Rename any of the words"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "IconRailItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "Names the button, and is its tooltip"
        },
        "icon": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ],
          "description": "SVG path data for a 24×24 stroked icon, or several paths"
        },
        "disabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "icon"
      ],
      "additionalProperties": false
    },
    "IconRailMoreItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "EnvironmentItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/EnvironmentKind"
        },
        "icon": {
          "type": "string",
          "description": "SVG path data for a 24×24 icon, for a custom row"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string",
          "description": "Quieter text after the label, cut off at its end when there isn't room"
        },
        "action": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "label"
          ],
          "additionalProperties": false,
          "description": "A small button at the row's end"
        },
        "toggle": {
          "type": "boolean",
          "description": "Draws a switch at the row's end, named by the label"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "additionalProperties": false
    },
    "EnvironmentKind": {
      "type": "string",
      "enum": [
        "branch",
        "computer",
        "custom",
        "folder",
        "repo"
      ]
    },
    "Subagent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "What it was asked to do, short – \"Review forms current\""
        },
        "status": {
          "$ref": "#/definitions/SubagentStatus"
        },
        "activity": {
          "type": "string",
          "description": "What it's doing now, or why it stopped – \"awaiting command message\""
        },
        "startedAt": {
          "type": "number",
          "description": "When it started, epoch ms – an active agent's clock runs from here"
        },
        "endedAt": {
          "type": "number",
          "description": "When it finished, failed or stopped, epoch ms – a done agent shows how long ago"
        },
        "mark": {
          "type": "string",
          "description": "What its mark is drawn from, when not its id – to give agents the same mark across sessions"
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ],
      "additionalProperties": false,
      "description": "One sub-agent"
    },
    "SubagentStatus": {
      "type": "string",
      "enum": [
        "done",
        "failed",
        "running",
        "stopped",
        "waiting"
      ],
      "description": "Where a sub-agent is: running and waiting are Active; done, failed and stopped are Done"
    },
    "ChangeItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "repo": {
          "type": "string",
          "description": "Where it is, such as a repository's name"
        },
        "number": {
          "type": "number",
          "description": "Its number there"
        },
        "state": {
          "$ref": "#/definitions/ChangeState"
        },
        "additions": {
          "type": "number",
          "description": "Lines added"
        },
        "deletions": {
          "type": "number",
          "description": "Lines removed"
        },
        "checks": {
          "$ref": "#/definitions/CheckCounts",
          "description": "How its checks went"
        }
      },
      "required": [
        "id",
        "title",
        "repo",
        "state"
      ],
      "additionalProperties": false
    },
    "ChangeState": {
      "type": "string",
      "enum": [
        "closed",
        "draft",
        "merged",
        "open"
      ]
    },
    "CheckCounts": {
      "type": "object",
      "properties": {
        "passing": {
          "type": "number"
        },
        "failing": {
          "type": "number"
        },
        "pending": {
          "type": "number"
        },
        "skipped": {
          "type": "number"
        }
      },
      "required": [
        "passing",
        "failing",
        "pending",
        "skipped"
      ],
      "additionalProperties": false
    },
    "ChangeRowAction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "SessionPanelSection": {
      "type": "string",
      "enum": [
        "background",
        "changes",
        "connectors",
        "context",
        "environment",
        "outputs",
        "subagents"
      ]
    }
  }
}
