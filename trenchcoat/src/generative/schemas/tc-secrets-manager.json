{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "@adamstavely/trenchcoat/generative/schemas/tc-secrets-manager.json",
  "title": "tc-secrets-manager",
  "description": "Write-only secrets for agents – missing ones first with the agents that need them, set and replace without ever\nshowing a value, delete that names what will break, and new secrets by UPPER_SNAKE name.",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string",
      "description": "The heading; by default \"Secrets\""
    },
    "description": {
      "type": "string",
      "description": "A line under the heading, such as whose secrets these are"
    },
    "secrets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Secret"
      },
      "description": "The secrets – names, scopes and status, never values. Changed by the user unless tc-secrets-change is prevented"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The scopes a new secret can have; the first is the default"
    },
    "creatable": {
      "type": "boolean",
      "description": "Offer Add secret"
    },
    "now": {
      "type": "number",
      "description": "\"Now\" for an update's date, epoch ms; without it a fresh update says \"Updated just now\". The element doesn't read the clock"
    },
    "currentUser": {
      "type": "string",
      "description": "Who's making changes – recorded as `updatedBy`"
    },
    "locale": {
      "type": "string",
      "description": "The locale for dates"
    },
    "labels": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string"
        },
        "count": {
          "type": "string"
        },
        "missingGroup": {
          "type": "string"
        },
        "savedGroup": {
          "type": "string"
        },
        "set": {
          "type": "string"
        },
        "missing": {
          "type": "string"
        },
        "expiring": {
          "type": "string"
        },
        "expired": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "updated": {
          "type": "string"
        },
        "updatedOn": {
          "type": "string"
        },
        "expires": {
          "type": "string"
        },
        "expiredOn": {
          "type": "string"
        },
        "usedBy": {
          "type": "string"
        },
        "neededBy": {
          "type": "string"
        },
        "notUsed": {
          "type": "string"
        },
        "setNow": {
          "type": "string"
        },
        "justSet": {
          "type": "string"
        },
        "setValue": {
          "type": "string"
        },
        "replace": {
          "type": "string"
        },
        "delete": {
          "type": "string"
        },
        "valueOf": {
          "type": "string"
        },
        "save": {
          "type": "string"
        },
        "cancel": {
          "type": "string"
        },
        "keep": {
          "type": "string"
        },
        "confirm": {
          "type": "string"
        },
        "confirmUnused": {
          "type": "string"
        },
        "add": {
          "type": "string"
        },
        "addTitle": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nameHint": {
          "type": "string"
        },
        "nameInvalid": {
          "type": "string"
        },
        "nameTaken": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "empty": {
          "type": "string"
        },
        "announceSet": {
          "type": "string"
        },
        "announceAdded": {
          "type": "string"
        },
        "announceDeleted": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Rename any of the words"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Secret": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "UPPER_SNAKE_CASE, e.g. VENDOR_API_KEY"
        },
        "scope": {
          "type": "string",
          "description": "\"Workspace\", or the agent it belongs to"
        },
        "status": {
          "$ref": "#/definitions/SecretStatus"
        },
        "updatedAt": {
          "type": "number",
          "description": "Epoch ms"
        },
        "updatedBy": {
          "type": "string"
        },
        "expiresAt": {
          "type": "number",
          "description": "Epoch ms, for expiring and expired secrets"
        },
        "usedBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The agents that use it – or, when it's missing, need it"
        }
      },
      "required": [
        "name",
        "scope",
        "status"
      ],
      "additionalProperties": false
    },
    "SecretStatus": {
      "type": "string",
      "enum": [
        "expired",
        "expiring",
        "missing",
        "set"
      ]
    }
  }
}
