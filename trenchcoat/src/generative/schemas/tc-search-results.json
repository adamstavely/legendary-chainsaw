{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trenchcoat/generative/schemas/tc-search-results.json",
  "title": "tc-search-results",
  "description": "Results of a search across files: grouped by file, each matching line with the match marked, with a field to search again and optional replace.",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string",
      "description": "The heading; empty leaves the header out"
    },
    "description": {
      "type": "string",
      "description": "Small text under the heading – where it searched"
    },
    "query": {
      "type": "string",
      "description": "The text that was searched for"
    },
    "options": {
      "type": "object",
      "properties": {
        "caseSensitive": {
          "type": "boolean"
        },
        "wholeWord": {
          "type": "boolean"
        },
        "regex": {
          "type": "boolean"
        }
      },
      "required": [
        "caseSensitive",
        "wholeWord",
        "regex"
      ],
      "additionalProperties": false,
      "description": "Match case, whole word and regular expression"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SearchResultsFile"
      },
      "description": "The files that matched, each with its matching lines"
    },
    "status": {
      "type": "string",
      "enum": [
        "idle",
        "error",
        "done",
        "searching"
      ],
      "description": "idle, searching, done or error"
    },
    "error": {
      "type": "string",
      "description": "What went wrong, with status \"error\""
    },
    "truncated": {
      "type": "boolean",
      "description": "The page stopped before finding everything"
    },
    "expanded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The open files' paths; null opens them all"
    },
    "selected": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "number"
        }
      },
      "required": [
        "path",
        "line"
      ],
      "additionalProperties": false,
      "description": "The chosen match"
    },
    "replaceable": {
      "type": "boolean",
      "description": "Shows a replace field, with Replace and Replace all"
    },
    "replacement": {
      "type": "string",
      "description": "The replace field's text"
    },
    "hideField": {
      "type": "boolean",
      "description": "Leaves out the search field, for a page that has its own"
    },
    "maxHeight": {
      "type": "number",
      "description": "Height in px at which the results scroll"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SearchResultsActionItem"
      },
      "description": "Buttons in the header, before Collapse all"
    },
    "labels": {
      "type": "object",
      "properties": {
        "search": {
          "type": "string"
        },
        "replace": {
          "type": "string"
        },
        "caseSensitive": {
          "type": "string"
        },
        "wholeWord": {
          "type": "string"
        },
        "regex": {
          "type": "string"
        },
        "replaceOne": {
          "type": "string"
        },
        "replaceAll": {
          "type": "string"
        },
        "collapseAll": {
          "type": "string"
        },
        "expandAll": {
          "type": "string"
        },
        "searching": {
          "type": "string"
        },
        "idle": {
          "type": "string"
        },
        "noResults": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "truncated": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "results": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "files": {
          "type": "string"
        },
        "line": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Renames the words it uses"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "SearchResultsFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SearchResultsMatch"
          }
        }
      },
      "required": [
        "path",
        "matches"
      ],
      "additionalProperties": false
    },
    "SearchResultsMatch": {
      "type": "object",
      "properties": {
        "line": {
          "type": "number",
          "description": "1-based line number"
        },
        "column": {
          "type": "number",
          "description": "1-based column of the first match, when known"
        },
        "text": {
          "type": "string",
          "description": "The line's text"
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Where the matches are in `text`, as [start, end) offsets. Required for regex highlighting; literal queries are matched locally when omitted."
        }
      },
      "required": [
        "line",
        "text"
      ],
      "additionalProperties": false
    },
    "SearchResultsActionItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "pressed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "icon"
      ],
      "additionalProperties": false
    }
  }
}
