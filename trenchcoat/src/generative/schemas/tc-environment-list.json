{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trenchcoat/generative/schemas/tc-environment-list.json",
  "title": "tc-environment-list",
  "description": "Where a session runs, as rows of machine, folders, repository and branch, each with an optional small action or a switch.",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string",
      "description": "The heading; empty draws no header"
    },
    "description": {
      "type": "string",
      "description": "One line under the heading"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/EnvironmentItem"
      },
      "description": "The rows, in order"
    },
    "toggles": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "The switches' values by row id. Changed by the user unless a tc-toggles-change listener calls preventDefault()"
    },
    "bare": {
      "type": "boolean",
      "description": "Drops the tray and card"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "EnvironmentItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/EnvironmentKind"
        },
        "icon": {
          "type": "string",
          "description": "SVG path data for a 24×24 icon, for a custom row"
        },
        "label": {
          "type": "string"
        },
        "detail": {
          "type": "string",
          "description": "Quieter text after the label, cut off at its end when there isn't room"
        },
        "action": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "label"
          ],
          "additionalProperties": false,
          "description": "A small button at the row's end"
        },
        "toggle": {
          "type": "boolean",
          "description": "Draws a switch at the row's end, named by the label"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "additionalProperties": false
    },
    "EnvironmentKind": {
      "type": "string",
      "enum": [
        "computer",
        "folder",
        "repo",
        "branch",
        "custom"
      ]
    }
  }
}
