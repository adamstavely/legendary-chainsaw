{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trenchcoat/generative/schemas/tc-candlestick-chart.json",
  "title": "tc-candlestick-chart",
  "description": "A reading's open, high, low and close per period as candles – hollow when it rose, solid when it fell – with moving\naverages, volume, the latest close tagged on the axis, and a table view.",
  "type": "object",
  "properties": {
    "x": {
      "type": "string",
      "description": "The period field – dates (ISO strings or epoch ms) or labels; by default \"date\""
    },
    "open": {
      "type": "string",
      "description": "The opening value field; by default \"open\" (missing: the previous close)"
    },
    "high": {
      "type": "string",
      "description": "The high field; by default \"high\""
    },
    "low": {
      "type": "string",
      "description": "The low field; by default \"low\""
    },
    "close": {
      "type": "string",
      "description": "The closing value field; by default \"close\" (rows without one are left out)"
    },
    "volume": {
      "type": "string",
      "description": "A volume field, drawn as a strip of bars under the candles"
    },
    "ma": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Moving averages of the close to draw, in periods, e.g. [5, 20]; up to three"
    },
    "maxCandles": {
      "type": "number",
      "description": "Merges neighbouring periods above this many candles; by default a candle per 4px of plot"
    },
    "yDomain": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Fixes the value axis to [min, max]"
    },
    "candleLabels": {
      "type": "object",
      "properties": {
        "open": {
          "type": "string"
        },
        "high": {
          "type": "string"
        },
        "low": {
          "type": "string"
        },
        "close": {
          "type": "string"
        },
        "change": {
          "type": "string"
        },
        "volume": {
          "type": "string"
        },
        "up": {
          "type": "string"
        },
        "down": {
          "type": "string"
        },
        "ma": {
          "type": "string"
        },
        "maLegend": {
          "type": "string"
        },
        "ohlc": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "The candlestick chart's own words, merged over defaultCandlestickLabels"
    },
    "brush": {
      "type": "string",
      "enum": [
        "none",
        "select",
        "zoom"
      ],
      "description": "Dragging across the candles (or Shift+arrows, then Enter) picks a range: \"select\" shows its change, high and low; \"zoom\" narrows the chart to it"
    },
    "heading": {
      "type": "string",
      "description": "The heading, and the chart's name"
    },
    "description": {
      "type": "string",
      "description": "One line under the heading"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Row"
      },
      "description": "The rows to draw"
    },
    "highlight": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      ],
      "description": "What to emphasise: an index, a label, a list of them, \"max\", \"min\", \"first\", \"last\", \"none\", or a test"
    },
    "format": {
      "anyOf": [
        {
          "$ref": "#/definitions/FormatName"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "suffix": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "localeMatcher": {
              "type": "string",
              "enum": [
                "best fit",
                "lookup"
              ]
            },
            "style": {
              "$ref": "#/definitions/Intl.NumberFormatOptionsStyle"
            },
            "currency": {
              "type": "string"
            },
            "currencyDisplay": {
              "$ref": "#/definitions/Intl.NumberFormatOptionsCurrencyDisplay"
            },
            "useGrouping": {
              "$ref": "#/definitions/Intl.NumberFormatOptionsUseGrouping"
            },
            "minimumIntegerDigits": {
              "type": "number"
            },
            "minimumFractionDigits": {
              "type": "number"
            },
            "maximumFractionDigits": {
              "type": "number"
            },
            "minimumSignificantDigits": {
              "type": "number"
            },
            "maximumSignificantDigits": {
              "type": "number"
            }
          }
        }
      ],
      "description": "How values are written: \"number\", \"integer\", \"percent\", \"compact\", \"currency\", Intl options, or a function"
    },
    "unit": {
      "type": "string",
      "description": "The unit after each value: \"%\", \"ms\", \" runs\""
    },
    "locale": {
      "type": "string",
      "description": "The language for numbers and dates, e.g. \"de\"; by default the browser's"
    },
    "height": {
      "type": "number",
      "description": "The plot's height in px; by default the chart's own for its width"
    },
    "still": {
      "type": "boolean",
      "description": "Draws everything at once: no entrance and no transitions"
    },
    "easing": {
      "type": "string",
      "enum": [
        "easeInOut",
        "easeOut",
        "linear",
        "spring"
      ],
      "description": "How marks move: \"spring\", \"easeOut\", \"easeInOut\" or \"linear\""
    },
    "duration": {
      "type": "number",
      "description": "How long a move takes, in ms; by default the chart's own"
    },
    "hideLabels": {
      "type": "boolean",
      "description": "Leaves the values off the marks"
    },
    "hideTooltip": {
      "type": "boolean",
      "description": "No tooltip on hover or focus"
    },
    "bare": {
      "type": "boolean",
      "description": "No card: just the plot, for a chart inside another component"
    },
    "view": {
      "type": "string",
      "enum": [
        "chart",
        "table"
      ],
      "description": "The chart or the same numbers as a table. Changed by the Table button unless a tc-view-change listener calls preventDefault()"
    },
    "labels": {
      "type": "object",
      "properties": {
        "table": {
          "type": "string"
        },
        "empty": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "share": {
          "type": "string"
        },
        "chart": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "more": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "The words it shows and says, merged over defaultChartLabels"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Row": {
      "type": "object",
      "additionalProperties": {}
    },
    "FormatName": {
      "type": "string",
      "enum": [
        "compact",
        "currency",
        "decimal",
        "integer",
        "number",
        "percent",
        "ratio"
      ],
      "description": "Number and date formats, through Intl; the default locale is en-US"
    },
    "Intl.NumberFormatOptionsStyle": {},
    "Intl.NumberFormatOptionsCurrencyDisplay": {},
    "Intl.NumberFormatOptionsUseGrouping": {
      "type": "boolean"
    }
  }
}
