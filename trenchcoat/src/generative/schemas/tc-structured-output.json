{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trenchcoat/generative/schemas/tc-structured-output.json",
  "title": "tc-structured-output",
  "description": "Streaming JSON as a collapsible, typed tree, checked against a JSON Schema as it arrives.",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "The JSON as it arrives – it may grow every frame and stop mid-value. A ```json fence around it is ignored"
    },
    "schema": {
      "type": "object",
      "properties": {
        "type": {
          "anyOf": [
            {
              "$ref": "#/definitions/StructuredOutputType"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/StructuredOutputType"
              }
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/StructuredOutputSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/definitions/StructuredOutputSchema"
        },
        "enum": {
          "type": "array",
          "items": {}
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "type": "number"
        },
        "exclusiveMaximum": {
          "type": "number"
        },
        "minLength": {
          "type": "number"
        },
        "maxLength": {
          "type": "number"
        },
        "pattern": {
          "type": "string"
        },
        "minItems": {
          "type": "number"
        },
        "maxItems": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "description": "A JSON Schema to check the value against as it arrives (the common keywords – see the docs); unset checks syntax only"
    },
    "streaming": {
      "type": "boolean",
      "description": "The text is still coming in: a caret blinks at the end, and what hasn't arrived isn't flagged yet"
    },
    "heading": {
      "type": "string",
      "description": "The heading, and the tree's accessible name"
    },
    "collapsed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "JSON Pointer paths of folded branches (\"/items/0\"). Changed by the user unless tc-collapsed-change is prevented"
    },
    "variableName": {
      "type": "string",
      "description": "The variable name in \"Copy as TypeScript\": `const output = { … };`"
    },
    "maxHeight": {
      "type": "number",
      "description": "Cap the tree's height in px (0: grow with the value); a capped tree scrolls and follows the end while streaming"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "StructuredOutputType": {
      "type": "string",
      "enum": [
        "object",
        "array",
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ],
      "description": "A JSON Schema type name"
    },
    "StructuredOutputSchema": {
      "type": "object",
      "properties": {
        "type": {
          "anyOf": [
            {
              "$ref": "#/definitions/StructuredOutputType"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/StructuredOutputType"
              }
            }
          ]
        },
        "title": {
          "type": "string",
          "description": "Shown as the field's tooltip"
        },
        "description": {
          "type": "string",
          "description": "Shown as the field's tooltip (after the title)"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/StructuredOutputSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "boolean",
          "description": "false flags fields the schema doesn't name"
        },
        "items": {
          "$ref": "#/definitions/StructuredOutputSchema",
          "description": "One schema for every item of a list"
        },
        "enum": {
          "type": "array",
          "items": {}
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "type": "number"
        },
        "exclusiveMaximum": {
          "type": "number"
        },
        "minLength": {
          "type": "number"
        },
        "maxLength": {
          "type": "number"
        },
        "pattern": {
          "type": "string"
        },
        "minItems": {
          "type": "number"
        },
        "maxItems": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "description": "The JSON Schema keywords the element checks; others are ignored"
    }
  }
}
