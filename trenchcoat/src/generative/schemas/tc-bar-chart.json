{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trenchcoat/generative/schemas/tc-bar-chart.json",
  "title": "tc-bar-chart",
  "description": "Values by category as bars – grouped, stacked or stacked to 100%, upright or lying down – with the highest one\nemphasised, values at the bars' ends and a table view.",
  "type": "object",
  "properties": {
    "x": {
      "type": "string",
      "description": "The category field (also for lying-down bars); by default \"x\""
    },
    "y": {
      "anyOf": [
        {
          "$ref": "#/definitions/Accessor%3CRow%2Cnumber%3E"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "The value field; a list of fields draws each as a series (a wide table); by default \"y\""
    },
    "series": {
      "type": "string",
      "description": "The series field, for a long table with one row per category and series"
    },
    "layout": {
      "type": "string",
      "enum": [
        "grouped",
        "percent",
        "stacked"
      ],
      "description": "Several series side by side (\"grouped\"), on top of each other (\"stacked\") or stacked to 100% (\"percent\")"
    },
    "orientation": {
      "type": "string",
      "enum": [
        "horizontal",
        "vertical"
      ],
      "description": "Upright bars (\"vertical\") or lying down (\"horizontal\")"
    },
    "sort": {
      "type": "boolean",
      "description": "Orders one series' bars from the largest"
    },
    "heading": {
      "type": "string",
      "description": "The heading, and the chart's name"
    },
    "description": {
      "type": "string",
      "description": "One line under the heading"
    },
    "data": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Row"
      },
      "description": "The rows to draw"
    },
    "highlight": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "description": "What to emphasise: an index, a label, a list of them, \"max\", \"min\", \"first\", \"last\", \"none\", or a test"
    },
    "format": {
      "anyOf": [
        {
          "$ref": "#/definitions/FormatName"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "suffix": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "localeMatcher": {
              "type": "string",
              "enum": [
                "best fit",
                "lookup"
              ]
            },
            "style": {
              "$ref": "#/definitions/Intl.NumberFormatOptionsStyle"
            },
            "currency": {
              "type": "string"
            },
            "currencyDisplay": {
              "$ref": "#/definitions/Intl.NumberFormatOptionsCurrencyDisplay"
            },
            "useGrouping": {
              "$ref": "#/definitions/Intl.NumberFormatOptionsUseGrouping"
            },
            "minimumIntegerDigits": {
              "type": "number"
            },
            "minimumFractionDigits": {
              "type": "number"
            },
            "maximumFractionDigits": {
              "type": "number"
            },
            "minimumSignificantDigits": {
              "type": "number"
            },
            "maximumSignificantDigits": {
              "type": "number"
            }
          }
        }
      ],
      "description": "How values are written: \"number\", \"integer\", \"percent\", \"compact\", \"currency\", Intl options, or a function"
    },
    "unit": {
      "type": "string",
      "description": "The unit after each value: \"%\", \"ms\", \" runs\""
    },
    "locale": {
      "type": "string",
      "description": "The language for numbers and dates, e.g. \"de\"; by default the browser's"
    },
    "height": {
      "type": "number",
      "description": "The plot's height in px; by default the chart's own for its width"
    },
    "still": {
      "type": "boolean",
      "description": "Draws everything at once: no entrance and no transitions"
    },
    "easing": {
      "type": "string",
      "enum": [
        "easeInOut",
        "easeOut",
        "linear",
        "spring"
      ],
      "description": "How marks move: \"spring\", \"easeOut\", \"easeInOut\" or \"linear\""
    },
    "duration": {
      "type": "number",
      "description": "How long a move takes, in ms; by default the chart's own"
    },
    "hideLabels": {
      "type": "boolean",
      "description": "Leaves the values off the marks"
    },
    "hideTooltip": {
      "type": "boolean",
      "description": "No tooltip on hover or focus"
    },
    "bare": {
      "type": "boolean",
      "description": "No card: just the plot, for a chart inside another component"
    },
    "view": {
      "type": "string",
      "enum": [
        "chart",
        "table"
      ],
      "description": "The chart or the same numbers as a table. Changed by the Table button unless a tc-view-change listener calls preventDefault()"
    },
    "labels": {
      "type": "object",
      "properties": {
        "table": {
          "type": "string"
        },
        "empty": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "share": {
          "type": "string"
        },
        "chart": {
          "type": "string"
        },
        "position": {
          "type": "string"
        },
        "more": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "The words it shows and says, merged over defaultChartLabels"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Accessor<Row,number>": {
      "type": "string",
      "description": "A field name (dot paths allowed) or a function"
    },
    "Row": {
      "type": "object",
      "additionalProperties": {}
    },
    "FormatName": {
      "type": "string",
      "enum": [
        "compact",
        "currency",
        "decimal",
        "integer",
        "number",
        "percent",
        "ratio"
      ],
      "description": "Number and date formats, through Intl; the default locale is en-US"
    },
    "Intl.NumberFormatOptionsStyle": {},
    "Intl.NumberFormatOptionsCurrencyDisplay": {},
    "Intl.NumberFormatOptionsUseGrouping": {
      "type": "boolean"
    }
  }
}
