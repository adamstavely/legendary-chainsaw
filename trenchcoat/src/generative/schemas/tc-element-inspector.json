{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trenchcoat/generative/schemas/tc-element-inspector.json",
  "title": "tc-element-inspector",
  "description": "A page's elements as a tree beside the chosen element's box model and styles.",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string",
      "description": "The heading; empty leaves the header out"
    },
    "description": {
      "type": "string",
      "description": "Small text under the heading – the page's address"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/InspectorNode"
      },
      "description": "The top of the tree, usually one <html> or <body> node"
    },
    "selected": {
      "type": "string",
      "description": "The chosen element's id, or null"
    },
    "expanded": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The ids of the open elements"
    },
    "details": {
      "type": "object",
      "properties": {
        "box": {
          "$ref": "#/definitions/InspectorBox"
        },
        "styles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InspectorStyle"
          }
        }
      },
      "additionalProperties": false,
      "description": "The chosen element's box model and styles, from the page"
    },
    "maxHeight": {
      "type": "number",
      "description": "Height in px at which the tree and the details scroll"
    },
    "labels": {
      "type": "object",
      "properties": {
        "tree": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "empty": {
          "type": "string"
        },
        "noElements": {
          "type": "string"
        },
        "noStyles": {
          "type": "string"
        },
        "loading": {
          "type": "string"
        },
        "boxModel": {
          "type": "string"
        },
        "styles": {
          "type": "string"
        },
        "margin": {
          "type": "string"
        },
        "border": {
          "type": "string"
        },
        "padding": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "keys": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Renames the words it uses"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "InspectorNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique in the tree: what `selected`, `expanded` and the events hold"
        },
        "tag": {
          "type": "string",
          "description": "The tag name, such as \"div\""
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Its attributes; `id` and `class` show first, in that order"
        },
        "text": {
          "type": "string",
          "description": "A short text inside it"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InspectorNode"
          }
        }
      },
      "required": [
        "id",
        "tag"
      ],
      "additionalProperties": false
    },
    "InspectorBox": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "margin": {
          "$ref": "#/definitions/InspectorEdges"
        },
        "border": {
          "$ref": "#/definitions/InspectorEdges"
        },
        "padding": {
          "$ref": "#/definitions/InspectorEdges"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "InspectorEdges": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "Top, right, bottom, left, in px"
    },
    "InspectorStyle": {
      "type": "object",
      "properties": {
        "property": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "property",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
