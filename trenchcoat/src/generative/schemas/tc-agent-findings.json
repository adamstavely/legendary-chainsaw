{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trenchcoat/generative/schemas/tc-agent-findings.json",
  "title": "tc-agent-findings",
  "description": "A group of agents checking something: one row per agent, beside a feed of what they've found.",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string",
      "description": "The heading"
    },
    "description": {
      "type": "string",
      "description": "A line under the heading"
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AgentFindingsAgent"
      },
      "description": "The agents doing the checking"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AgentFinding"
      },
      "description": "What they've found, in any order: findings with `at` show newest first"
    },
    "selected": {
      "type": "string",
      "description": "The open finding's id, or null. Changed by the user unless a tc-selected-change listener calls preventDefault()"
    },
    "agentFilter": {
      "type": "string",
      "description": "The agent id the feed shows, or \"all\". Changed by the user unless a tc-agent-filter-change listener calls preventDefault()"
    },
    "severityFilter": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "$ref": "#/definitions/AgentFindingSeverity"
        }
      ],
      "description": "The severity the feed shows, or \"all\". Changed by the user unless a tc-severity-filter-change listener calls preventDefault()"
    },
    "locale": {
      "type": "string",
      "description": "The locale for times"
    },
    "layout": {
      "type": "string",
      "enum": [
        "columns",
        "stacked"
      ],
      "description": "How the agents and feed sit: \"columns\", side by side, or \"stacked\", agents above the feed"
    },
    "now": {
      "type": "number",
      "description": "\"Now\", epoch ms: when given, findings say how long ago, such as \"5 sec. ago\". The element doesn't read the clock"
    },
    "labels": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "string"
        },
        "findings": {
          "type": "string"
        },
        "queued": {
          "type": "string"
        },
        "running": {
          "type": "string"
        },
        "done": {
          "type": "string"
        },
        "failed": {
          "type": "string"
        },
        "info": {
          "type": "string"
        },
        "low": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "high": {
          "type": "string"
        },
        "critical": {
          "type": "string"
        },
        "allAgents": {
          "type": "string"
        },
        "allSeverities": {
          "type": "string"
        },
        "filterAgent": {
          "type": "string"
        },
        "filterSeverity": {
          "type": "string"
        },
        "count": {
          "type": "string"
        },
        "countOne": {
          "type": "string"
        },
        "progress": {
          "type": "string"
        },
        "empty": {
          "type": "string"
        },
        "noMatch": {
          "type": "string"
        },
        "newOne": {
          "type": "string"
        },
        "newMany": {
          "type": "string"
        },
        "checks": {
          "type": "string"
        },
        "fraction": {
          "type": "string"
        },
        "severityCount": {
          "type": "string"
        },
        "totals": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Rename any of the words"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "AgentFindingsAgent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/AgentFindingsStatus"
        },
        "progress": {
          "type": "number",
          "description": "How far along, 0 to 1"
        },
        "checked": {
          "type": [
            "number",
            "string"
          ],
          "description": "What it's checked so far: a number, with `total`, or in words: \"412 of 900 records\""
        },
        "total": {
          "type": "number",
          "description": "How many checks it has to do"
        },
        "activity": {
          "type": "string",
          "description": "What it's doing now"
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ],
      "additionalProperties": false
    },
    "AgentFindingsStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ]
    },
    "AgentFinding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "agent": {
          "type": "string",
          "description": "The id of the agent that found it"
        },
        "severity": {
          "$ref": "#/definitions/AgentFindingSeverity"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string",
          "description": "More about it, shown when it's opened"
        },
        "at": {
          "type": "number",
          "description": "When it was found, epoch ms"
        },
        "location": {
          "type": "string",
          "description": "Where it is, such as a file and line"
        }
      },
      "required": [
        "id",
        "agent",
        "severity",
        "title"
      ],
      "additionalProperties": false
    },
    "AgentFindingSeverity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
