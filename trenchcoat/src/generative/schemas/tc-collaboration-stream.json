{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "@adamstavely/trenchcoat/generative/schemas/tc-collaboration-stream.json",
  "title": "tc-collaboration-stream",
  "description": "What agents say to each other in a run: a quiet chat with who-to-whom, files, details and a composer.",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string",
      "description": "The heading"
    },
    "description": {
      "type": "string",
      "description": "One line under the heading, e.g. the run's goal"
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CollabParticipant"
      },
      "description": "Everyone in the run – people and agents"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CollabMessage"
      },
      "description": "The messages, oldest first"
    },
    "filter": {
      "type": "string",
      "description": "The tab on show: \"everyone\", \"you\", or an agent's id. Changed by the tabs unless tc-filter-change is prevented"
    },
    "you": {
      "type": "string",
      "description": "The id of the person reading – their messages read \"You\", and questions to them get an answer box"
    },
    "locale": {
      "type": "string",
      "description": "Locale for times"
    },
    "timeZone": {
      "type": "string",
      "description": "Time zone for times, e.g. \"Europe/Berlin\" – defaults to the reader's"
    },
    "hideComposer": {
      "type": "boolean",
      "description": "Hides the composer – a read-only stream"
    },
    "labels": {
      "type": "object",
      "properties": {
        "everyone": {
          "type": "string"
        },
        "you": {
          "type": "string"
        },
        "needsYou": {
          "type": "string"
        },
        "answered": {
          "type": "string"
        },
        "live": {
          "type": "string"
        },
        "writing": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "newMessages": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "send": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Words the page can rename, merged over defaultCollabLabels"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CollabParticipant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "person"
          ],
          "description": "A person or an agent – people get round avatars, agents square ones"
        },
        "model": {
          "type": "string",
          "description": "The agent's model, e.g. \"Sonnet 5.5\""
        },
        "initials": {
          "type": "string",
          "description": "The initials to show when there's no avatar – defaults to the name's"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "CollabMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "description": "A participant's id"
        },
        "to": {
          "type": "string",
          "description": "A participant's id, or \"everyone\""
        },
        "at": {
          "type": "number",
          "description": "When it was sent, in epoch ms"
        },
        "text": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/CollabMessageKind",
          "description": "\"handoff\" and \"event\" are slim rows; \"question\" to you is tagged \"Needs you\" and gets an answer box"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CollabFile"
          }
        },
        "details": {
          "$ref": "#/definitions/CollabDetails"
        },
        "streaming": {
          "type": "boolean",
          "description": "Still being written: a caret after the text"
        },
        "answered": {
          "type": "boolean",
          "description": "A question that's been answered – the answer box goes"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "at",
        "text"
      ],
      "additionalProperties": false
    },
    "CollabMessageKind": {
      "type": "string",
      "enum": [
        "event",
        "handoff",
        "message",
        "question"
      ]
    },
    "CollabFile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "preview": {
          "type": "string",
          "description": "What the preview shows: text (kept as written, in a monospace block) or an element (cloned)"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "CollabDetails": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "tokens": {
          "type": "number"
        },
        "cost": {
          "type": "number",
          "description": "In the currency `formatCost` writes"
        },
        "ms": {
          "type": "number",
          "description": "How long the message took, in ms"
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CollabTool"
          }
        }
      },
      "additionalProperties": false
    },
    "CollabTool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The tool's name, e.g. \"web_search\""
        },
        "summary": {
          "type": "string",
          "description": "What the call did, e.g. \"6 searches – station records 2016–2025\""
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CollabToolResult"
          }
        }
      },
      "required": [
        "name",
        "summary"
      ],
      "additionalProperties": false
    },
    "CollabToolResult": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "format": "uri-reference"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  }
}
