{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "@adamstavely/trenchcoat/generative/schemas/tc-flow-builder.json",
  "title": "tc-flow-builder",
  "description": "An automation built in place as a top-down flow – + on every line, If / else paths, undo, and a test run that lights\nthe working step.",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string",
      "description": "The heading"
    },
    "description": {
      "type": "string",
      "description": "One line under the heading"
    },
    "trigger": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/WorkflowKind"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "description": "What starts the flow, shown at the top"
    },
    "flow": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FlowStep"
      },
      "description": "The steps, in order, with If / else paths inside. Changed by the user unless a tc-flow-change listener calls preventDefault()"
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FlowStepOption"
      },
      "description": "The steps the + menu offers"
    },
    "kinds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "icon": {
            "$ref": "#/definitions/TemplateResult"
          }
        },
        "additionalProperties": false
      },
      "description": "Labels and icons for kinds, merged over the defaults"
    },
    "statuses": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/WorkflowStatus"
      },
      "description": "Each step's state in a test run, by step id – a light runs into the one that's \"running\""
    },
    "statusLabels": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "string"
        },
        "done": {
          "type": "string"
        },
        "idle": {
          "type": "string"
        },
        "running": {
          "type": "string"
        },
        "skipped": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "The status words, merged over the defaults"
    },
    "readonly": {
      "type": "boolean",
      "description": "Leaves out the editing controls: no +, renaming, moving or removing"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "WorkflowKind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "approval",
            "condition",
            "llm",
            "output",
            "tool",
            "trigger"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "FlowStep": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/WorkflowKind",
          "description": "Sets the icon: llm, output, wait, condition, approval, tool, or the page's own"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string",
          "description": "One quiet line under the title"
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowBranch"
          },
          "description": "An If / else's named paths, side by side; each is a column of steps of its own"
        }
      },
      "required": [
        "id",
        "kind",
        "title"
      ],
      "additionalProperties": false
    },
    "FlowBranch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FlowStep"
          }
        }
      },
      "required": [
        "id",
        "label",
        "steps"
      ],
      "additionalProperties": false
    },
    "FlowStepOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/WorkflowKind"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "One line on what it does"
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "For a step that forks: its paths' names, e.g. [\"If\", \"Else\"]"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "additionalProperties": false,
      "description": "A step the + menu offers"
    },
    "TemplateResult": {
      "$ref": "#/definitions/UncompiledTemplateResult%3Calias-1%3E",
      "description": "The return type of the template tag functions,  {@linkcode  html }  and  {@linkcode  svg } .\n\nA `TemplateResult` object holds all the information about a template expression required to render it: the template strings, expression values, and type of template (html or svg).\n\n`TemplateResult` objects do not create any DOM on their own. To create or update DOM you need to render the `TemplateResult`. See [Rendering](https://lit.dev/docs/components/rendering) for more information.\n\nIn Lit 4, this type will be an alias of MaybeCompiledTemplateResult, so that code will get type errors if it assumes that Lit templates are not compiled. When deliberately working with only one, use either  {@linkcode  CompiledTemplateResult }  or  {@linkcode  UncompiledTemplateResult }  explicitly."
    },
    "UncompiledTemplateResult<alias-1>": {
      "type": "object",
      "properties": {
        "_$litType$": {
          "type": "number",
          "enum": [
            1,
            2,
            3
          ]
        },
        "strings": {
          "type": "object",
          "properties": {
            "length": {
              "type": "number"
            },
            "raw": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "length",
            "raw"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "values": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "_$litType$",
        "strings",
        "values"
      ],
      "additionalProperties": false,
      "description": "The return type of the template tag functions,  {@linkcode  html }  and  {@linkcode  svg }  when it hasn't been compiled by"
    },
    "WorkflowStatus": {
      "type": "string",
      "enum": [
        "done",
        "failed",
        "idle",
        "running",
        "skipped"
      ]
    }
  }
}
