{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trenchcoat/generative/schemas/tc-case-review.json",
  "title": "tc-case-review",
  "description": "One case ready for a person to decide: the evidence, the timeline, the assistant's suggestion and the decision.",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string",
      "description": "The case's title"
    },
    "subject": {
      "type": "string",
      "description": "Who or what it's about"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "How serious it is, always shown in words"
    },
    "read": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggestion": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false,
      "description": "The assistant's read of the case"
    },
    "assistantName": {
      "type": "string",
      "description": "The assistant's name"
    },
    "assistantFace": {
      "type": "boolean",
      "description": "Show the assistant's animated face"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FactSection"
      },
      "description": "The evidence"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TimelineEvent"
      },
      "description": "What happened"
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TimelineCategory"
      },
      "description": "The timeline's categories"
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CaseOption"
      },
      "description": "The outcomes to choose from"
    },
    "decision": {
      "type": "object",
      "properties": {
        "option": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "option",
        "note"
      ],
      "additionalProperties": false,
      "description": "The decision on record. Changed by the user unless a tc-decision-change listener calls preventDefault()"
    },
    "locale": {
      "type": "string",
      "description": "The locale for dates"
    },
    "labels": {
      "type": "object",
      "properties": {
        "severity": {
          "type": "object",
          "properties": {
            "low": {
              "type": "string"
            },
            "medium": {
              "type": "string"
            },
            "high": {
              "type": "string"
            },
            "critical": {
              "type": "string"
            }
          },
          "required": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "additionalProperties": false
        },
        "readHeading": {
          "type": "string"
        },
        "advisory": {
          "type": "string"
        },
        "suggests": {
          "type": "string"
        },
        "suggested": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "notePlaceholder": {
          "type": "string"
        },
        "submit": {
          "type": "string"
        },
        "needsChoice": {
          "type": "string"
        },
        "needsNote": {
          "type": "string"
        },
        "decided": {
          "type": "string"
        },
        "change": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Rename any of the words"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "FactSection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Fact"
          }
        }
      },
      "required": [
        "id",
        "title",
        "facts"
      ],
      "additionalProperties": false
    },
    "Fact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "The value – a string, or several; empty or missing reads `missingLabel`"
        },
        "source": {
          "$ref": "#/definitions/FactSource"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FactReading"
          },
          "description": "Other readings that disagree with `value` – the fact then shows as conflicting"
        },
        "copyable": {
          "type": "boolean",
          "description": "Adds a Copy button to this value (the element's `copyable` does it for all)"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "FactSource": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "Where the value comes from, short: \"Registry\", \"OSINT\", \"Customer\""
        },
        "grade": {
          "type": "string",
          "description": "The Admiralty grade: a reliability letter A–F and a credibility digit 1–6, e.g. \"B2\""
        },
        "band": {
          "$ref": "#/definitions/FactBand",
          "description": "Sets the band instead of working it out from the grade"
        },
        "note": {
          "type": "string",
          "description": "One line on the source, read after the grade: \"Companies House filing, 2025\""
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "FactBand": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "description": "How far a value can be trusted, from its grade"
    },
    "FactReading": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/FactSource"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false,
      "description": "One reading of a fact"
    },
    "TimelineEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "date": {
          "type": "number",
          "description": "When it happened, as epoch ms"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string",
          "description": "One quiet line under the title"
        },
        "category": {
          "type": "string",
          "description": "A category id from `categories`"
        },
        "source": {
          "$ref": "#/definitions/TimelineSource"
        },
        "flag": {
          "type": "string",
          "description": "A short flag shown beside the tags, e.g. \"Auto-flag\""
        },
        "body": {
          "type": "string",
          "description": "The longer note shown when the event is opened"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TimelineLink"
          },
          "description": "Attachments or records to open from the detail"
        }
      },
      "required": [
        "id",
        "date",
        "title"
      ],
      "additionalProperties": false
    },
    "TimelineSource": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "description": "Where an event came from: any label, with an optional Admiralty grade (A–F reliability, 1–6 credibility)"
    },
    "TimelineLink": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "format": "uri-reference"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "TimelineCategory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "tone": {
          "$ref": "#/definitions/TimelineTone"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "TimelineTone": {
      "type": "string",
      "enum": [
        "success",
        "info",
        "warning",
        "danger",
        "neutral",
        "violet"
      ],
      "description": "The tone a category is drawn in"
    },
    "CaseOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    }
  }
}
