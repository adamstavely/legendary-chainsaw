{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "@adamstavely/trenchcoat/generative/schemas/tc-handoff-brief.json",
  "title": "tc-handoff-brief",
  "description": "Work passing from one person to another: summary, open items and commitments, each acknowledged by the receiver,\nblocked when they lack access.",
  "type": "object",
  "properties": {
    "heading": {
      "type": "string",
      "description": "The heading, and the group's name"
    },
    "from": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Who hands the work over"
    },
    "to": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Who receives it – the person looking"
    },
    "at": {
      "type": "string",
      "description": "When, as the app words it – \"Today 16:40\""
    },
    "summary": {
      "type": "string",
      "description": "What the work is and where it stands, in a short paragraph"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/HandoffBriefItem"
      },
      "description": "What's still open"
    },
    "commitments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/HandoffBriefItem"
      },
      "description": "What the previous owner promised, to whom and by when"
    },
    "acknowledged": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/HandoffBriefSection"
      },
      "description": "The sections acknowledged so far"
    },
    "missing": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/HandoffBriefAccess"
      },
      "description": "Material the work refers to that the receiver can't open – any blocks the handoff"
    },
    "accessRequest": {
      "anyOf": [
        {
          "$ref": "#/definitions/HandoffBriefRequest"
        },
        {
          "type": "string",
          "const": ""
        }
      ],
      "description": "Where the access request stands, when the app owns it; the element sets it when not prevented"
    },
    "accepted": {
      "type": "boolean",
      "description": "The receiver accepted the work"
    },
    "sectionTitles": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "unresolved": {
          "type": "string"
        },
        "commitments": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Names of the three sections"
    },
    "acceptLabel": {
      "type": "string",
      "description": "The accept button's text"
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/HandoffBriefRunStatus"
        },
        "step": {
          "type": "string"
        },
        "startedAt": {
          "type": "number"
        },
        "owner": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "status"
      ],
      "additionalProperties": false,
      "description": "An agent run that's still going, to hand on with the work – set, the card is the sender's"
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/HandoffBriefPerson"
      },
      "description": "Who the run can be handed to"
    },
    "handoffTo": {
      "type": "string",
      "description": "The chosen receiver: a person's id (or name) from `people`"
    },
    "pauseUntilAccepted": {
      "type": "boolean",
      "description": "Whether the run pauses until the receiver accepts"
    },
    "handoffNote": {
      "type": "string",
      "description": "The note for the receiver"
    },
    "handoffState": {
      "type": "string",
      "enum": [
        "",
        "sent"
      ],
      "description": "\"sent\" once the run is handed off and waiting for the receiver; the element sets it when tc-handoff isn't prevented"
    },
    "takesOver": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What the receiver takes over with the run, one line each"
    },
    "locale": {
      "type": "string",
      "description": "Locale for the run's start time"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "HandoffBriefItem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "The item in a sentence"
        },
        "detail": {
          "type": "string",
          "description": "A quiet line under it – where it stands, who's waiting"
        },
        "meta": {
          "type": "string",
          "description": "Right-aligned and quiet: a due date, an owner – \"Due Fri\", \"to Finance\""
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "HandoffBriefSection": {
      "type": "string",
      "enum": [
        "commitments",
        "summary",
        "unresolved"
      ]
    },
    "HandoffBriefAccess": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "What it is – \"Supplier contract (v3)\""
        },
        "where": {
          "type": "string",
          "description": "Where the brief refers to it – \"Open item 2\""
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "description": "Material the work refers to that the receiver can't open"
    },
    "HandoffBriefRequest": {
      "type": "string",
      "enum": [
        "failed",
        "pending",
        "requested"
      ],
      "description": "Where an access request stands"
    },
    "HandoffBriefRunStatus": {
      "type": "string",
      "enum": [
        "paused",
        "running",
        "waiting"
      ],
      "description": "Where an in-flight run stands"
    },
    "HandoffBriefPerson": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "description": "Tells people apart in `people` and `handoffTo`; the name when left out"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  }
}
