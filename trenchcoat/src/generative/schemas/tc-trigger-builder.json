{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "@adamstavely/trenchcoat/generative/schemas/tc-trigger-builder.json",
  "title": "tc-trigger-builder",
  "description": "When an automation runs: an event or a schedule, conditions, a plain-language summary and the next run times.",
  "type": "object",
  "properties": {
    "value": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "event",
            "schedule",
            "webhook"
          ]
        },
        "event": {
          "type": "string"
        },
        "schedule": {
          "$ref": "#/definitions/TriggerSchedule"
        },
        "webhook": {
          "$ref": "#/definitions/TriggerWebhook"
        },
        "active": {
          "anyOf": [
            {
              "$ref": "#/definitions/TriggerActive"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TriggerCondition"
          }
        },
        "match": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ]
        }
      },
      "required": [
        "kind",
        "conditions",
        "match"
      ],
      "additionalProperties": false,
      "description": "The trigger definition. Changed by the user unless a tc-value-change listener calls preventDefault()"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TriggerEvent"
      },
      "description": "The events a trigger can listen for"
    },
    "scheduleFields": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TriggerField"
      },
      "description": "What a schedule's conditions can test (none: schedules have no conditions)"
    },
    "webhookUrl": {
      "type": "string",
      "description": "The webhook address a request starts it from; offers the webhook kind when set"
    },
    "webhookSample": {
      "type": "string",
      "description": "A sample request body (JSON text) to show and send as a test"
    },
    "webhookLast": {
      "type": "object",
      "properties": {
        "at": {
          "type": "number"
        },
        "status": {
          "type": "number"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "at",
        "status"
      ],
      "additionalProperties": false,
      "description": "How the last request to the webhook went; a new value also ends a test that's waiting"
    },
    "webhookFields": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/TriggerField"
      },
      "description": "What a webhook's conditions can test – fields of the request body (none: no conditions)"
    },
    "heading": {
      "type": "string",
      "description": "Names the group, shown at the top"
    },
    "now": {
      "type": "number",
      "description": "Counts the next runs from here (ms since epoch); unset: when the element connected"
    },
    "runCount": {
      "type": "number",
      "description": "How many next runs to list"
    },
    "timeZone": {
      "type": "string",
      "description": "Shown under the card – unset: the browser's time zone"
    },
    "name": {
      "type": "string",
      "description": "Submitted with the form: the definition as JSON"
    },
    "disabled": {
      "type": "boolean",
      "description": "Turns every control off and leaves the definition out of the form; a disabled fieldset does the same"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "TriggerSchedule": {
      "type": "object",
      "properties": {
        "frequency": {
          "$ref": "#/definitions/TriggerFrequency"
        },
        "time": {
          "type": "string",
          "description": "\"09:00\", 24-hour; hourly runs use its minutes"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "Weekly: the days, 0 = Sunday … 6 = Saturday"
        },
        "dayOfMonth": {
          "type": "number",
          "description": "Monthly: the day of the month, 1–31 (a short month runs on its last day)"
        }
      },
      "required": [
        "frequency",
        "time"
      ],
      "additionalProperties": false
    },
    "TriggerFrequency": {
      "type": "string",
      "enum": [
        "daily",
        "hourly",
        "monthly",
        "weekly"
      ]
    },
    "TriggerWebhook": {
      "type": "object",
      "properties": {
        "method": {
          "$ref": "#/definitions/TriggerMethod",
          "description": "POST by default"
        },
        "secretHeader": {
          "type": "string",
          "description": "A header every request must carry with the shared secret, e.g. \"X-Signature\"; none: any request starts it"
        }
      },
      "additionalProperties": false,
      "description": "A webhook trigger's settings"
    },
    "TriggerMethod": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT"
      ]
    },
    "TriggerActive": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false,
      "description": "Only between these days, \"YYYY-MM-DD\", both included"
    },
    "TriggerCondition": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "operator": {
          "$ref": "#/definitions/TriggerOperator"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "TriggerOperator": {
      "type": "string",
      "enum": [
        "contains",
        "gt",
        "is",
        "is-not",
        "lt"
      ]
    },
    "TriggerEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string",
          "description": "In the list – \"Deal changes stage\""
        },
        "phrase": {
          "type": "string",
          "description": "In the sentence after \"when\" – \"a deal changes stage\"; defaults to the label"
        },
        "hint": {
          "type": "string",
          "description": "Lighter text in the list, e.g. the app it comes from"
        },
        "group": {
          "type": "string",
          "description": "Events with the same group are listed under one title"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TriggerField"
          },
          "description": "What its conditions can test"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "TriggerField": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "number",
            "select",
            "text"
          ],
          "description": "\"text\" (the default), \"number\", or \"select\" with `options`"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    }
  }
}
