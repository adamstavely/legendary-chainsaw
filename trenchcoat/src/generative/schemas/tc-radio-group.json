{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trenchcoat/generative/schemas/tc-radio-group.json",
  "title": "tc-radio-group",
  "description": "Radio group for AI product settings.",
  "type": "object",
  "properties": {
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SettingsRadioOption"
      },
      "description": "Choices with stable values and visible labels."
    },
    "label": {
      "type": "string",
      "description": "Visible heading or field label."
    },
    "value": {
      "type": "string",
      "description": "Current value; prevent tc-value-change to control it from the application."
    },
    "description": {
      "type": "string",
      "description": "Supporting explanation under the label."
    },
    "name": {
      "type": "string",
      "description": "Form field name; objects and arrays are serialized as JSON."
    },
    "disabled": {
      "type": "boolean",
      "description": "Disable editing and omit the control from form submission."
    },
    "required": {
      "type": "boolean",
      "description": "Require a nonempty value."
    }
  },
  "additionalProperties": false,
  "definitions": {
    "SettingsRadioOption": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "additionalProperties": false
    }
  }
}
