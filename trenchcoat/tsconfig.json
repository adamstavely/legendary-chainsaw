{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ],
    "useDefineForClassFields": true,
    "plugins": [
      {
        "name": "ts-lit-plugin",
        "strict": true
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@components/*-clean": [
        "src/components/*"
      ],
      "@components/*": [
        "src/components/*"
      ],
      "@blocks/*": [
        "blocks/*"
      ],
      "@screens/*": [
        "screens/*"
      ],
      "@illustrations/*": [
        "illustrations/*"
      ],
      "@motion/*": [
        "motion/*"
      ],
      "trenchcoat/react": [
        "src/elements/react.ts"
      ],
      "trenchcoat/look-provider": [
        "src/elements/internal/look.ts"
      ],
      "@/components/ui/*": [
        "src/components/*",
        "screens/*",
        "blocks/*",
        "illustrations/*",
        "motion/*"
      ]
    }
  },
  "include": [
    "app/src",
    "tests",
    "vite.config.ts",
    "src"
  ],
  // The Angular wrappers import the built package ("trenchcoat/*") and use Angular's decorators: npm run
  // check:angular builds the package and compiles them with ngc. iCloud's "<name> 2.ts" copies (the repo lives under
  // ~/Documents) redeclare their originals' globals
  "exclude": [
    "src/angular",
    "**/* ?.ts",
    "**/* ?.tsx",
    "**/* ?/**"
  ]
}
