{
  "name": "trenchcoat",
  "version": "0.1.0",
  "private": true,
  "description": "Trenchcoat – Lit web components for AI-native products",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/elements/index.d.ts",
      "import": "./dist/index.js"
    },
    "./look-provider": {
      "types": "./dist/types/elements/internal/look.d.ts",
      "import": "./dist/look-provider.js"
    },
    "./react": {
      "types": "./dist/types/elements/react.d.ts",
      "import": "./dist/react.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.js"
    },
    "./angular/forms": {
      "types": "./dist/angular/forms.d.ts",
      "import": "./dist/angular/forms.js"
    },
    "./generative": {
      "types": "./dist/types/generative/index.d.ts",
      "import": "./dist/generative.js"
    },
    "./vue": {
      "types": "./dist/types/vue.d.ts"
    },
    "./svelte": {
      "types": "./dist/types/svelte.d.ts"
    },
    "./tokens.css": "./tokens/tokens.css",
    "./tokens/dtcg/*": "./tokens/dtcg/*",
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json",
    "./internal/*": null,
    "./elements/*": null,
    "./generative/*": null,
    "./angular/*": null,
    "./types/*": null,
    "./*": {
      "types": "./dist/types/elements/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "types": "./dist/types/elements/index.d.ts",
  "customElements": "custom-elements.json",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/angular",
    "dist/types",
    "tokens/tokens.css",
    "tokens/dtcg",
    "custom-elements.json",
    "!**/* [0-9].*",
    "!**/* [0-9][0-9].*"
  ],
  "sideEffects": [
    "*.css",
    "./dist/*.js"
  ],
  "scripts": {
    "dev": "vite --port 5199",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "xd-kit": "node xd-kit/extract.mjs && node --test xd-kit/test/*.test.mjs && node xd-kit/pack.mjs",
    "test": "vitest run",
    "check:prefixes": "node scripts/check-prefixes.mjs",
    "check:ratchet": "node scripts/check-ratchet.mjs",
    "ci": "npm run typecheck && npm run lint && npm run check:prefixes && npm run check:ratchet && npm run check:tokens && npm run check:contrast && node scripts/gen-elements.mjs --check && npm run check:angular && npm run check:generative && npm run check:dead-css && npm run check:docs && npm run check:snippets && npm run check:lit && npm test",
    "check:tokens": "node scripts/tokens.mjs --check && node scripts/check-tokens.mjs && node scripts/tokens-dtcg.mjs --check",
    "check:contrast": "node scripts/contrast.mjs",
    "check:lit": "lit-analyzer src/elements --strict --maxWarnings 0",
    "visual": "node scripts/visual.mjs",
    "build:package": "vite build -c vite.package.config.ts && tsc -p tsconfig.package.json && ngc -p tsconfig.angular.json && cem analyze --config custom-elements-manifest.config.mjs",
    "examples": "node scripts/examples.mjs",
    "gen:elements": "node scripts/gen-elements.mjs",
    "check:dead-css": "node scripts/dead-css.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "check:docs": "node scripts/gen-docs.mjs --check && node scripts/check-docs.mjs",
    "measure:perf": "node scripts/measure-perf.mjs",
    "capture:thumbs": "node scripts/capture-thumbs.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "check:angular": "node scripts/gen-angular.mjs --check && node scripts/check-angular.mjs",
    "tokens:dtcg": "node scripts/tokens-dtcg.mjs",
    "check:generative": "node scripts/gen-schemas.mjs --check"
  },
  "dependencies": {
    "@lit/context": "1.1.6",
    "@lit/react": "1.0.8",
    "@lit/task": "1.0.3",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/compiler-cli": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "4.14.0",
    "custom-element-svelte-integration": "1.2.0",
    "custom-element-vuejs-integration": "1.4.0",
    "eslint": "9.30.1",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-wc": "3.1.0",
    "jsdom": "26.1.0",
    "lit-analyzer": "2.0.3",
    "lucide-react": "1.55.0",
    "marked": "18.1.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "3.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "ts-json-schema-generator": "2.9.0",
    "ts-lit-plugin": "2.0.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@angular/core": ">=19.0.0 <22.0.0",
    "@angular/forms": ">=19.0.0 <22.0.0",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    }
  }
}
