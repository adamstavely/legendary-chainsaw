{
  "name": "trenchcoat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5199",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.lib.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:prefixes": "node scripts/check-prefixes.mjs",
    "check:ratchet": "node scripts/check-ratchet.mjs",
    "ci": "npm run typecheck && npm run lint && npm run check:prefixes && npm run check:ratchet && npm run check:tokens && npm run check:contrast && npm run check:lit && npm test",
    "check:tokens": "node scripts/tokens.mjs --check && node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "check:lit": "lit-analyzer src/elements --strict --maxWarnings 0",
    "visual": "node scripts/visual.mjs"
  },
  "dependencies": {
    "@lit/context": "1.1.6",
    "@lit/react": "1.0.8",
    "@lit/task": "1.0.3",
    "lit": "3.3.3",
    "lucide-react": "1.55.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "axe-core": "4.14.0",
    "eslint": "9.30.1",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-wc": "3.1.0",
    "jsdom": "26.1.0",
    "lit-analyzer": "2.0.3",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "ts-lit-plugin": "2.0.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "6.4.5",
    "vitest": "5.0.5"
  }
}
